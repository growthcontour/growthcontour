<%#
	Головна: короткий звіт продажів за 30 днів (дані — з кешу аналітики в маршруті /). Повний звіт — /analytics/.
%>
<div class="card border-primary rounded-0 mb-3" id="home-analytics">
	<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
		<span><i class="fa-solid fa-chart-line me-2"></i><%= i18n.__('index.analytics.title') %> <small class="opacity-75 ms-2 d-none d-md-inline"><%= i18n.__('index.analytics.period', { from: home.analytics.period.from, to: home.analytics.period.to }) %></small></span>
		<a class="btn btn-sm btn-light rounded-0" href="/analytics/"><%= i18n.__('index.analytics.open') %></a>
	</div>
	<div class="card-body">
		<div class="row g-3 mb-3">
			<% home.analytics.kpi.forEach(function (k) { %>
			<div class="col-6 col-xl-3">
				<div class="home-kpi h-100">
					<div class="small text-muted"><%= i18n.__('index.analytics.kpi_' + k.key) %></div>
					<div class="fs-4 fw-semibold"><%= k.value %></div>
					<div class="small <%= k.trend === 'up' ? 'text-success' : k.trend === 'down' ? 'text-danger' : 'text-muted' %>">
						<i class="fa-solid <%= k.trend === 'up' ? 'fa-arrow-trend-up' : k.trend === 'down' ? 'fa-arrow-trend-down' : 'fa-minus' %> me-1"></i><%= k.delta %> <span class="text-muted"><%= i18n.__('index.analytics.vs_prev') %></span>
					</div>
				</div>
			</div>
			<% }); %>
		</div>
		<% if (home.analytics.any) { %>
		<div class="row g-3">
			<div class="col-xl-8">
				<div id="home-chart" data-chart="<%= home.analytics.chart %>" style="width: 100%; height: 300px"></div>
			</div>
			<div class="col-xl-4">
				<div class="fw-semibold mb-2"><%= i18n.__('index.analytics.top') %></div>
				<% if (home.analytics.top.length) { %>
				<ol class="list-group list-group-numbered list-group-flush">
					<% home.analytics.top.forEach(function (p) { %>
					<li class="list-group-item d-flex align-items-start gap-2 px-0">
						<span class="min-w-0 flex-grow-1"><span class="d-block text-truncate"><%= p.name %></span><small class="text-muted"><%= i18n.__('index.analytics.sold', { qty: p.qty }) %></small></span>
						<span class="fw-semibold text-nowrap"><%= p.revenue %></span>
					</li>
					<% }); %>
				</ol>
				<% } else { %>
				<div class="text-muted small"><%= i18n.__('index.analytics.no_products') %></div>
				<% } %>
			</div>
		</div>
		<% } else { %>
		<div class="text-muted small"><%= i18n.__('index.analytics.no_sales') %></div>
		<% } %>
	</div>
</div>