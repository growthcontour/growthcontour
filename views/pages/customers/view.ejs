<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
<head>
    <%- include('../../partials/head'); %>
	<style>
.profile-pic {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border: 2px solid #dee2e6;
    transition: opacity 0.3s ease;
}

#upload-avatar-btn {
    transition: transform 0.2s ease;
}

#upload-avatar-btn:hover {
    transform: scale(1.1);
}

.position-relative {
    display: inline-block;
}

#avatar-spinner {
    z-index: 10;
}
</style>
</head>
<body class="d-flex flex-column h-100">
<%- include('../../partials/header'); %>

<%
const _id       = customer.id;
const _fullName = [customer.last_name, customer.first_name, customer.middle_name].filter(Boolean).join(' ');
const _initials = ((customer.first_name || '')[0] || '') + ((customer.last_name || '')[0] || '');
const _base     = '/customers/' + _id;
function fmtDate(v) {
    if (!v) return '—';
    return new Date(v).toLocaleDateString('uk-UA');
}
function fmtMoney(v) {
    if (v == null) return '—';
    return parseFloat(v).toLocaleString('uk-UA', { minimumFractionDigits: 2 }) + ' ₴';
}
%>

<!-- Breadcrumb -->
<div class="breadcrumbs pt-3 pb-3">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col">
                <span><%= _fullName || customer.uid %></span>
                <div>
                    <ul class="list-inline mb-0">
                        <li class="list-inline-item">
                            <a href="/"><i class="fas fa-home"></i> <span>Головна</span></a>
                        </li>
                        <li class="list-inline-item">
                            <a href="/customers/"><i class="fas fa-chevron-right"></i> <span>Покупці</span></a>
                        </li>
                        <li class="list-inline-item">
                            <i class="fas fa-chevron-right"></i> <%= _fullName || customer.uid %>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-auto">
                <a href="/customers/" class="btn btn-primary rounded-0">
                    <i class="fa-solid fa-angle-left"></i>
                </a>
            </div>
        </div>
    </div>
</div>
<!-- END Breadcrumb -->

<div class="container-fluid mt-3">
    <div class="row">

        <!-- ── SIDEBAR ──────────────────────────────────────────── -->
        <div class="col-12 col-lg-3 col-xl-2">

            <div class="card border-primary rounded-0 mb-3">
                <div class="card-header text-bg-primary rounded-0">Користувач</div>
                <div class="card-header text-center bg-white pt-4 pb-2">
					<div class="position-relative d-inline-block">
						<div class="spinner-border text-primary position-absolute top-50 start-50 translate-middle" 
							id="avatar-spinner" 
							role="status" 
							style="display: none; width: 40px; height: 40px;">
							<span class="visually-hidden">Loading...</span>
						</div>
						<img src="/assets/images/customers/avatars/no-avatar.jpg" 
							class="rounded-circle profile-pic" 
							alt="Profile Picture"
							id="customer-avatar"
							style="width: 80px; height: 80px; object-fit: cover; border: 2px solid #ddd;">
						<button class="btn btn-primary btn-sm position-absolute bottom-0 end-0 rounded-circle" 
								id="upload-avatar-btn"
								style="width: 28px; height: 28px; padding: 0; font-size: 12px;">
							<i class="fas fa-camera"></i>
						</button>
						<input type="file" id="avatar-file-input" accept="image/jpeg,image/png" style="display: none;">
					</div>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item text-center">
                        <div class="fw-bold"><%= _fullName || '—' %></div>
                        <div class="text-muted small"><%= customer.uid %></div>
                    </li>
                    <% if (customer.blacklisted || customer.is_new) { %>
                    <li class="list-group-item text-center">
                        <% if (customer.blacklisted) { %><span class="badge bg-danger me-1">Blocked</span><% } %>
                        <% if (customer.is_new) { %><span class="badge bg-success">New</span><% } %>
                    </li>
                    <% } %>
                    <% if (groups && groups.length) { %>
                    <li class="list-group-item text-center">
                        <div class="d-flex flex-wrap justify-content-center gap-1">
                            <% groups.forEach(function(g) { %>
                            <span class="badge" style="color:<%= g.color_text %>;background:<%= g.color_background %>">
                                <%= g.text %>
                            </span>
                            <% }); %>
                        </div>
                    </li>
                    <% } %>
                    <% if (loyalty) { %>
                    <li class="list-group-item text-center">
                        <span class="badge px-2 py-1 me-1"
                              style="background:<%= loyalty.level_color || '#ccc' %>;color:#fff">
                            <%= loyalty.level_name || '—' %>
                        </span>
                        <span class="small fw-semibold text-warning">
                            <%= loyalty.points_balance || 0 %> pts
                        </span>
                    </li>
                    <% } %>
                </ul>
            </div>

            <div class="card border-primary rounded-0 mb-3">
                <div class="card-header text-bg-primary rounded-0">Навігація</div>
                <div class="list-group list-group-flush">
                    <%
                    const _nav = [
                        { path: '',           icon: 'fa-user',              label: 'General'   },
                        { path: '/contacts',  icon: 'fa-address-book',      label: 'Contacts'  },
                        { path: '/addresses', icon: 'fa-location-dot',      label: 'Addresses' },
                        { path: '/groups',    icon: 'fa-users',             label: 'Groups'    },
                        { path: '/loyalty',   icon: 'fa-star',              label: 'Loyalty'   },
                        { path: '/analytics', icon: 'fa-chart-simple',      label: 'Analytics' },
                        { path: '/notes',     icon: 'fa-note-sticky',       label: 'Notes'     },
                        { path: '/history',   icon: 'fa-clock-rotate-left', label: 'History'   },
                    ];
                    _nav.forEach(function(n) {
                        const href    = _base + n.path;
                        const current = (n.path === '' && locals.active === undefined)
                                     || locals.active === n.path.replace('/', '');
                    %>
                    <a href="<%= href %>"
                       class="list-group-item list-group-item-action rounded-0 py-2 <%= current ? 'active' : '' %>">
                        <i class="fa-solid <%= n.icon %> fa-fw me-2"></i><%= n.label %>
                    </a>
                    <% }); %>
                </div>
            </div>

        </div>
        <!-- END SIDEBAR -->

        <!-- ── MAIN CONTENT ─────────────────────────────────────── -->
        <div class="col-12 col-lg-9 col-xl-10">
            <div class="row g-3">

                <!-- General info — inline edit -->
                <div class="col-12 col-xl-8">
                    <div class="card border-primary rounded-0 h-100">
    <div class="card-header text-bg-primary rounded-0">
        <i class="fa-solid fa-user me-2"></i>General Information
        <small class="ms-2 opacity-75" style="font-size:.7rem">
            <i class="fa-solid fa-pen-to-square me-1"></i>Click a field to edit
        </small>
    </div>
    <div class="card-body">
        <!-- Функція для безпечного виведення з дефолтним значенням -->
        <% function displayValue(value) { 
            if (value && value !== '') { 
                return value; 
            } else { 
                return '<span class="text-muted">—</span>'; 
            } 
        } %>
        
        <!-- ID - readonly, not editable -->
        <div class="row mb-4 pb-1 border-bottom">
            <div class="col-12">
                <div class="d-flex align-items-center justify-content-between bg-light p-2 rounded-0">
                    <div>
                        <span class="text-muted small me-2">Customer ID:</span>
                        <span class="fw-bold text-primary"><%= customer.id %></span>
                        <span class="text-muted mx-2">|</span>
                        <span class="text-muted small me-2">UID:</span>
                        <span class="fw-mono"><code><%= customer.uid %></code></span>
                    </div>
                    <div>
                        <span class="badge bg-secondary rounded-0">System ID</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Row 1: Name fields (3 columns) -->
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="text-muted small mb-1">Last name</div>
                <div class="ie-field fw-semibold p-2 bg-light rounded-1"
                     data-field="last_name"
                     data-value="<%= customer.last_name || '' %>">
                    <%- customer.last_name ? customer.last_name : '<span class="text-muted fw-normal">—</span>' %>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">First name</div>
                <div class="ie-field fw-semibold p-2 bg-light rounded-1"
                     data-field="first_name"
                     data-value="<%= customer.first_name || '' %>">
                    <%- customer.first_name ? customer.first_name : '<span class="text-muted fw-normal">—</span>' %>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">Middle name</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="middle_name"
                     data-value="<%= customer.middle_name || '' %>">
                    <%- customer.middle_name ? customer.middle_name : '<span class="text-muted">—</span>' %>
                </div>
            </div>
        </div>

        <!-- Row 2: Personal info (4 columns) -->
        <div class="row g-3 mb-3">
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Gender</div>
                <div class="ie-field ie-select p-2 bg-light rounded-1"
                     data-field="gender"
                     data-value="<%= customer.gender || '' %>"
                     data-options='[{"value":"male","label":"Male"},{"value":"female","label":"Female"},{"value":"other","label":"Other"}]'>
                    <% if (customer.gender === 'male') { %>
                        <i class="fa-solid fa-mars text-primary me-1"></i>Male
                    <% } else if (customer.gender === 'female') { %>
                        <i class="fa-solid fa-venus text-danger me-1"></i>Female
                    <% } else { %>
                        <span class="text-muted">—</span>
                    <% } %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Birthday</div>
                <div class="ie-field ie-date p-2 bg-light rounded-1"
                     data-field="birthday"
                     data-value="<%= customer.birthday ? customer.birthday.toString().slice(0,10) : '' %>">
                    <%- fmtDate(customer.birthday) %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Age</div>
                <div class="p-2 bg-light rounded-1">
                    <%- customer.age ? customer.age + ' years' : '<span class="text-muted">—</span>' %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Type</div>
                <div class="ie-field ie-select p-2 bg-light rounded-1"
                     data-field="type"
                     data-value="<%= customer.type || '' %>"
                     data-options='[{"value":"individual","label":"Individual"},{"value":"company","label":"Company"}]'>
                    <% if (customer.type === 'individual') { %>
                        <i class="fa-solid fa-user me-1"></i>Individual
                    <% } else if (customer.type === 'company') { %>
                        <i class="fa-solid fa-building me-1"></i>Company
                    <% } else { %>
                        <span class="text-muted">—</span>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Row 3: System settings (4 columns) -->
        <div class="row g-3 mb-3">
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Language</div>
                <div class="ie-field ie-select p-2 bg-light rounded-1"
                     data-field="language"
                     data-value="<%= customer.language || '' %>"
                     data-options='[{"value":"uk","label":"Ukrainian"},{"value":"en","label":"English"}]'>
                    <% if (customer.language === 'uk') { %>
                        <i class="fa-solid fa-flag me-1"></i>UA
                    <% } else if (customer.language === 'en') { %>
                        <i class="fa-solid fa-flag me-1"></i>EN
                    <% } else { %>
                        <span class="text-muted">—</span>
                    <% } %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Timezone</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="timezone"
                     data-value="<%= customer.timezone || '' %>">
                    <i class="fa-regular fa-clock me-1"></i>
                    <%- customer.timezone ? customer.timezone : '<span class="text-muted">—</span>' %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Currency</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="currency"
                     data-value="<%= customer.currency || '' %>">
                    <i class="fa-solid fa-coins me-1"></i>
                    <%- customer.currency ? customer.currency : '<span class="text-muted">—</span>' %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Source</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="source"
                     data-value="<%= customer.source || '' %>">
                    <i class="fa-solid fa-globe me-1"></i>
                    <%- customer.source ? customer.source : '<span class="text-muted">—</span>' %>
                </div>
            </div>
        </div>

        <!-- Row 4: External references (4 columns) -->
        <div class="row g-3 mb-3">
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">External ID</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="external_id"
                     data-value="<%= customer.external_id || '' %>">
                    <i class="fa-solid fa-link me-1"></i>
                    <%- customer.external_id ? customer.external_id : '<span class="text-muted">—</span>' %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">External Source</div>
                <div class="p-2 bg-light rounded-1">
                    <%- customer.external_source ? customer.external_source : '<span class="text-muted">—</span>' %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Referral Code</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="referral_code"
                     data-value="<%= customer.referral_code || '' %>">
                    <i class="fa-solid fa-gift me-1"></i>
                    <%- customer.referral_code ? customer.referral_code : '<span class="text-muted">—</span>' %>
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <div class="text-muted small mb-1">Referred By</div>
                <div class="p-2 bg-light rounded-1">
                    <%- customer.referred_by_id ? 'ID: ' + customer.referred_by_id : '<span class="text-muted">—</span>' %>
                </div>
            </div>
        </div>

        <!-- Row 5: CRM / Pipeline references (3 columns) -->
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="text-muted small mb-1">Lead ID</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="lead_id"
                     data-value="<%= customer.lead_id || '' %>">
                    <i class="fa-solid fa-chart-line me-1"></i>
                    <%- customer.lead_id ? customer.lead_id : '<span class="text-muted">—</span>' %>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">Deal ID</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="deal_id"
                     data-value="<%= customer.deal_id || '' %>">
                    <i class="fa-solid fa-handshake me-1"></i>
                    <%- customer.deal_id ? customer.deal_id : '<span class="text-muted">—</span>' %>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small mb-1">Quote ID</div>
                <div class="ie-field p-2 bg-light rounded-1"
                     data-field="quote_id"
                     data-value="<%= customer.quote_id || '' %>">
                    <i class="fa-solid fa-file-invoice me-1"></i>
                    <%- customer.quote_id ? customer.quote_id : '<span class="text-muted">—</span>' %>
                </div>
            </div>
        </div>

        <!-- Row 6: Notes (full width) -->
        <div class="row g-3 mb-3">
            <div class="col-12">
                <div class="text-muted small mb-1">
                    <i class="fa-solid fa-pen me-1"></i>Notes
                </div>
                <div class="ie-field ie-textarea p-2 bg-light rounded-1"
                     data-field="notes"
                     data-value="<%= customer.notes || '' %>">
                    <% if (customer.notes) { %>
                        <div class="border-start border-2 border-warning ps-2 py-1 small">
                            <%- customer.notes.replace(/\n/g, '<br>') %>
                        </div>
                    <% } else { %>
                        <span class="text-muted">—</span>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Row 7: Tags (full width) -->
        <div class="row g-3">
            <div class="col-12">
                <div class="text-muted small mb-1">
                    <i class="fa-solid fa-tags me-1"></i>Tags
                </div>
                <div class="ie-field ie-textarea p-2 bg-light rounded-1"
                     data-field="tags"
                     data-value="<%= customer.tags ? JSON.stringify(customer.tags) : '' %>">
                    <% if (customer.tags && Array.isArray(customer.tags) && customer.tags.length) { %>
                        <% customer.tags.forEach(function(tag) { %>
                            <span class="badge bg-info text-dark rounded-0 me-1 mb-1 px-2 py-1">
                                <i class="fa-solid fa-hashtag me-1 fa-xs"></i><%= tag %>
                            </span>
                        <% }); %>
                    <% } else { %>
                        <span class="text-muted">—</span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
                </div>

                <!-- CRM статус — inline edit + modal -->
                <div class="col-12 col-xl-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-sliders me-2"></i>CRM Status</span>
                            <button class="btn btn-sm btn-light rounded-0"
                                    data-bs-toggle="modal" data-bs-target="#modalComm"
                                    title="Communication settings">
                                <i class="fa-solid fa-tower-broadcast"></i>
                            </button>
                        </div>
                        <div class="card-body">

                            <div class="mb-3">
                                <div class="text-muted small">Segment</div>
                                <div class="ie-field ie-select"
                                     data-field="segment"
                                     data-value="<%= customer.segment || '' %>"
                                     data-options='[{"value":"vip","label":"VIP"},{"value":"retail","label":"Retail"},{"value":"bulk_buyer","label":"Bulk Buyer"},{"value":"at_risk","label":"At Risk"}]'>
                                    <% if (customer.segment) { %>
                                        <span class="badge bg-secondary rounded-0"><%= customer.segment %></span>
                                    <% } else { %>
                                        <span class="text-muted">—</span>
                                    <% } %>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Payment discipline</div>
                                <%
                                const _disc      = customer.payment_discipline;
                                const _discColor = _disc === 'good' ? 'success' : _disc === 'average' ? 'warning' : 'danger';
                                %>
                                <div class="ie-field ie-select"
                                     data-field="payment_discipline"
                                     data-value="<%= _disc || '' %>"
                                     data-options='[{"value":"good","label":"Good"},{"value":"average","label":"Average"},{"value":"bad","label":"Bad"}]'>
                                    <span class="badge bg-<%= _discColor %> rounded-0"><%= _disc || '—' %></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Credit limit</div>
                                <div class="ie-field ie-number"
                                     data-field="credit_limit"
                                     data-value="<%= customer.credit_limit || 0 %>">
                                    <span class="fw-semibold"><%= fmtMoney(customer.credit_limit) %></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="text-muted small">Assigned to</div>
                                <div class="ie-field"
                                     data-field="assigned_to"
                                     data-value="<%= customer.assigned_to || '' %>">
                                    <%= customer.assigned_to || '—' %>
                                </div>
                            </div>

                            <hr>

                            <!-- Канали зв'язку — тільки перегляд, редагується через modal -->
                            <div class="d-flex flex-wrap gap-1">
                                <% if (customer.do_not_call) { %>
                                <span class="badge bg-danger rounded-0">
                                    <i class="fa-solid fa-phone-slash me-1"></i>No call
                                </span>
                                <% } %>
                                <% if (customer.do_not_email) { %>
                                <span class="badge bg-danger rounded-0">
                                    <i class="fa-solid fa-envelope-slash me-1"></i>No email
                                </span>
                                <% } %>
                                <% if (customer.do_not_sms) { %>
                                <span class="badge bg-danger rounded-0">
                                    <i class="fa-solid fa-comment-slash me-1"></i>No SMS
                                </span>
                                <% } %>
                                <% if (!customer.do_not_call && !customer.do_not_email && !customer.do_not_sms) { %>
                                <span class="text-muted small">All channels active</span>
                                <% } %>
                            </div>

                            <!-- Blacklisted info -->
                            <% if (customer.blacklisted && customer.blacklisted_at) { %>
                            <hr>
                            <div class="mt-2">
                                <div class="text-muted small">Blacklisted at</div>
                                <div><%= fmtDate(customer.blacklisted_at) %></div>
                                <% if (customer.blacklist_reason) { %>
                                <div class="text-muted small mt-1">Reason</div>
                                <div class="text-danger"><%= customer.blacklist_reason %></div>
                                <% } %>
                            </div>
                            <% } %>

                        </div>
                    </div>
                </div>

                <!-- Контакти (phones + emails) — тільки modal -->
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-address-book me-2"></i>Contacts</span>
                            <button class="btn btn-sm btn-light rounded-0"
                                    data-bs-toggle="modal" data-bs-target="#modalContacts">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                        </div>
                        <div class="card-body py-2 px-3" id="contacts-preview">
                            <p class="text-muted small mb-0">Loading...</p>
                        </div>
                    </div>
                </div>

                <!-- Соціальні мережі — inline edit -->
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div class="card-header text-bg-primary rounded-0">
                            <i class="fa-solid fa-share-nodes me-2"></i>Social
                            <small class="ms-2 opacity-75" style="font-size:.7rem">
                                <i class="fa-solid fa-pen-to-square me-1"></i>Click to edit
                            </small>
                        </div>
                        <div class="card-body">
                            <%
                            const _socials = [
                                { field: 'social_telegram',  icon: 'fa-brands fa-telegram',  val: customer.social_telegram,  prefix: 'https://t.me/'          },
