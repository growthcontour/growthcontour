<script>
const CUSTOMER_ID = '<%= _id %>';
const API         = '/api/customers/' + CUSTOMER_ID;

// ══════════════════════════════════════════════
//  INLINE EDIT
// ══════════════════════════════════════════════
document.querySelectorAll('.ie-field').forEach(function(el) {
    el.style.cursor = 'pointer';
    el.title = 'Click to edit';

    el.addEventListener('click', function() {
        if (el.querySelector('input, select, textarea')) return; // вже редагується

        const field   = el.dataset.field;
        const val     = el.dataset.value || '';
        const origHtml = el.innerHTML;
        const isSelect   = el.classList.contains('ie-select');
        const isDate     = el.classList.contains('ie-date');
        const isTextarea = el.classList.contains('ie-textarea');
        const isNumber   = el.classList.contains('ie-number');

        let input;

        if (isSelect) {
            const opts = JSON.parse(el.dataset.options || '[]');
            input = document.createElement('select');
            input.className = 'form-select form-select-sm rounded-0';
            opts.forEach(function(o) {
                const opt = document.createElement('option');
                opt.value = o.value;
                opt.textContent = o.label;
                if (o.value === val) opt.selected = true;
                input.appendChild(opt);
            });
        } else if (isDate) {
            input = document.createElement('input');
            input.type = 'date';
            input.className = 'form-control form-control-sm rounded-0';
            input.value = val;
        } else if (isTextarea) {
            input = document.createElement('textarea');
            input.className = 'form-control form-control-sm rounded-0';
            input.rows = 3;
            input.value = val;
        } else if (isNumber) {
            input = document.createElement('input');
            input.type = 'number';
            input.className = 'form-control form-control-sm rounded-0';
            input.value = val;
        } else {
            input = document.createElement('input');
            input.type = 'text';
            input.className = 'form-control form-control-sm rounded-0';
            input.value = val;
        }

        el.innerHTML = '';
        el.appendChild(input);
        input.focus();

        function save() {
            const newVal = input.value.trim();
            if (newVal === val) { el.innerHTML = origHtml; return; } // не змінилось

            fetch(API + '/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ [field]: newVal })
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                if (d.success) {
                    el.dataset.value = newVal;
                    // Оновлюємо відображення
                    if (newVal) {
                        if (field === 'tags') {
                            try {
                                const tags = JSON.parse(newVal);
                                if (Array.isArray(tags)) {
                                    el.innerHTML = tags.map(function(t) {
                                        return '<span class="badge bg-info rounded-0 me-1">' + t + '</span>';
                                    }).join('');
                                } else {
                                    el.innerHTML = newVal;
                                }
                            } catch(e) {
                                el.innerHTML = newVal;
                            }
                        } else {
                            el.innerHTML = newVal;
                        }
                    } else {
                        el.innerHTML = '<span class="text-muted">—</span>';
                    }
                } else {
                    el.innerHTML = origHtml;
                    alert(d.error || 'Save error');
                }
            })
            .catch(function() {
                el.innerHTML = origHtml;
            });
        }

        input.addEventListener('blur', save);
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !isTextarea) save();
            if (e.key === 'Escape') el.innerHTML = origHtml;
        });
    });
});


// ══════════════════════════════════════════════
//  CONTACTS MODAL
// ══════════════════════════════════════════════
function loadContacts() {
    fetch(API + '/contacts', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(rows) {
        renderContacts(rows);
        // Також оновлюємо preview в картці
        var preview = document.getElementById('contacts-preview');
        if (!rows.length) {
            preview.innerHTML = '<span class="text-muted small">No contacts</span>';
            return;
        }
        preview.innerHTML = rows.slice(0, 4).map(function(c) {
            var icon = c.type === 'phone' ? 'fa-phone' : 'fa-envelope';
            var star = c.is_primary ? ' <i class="fa-solid fa-star text-warning fa-xs"></i>' : '';
            return '<div class="small mb-1"><i class="fa-solid ' + icon + ' fa-xs text-muted me-2"></i>'
                 + c.value + star + '</div>';
        }).join('');
    });
}

function renderContacts(rows) {
    var tb = document.getElementById('contacts-tbody');
    if (!rows.length) {
        tb.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-3">No contacts</td></tr>';
        return;
    }
    tb.innerHTML = rows.map(function(c) {
        var typeBadge = '<span class="badge bg-secondary rounded-0">' + c.type + '</span>';
        var star      = c.is_primary
            ? '<i class="fa-solid fa-star text-warning"></i>'
            : '<i class="fa-regular fa-star text-muted" style="cursor:pointer" onclick="setPrimary(' + c.id + ',\'' + c.type + '\')"></i>';
        return '<tr>'
            + '<td class="ps-3">' + typeBadge + '</td>'
            + '<td class="fw-semibold">' + c.value + '</td>'
            + '<td class="text-muted small">' + (c.label_name || '—') + '</td>'
            + '<td class="text-center">' + star + '</td>'
            + '<td><a href="#" class="text-danger" onclick="deleteContact(' + c.id + ');return false">'
            + '<i class="fa-solid fa-xmark"></i></a></td>'
            + '</tr>';
    }).join('');
}

document.getElementById('modalContacts').addEventListener('show.bs.modal', loadContacts);

document.getElementById('btn-add-contact').addEventListener('click', function() {
    var type  = document.getElementById('new-contact-type').value;
    var value = document.getElementById('new-contact-value').value.trim();
    var label = document.getElementById('new-contact-label').value;
    if (!value) return;

    fetch(API + '/contacts/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: type, value: value, id_label: label || null })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.success) {
            document.getElementById('new-contact-value').value = '';
            loadContacts();
        } else {
            alert(d.error || 'Error');
        }
    });
});

function deleteContact(id) {
    if (!confirm('Delete this contact?')) return;
    fetch(API + '/contacts/' + id + '/delete', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) { if (d.success) loadContacts(); });
}

function setPrimary(id, type) {
    fetch(API + '/contacts/' + id + '/set-primary', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) { if (d.success) loadContacts(); });
}


// ══════════════════════════════════════════════
//  COMMUNICATION MODAL
// ══════════════════════════════════════════════
document.getElementById('sw-blacklisted').addEventListener('change', function() {
    document.getElementById('blacklist-reason-wrap').style.display = this.checked ? '' : 'none';
});

document.getElementById('btn-save-comm').addEventListener('click', function() {
    var payload = {
        do_not_call:      document.getElementById('sw-do-not-call').checked  ? 1 : 0,
        do_not_email:     document.getElementById('sw-do-not-email').checked ? 1 : 0,
        do_not_sms:       document.getElementById('sw-do-not-sms').checked   ? 1 : 0,
        blacklisted:      document.getElementById('sw-blacklisted').checked  ? 1 : 0,
        blacklist_reason: document.getElementById('blacklist-reason').value.trim() || null,
    };

    fetch(API + '/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        if (d.success) {
            bootstrap.Modal.getInstance(document.getElementById('modalComm')).hide();
            location.reload();
        } else {
            alert(d.error || 'Save error');
        }
    });
});


// ══════════════════════════════════════════════
//  Init
// ══════════════════════════════════════════════
loadContacts();
</script>
<script>
$(document).ready(function() {
    const CUSTOMER_ID = '<%= _id %>';
    const $avatar = $('#customer-avatar');
    const $spinner = $('#avatar-spinner');
    
    // Функція завантаження аватара через POST
    function loadAvatar() {
        $spinner.show();
        $avatar.css('opacity', '0.3');
        
        $.ajax({
            url: `/api/customers/${CUSTOMER_ID}/avatar`,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({}),
            success: function(response) {
                if (response.exists) {
                    $avatar.attr('src', `/assets/images/customers/avatars/${CUSTOMER_ID}.jpg`);
                } else {
                    $avatar.attr('src', '/assets/images/customers/avatars/no-avatar.jpg');
                }
            },
            error: function() {
                $avatar.attr('src', '/assets/images/customers/avatars/no-avatar.jpg');
            },
            complete: function() {
                $spinner.hide();
                $avatar.css('opacity', '1');
            }
        });
    }
    
    // Завантажуємо аватар при завантаженні сторінки
    loadAvatar();
    
    // Обробка кліку на кнопку камери
    $('#upload-avatar-btn').on('click', function() {
        $('#avatar-file-input').click();
    });
    
    // Обробка вибору файлу
    $('#avatar-file-input').on('change', function(e) {
        const file = e.target.files[0];
        
        if (!file) return;
        
        // Перевірка типу через JavaScript
        if (!file.type.match('image/jpeg') && !file.type.match('image/png')) {
            alert('❌ Тільки JPG та PNG файли дозволені');
            $('#avatar-file-input').val('');
            return;
        }
        
        // Перевірка розміру (2MB)
        if (file.size > 2 * 1024 * 1024) {
            alert('❌ Файл занадто великий. Максимум 2MB');
            $('#avatar-file-input').val('');
            return;
        }
        
        // Показуємо спінер
        $spinner.show();
        $avatar.css('opacity', '0.3');
        
        // Відправка файлу
        const formData = new FormData();
        formData.append('avatar', file);
        
        $.ajax({
            url: `/api/customers/${CUSTOMER_ID}/upload-avatar`,
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                if (response.success) {
                    // Оновлюємо аватар з кеш-бастером
                    $avatar.attr('src', `/assets/images/customers/avatars/${CUSTOMER_ID}.jpg?t=${Date.now()}`);
                    alert('✅ Аватар успішно оновлено');
                } else {
                    alert('❌ ' + (response.error || 'Помилка завантаження'));
                    // Повертаємо поточний аватар
                    loadAvatar();
                }
            },
            error: function(xhr) {
                let errorMsg = 'Помилка завантаження';
                if (xhr.responseJSON && xhr.responseJSON.error) {
                    errorMsg = xhr.responseJSON.error;
                }
                alert('❌ ' + errorMsg);
                // Повертаємо поточний аватар
                loadAvatar();
            },
            complete: function() {
                $spinner.hide();
                $avatar.css('opacity', '1');
            }
        });
        
        // Очищаємо input
        $('#avatar-file-input').val('');
    });
});
</script>
</body>
</html>