<%
	// Спільна сторінка помилки: 403 / 404 / 500. Змінні необов'язкові — сторінку рендерять і обробник помилок, і маршрути.
	const code = (typeof error !== 'undefined' && error && error.status) || (typeof status !== 'undefined' && status) || 404;
	const titles = { 400: 'Невірний запит', 401: 'Потрібен вхід', 403: 'Доступ заборонено', 404: 'Сторінку не знайдено', 500: 'Помилка сервера' };
	const text = (typeof message !== 'undefined' && message) || titles[code] || titles[500];
	const rid = typeof request_id !== 'undefined' ? request_id : null;
%>
<!doctype html>
<html class="h-100" lang="uk">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title><%= code %> · <%= titles[code] || titles[500] %></title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
	</head>
	<body class="d-flex flex-column h-100 bg-body-tertiary">
		<div class="container h-100">
			<div class="row h-100 align-items-center justify-content-center">
				<div class="col-12 col-md-6 col-lg-5">
					<div class="card border-primary rounded-0">
						<div class="card-header text-bg-primary rounded-0 fw-semibold"><%= code %> · <%= titles[code] || titles[500] %></div>
						<div class="card-body">
							<p class="mb-3"><%= text %></p>
							<% if (rid) { %><p class="small text-muted mb-3">Request ID: <code><%= rid %></code> — назвіть його адміністратору, щоб швидко знайти помилку в журналі.</p><% } %>
							<a href="javascript:history.back()" class="btn btn-outline-secondary rounded-0 me-2">Назад</a>
							<a href="/" class="btn btn-primary rounded-0">На головну</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</body>
</html>
