<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('index.title') %></title>
		<%- include('../../partials/head'); %>
		<!-- Сторонні бібліотеки -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
		<!-- END Сторонні бібліотеки -->
		<!-- Full calendar -->
		<link href="/assets/css/tabulator/tabulator.min.css" rel="stylesheet" />
		<link href="/assets/css/tabulator/tabulator_bootstrap5.min.css" rel="stylesheet" />
		<link href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css" rel="stylesheet" />
		<style>
			/* ── Календар: базове ─────────────────────────────── */
			#userCalendar .fc-daygrid-event-harness {
				margin-bottom: 2px;
			}

			#userCalendar .fc-event {
				border: none !important;
				background: transparent !important;
				box-shadow: none !important;
			}

			#userCalendar .fc-event:focus {
				outline: none;
				box-shadow: none;
			}

			#userCalendar .fc-daygrid-day.fc-day-today {
				background-color: rgba(13, 110, 253, 0.06) !important;
			}

			#userCalendar .fc-col-header-cell {
				background: var(--bs-light);
				font-weight: 600;
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.03em;
			}

			#userCalendar .fc-daygrid-day-number {
				font-size: 0.8rem;
				padding: 4px 6px;
			}

			/* ── Картка події ─────────────────────────────────── */
			.ce-chip {
				display: flex;
				align-items: center;
				gap: 5px;
				padding: 3px 6px;
				font-size: 0.72rem;
				line-height: 1.25;
				border-left: 3px solid var(--ce-color, #6c757d);
				background: color-mix(in srgb, var(--ce-color, #6c757d) 12%, #fff);
				color: #212529;
				overflow: hidden;
				cursor: pointer;
				transition:
					background 0.12s ease,
					transform 0.12s ease;
			}

			.ce-chip:hover {
				background: color-mix(in srgb, var(--ce-color, #6c757d) 22%, #fff);
				transform: translateX(1px);
			}

			.ce-chip__icon {
				flex: 0 0 auto;
				color: var(--ce-color, #6c757d);
				font-size: 0.7rem;
			}

			.ce-chip__time {
				flex: 0 0 auto;
				font-variant-numeric: tabular-nums;
				font-weight: 600;
				opacity: 0.75;
			}

			.ce-chip__title {
				flex: 1 1 auto;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
				font-weight: 500;
			}

			.ce-chip__meta {
				flex: 0 0 auto;
				display: flex;
				align-items: center;
				gap: 4px;
				opacity: 0.65;
				font-size: 0.65rem;
			}

			/* Подія на весь день — суцільна заливка */
			.ce-chip--allday {
				background: var(--ce-color, #6c757d);
				color: #fff;
				border-left: none;
				padding: 4px 8px;
				font-weight: 500;
			}

			.ce-chip--allday:hover {
				background: color-mix(in srgb, var(--ce-color, #6c757d) 85%, #000);
			}

			.ce-chip--allday .ce-chip__icon,
			.ce-chip--allday .ce-chip__meta {
				color: #fff;
				opacity: 0.85;
			}

			/* Стани */
			.ce-chip--done .ce-chip__title {
				text-decoration: line-through;
				opacity: 0.55;
			}

			.ce-chip--canceled {
				opacity: 0.45;
			}

			.ce-chip--canceled .ce-chip__title {
				text-decoration: line-through;
			}

			/* Чужа подія — пунктир */
			.ce-chip--guest {
				border-left-style: dashed;
			}

			/* Пріоритет — крапка справа */
			.ce-chip__prio {
				flex: 0 0 auto;
				width: 6px;
				height: 6px;
				border-radius: 50%;
			}

			.ce-prio-3 {
				background: #fd7e14;
			}
			.ce-prio-4 {
				background: #dc3545;
			}

			/* ── Вигляд тижня/дня ─────────────────────────────── */
			.fc-timeGridWeek-view .ce-chip,
			.fc-timeGridDay-view .ce-chip {
				height: 100%;
				flex-direction: column;
				align-items: flex-start;
				gap: 2px;
				background: color-mix(in srgb, var(--ce-color, #6c757d) 18%, #fff);
			}

			.fc-timeGridWeek-view .ce-chip__title,
			.fc-timeGridDay-view .ce-chip__title {
				white-space: normal;
				line-height: 1.2;
			}

			/* ── Поповер ──────────────────────────────────────── */
			.ce-pop {
				max-width: 320px;
			}

			.ce-pop .popover-header {
				background: var(--ce-color, #6c757d);
				color: #fff;
				border-bottom: none;
				font-size: 0.85rem;
				border-radius: 0;
			}

			.ce-pop .popover-body {
				font-size: 0.8rem;
				padding: 0.6rem 0.75rem;
			}

			.ce-pop .popover-arrow::after {
				border-top-color: var(--ce-color, #6c757d);
			}

			.ce-pop__row {
				display: flex;
				align-items: flex-start;
				gap: 7px;
				margin-bottom: 5px;
			}

			.ce-pop__row:last-child {
				margin-bottom: 0;
			}

			.ce-pop__row i {
				flex: 0 0 14px;
				margin-top: 2px;
				color: var(--bs-secondary);
				font-size: 0.75rem;
			}

			.ce-pop__desc {
				color: var(--bs-secondary);
				font-style: italic;
				border-top: 1px solid var(--bs-border-color);
				padding-top: 6px;
				margin-top: 6px;
			}
			/* ── Чужа подія ───────────────────────────────────── */
			.ce-chip--foreign {
				border-left-style: dotted;
				opacity: 0.82;
			}

			.ce-chip--foreign .ce-chip__title {
				font-weight: 400;
			}

			.ce-chip__owner {
				flex: 0 0 auto;
				font-size: 0.62rem;
				opacity: 0.7;
				font-style: italic;
			}

			/* Замасковано (busy) */
			.ce-chip--masked {
				background: repeating-linear-gradient(45deg, rgba(173, 181, 189, 0.18), rgba(173, 181, 189, 0.18) 6px, rgba(173, 181, 189, 0.3) 6px, rgba(173, 181, 189, 0.3) 12px);
				border-left-color: #adb5bd;
				color: var(--bs-secondary);
			}

			/* ── Відсутність: фонова смуга ────────────────────── */
			#userCalendar .fc-bg-event {
				opacity: 1 !important;
			}

			.ce-absence {
				height: 100%;
				display: flex;
				align-items: center;
				gap: 6px;
				padding: 2px 8px;
				font-size: 0.7rem;
				font-weight: 600;
				color: #fff;
				background: var(--ce-color, #fd7e14);
				opacity: 0.9;
			}

			.ce-absence i {
				font-size: 0.68rem;
			}

			/* Панель фільтрів */
			.card-header .form-check-input {
				cursor: pointer;
			}

			.card-header .form-check-label {
				cursor: pointer;
				user-select: none;
			}
		</style>
		<!-- END Full calendar -->
		<style>
			/* Головна: привітання, показники дня, списки з прокруткою */
			.home-hero {
				background: linear-gradient(120deg, #0057b8 0%, #2f7fd8 60%, #5aa2ea 100%);
				color: #fff;
			}
			.home-hello {
				font-size: 1.5rem;
				font-weight: 600;
				line-height: 1.2;
			}
			.home-date {
				opacity: 0.85;
				text-transform: capitalize;
			}
			.home-stat {
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				min-width: 96px;
				padding: 0.5rem 0.75rem;
				background: rgba(255, 255, 255, 0.14);
				color: #fff;
				border: 1px solid rgba(255, 255, 255, 0.25);
				transition: background 0.15s;
			}
			.home-stat:hover {
				background: rgba(255, 255, 255, 0.24);
				color: #fff;
			}
			.home-stat-value {
				font-size: 1.5rem;
				font-weight: 700;
				line-height: 1.1;
			}
			.home-stat-label {
				font-size: 0.75rem;
				opacity: 0.9;
				white-space: nowrap;
			}
			.home-stat-danger {
				background: rgba(220, 53, 69, 0.85);
				border-color: rgba(255, 255, 255, 0.4);
			}
			.home-stat-accent {
				background: rgba(255, 193, 7, 0.9);
				color: #212529;
			}
			.home-stat-accent:hover {
				color: #212529;
			}
			.home-hero .btn-outline-primary {
				color: #fff;
				border-color: rgba(255, 255, 255, 0.6);
			}
			.home-hero .btn-outline-primary:hover {
				background: #fff;
				color: #0057b8;
			}
			.home-hero .btn-primary {
				background: #fff;
				color: #0057b8;
				border-color: #fff;
			}
			.home-kpi {
				padding: 0.75rem 1rem;
				border: 1px solid #e3e8ef;
				background: #f8fafc;
			}
			.home-scroll {
				max-height: 360px;
				overflow-y: auto;
			}
		</style>
	</head>

	<body class="d-flex flex-column h-100">
		<%- include('../../partials/header'); %>
		<main class="container-fluid mt-3 home">
			<!-- ─── Привітання й показники дня ─── -->
			<div class="card border-0 rounded-0 home-hero mb-3">
				<div class="card-body d-flex flex-wrap align-items-center gap-3">
					<div class="me-auto">
						<div class="home-hello"><%= i18n.__('index.home.hello_' + home.part, { name: home.name }) %></div>
						<div class="home-date"><%= home.date_label %></div>
					</div>
					<div class="d-flex flex-wrap gap-2">
						<a href="#home-my-day" class="home-stat text-decoration-none">
							<span class="home-stat-value" id="home-stat-today"><%= home.today %></span>
							<span class="home-stat-label"><%= i18n.__('index.home.stat_today') %></span>
						</a>
						<a href="#home-my-day" class="home-stat text-decoration-none<%= home.overdue ? ' home-stat-danger' : '' %>" id="home-stat-overdue-box">
							<span class="home-stat-value" id="home-stat-overdue"><%= home.overdue %></span>
							<span class="home-stat-label"><%= i18n.__('index.home.stat_overdue') %></span>
						</a>
						<% if (home.chat) { %>
						<a href="/chat/" class="home-stat text-decoration-none">
							<span class="home-stat-value" id="home-stat-unread"><%= home.chat.total_label %></span>
							<span class="home-stat-label"><%= i18n.__('index.home.stat_unread') %></span>
						</a>
						<a href="/chat/" class="home-stat text-decoration-none<%= home.chat.mentions ? ' home-stat-accent' : '' %>" id="home-stat-mentions-box">
							<span class="home-stat-value" id="home-stat-mentions"><%= home.chat.mentions %></span>
							<span class="home-stat-label"><%= i18n.__('index.home.stat_mentions') %></span>
						</a>
						<% } %>
					</div>
				</div>
				<div class="card-footer bg-transparent border-0 pt-0 d-flex flex-wrap gap-2">
					<button type="button" class="btn btn-sm btn-primary rounded-0" id="home-add-event"><i class="fa-solid fa-calendar-plus me-1"></i><%= i18n.__('index.home.act_event') %></button>
					<% if (can('orders.list', 'add')) { %><a class="btn btn-sm btn-outline-primary rounded-0" href="/orders/new/"><i class="fa-solid fa-cart-plus me-1"></i><%= i18n.__('index.home.act_order') %></a><% } %>
					<% if (can('leads.list', 'add')) { %><a class="btn btn-sm btn-outline-primary rounded-0" href="/leads/new/"><i class="fa-solid fa-bullseye me-1"></i><%= i18n.__('index.home.act_lead') %></a><% } %>
					<% if (home.chat) { %><a class="btn btn-sm btn-outline-primary rounded-0" href="/chat/"><i class="fa-regular fa-comments me-1"></i><%= i18n.__('index.home.act_chat') %></a><% } %>
				</div>
			</div>

			<div class="row">
				<!-- ─── Ліва колонка: Пульс компанії ─── -->
				<div class="<%= home.chat ? 'col-xl-8' : 'col-12' %> mb-3">
					<% if (home.chat) { %>
					<div class="card border-primary rounded-0 h-100">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><i class="fa-solid fa-heart-pulse me-2"></i><%= i18n.__('header.chat.pulse') %> <small class="opacity-75 ms-2 d-none d-md-inline"><%= i18n.__('header.chat.pulse_hint') %></small></span>
							<a class="btn btn-sm btn-light rounded-0" href="/chat/"><%= i18n.__('header.chat.open') %></a>
						</div>
						<%- include('../../partials/chat/app', { chatMode: 'pulse', chatPrefix: 'chatpulse-' }); %>
					</div>
					<% } else { %>
					<%- include('../../partials/index/my-day'); %>
					<% } %>
				</div>

				<% if (home.chat) { %>
				<!-- ─── Права колонка: Мій день і непрочитане в чаті ─── -->
				<div class="col-xl-4 mb-3 d-flex flex-column gap-3">
					<%- include('../../partials/index/my-day'); %>

					<div class="card border-primary rounded-0">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><i class="fa-regular fa-comments me-2"></i><%= i18n.__('header.chat.widget_title') %> <span class="badge text-bg-danger rounded-pill ms-1<%= home.chat.total ? '' : ' d-none' %>" id="hw-chat-total"><%= home.chat.total_label %></span></span>
							<a class="btn btn-sm btn-light rounded-0" href="/chat/"><%= i18n.__('header.chat.open') %></a>
						</div>
						<div class="list-group list-group-flush home-scroll" id="hw-chat-list">
							<% if (home.chat.rooms.length) { home.chat.rooms.forEach(function (x) { %>
							<a class="list-group-item list-group-item-action d-flex align-items-center gap-2" href="/chat/?room=<%= encodeURIComponent(x.code) %>">
								<span class="min-w-0 flex-grow-1"><span class="d-block fw-semibold text-truncate"><%= x.name %></span><small class="text-muted d-block text-truncate"><%= x.last %></small></span>
								<small class="text-muted text-nowrap"><%= x.time %></small>
								<span class="badge text-bg-primary rounded-pill"><%= x.unread %></span>
							</a>
							<% }); } else { %>
							<div class="list-group-item text-muted small"><%= i18n.__('header.chat.all_read') %></div>
							<% } %>
						</div>
					</div>
				</div>
				<% } %>
			</div>
		</main>
		<% if (home.analytics) { %>
		<!-- ─── Продажі за 30 днів (право analytics) ─── -->
		<div class="container-fluid">
			<%- include('../../partials/index/analytics'); %>
		</div>
		<% } %>

		<div class="container-fluid">
			<div class="row">
				<div class="col-md-6">
					<!-- ================================================== -->
					<!-- КАЛЕНДАР -->
					<!-- ================================================== -->
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
							<span><i class="fa-solid fa-calendar-days me-1"></i><%= i18n.__('index.calendar.title') %></span>

							<div class="d-flex align-items-center gap-3 flex-wrap">
								<div class="form-check form-switch mb-0">
									<input class="form-check-input" type="checkbox" id="ce_layer_company" checked />
									<label class="form-check-label small" for="ce_layer_company"> <i class="fa-solid fa-building me-1"></i><%= i18n.__('index.calendar.layer.company') %> </label>
								</div>

								<div class="form-check form-switch mb-0">
									<input class="form-check-input" type="checkbox" id="ce_layer_busy" />
									<label class="form-check-label small" for="ce_layer_busy"> <i class="fa-solid fa-user-clock me-1"></i><%= i18n.__('index.calendar.layer.busy') %> </label>
								</div>

								<button class="btn btn-light btn-sm rounded-0" id="btnAddCalendarEvent"><i class="fa-solid fa-plus me-1"></i><%= i18n.__('index.calendar.add') %></button>
							</div>
						</div>
						<div class="card-body p-2">
							<div id="userCalendar"></div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="modal fade" id="modalCalendarEvent" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-lg modal-dialog-centered">
				<div class="modal-content rounded-0">
					<div class="modal-header text-bg-primary rounded-0">
						<h5 class="modal-title" id="modalCalendarEventTitle"><%= i18n.__('index.calendar.modal.title') %></h5>
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<form id="formCalendarEvent" novalidate>
							<input type="hidden" id="ce_id" />

							<div class="row g-3">
								<!-- Тип події -->
								<div class="col-12 col-md-6">
									<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.field.type') %></label>
									<select class="form-select form-select-sm rounded-0" id="ce_event_type">
										<option value=""><%= i18n.__('index.calendar.field.type_empty') %></option>
									</select>
								</div>

								<!-- Пріоритет -->
								<div class="col-12 col-md-6">
									<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.field.priority') %></label>
									<select class="form-select form-select-sm rounded-0" id="ce_priority">
										<option value="1"><%= i18n.__('index.calendar.priority.1') %></option>
										<option value="2" selected><%= i18n.__('index.calendar.priority.2') %></option>
										<option value="3"><%= i18n.__('index.calendar.priority.3') %></option>
										<option value="4"><%= i18n.__('index.calendar.priority.4') %></option>
									</select>
								</div>

								<!-- Назва -->
								<div class="col-12">
									<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.field.title') %> <span class="text-danger">*</span></label>
									<input type="text" class="form-control form-control-sm rounded-0" id="ce_title" maxlength="255" required placeholder="<%= i18n.__('index.calendar.placeholder.title') %>" />
									<div class="invalid-feedback"><%= i18n.__('index.calendar.msg.need_title') %></div>
								</div>

								<!-- Опис -->
								<div class="col-12">
									<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.field.description') %></label>
									<textarea class="form-control form-control-sm rounded-0" id="ce_description" rows="3" placeholder="<%= i18n.__('index.calendar.placeholder.description') %>"></textarea>
								</div>

								<!-- Місце -->
								<div class="col-12 col-md-6">
									<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.field.location') %></label>
									<input type="text" class="form-control form-control-sm rounded-0" id="ce_location" maxlength="255" placeholder="<%= i18n.__('index.calendar.placeholder.location') %>" />
								</div>

								<!-- Посилання -->
								<div class="col-12 col-md-6">
									<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.field.location_url') %></label>
									<input type="url" class="form-control form-control-sm rounded-0" id="ce_location_url" maxlength="500" placeholder="https://" />
									<div class="invalid-feedback"><%= i18n.__('index.calendar.msg.bad_url') %></div>
								</div>

								<!-- Увесь день -->
								<div class="col-12 d-flex gap-4 flex-wrap">
									<div class="form-check form-switch">
										<input class="form-check-input" type="checkbox" id="ce_all_day" />
										<label class="form-check-label small fw-semibold" for="ce_all_day"><%= i18n.__('index.calendar.field.all_day') %></label>
									</div>

									<div class="form-check form-switch">
										<input class="form-check-input" type="checkbox" id="ce_is_busy" checked />
										<label class="form-check-label small fw-semibold" for="ce_is_busy"><%= i18n.__('index.calendar.field.is_busy') %></label>
									</div>
								</div>

								<!-- Дата початку -->
								<div class="col-6 col-md-3">
									<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.field.date_start') %> <span class="text-danger">*</span></label>
									<input type="text" class="form-control form-control-sm rounded-0" id="ce_date_start" placeholder="<%= i18n.__('index.calendar.ph_date') %>" required />
									<div class="invalid-feedback"><%= i18n.__('index.calendar.msg.need_dates') %></div>
								</div>

								<!-- Час початку -->
								<div class="col-6 col-md-3" id="ce_time_start_block">
									<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.field.time_start') %> <span class="text-danger">*</span></label>
									<input type="text" class="form-control form-control-sm rounded-0" id="ce_time_start" placeholder="<%= i18n.__('index.calendar.ph_time') %>" />
									<div class="invalid-feedback"><%= i18n.__('index.calendar.msg.need_time') %></div>
								</div>

								<!-- Дата кінця -->
								<div class="col-6 col-md-3">
