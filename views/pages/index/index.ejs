									<!-- Прив'язки до CRM -->
									<div class="col-12">
										<label class="form-label small fw-semibold"><%= i18n.__('index.calendar.links.label') %> <span class="text-muted fw-normal"><%= i18n.__('index.calendar.links.hint') %></span></label>
