											<input type="text" class="form-control form-control-sm rounded-0" id="ce_link_search" autocomplete="off" placeholder="<%= i18n.__('index.calendar.links.search') %>" />
											<div class="list-group position-absolute w-100 shadow-sm" id="ce_link_results" style="display: none; z-index: 1080; max-height: 240px; overflow-y: auto"></div>
