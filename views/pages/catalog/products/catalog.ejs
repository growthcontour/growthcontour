<!doctype html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('catalog.overview.title') %></title>
		<%- include('../../../partials/head'); %>
		<style>
			.ov-tile {
				border: 1px solid var(--bs-border-color);
				padding: 1rem;
				height: 100%;
				display: block;
				color: inherit;
				text-decoration: none;
			}
			a.ov-tile:hover {
				border-color: var(--bs-primary);
			}
			.ov-num {
				font-size: 1.75rem;
				font-weight: 600;
				line-height: 1.1;
			}
			.ov-sub {
				font-size: 0.8rem;
				color: var(--bs-secondary-color);
			}
			.ov-link {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.75rem 1rem;
				border: 1px solid var(--bs-border-color);
				color: inherit;
				text-decoration: none;
				height: 100%;
			}
			.ov-link:hover {
				border-color: var(--bs-primary);
			}
			.ov-link i {
				width: 1.5rem;
				text-align: center;
				color: var(--bs-primary);
			}
		</style>
	</head>
	<body class="d-flex flex-column h-100">
		<%- include('../../../partials/header'); %>

		<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('catalog.menu.catalog') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('catalog.common.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= i18n.__('catalog.menu.catalog') %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/" class="btn btn-primary rounded-0">
							<i class="fa-solid fa-angle-left"></i>
						</a>
					</div>
				</div>
			</div>
		</div>

		<main class="flex-shrink-0">
			<div class="container-fluid pb-5">
				<div class="d-flex align-items-center mb-3">
					<h1 class="h4 mb-0 me-auto"><%= i18n.__('catalog.overview.title') %></h1>
					<% if (perms.add) { %>
					<a href="/catalog/products/new/" class="btn btn-primary rounded-0"><i class="fa-solid fa-plus"></i> <%= i18n.__('catalog.overview.add_product') %></a>
					<% } %>
				</div>

				<div class="row g-3 mb-4">
					<% if (perms.list) { %>
					<div class="col-6 col-lg-3">
						<a class="ov-tile" href="/catalog/products/">
							<div class="ov-sub"><%= i18n.__('catalog.overview.products') %></div>
							<div class="ov-num"><%= data.products.total %></div>
							<div class="ov-sub"><%= i18n.__('catalog.products.status.active') %>: <%= data.products.active %> · <%= i18n.__('catalog.products.status.draft') %>: <%= data.products.draft %> · <%= i18n.__('catalog.products.status.archived') %>: <%= data.products.archived %></div>
						</a>
					</div>
					<div class="col-6 col-lg-3">
						<a class="ov-tile" href="/catalog/quality/">
							<div class="ov-sub"><%= i18n.__('catalog.overview.quality') %></div>
							<div class="ov-num<% if (data.products.quality_avg !== null && data.products.quality_avg < 50) { %> text-danger<% } else if (data.products.quality_avg !== null && data.products.quality_avg < 80) { %> text-warning<% } else if (data.products.quality_avg !== null) { %> text-success<% } %>"><%= data.products.quality_avg === null ? '—' : data.products.quality_avg + '%' %></div>
							<div class="ov-sub"><%= i18n.__('catalog.overview.quality_low') %>: <%= data.products.quality_low %></div>
						</a>
					</div>
					<div class="col-6 col-lg-3">
						<a class="ov-tile" href="/catalog/reviews/">
							<div class="ov-sub"><%= i18n.__('catalog.overview.reviews_pending') %></div>
							<div class="ov-num<% if (data.reviews.pending) { %> text-warning<% } %>"><%= data.reviews.pending %></div>
							<div class="ov-sub"><%= i18n.__('catalog.overview.total') %>: <%= data.reviews.total %></div>
						</a>
					</div>
					<% } %> <% if (perms.stock) { %>
					<div class="col-6 col-lg-3">
						<a class="ov-tile" href="/catalog/stock/">
							<div class="ov-sub"><%= i18n.__('catalog.overview.stock_low') %></div>
							<div class="ov-num<% if (data.stockLow) { %> text-danger<% } %>"><%= data.stockLow %></div>
							<div class="ov-sub"><%= i18n.__('catalog.overview.stock_low_hint') %></div>
						</a>
					</div>
					<% } %>
				</div>

				<h2 class="h6 text-uppercase text-body-secondary mb-2"><%= i18n.__('catalog.overview.sections') %></h2>
				<div class="row g-2 mb-4">
					<% if (perms.list) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/products/"
							><i class="fa-solid fa-box"></i><span><%= i18n.__('catalog.menu.products') %> <span class="ov-sub">(<%= data.products.total %>)</span></span></a
						>
					</div>
					<% } %> <% if (perms.categories) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/categories/"
							><i class="fa-solid fa-sitemap"></i><span><%= i18n.__('catalog.menu.categories') %> <span class="ov-sub">(<%= data.categories %>)</span></span></a
						>
					</div>
					<% } %> <% if (perms.brands) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/brands/"
							><i class="fa-solid fa-copyright"></i><span><%= i18n.__('catalog.menu.brands') %> <span class="ov-sub">(<%= data.brands %>)</span></span></a
						>
					</div>
					<% } %> <% if (perms.attributes) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/attributes/"><i class="fa-solid fa-list-check"></i><span><%= i18n.__('catalog.menu.attributes') %></span></a>
					</div>
					<% } %> <% if (perms.options) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/options/"><i class="fa-solid fa-sliders"></i><span><%= i18n.__('catalog.menu.options') %></span></a>
					</div>
					<% } %> <% if (perms.list) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/reviews/"><i class="fa-solid fa-star"></i><span><%= i18n.__('catalog.menu.reviews') %></span></a>
					</div>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/quality/"><i class="fa-solid fa-clipboard-check"></i><span><%= i18n.__('catalog.menu.quality') %></span></a>
					</div>
					<% } %> <% if (perms.import) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/import/"><i class="fa-solid fa-file-import"></i><span><%= i18n.__('catalog.menu.import') %></span></a>
					</div>
					<% } %> <% if (perms.sync) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/sync/"><i class="fa-solid fa-arrows-rotate"></i><span><%= i18n.__('catalog.menu.sync') %></span></a>
					</div>
					<% } %> <% if (perms.stock) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/stock/"><i class="fa-solid fa-warehouse"></i><span><%= i18n.__('catalog.menu.group_stock') %></span></a>
					</div>
					<% } %> <% if (perms.settings) { %>
					<div class="col-sm-6 col-lg-3">
						<a class="ov-link" href="/catalog/settings/"><i class="fa-solid fa-gear"></i><span><%= i18n.__('catalog.menu.group_settings') %></span></a>
					</div>
					<% } %>
				</div>

				<% if (perms.list) { %>
				<h2 class="h6 text-uppercase text-body-secondary mb-2"><%= i18n.__('catalog.overview.recent') %></h2>
				<% if (!data.recent.length) { %>
				<div class="text-body-secondary"><%= i18n.__('catalog.overview.empty') %></div>
				<% } else { %>
				<div class="table-responsive">
					<table class="table table-sm table-hover align-middle">
						<thead>
							<tr>
								<th><%= i18n.__('catalog.overview.col_name') %></th>
								<th><%= i18n.__('catalog.overview.col_sku') %></th>
								<th><%= i18n.__('catalog.overview.col_status') %></th>
								<th class="text-end"><%= i18n.__('catalog.overview.col_quality') %></th>
								<th class="text-end"><%= i18n.__('catalog.overview.col_edited') %></th>
							</tr>
						</thead>
						<tbody>
							<% data.recent.forEach(function (p) { %>
							<tr>
								<td><a href="/catalog/products/<%= p.id %>/"><%= p.name %></a></td>
								<td class="text-body-secondary"><%= p.sku || '' %></td>
								<td><%= i18n.__('catalog.products.status.' + p.status) %></td>
								<td class="text-end"><%= p.quality_score === null ? '—' : p.quality_score + '%' %></td>
								<td class="text-end text-body-secondary"><time data-dt="<%= p.date_edit ? new Date(p.date_edit).toISOString() : '' %>"></time></td>
							</tr>
							<% }) %>
						</tbody>
					</table>
				</div>
				<% } %> <% } %>
			</div>
		</main>

		<%- include('../../../partials/footer'); %>
		<script>
			(function () {
				const fmt = new Intl.DateTimeFormat("<%= i18n.__('lang_iso') %>", { dateStyle: "short", timeStyle: "short" });
				document.querySelectorAll("time[data-dt]").forEach(function (el) {
					if (el.dataset.dt) el.textContent = fmt.format(new Date(el.dataset.dt));
				});
			})();
		</script>
	</body>
</html>
