<%
  const t = (k) => i18n.__('catalog.products.settings.' + k);
  const opt = (v) => i18n.__('catalog.products.settings.options.' + v);
  const val = (block, name) => name.split('.').reduce((o, k) => (o == null ? o : o[k]), current[block]);

  const BLOCKS = [
    { key: 'sku', fields: [
      { name: 'auto', type: 'bool' },
      { name: 'pattern', type: 'text', hint: true },
      { name: 'prefix', type: 'text' },
      { name: 'variant_pattern', type: 'text', hint: true },
      { name: 'regenerate_on_change', type: 'bool' } ] },
    { key: 'ean', fields: [
      { name: 'auto', type: 'bool' },
      { name: 'internal_prefix', type: 'text', hint: true } ] },
    { key: 'slug', fields: [
      { name: 'auto', type: 'bool' },
      { name: 'transliteration', type: 'select', options: ['uk', 'ru', 'none'] },
      { name: 'max_length', type: 'int' } ] },
    { key: 'images', fields: [
      { name: 'format', type: 'select', options: ['webp', 'avif', 'jpeg', 'original'], hint: true },
      { name: 'quality', type: 'int' },
      { name: 'max_width', type: 'int' },
      { name: 'max_height', type: 'int' },
      { name: 'max_file_mb', type: 'int' },
      { name: 'allowed_mime', type: 'multiselect', options: ['image/jpeg', 'image/png', 'image/webp', 'image/avif', 'image/gif', 'image/heif', 'image/tiff'], raw: true },
      { name: 'strip_metadata', type: 'bool' },
      { name: 'keep_original', type: 'bool' },
      { name: 'thumbnails', type: 'thumbnails' },
      { name: 'watermark.enabled', type: 'bool' },
      { name: 'watermark.file', type: 'watermark' },
      { name: 'watermark.position', type: 'select', options: ['center', 'north', 'south', 'east', 'west', 'northeast', 'northwest', 'southeast', 'southwest'] },
      { name: 'watermark.opacity', type: 'number', step: '0.05' },
      { name: 'watermark.scale', type: 'number', step: '0.05' } ] },
    { key: 'stock', fields: [
      { name: 'multi_warehouse', type: 'bool' },
      { name: 'id_default_warehouse', type: 'select', int: true, options: warehouses.map(w => ({ value: w.id, label: w.code + ' — ' + w.name })) },
      { name: 'write_off_strategy', type: 'select', options: ['priority', 'fifo', 'fefo'] },
      { name: 'reserve_on', type: 'select', options: ['order_create', 'order_paid', 'never'] },
      { name: 'reservation_ttl_minutes', type: 'int' },
      { name: 'default_out_of_stock_action', type: 'select', options: ['deny', 'backorder', 'preorder'] },
      { name: 'allow_negative', type: 'bool' },
      { name: 'track_batches', type: 'bool' },
      { name: 'track_serials', type: 'bool' } ] },
    { key: 'prices', fields: [
      { name: 'base_currency', type: 'text', hint: true },
      { name: 'prices_include_tax', type: 'bool' },
      { name: 'rounding', type: 'int' },
      { name: 'show_compare_at', type: 'bool' } ] },
    { key: 'rewards', fields: [
      { name: 'enabled', type: 'bool' },
      { name: 'point_value', type: 'number', step: '0.01', hint: true },
      { name: 'auto_mode', type: 'select', options: ['none', 'percent'] },
      { name: 'auto_percent', type: 'number', step: '0.01' },
      { name: 'accrue_on_status', type: 'intnull', hint: true } ] },
    { key: 'units', fields: [
      { name: 'weight', type: 'select', options: ['kg', 'g', 'lb', 'oz'], raw: true },
      { name: 'length', type: 'select', options: ['cm', 'mm', 'm', 'in'], raw: true } ] },
    { key: 'card', fields: [
      { name: 'default_status', type: 'select', options: ['draft', 'active'] },
      { name: 'required_fields', type: 'multiselect', options: ['name', 'sku', 'price', 'category', 'brand', 'image', 'description'] },
      { name: 'per_page', type: 'int' } ] },
    { key: 'edit_lock', fields: [
      { name: 'ttl_seconds', type: 'int' },
      { name: 'heartbeat_seconds', type: 'int', hint: true } ] },
  ];

  const norm = (f, o) => (typeof o === 'object' ? o : { value: o, label: f.raw ? o : opt(o) });
  const dis = canEdit ? '' : 'disabled';
%>
<!doctype html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= t('title') %></title>
		<%- include('../../../partials/head'); %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	</head>
	<body class="d-flex flex-column h-100">
		<%- include('../../../partials/header'); %>

		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<nav aria-label="breadcrumb">
					<ol class="breadcrumb mb-0">
						<li class="breadcrumb-item"><a href="/"><%= t('home') %></a></li>
						<li class="breadcrumb-item"><%= i18n.__('catalog.menu.catalog') %></li>
						<li class="breadcrumb-item active" aria-current="page"><%= t('title') %></li>
					</ol>
				</nav>
			</div>
		</div>

		<main class="flex-shrink-0">
			<div class="container-fluid pb-5">
				<h1 class="h4 mb-3"><%= t('title') %></h1>
				<% if (!canEdit) { %><div class="alert alert-info rounded-0"><%= t('read_only') %></div><% } %>

				<div class="row">
					<div class="col-lg-3 mb-3">
						<div class="list-group rounded-0" id="settings-tabs" role="tablist">
							<% BLOCKS.forEach((b, i) => { %>
							<button type="button" class="list-group-item list-group-item-action<%= i === 0 ? ' active' : '' %>" data-bs-toggle="list" data-bs-target="#block-<%= b.key %>" role="tab"><%= t('blocks.' + b.key) %></button>
							<% }) %>
						</div>
					</div>

					<div class="col-lg-9">
						<div class="tab-content">
						<% BLOCKS.forEach((b, i) => { %>
							<div class="tab-pane fade<%= i === 0 ? ' show active' : '' %>" id="block-<%= b.key %>" role="tabpanel">
								<form class="card rounded-0 js-settings-form" data-key="<%= b.key %>" novalidate>
									<div class="card-header"><strong><%= t('blocks.' + b.key) %></strong></div>
									<div class="card-body">
									<% b.fields.forEach((f) => {
									     const id = b.key + '__' + f.name.replace(/\./g, '_');
									     const label = t('fields.' + b.key + '.' + f.name);
									     const hint = f.hint ? t('hints.' + b.key + '.' + f.name) : '';
									     const v = val(b.key, f.name); %>
										<div class="mb-3" data-field="<%= f.name %>">
										<% if (f.type === 'bool') { %>
											<div class="form-check form-switch">
												<input class="form-check-input" type="checkbox" id="<%= id %>" name="<%= f.name %>" data-type="bool" <%= v ? 'checked' : '' %> <%= dis %>>
												<label class="form-check-label" for="<%= id %>"><%= label %></label>
											</div>
										<% } else if (f.type === 'select' || f.type === 'multiselect') { %>
											<label class="form-label" for="<%= id %>"><%= label %></label>
											<select class="form-select rounded-0" id="<%= id %>" name="<%= f.name %>" data-type="<%= f.type === 'multiselect' ? (f.int ? 'intarray' : 'array') : (f.int ? 'int' : 'text') %>" <%= f.type === 'multiselect' ? 'multiple size=' + Math.min(f.options.length, 7) : '' %> <%= dis %>>
												<% f.options.map(o => norm(f, o)).forEach((o) => {
												     const sel = Array.isArray(v) ? v.map(String).includes(String(o.value)) : String(v) === String(o.value); %>
												<option value="<%= o.value %>" <%= sel ? 'selected' : '' %>><%= o.label %></option>
												<% }) %>
											</select>
										<% } else if (f.type === 'thumbnails') { %>
											<label class="form-label"><%= label %></label>
											<table class="table table-sm align-middle mb-2">
												<thead><tr><th><%= t('thumb.code') %></th><th><%= t('thumb.width') %></th><th><%= t('thumb.height') %></th><th><%= t('thumb.fit') %></th><th></th></tr></thead>
												<tbody class="js-thumbs">
												<% (v || []).forEach((th) => { %>
													<tr>
														<td><input class="form-control form-control-sm rounded-0" data-thumb="code" value="<%= th.code %>" <%= dis %>></td>
														<td><input class="form-control form-control-sm rounded-0" type="number" min="16" max="4000" data-thumb="width" value="<%= th.width %>" <%= dis %>></td>
														<td><input class="form-control form-control-sm rounded-0" type="number" min="16" max="4000" data-thumb="height" value="<%= th.height %>" <%= dis %>></td>
														<td><select class="form-select form-select-sm rounded-0" data-thumb="fit" <%= dis %>>
															<% ['contain', 'cover', 'inside'].forEach((fit) => { %><option value="<%= fit %>" <%= th.fit === fit ? 'selected' : '' %>><%= opt(fit) %></option><% }) %>
														</select></td>
														<td class="text-end"><% if (canEdit) { %><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-thumb-del" aria-label="<%= t('delete') %>"><i class="fa-solid fa-xmark"></i></button><% } %></td>
													</tr>
												<% }) %>
												</tbody>
											</table>
											<% if (canEdit) { %><button type="button" class="btn btn-sm btn-outline-secondary rounded-0 js-thumb-add"><i class="fa-solid fa-plus"></i> <%= t('thumb.add') %></button><% } %>
											<div class="form-text"><%= t('hints.images.thumbnails') %></div>
										<% } else if (f.type === 'watermark') { %>
											<label class="form-label"><%= label %></label>
											<div class="d-flex align-items-center gap-3">
												<img class="js-watermark-preview border p-1" style="max-height:60px;max-width:200px;background:repeating-conic-gradient(#ddd 0 25%,#fff 0 50%) 50%/16px 16px;<%= v ? '' : 'display:none' %>" src="<%= v ? '/assets/images/products/' + v : '' %>" alt="">
												<% if (canEdit) { %><input class="form-control rounded-0 js-watermark-file" type="file" accept="image/png,image/webp" style="max-width:320px"><% } %>
											</div>
											<div class="form-text"><%= t('hints.images.watermark.file') %></div>
										<% } else { %>
											<label class="form-label" for="<%= id %>"><%= label %></label>
											<input class="form-control rounded-0" id="<%= id %>" name="<%= f.name %>"
												type="<%= ['int', 'intnull', 'number'].includes(f.type) ? 'number' : 'text' %>"
												<%= f.step ? 'step=' + f.step : '' %>
												data-type="<%= f.type %>" value="<%= v == null ? '' : v %>" <%= dis %>>
										<% } %>
										<% if (hint && f.type !== 'thumbnails' && f.type !== 'watermark') { %><div class="form-text"><%= hint %></div><% } %>
											<div class="invalid-feedback d-block js-error"></div>
										</div>
									<% }) %>
									</div>
									<% if (canEdit) { %>
									<div class="card-footer text-end">
										<button type="submit" class="btn btn-primary rounded-0"><%= t('save') %></button>
									</div>
									<% } %>
								</form>
							</div>
						<% }) %>
						</div>
					</div>
				</div>
			</div>
		</main>

		<%- include('../../../partials/footer'); %>
		<%- include('../../../partials/script'); %>
		<script src="/assets/js/notyf/notyf.min.js"></script>
		<script type="application/json" id="settings-data"><%- JSON.stringify({
			current,
			i18n: {
				saved: t('saved'),
				save_error: t('save_error'),
				uploaded: t('watermark_uploaded'),
				fits: { contain: opt('contain'), cover: opt('cover'), inside: opt('inside') },
				del: t('delete'),
			},
		}).replace(/</g, '\\u003c') %></script>
		<script>
            (function () {
	"use strict";

	const data = JSON.parse(document.getElementById("settings-data").textContent);
	const current = data.current;
	const L = data.i18n;
	const notyf = new Notyf({ duration: 3000, position: { x: "right", y: "top" } });

	function setPath(obj, path, value) {
		const keys = path.split(".");
		let o = obj;
		keys.slice(0, -1).forEach((k) => {
			if (typeof o[k] !== "object" || o[k] === null) o[k] = {};
			o = o[k];
		});
		o[keys[keys.length - 1]] = value;
	}

	function readValue(el) {
		const type = el.dataset.type;
		if (type === "bool") return el.checked;
		if (type === "array") return Array.from(el.selectedOptions).map((o) => o.value);
		if (type === "intarray") return Array.from(el.selectedOptions).map((o) => parseInt(o.value, 10));
		if (type === "int") return el.value === "" ? null : parseInt(el.value, 10);
		if (type === "intnull") return el.value === "" ? null : parseInt(el.value, 10);
		if (type === "number") return el.value === "" ? null : parseFloat(el.value);
		return el.value.trim();
	}

	function collect(form) {
		// Беремо поточне значення блоку як основу, щоб не скинути поля, яких немає у формі
		const value = JSON.parse(JSON.stringify(current[form.dataset.key] || {}));
		form.querySelectorAll("[name][data-type]").forEach((el) => setPath(value, el.name, readValue(el)));
		const thumbs = form.querySelector(".js-thumbs");
		if (thumbs) {
			value.thumbnails = Array.from(thumbs.querySelectorAll("tr")).map((tr) => ({
				code: tr.querySelector('[data-thumb="code"]').value.trim(),
				width: parseInt(tr.querySelector('[data-thumb="width"]').value, 10),
				height: parseInt(tr.querySelector('[data-thumb="height"]').value, 10),
				fit: tr.querySelector('[data-thumb="fit"]').value,
			}));
		}
		return value;
	}

	function clearErrors(form) {
		form.querySelectorAll(".is-invalid").forEach((el) => el.classList.remove("is-invalid"));
		form.querySelectorAll(".js-error").forEach((el) => (el.textContent = ""));
	}

	function showErrors(form, errors) {
		(errors || []).forEach((err) => {
			// "thumbnails.0.width" → поле "thumbnails"; "watermark.opacity" → поле "watermark.opacity"
			const field = String(err.field || "");
			const box = form.querySelector(`[data-field="${CSS.escape(field)}"]`) || form.querySelector(`[data-field="${CSS.escape(field.split(".")[0])}"]`);
			if (!box) return;
			box.querySelectorAll("input,select").forEach((el) => el.classList.add("is-invalid"));
			const out = box.querySelector(".js-error");
			if (out) out.textContent = err.message;
		});
	}

	async function post(url, body, isForm) {
		const res = await fetch(url, {
			method: "POST",
			credentials: "same-origin",
			headers: isForm ? { Accept: "application/json" } : { "Content-Type": "application/json", Accept: "application/json" },
			body: isForm ? body : JSON.stringify(body),
		});
		const json = await res.json().catch(() => ({}));
		if (!res.ok || json.ok === false) throw json;
		return json;
	}

	document.querySelectorAll(".js-settings-form").forEach((form) => {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const key = form.dataset.key;
			const btn = form.querySelector('button[type="submit"]');
			clearErrors(form);
			btn.disabled = true;
			try {
				const r = await post(`/api/catalog/products/settings/${encodeURIComponent(key)}/save/`, { value: collect(form) });
				current[key] = r.value;
				notyf.success(L.saved);
			} catch (err) {
				showErrors(form, err.errors);
				notyf.error(err.error || L.save_error);
			} finally {
				btn.disabled = false;
			}
		});
	});

	// ── Мініатюри: додати / видалити рядок ──────────────────
	document.addEventListener("click", (e) => {
		const add = e.target.closest(".js-thumb-add");
		if (add) {
			const tbody = add.closest("[data-field]").querySelector(".js-thumbs");
			const tr = document.createElement("tr");
			const fits = Object.entries(L.fits)
				.map(([v, label]) => `<option value="${v}">${label}</option>`)
				.join("");
			tr.innerHTML = `
				<td><input class="form-control form-control-sm rounded-0" data-thumb="code" value=""></td>
				<td><input class="form-control form-control-sm rounded-0" type="number" min="16" max="4000" data-thumb="width" value="300"></td>
				<td><input class="form-control form-control-sm rounded-0" type="number" min="16" max="4000" data-thumb="height" value="300"></td>
				<td><select class="form-select form-select-sm rounded-0" data-thumb="fit">${fits}</select></td>
				<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-thumb-del"><i class="fa-solid fa-xmark"></i></button></td>`;
			tr.querySelector(".js-thumb-del").setAttribute("aria-label", L.del);
			tbody.appendChild(tr);
			tr.querySelector("input").focus();
			return;
		}
		const del = e.target.closest(".js-thumb-del");
		if (del) del.closest("tr").remove();
	});

	// ── Водяний знак: завантаження ──────────────────────────
	const wmInput = document.querySelector(".js-watermark-file");
	if (wmInput) {
		wmInput.addEventListener("change", async () => {
			const file = wmInput.files[0];
			if (!file) return;
			const fd = new FormData();
			fd.append("file", file);
			wmInput.disabled = true;
			try {
				const r = await post("/api/catalog/products/settings/watermark/upload/", fd, true);
				current.images = r.value;
				const img = document.querySelector(".js-watermark-preview");
				img.src = r.url;
				img.style.display = "";
				notyf.success(L.uploaded);
			} catch (err) {
				notyf.error(err.error || L.save_error);
			} finally {
				wmInput.disabled = false;
				wmInput.value = "";
			}
		});
	}
})();
</script>
	</body>
</html>