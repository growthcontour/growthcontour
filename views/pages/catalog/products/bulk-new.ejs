<!doctype html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('catalog.bulk_new.title') %></title>
		<%- include('../../../partials/head'); %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	</head>
	<body class="d-flex flex-column h-100">
		<%- include('../../../partials/header'); %>

		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('catalog.bulk_new.title') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('catalog.bulk_new.breadcrumb.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/catalog/"><%= i18n.__('catalog.bulk_new.breadcrumb.catalog') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/catalog/bulk/"><%= i18n.__('catalog.bulk_new.breadcrumb.bulk') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= i18n.__('catalog.bulk_new.breadcrumb.current') %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/catalog/bulk/" class="btn btn-primary rounded-0">
							<i class="fa-solid fa-angle-left"></i>
						</a>
					</div>
				</div>
			</div>
		</div>

		<div class="container-fluid mt-3">
			<div class="row">
				<% if (templates.length) { %>
				<!-- ─── Почати з шаблону ─── -->
				<div class="col-12 mb-3">
					<div class="d-flex gap-2 align-items-center">
						<i class="fa-solid fa-star text-warning"></i>
						<select class="form-select rounded-0 w-auto" id="bn-template">
							<option value=""><%= i18n.__('catalog.bulk_new.from_template') %></option>
							<% templates.forEach(function (t) { %><option value="<%= t.id %>">#<%= t.id %> <%= t.title || i18n.__('catalog.bulk_new.untitled') %></option><% }) %>
						</select>
						<span class="form-text m-0"><%= i18n.__('catalog.bulk_new.from_template_hint') %></span>
					</div>
				</div>
				<% } %>
				<!-- ─── 1. Які товари ─── -->
				<div class="col-12 mb-3">
					<div class="card border-primary rounded-0">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('catalog.bulk_new.step_products') %></span>
							<span><%= i18n.__('catalog.bulk_new.found') %>: <span class="badge text-bg-light rounded-0" id="bn-count">…</span></span>
						</div>
						<div class="card-body">
							<div class="btn-group mb-3" role="group">
								<input type="radio" class="btn-check" name="bn-mode" id="bn-mode-filter" value="filter" checked />
								<label class="btn btn-outline-primary rounded-0" for="bn-mode-filter"><i class="fa-solid fa-filter me-1"></i> <%= i18n.__('catalog.bulk_new.mode_filter') %></label>
								<input type="radio" class="btn-check" name="bn-mode" id="bn-mode-list" value="list" />
								<label class="btn btn-outline-primary rounded-0" for="bn-mode-list"><i class="fa-solid fa-list me-1"></i> <%= i18n.__('catalog.bulk_new.mode_list') %></label>
							</div>

							<div id="bn-filter">
								<div class="row g-2">
									<div class="col-12 col-md-4"><input type="search" class="form-control rounded-0" data-f="search" value="<%= filter.search %>" placeholder="<%= i18n.__('catalog.products.filters.search') %>" /><input type="hidden" data-f="issue" value="<%= filter.issue %>" /></div>
									<div class="col-12 col-md-4">
										<select class="form-select rounded-0" data-f="id_category">
											<option value=""><%= i18n.__('catalog.products.filters.all_categories') %></option>
											<% categories.forEach(function (c) { %><option value="<%= c.id %>"<% if (String(c.id) === filter.id_category) { %> selected<% } %>><%= c.label %></option><% }) %>
										</select>
									</div>
									<div class="col-12 col-md-4">
										<select class="form-select rounded-0" data-f="id_brand">
											<option value=""><%= i18n.__('catalog.products.filters.all_brands') %></option>
											<% brands.forEach(function (b) { %><option value="<%= b.id %>"<% if (String(b.id) === filter.id_brand) { %> selected<% } %>><%= b.name %></option><% }) %>
										</select>
									</div>
									<div class="col-6 col-md-2">
										<select class="form-select rounded-0" data-f="status">
											<option value=""><%= i18n.__('catalog.products.filters.all_statuses') %></option>
											<option value="active"<% if (filter.status === 'active') { %> selected<% } %>><%= i18n.__('catalog.products.status.active') %></option>
											<option value="draft"<% if (filter.status === 'draft') { %> selected<% } %>><%= i18n.__('catalog.products.status.draft') %></option>
											<option value="archived"<% if (filter.status === 'archived') { %> selected<% } %>><%= i18n.__('catalog.products.status.archived') %></option>
										</select>
									</div>
									<div class="col-6 col-md-2">
										<select class="form-select rounded-0" data-f="type">
											<option value=""><%= i18n.__('catalog.products.filters.all_types') %></option>
											<% ['simple', 'variable', 'bundle', 'digital', 'service', 'gift_card'].forEach(function (t) { %><option value="<%= t %>"<% if (filter.type === t) { %> selected<% } %>><%= i18n.__('catalog.products.types.' + t) %></option><% }) %>
										</select>
									</div>
									<div class="col-6 col-md-2">
										<select class="form-select rounded-0" data-f="stock">
											<option value=""><%= i18n.__('catalog.products.filters.any_stock') %></option>
											<option value="in"<% if (filter.stock === 'in') { %> selected<% } %>><%= i18n.__('catalog.products.filters.in_stock') %></option>
											<option value="out"<% if (filter.stock === 'out') { %> selected<% } %>><%= i18n.__('catalog.products.filters.out_of_stock') %></option>
											<option value="low"<% if (filter.stock === 'low') { %> selected<% } %>><%= i18n.__('catalog.products.filters.low_stock') %></option>
										</select>
									</div>
									<div class="col-6 col-md-1"><input type="number" min="0" step="0.01" class="form-control rounded-0" data-f="price_from" value="<%= filter.price_from %>" placeholder="<%= i18n.__('catalog.products.filters.price_from') %>" /></div>
									<div class="col-6 col-md-1"><input type="number" min="0" step="0.01" class="form-control rounded-0" data-f="price_to" value="<%= filter.price_to %>" placeholder="<%= i18n.__('catalog.products.filters.price_to') %>" /></div>
									<div class="col-6 col-md-2">
										<select class="form-select rounded-0" data-f="quality">
											<option value=""><%= i18n.__('catalog.quality.filter_any') %></option>
											<option value="low"<% if (filter.quality === 'low') { %> selected<% } %>><%= i18n.__('catalog.quality.levels.low') %></option>
											<option value="mid"<% if (filter.quality === 'mid') { %> selected<% } %>><%= i18n.__('catalog.quality.levels.mid') %></option>
											<option value="high"<% if (filter.quality === 'high') { %> selected<% } %>><%= i18n.__('catalog.quality.levels.high') %></option>
										</select>
									</div>
									<% if (publishing) { %>
									<div class="col-6 col-md-2">
										<select class="form-select rounded-0" data-f="publish">
											<option value=""><%= i18n.__('catalog.publish.filter_any') %></option>
											<% ['changed', 'never', 'published', 'withdrawn'].forEach(function (s) { %><option value="<%= s %>"<% if (filter.publish === s) { %> selected<% } %>><%= i18n.__('catalog.publish.state_' + s) %></option><% }) %>
											<option value="scheduled"<% if (filter.publish === 'scheduled') { %> selected<% } %>><%= i18n.__('catalog.publish.filter_scheduled') %></option>
										</select>
									</div>
									<% } %>
									<% if (channels.length) { %>
									<div class="col-12 col-md-4">
										<select class="form-select rounded-0" data-f="channel">
											<option value=""><%= i18n.__('catalog.products.filters.channel_any') %></option>
											<% channels.forEach(function (ch) { %>
											<option value="<%= ch.id %>:in"<% if (filter.channel === ch.id + ':in') { %> selected<% } %>><%= i18n.__('catalog.products.filters.channel_in').replace('%s', ch.name) %></option>
											<option value="<%= ch.id %>:out"<% if (filter.channel === ch.id + ':out') { %> selected<% } %>><%= i18n.__('catalog.products.filters.channel_out').replace('%s', ch.name) %></option>
											<option value="<%= ch.id %>:notready"<% if (filter.channel === ch.id + ':notready') { %> selected<% } %>><%= i18n.__('catalog.products.filters.channel_notready').replace('%s', ch.name) %></option>
											<% }) %>
										</select>
									</div>
									<% } %>
								</div>
								<div class="form-text"><%= i18n.__('catalog.bulk_new.filter_hint') %></div>
							</div>

							<div id="bn-list" class="d-none">
								<textarea class="form-control rounded-0 font-monospace" id="bn-list-text" rows="8" placeholder="<%= i18n.__('catalog.bulk_new.list_placeholder') %>"></textarea>
								<div class="form-text"><%= i18n.__('catalog.bulk_new.list_hint') %></div>
								<div class="alert alert-warning rounded-0 mt-2 mb-0 d-none" id="bn-not-found"></div>
							</div>
						</div>
					</div>
				</div>

				<!-- ─── 2. Що змінити ─── -->
				<div class="col-12 mb-3">
					<div class="card border-primary rounded-0">
						<div class="card-header text-bg-primary rounded-0"><%= i18n.__('catalog.bulk_new.step_actions') %></div>
						<div class="card-body">
							<div class="mb-3">
								<label class="form-label" for="bn-title"><%= i18n.__('catalog.bulk_new.name') %></label>
								<input type="text" class="form-control rounded-0" id="bn-title" maxlength="255" placeholder="<%= i18n.__('catalog.bulk_new.name_placeholder') %>" />
							</div>
							<div id="bn-ops"></div>
							<div class="d-flex gap-2 align-items-center">
								<select class="form-select rounded-0 w-auto" id="bn-add">
									<option value=""><%= i18n.__('catalog.bulk_new.add_action') %></option>
									<option value="status"><%= i18n.__('catalog.bulk.a_status') %></option>
									<option value="visibility"><%= i18n.__('catalog.bulk.a_visibility') %></option>
									<option value="featured"><%= i18n.__('catalog.bulk.a_featured') %></option>
									<option value="brand"><%= i18n.__('catalog.bulk.a_brand') %></option>
									<option value="categories"><%= i18n.__('catalog.bulk.a_categories') %></option>
									<option value="price"><%= i18n.__('catalog.bulk.a_price') %></option>
									<option value="compare_from_price"><%= i18n.__('catalog.bulk.a_compare_from_price') %></option>
									<% if (currencies.length) { %><option value="currency"><%= i18n.__('catalog.bulk.a_currency') %></option><% } %>
									<% if (perms.costEdit) { %><option value="formula"><%= i18n.__('catalog.bulk.a_formula') %></option><% } %>
									<% if (currencies.length) { %><option value="fixed_price"><%= i18n.__('catalog.bulk.a_fixed_price') %></option><% } %>
									<option value="field"><%= i18n.__('catalog.bulk.a_field') %></option>
									<option value="variant_field"><%= i18n.__('catalog.bulk.a_variant_field') %></option>
									<option value="text"><%= i18n.__('catalog.bulk.a_text') %></option>
									<option value="seo"><%= i18n.__('catalog.bulk.a_seo') %></option>
									<option value="media"><%= i18n.__('catalog.bulk.a_media') %></option>
									<% if (attributes.length) { %><option value="attribute"><%= i18n.__('catalog.bulk.a_attribute') %></option><% } %>
									<option value="codes"><%= i18n.__('catalog.bulk.a_codes') %></option>
									<% if (warehouses.length) { %><option value="stock"><%= i18n.__('catalog.bulk.a_stock') %></option><% } %>
								</select>
								<span class="form-text m-0"><%= i18n.__('catalog.bulk_new.actions_hint') %></span>
							</div>
						</div>
					</div>
				</div>

				<!-- ─── 3. Перевірка і запуск ─── -->
				<div class="col-12 mb-3">
					<div class="card border-primary rounded-0">
						<div class="card-header text-bg-primary rounded-0"><%= i18n.__('catalog.bulk_new.step_preview') %></div>
						<div class="card-body">
							<div class="row g-2 mb-3">
								<div class="col-12 col-md-4">
									<label class="form-label" for="bn-when"><%= i18n.__('catalog.bulk_new.when') %></label>
									<select class="form-select rounded-0" id="bn-when">
										<option value="now"><%= i18n.__('catalog.bulk_new.when_now') %></option>
										<option value="at"><%= i18n.__('catalog.bulk_new.when_at') %></option>
									</select>
								</div>
								<div class="col-12 col-md-4 d-none" id="bn-run-at-wrap">
									<label class="form-label" for="bn-run-at"><%= i18n.__('catalog.bulk_new.run_at') %></label>
									<input type="datetime-local" class="form-control rounded-0" id="bn-run-at" />
								</div>
								<div class="col-12 col-md-4">
									<div class="form-check mt-md-4 pt-md-2">
										<input class="form-check-input" type="checkbox" id="bn-auto-revert" />
										<label class="form-check-label" for="bn-auto-revert"><%= i18n.__('catalog.bulk_new.auto_revert') %></label>
									</div>
									<input type="datetime-local" class="form-control rounded-0 mt-1 d-none" id="bn-revert-at" />
								</div>
								<div class="col-12 form-text mt-0"><%= i18n.__('catalog.bulk_new.schedule_hint') %></div>
							</div>
							<div class="d-flex gap-2 mb-3">
								<button type="button" class="btn btn-outline-primary rounded-0" id="bn-preview"><i class="fa-solid fa-eye me-1"></i> <%= i18n.__('catalog.bulk_new.preview') %></button>
								<button type="button" class="btn btn-primary rounded-0" id="bn-run" disabled><i class="fa-solid fa-play me-1"></i> <%= i18n.__('catalog.bulk_new.run') %></button>
							</div>
							<div class="form-text mb-2" id="bn-preview-hint"><%= i18n.__('catalog.bulk_new.preview_hint', { n: String(preview) }) %></div>
							<div class="table-responsive d-none" id="bn-preview-wrap">
								<table class="table table-sm table-bordered align-middle mb-0">
									<thead>
										<tr>
											<th><%= i18n.__('catalog.bulk_new.col_product') %></th>
											<th><%= i18n.__('catalog.bulk_new.col_field') %></th>
											<th><%= i18n.__('catalog.bulk_new.col_old') %></th>
											<th><%= i18n.__('catalog.bulk_new.col_new') %></th>
										</tr>
									</thead>
									<tbody id="bn-preview-rows"></tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- Підтвердження запуску -->
		<div class="modal fade" id="bn-run-modal" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content rounded-0">
					<div class="modal-header">
						<h1 class="modal-title fs-5"><%= i18n.__('catalog.bulk_new.run_title') %></h1>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<p class="mb-2" id="bn-run-text"></p>
						<div class="form-text"><%= i18n.__('catalog.bulk_new.run_hint') %></div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('catalog.bulk_new.cancel') %></button>
						<button type="button" class="btn btn-primary rounded-0" id="bn-run-ok"><%= i18n.__('catalog.bulk_new.run') %></button>
					</div>
				</div>
			</div>
		</div>

		<!-- ─── Шаблони параметрів дій (клонуються в блок дії; поля — data-p) ─── -->
		<template data-op="status">
			<select class="form-select rounded-0" data-p="status">
				<option value="active"><%= i18n.__('catalog.products.status.active') %></option>
				<option value="draft"><%= i18n.__('catalog.products.status.draft') %></option>
				<option value="archived"><%= i18n.__('catalog.products.status.archived') %></option>
			</select>
		</template>
		<template data-op="visibility">
			<select class="form-select rounded-0" data-p="visibility">
				<option value="all"><%= i18n.__('catalog.bulk.visibility_all') %></option>
				<option value="catalog"><%= i18n.__('catalog.bulk.visibility_catalog') %></option>
				<option value="search"><%= i18n.__('catalog.bulk.visibility_search') %></option>
				<option value="none"><%= i18n.__('catalog.bulk.visibility_none') %></option>
			</select>
		</template>
		<template data-op="featured">
			<select class="form-select rounded-0" data-p="value" data-type="int">
				<option value="1"><%= i18n.__('catalog.bulk.featured_yes') %></option>
				<option value="0"><%= i18n.__('catalog.bulk.featured_no') %></option>
			</select>
		</template>
		<template data-op="brand">
			<select class="form-select rounded-0" data-p="id_brand" data-type="intnull">
				<option value=""><%= i18n.__('catalog.bulk.brand_none') %></option>
				<% brands.forEach(function (b) { %><option value="<%= b.id %>"><%= b.name %></option><% }) %>
			</select>
		</template>
		<template data-op="categories">
			<div class="row g-2">
				<div class="col-12 col-md-4">
					<label class="form-label"><%= i18n.__('catalog.bulk.cat_op') %></label>
					<select class="form-select rounded-0" data-p="op">
						<option value="add"><%= i18n.__('catalog.bulk.cat_add') %></option>
						<option value="remove"><%= i18n.__('catalog.bulk.cat_remove') %></option>
						<option value="replace"><%= i18n.__('catalog.bulk.cat_replace') %></option>
					</select>
					<div class="form-check mt-2">
						<input class="form-check-input" type="checkbox" data-p="set_main" />
						<label class="form-check-label"><%= i18n.__('catalog.bulk.cat_set_main') %></label>
					</div>
				</div>
				<div class="col-12 col-md-8">
					<label class="form-label"><%= i18n.__('catalog.bulk.cat_list') %></label>
					<select class="form-select rounded-0" data-p="ids" data-type="ints" multiple size="8">
						<% categories.forEach(function (c) { %><option value="<%= c.id %>"><%= c.label %></option><% }) %>
					</select>
				</div>
			</div>
		</template>
		<template data-op="price">
			<div class="row g-2">
				<div class="col-6 col-md-3">
					<label class="form-label"><%= i18n.__('catalog.bulk.price_field') %></label>
					<select class="form-select rounded-0" data-p="field">
						<option value="price"><%= i18n.__('catalog.bulk.field_price') %></option>
						<option value="compare_at_price"><%= i18n.__('catalog.bulk.field_compare_at_price') %></option>
						<% if (perms.costEdit) { %>
						<option value="cost_price"><%= i18n.__('catalog.bulk.field_cost_price') %></option>
						<option value="wholesale_price"><%= i18n.__('catalog.bulk.field_wholesale_price') %></option>
						<% } %>
					</select>
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label"><%= i18n.__('catalog.bulk.price_op') %></label>
					<select class="form-select rounded-0" data-p="op">
						<option value="percent"><%= i18n.__('catalog.bulk.op_percent') %></option>
						<option value="amount"><%= i18n.__('catalog.bulk.op_amount') %></option>
						<option value="set"><%= i18n.__('catalog.bulk.op_set') %></option>
					</select>
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label"><%= i18n.__('catalog.bulk.price_value') %></label>
					<input type="number" step="0.0001" class="form-control rounded-0" data-p="value" data-type="num" />
					<div class="form-text"><%= i18n.__('catalog.bulk.price_value_hint') %></div>
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label"><%= i18n.__('catalog.bulk.round') %></label>
					<select class="form-select rounded-0" data-p="round">
						<% ['none', '0', '1', '2', '99', '9'].forEach(function (r) { %><option value="<%= r %>"><%= i18n.__('catalog.bulk.round_' + r) %></option><% }) %>
					</select>
				</div>
				<div class="col-12">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" data-p="variants" checked />
						<label class="form-check-label"><%= i18n.__('catalog.bulk.apply_variants') %></label>
					</div>
				</div>
			</div>
		</template>
		<template data-op="compare_from_price">
			<div class="form-check">
				<input class="form-check-input" type="checkbox" data-p="variants" checked />
				<label class="form-check-label"><%= i18n.__('catalog.bulk.apply_variants') %></label>
			</div>
		</template>
		<template data-op="formula">
			<select class="form-select rounded-0" data-p="on" data-type="bool">
				<option value="1"><%= i18n.__('catalog.bulk.formula_on') %></option>
				<option value="0"><%= i18n.__('catalog.bulk.formula_off') %></option>
			</select>
			<div class="form-text"><%= i18n.__('catalog.bulk.formula_hint') %></div>
		</template>
		<template data-op="fixed_price">
			<div class="row g-2">
				<div class="col-6 col-md-3">
					<label class="form-label"><%= i18n.__('catalog.bulk.cur_code') %></label>
					<select class="form-select rounded-0" data-p="code">
