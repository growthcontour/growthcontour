				<div class="col-12 col-md-4">
					<label class="form-label"><%= i18n.__('catalog.bulk_new.stock_op') %></label>
					<select class="form-select rounded-0" data-p="op">
						<option value="set"><%= i18n.__('catalog.bulk_new.stock_set') %></option>
						<option value="add"><%= i18n.__('catalog.bulk_new.stock_add') %></option>
					</select>
				</div>
				<div class="col-12 col-md-4">
					<label class="form-label"><%= i18n.__('catalog.bulk_new.stock_qty') %></label>
					<input type="number" step="any" class="form-control rounded-0" data-p="qty" data-type="num" />
				</div>
				<div class="col-12 form-text" data-show-if="op=set"><%= i18n.__('catalog.bulk_new.stock_set_hint') %></div>
				<div class="col-12 form-text" data-show-if="op=add"><%= i18n.__('catalog.bulk_new.stock_add_hint') %></div>
				<div class="col-12 form-text"><%= i18n.__('catalog.bulk_new.stock_hint') %></div>
			</div>
		</template>
		<% } %>

		<%- include('../../../partials/footer'); %>
		<%- include('../../../partials/script'); %>
		<script src="/assets/js/notyf/notyf.min.js"></script>
		<script>
			(function () {
				"use strict";
				const $ = (id) => document.getElementById(id);
				const esc = (s) => String(s === null || s === undefined ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
				const fmt = (n) => Number(n || 0).toLocaleString();
				const notyf = new Notyf({ duration: 6000, position: { x: "right", y: "top" } });
				const MAX_OPS = 10;

				async function api(url, body) {
					const res = await fetch(url, { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(body || {}) });
					let j = {};
					try {
						j = await res.json();
					} catch (e) {}
					if (!res.ok || !j.ok) throw Object.assign(new Error(j.error || "Error"), { errors: j.errors });
					return j;
				}

				/* ─── 1. Набір товарів ─── */
				const mode = () => document.querySelector("input[name=bn-mode]:checked").value;
				function selection() {
					if (mode() === "list") return { mode: "list", list: $("bn-list-text").value };
					const filter = {};
					document.querySelectorAll("#bn-filter [data-f]").forEach((el) => el.value !== "" && (filter[el.dataset.f] = el.value));
					return { mode: "filter", filter };
				}
				let total = 0;
				let countTimer = null;
				let countSeq = 0;
				async function count() {
					const seq = ++countSeq;
					$("bn-count").textContent = "…";
					try {
						const sel = selection();
						if (sel.mode === "list" && !sel.list.trim()) {
							total = 0;
							$("bn-count").textContent = "0";
							$("bn-not-found").classList.add("d-none");
							return;
						}
						const r = await api("/api/catalog/bulk/count/", { selection: sel });
						if (seq !== countSeq) return;
						total = r.total;
						$("bn-count").textContent = fmt(r.total);
						const nf = $("bn-not-found");
						if (sel.mode === "list" && r.not_found_count) {
							nf.innerHTML = `${esc("<%= i18n.__('catalog.bulk_new.not_found') %>")}: <b>${fmt(r.not_found_count)}</b><div class="small font-monospace">${r.not_found.map(esc).join(", ")}${r.not_found_count > r.not_found.length ? " …" : ""}</div>`;
							nf.classList.remove("d-none");
						} else nf.classList.add("d-none");
					} catch (e) {
						if (seq === countSeq) $("bn-count").textContent = "—";
					}
				}
				const recount = () => {
					stale();
					clearTimeout(countTimer);
					countTimer = setTimeout(count, 400);
				};
				document.querySelectorAll("input[name=bn-mode]").forEach((r) =>
					r.addEventListener("change", () => {
						$("bn-filter").classList.toggle("d-none", mode() !== "filter");
						$("bn-list").classList.toggle("d-none", mode() !== "list");
						recount();
					})
				);
				document.querySelectorAll("#bn-filter [data-f]").forEach((el) => el.addEventListener(el.tagName === "SELECT" ? "change" : "input", recount));
				$("bn-list-text").addEventListener("input", recount);

				/* ─── 2. Дії ─── */
				const opsBox = $("bn-ops");
				function addOp(action) {
					if (opsBox.children.length >= MAX_OPS) return notyf.error("<%= i18n.__('catalog.bulk_new.max_actions', { n: '10' }) %>");
					const tpl = document.querySelector(`template[data-op="${action}"]`);
					const card = document.createElement("div");
					card.className = "card rounded-0 mb-3";
					card.dataset.action = action;
					card.innerHTML = `<div class="card-header rounded-0 d-flex justify-content-between align-items-center">
						<span><span class="badge text-bg-primary rounded-0 me-2" data-num></span>${esc($("bn-add").querySelector(`option[value="${action}"]`).textContent)}</span>
						<span class="btn-group">
							<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" data-move="-1" title="<%= i18n.__('catalog.bulk_new.up') %>"><i class="fa-solid fa-arrow-up"></i></button>
							<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" data-move="1" title="<%= i18n.__('catalog.bulk_new.down') %>"><i class="fa-solid fa-arrow-down"></i></button>
							<button type="button" class="btn btn-sm btn-outline-danger rounded-0" data-remove title="<%= i18n.__('catalog.bulk_new.remove') %>"><i class="fa-solid fa-xmark"></i></button>
						</span></div><div class="card-body"></div>`;
					card.querySelector(".card-body").appendChild(tpl.content.cloneNode(true));
					opsBox.appendChild(card);
					renumber();
					showIf(card);
					stale();
				}
				function renumber() {
					[...opsBox.children].forEach((c, i) => (c.querySelector("[data-num]").textContent = i + 1));
				}
				// Поля, потрібні лише при певному значенні іншого поля: data-show-if="op=replace|regex", data-hide-if="op=clear"
				function showIf(card) {
					const test = (rule) => {
						const [k, v] = rule.split("=");
						const src = card.querySelector(`[data-p="${k}"]`);
						return !!src && v.split("|").includes(src.value);
					};
					card.querySelectorAll("[data-show-if]").forEach((el) => el.classList.toggle("d-none", !test(el.dataset.showIf)));
					card.querySelectorAll("[data-hide-if]").forEach((el) => el.classList.toggle("d-none", test(el.dataset.hideIf)));
					if (card.dataset.action === "field" || card.dataset.action === "variant_field") fieldControls(card);
					if (card.dataset.action === "attribute") attrControls(card);
				}

				// «Поле товару»: операції й поле значення — за типом вибраного поля
				const FIELD_OPS = { num: ["set", "percent", "amount", "clear"], int: ["set", "amount", "clear"], bool: ["set"], enum: ["set", "clear"], str: ["set", "clear", "prepend", "append", "replace"], date: ["set", "clear"] };
				function fieldControls(card) {
					const opt = card.querySelector("[data-field-select]").selectedOptions[0];
					const t = opt.dataset.t;
					const ops = FIELD_OPS[t].filter((o) => o !== "clear" || opt.dataset.nullable === "1");
					const opSel = card.querySelector("[data-op-select]");
					[...opSel.options].forEach((o) => (o.hidden = !ops.includes(o.value)));
					if (!ops.includes(opSel.value)) {
						opSel.value = ops[0];
						return showIf(card);
					}
					card.querySelectorAll("[data-vt]").forEach((el) => el.classList.toggle("d-none", el.dataset.vt !== t));
					// Значення переліку — підписами з шаблону
					const en = card.querySelector("[data-enum]");
					if (t === "enum" && en.dataset.for !== opt.value) {
						en.dataset.for = opt.value;
						en.innerHTML = opt.dataset.values
							.split(",")
							.map((v) => `<option value="${esc(v)}">${esc((card.querySelector(`[data-enum-label="${opt.value}:${v}"]`) || {}).textContent || v)}</option>`)
							.join("");
					}
				}

				// «Характеристика»: поле значення — за типом характеристики; значення вибору — з сервера
				const AT = { select: "values", multiselect: "values", color: "values", integer: "number", decimal: "number", boolean: "bool", date: "date", text: "text", textarea: "text" };
				function attrControls(card) {
					const opt = card.querySelector("[data-attr-select]").selectedOptions[0];
					const kind = AT[opt.dataset.t] || "text";
					card.querySelectorAll("[data-at]").forEach((el) => el.classList.toggle("d-none", el.dataset.at !== kind));
					const sel = card.querySelector('[data-p="value_ids"]');
					sel.multiple = opt.dataset.t === "multiselect";
					sel.size = sel.multiple ? 6 : 1;
					if (kind === "values" && sel.dataset.for !== opt.value) {
						sel.dataset.for = opt.value;
						sel.innerHTML = "";
						api("/api/catalog/bulk/attribute-values/", { id_attribute: Number(opt.value) })
							.then((r) => {
								if (sel.dataset.for !== opt.value) return;
								sel.innerHTML = r.values.map((v) => `<option value="${Number(v.id)}">${esc(v.name)}</option>`).join("");
								// «Створити таку саму»: вибрати збережені значення, коли вони підвантажились
								const want = sel.dataset.want ? JSON.parse(sel.dataset.want) : [];
								[...sel.options].forEach((o) => (o.selected = want.includes(Number(o.value))));
							})
							.catch((e) => notyf.error(e.message));
					}
				}
				$("bn-add").addEventListener("change", (e) => {
					if (e.target.value) addOp(e.target.value);
					e.target.value = "";
				});
				opsBox.addEventListener("click", (e) => {
					const card = e.target.closest(".card[data-action]");
					if (!card) return;
					if (e.target.closest("[data-remove]")) {
						card.remove();
						renumber();
						stale();
					}
					const mv = e.target.closest("[data-move]");
					if (mv) {
						const sib = Number(mv.dataset.move) < 0 ? card.previousElementSibling : card.nextElementSibling;
						if (sib) Number(mv.dataset.move) < 0 ? opsBox.insertBefore(card, sib) : opsBox.insertBefore(sib, card);
						renumber();
						stale();
					}
				});
				opsBox.addEventListener("change", (e) => {
					const card = e.target.closest(".card[data-action]");
					if (card) showIf(card);
					stale();
				});
				opsBox.addEventListener("input", stale);

				/** Параметри дії з полів data-p (data-type: int, intnull, num, bool, ints, strnull; checkbox — так / ні) */
				function params(card) {
					const p = {};
					card.querySelectorAll("[data-p]").forEach((el) => {
						if (el.closest(".d-none")) return;
						const k = el.dataset.p;
						const t = el.dataset.type;
						if (t === "checks") {
							p[k] = p[k] || [];
							if (el.checked) p[k].push(Number(el.value));
						} else if (t === "boolv") p[k] = el.value === "1";
						else if (el.type === "checkbox") p[k] = el.checked;
						else if (t === "ints") p[k] = [...el.selectedOptions].map((o) => Number(o.value));
						else if (t === "int") p[k] = Number(el.value);
						else if (t === "intnull") p[k] = el.value === "" ? null : Number(el.value);
						else if (t === "num") {
							if (el.value !== "") p[k] = Number(el.value);
						} else if (t === "bool") p[k] = el.value === "1";
						else if (t === "strnull") p[k] = el.value === "" ? null : el.value;
						else p[k] = el.value;
					});
					return p;
				}
				// Час — у поясі людини (datetime-local), на сервер — ISO у UTC
				const iso = (v) => (v ? new Date(v).toISOString() : null);
				const runAt = () => ($("bn-when").value === "at" ? iso($("bn-run-at").value) : null);
				const revertAt = () => ($("bn-auto-revert").checked ? iso($("bn-revert-at").value) : null);
				const payload = () => ({
					title: $("bn-title").value.trim(),
					selection: selection(),
					operations: [...opsBox.children].map((c) => ({ action: c.dataset.action, params: params(c) })),
					run_at: runAt(),
					revert_at: revertAt(),
				});
				$("bn-when").addEventListener("change", () => $("bn-run-at-wrap").classList.toggle("d-none", $("bn-when").value !== "at"));
				$("bn-auto-revert").addEventListener("change", () => $("bn-revert-at").classList.toggle("d-none", !$("bn-auto-revert").checked));

				/* ─── 3. Перегляд і запуск ─── */
				// Будь-яка зміна набору чи дій — перегляд застарів, запуск лише після нового перегляду
				function stale() {
					$("bn-run").disabled = true;
					$("bn-preview-wrap").classList.add("d-none");
				}
				function validate() {
					if (!opsBox.children.length) {
						notyf.error("<%= i18n.__('catalog.bulk_new.e_no_actions') %>");
						return false;
					}
					// Залишки — окремим складським документом, з іншими діями не поєднуються
					if (opsBox.children.length > 1 && opsBox.querySelector('[data-action="stock"]')) {
						notyf.error("<%= i18n.__('catalog.bulk_new.e_stock_alone') %>");
						return false;
					}
					const st = opsBox.querySelector('[data-action="stock"] [data-p="qty"]');
					if (st && st.value === "") {
						notyf.error("<%= i18n.__('catalog.bulk_new.e_stock_qty') %>");
						return false;
					}
					// Обов'язкові поля дій (шаблон SEO, ALT): порожнє видиме поле — підказка з номером дії, без запиту на сервер
					for (const [i, card] of [...opsBox.children].entries()) {
						const el = [...card.querySelectorAll("[data-required]")].find((x) => !x.closest(".d-none") && !x.value.trim());
						if (el) {
							el.classList.add("is-invalid");
							el.addEventListener("input", () => el.classList.remove("is-invalid"), { once: true });
							el.focus();
							notyf.error(`<%= i18n.__('catalog.bulk_new.e_template') %> №${i + 1}`);
							return false;
						}
					}
					return true;
				}
				const errorText = (e) => e.message + (e.errors && e.errors.length ? ": " + e.errors.map((x) => x.field).join(", ") : "");

				$("bn-preview").addEventListener("click", async () => {
					if (!validate()) return;
					const btn = $("bn-preview");
					btn.disabled = true;
					try {
						const r = await api("/api/catalog/bulk/preview/", payload());
						total = r.total;
						$("bn-count").textContent = fmt(r.total);
						const rows = [];
						for (const p of r.sample) {
							const name = `<a href="/catalog/products/${Number(p.id)}/" target="_blank">${esc(p.name)}</a>${p.sku ? `<div class="small text-secondary">${esc(p.sku)}</div>` : ""}`;
							if (p.status !== "changed") {
								const text = p.status === "unchanged" ? "<%= i18n.__('catalog.bulk_new.unchanged') %>" : [p.message_text, p.user_name].filter(Boolean).join(": ");
								rows.push(`<tr><td>${name}</td><td colspan="3" class="${p.status === "unchanged" ? "text-secondary" : "text-warning"}">${esc(text)}</td></tr>`);
								continue;
							}
							p.changes.forEach((c, i) => {
								rows.push(`<tr>${i ? "" : `<td rowspan="${p.changes.length}">${name}</td>`}<td>${esc(c.label)}</td><td class="text-secondary">${esc(c.old === null ? "—" : c.old)}</td><td class="fw-semibold">${esc(c.new === null ? "—" : c.new)}</td></tr>`);
							});
						}
						$("bn-preview-rows").innerHTML = rows.join("") || `<tr><td colspan="4" class="text-secondary">${esc("<%= i18n.__('catalog.bulk_new.preview_empty') %>")}</td></tr>`;
						$("bn-preview-wrap").classList.remove("d-none");
						$("bn-run").disabled = !r.total;
						if (!r.total) notyf.error("<%= i18n.__('catalog.bulk_new.e_empty') %>");
					} catch (e) {
						notyf.error(errorText(e));
					} finally {
						btn.disabled = false;
					}
				});

				const runModal = new bootstrap.Modal($("bn-run-modal"));
				$("bn-run").addEventListener("click", () => {
					if (!validate()) return;
					if ($("bn-when").value === "at" && !$("bn-run-at").value) return notyf.error("<%= i18n.__('catalog.bulk_new.e_run_at') %>");
					if ($("bn-auto-revert").checked && !$("bn-revert-at").value) return notyf.error("<%= i18n.__('catalog.bulk_new.e_revert_at') %>");
					const lines = ["<%= i18n.__('catalog.bulk_new.run_text') %>".replace("%n", fmt(total))];
					if (runAt()) lines.push("<%= i18n.__('catalog.bulk_new.run_text_at') %>".replace("%s", new Date(runAt()).toLocaleString()));
					if (revertAt()) lines.push("<%= i18n.__('catalog.bulk_new.run_text_revert') %>".replace("%s", new Date(revertAt()).toLocaleString()));
					$("bn-run-text").textContent = lines.join(" ");
					runModal.show();
				});
				$("bn-run-ok").addEventListener("click", async () => {
					const btn = $("bn-run-ok");
					btn.disabled = true;
					try {
						const r = await api("/api/catalog/bulk/jobs/", payload());
						location.assign(`/catalog/bulk/${Number(r.id)}/`);
					} catch (e) {
						btn.disabled = false;
						runModal.hide();
						notyf.error(errorText(e));
					}
				});

				/* ─── «Створити таку саму»: набір і дії з попередньої зміни (?from=id) ─── */
				function fill(card, p) {
					const set = (el, v) => {
						const t = el.dataset.type;
						if (t === "checks") el.checked = (v || []).includes(Number(el.value));
						else if (el.type === "checkbox") el.checked = !!v;
						else if (t === "ints") {
							el.dataset.want = JSON.stringify(v || []);
							[...el.options].forEach((o) => (o.selected = (v || []).includes(Number(o.value))));
						} else if (t === "boolv" || t === "bool") el.value = v ? "1" : "0";
						else el.value = v === null || v === undefined ? "" : String(v);
					};
					// Спершу «ключові» поля (від них залежать інші), потім значення
					const first = ["field", "id_attribute", "code", "op"];
					first.forEach((k) => p[k] !== undefined && card.querySelectorAll(`[data-p="${k}"]`).forEach((el) => set(el, p[k])));
					showIf(card);
					card.querySelectorAll("[data-p]").forEach((el) => !first.includes(el.dataset.p) && p[el.dataset.p] !== undefined && set(el, p[el.dataset.p]));
					showIf(card);
				}
				// Шаблон: та сама сторінка з ?from=<id> — набір і дії підставляються з нього
				if ($("bn-template")) $("bn-template").addEventListener("change", (e) => e.target.value && location.assign(`/catalog/bulk/new/?from=${Number(e.target.value)}`));
				const from = Number(new URLSearchParams(location.search).get("from")) || 0;
				if (from)
					api(`/api/catalog/bulk/jobs/${from}/source/`)
						.then(({ source }) => {
							$("bn-title").value = source.title || "";
							if (source.selection.mode === "list") {
								$("bn-mode-list").checked = true;
								$("bn-list-text").value = source.selection.list;
								$("bn-filter").classList.add("d-none");
								$("bn-list").classList.remove("d-none");
							} else document.querySelectorAll("#bn-filter [data-f]").forEach((el) => (el.value = source.selection.filter[el.dataset.f] || ""));
							for (const op of source.operations) {
								if (!document.querySelector(`template[data-op="${op.action}"]`)) continue;
								addOp(op.action);
								fill(opsBox.lastElementChild, op.params || {});
							}
							count();
						})
						.catch((e) => notyf.error(e.message));
				else count();
			})();
		</script>
	</body>
</html>