												<td><input class="form-control form-control-sm rounded-0" type="number" data-p="priority" value="<%= Number(x.priority || 0) %>" style="width:80px"></td>
												<td><input class="form-control form-control-sm rounded-0" type="datetime-local" data-p="date_start" value="<%= x.date_start %>"></td>
