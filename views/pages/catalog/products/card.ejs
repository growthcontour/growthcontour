									<input class="form-control rounded-0" type="number" min="0" step="0.001" name="unit_price_base" data-type="number" value="<%= (product.unit_price_base ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-1" data-field="unit_price_unit">
									<label class="form-label"><%= i18n.__('catalog.products.f.unit_price_unit') %></label>
									<input class="form-control rounded-0" name="unit_price_unit" maxlength="16" placeholder="kg" value="<%= (product.unit_price_unit ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="ecotax">
									<label class="form-label"><%= i18n.__('catalog.products.f.ecotax') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="ecotax" data-type="number" value="<%= (product.ecotax ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="points_price">
									<label class="form-label"><%= i18n.__('catalog.products.f.points_price') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="1" name="points_price" data-type="intnull" value="<%= (product.points_price ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-12 d-flex flex-wrap gap-4">
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="show_price" data-type="bool" id="pf-showprice"<%= (Number(product.show_price ?? 1) ? ' checked' : '') %> /><label class="form-check-label" for="pf-showprice"><%= i18n.__('catalog.products.f.show_price') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="price_on_request" data-type="bool" id="pf-onrequest"<%= (Number(product.price_on_request ?? 0) ? ' checked' : '') %> /><label class="form-check-label" for="pf-onrequest"><%= i18n.__('catalog.products.f.price_on_request') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="available_for_order" data-type="bool" id="pf-available"<%= (Number(product.available_for_order ?? 1) ? ' checked' : '') %> /><label class="form-check-label" for="pf-available"><%= i18n.__('catalog.products.f.available_for_order') %></label></div>
								</div>
							</div>

							<div data-field="prices">
								<div class="d-flex align-items-center mb-2">
									<strong class="me-auto"><%= i18n.__('catalog.products.prices.title') %></strong>
									<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="btn-add-price"><i class="fa-solid fa-plus"></i> <%= i18n.__('catalog.products.prices.add') %></button>
								</div>
