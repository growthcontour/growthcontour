<!doctype html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('catalog.products.card_title') %></title>
		<%- include('../../../partials/head'); %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
		<style>
			.pc-sticky { position: sticky; top: 0; z-index: 1020; background: var(--bs-body-bg); }
			.pc-media { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }
			.pc-media-item { border: 1px solid var(--bs-border-color); padding: 6px; background: var(--bs-body-bg); }
			.pc-media-item.cover { border-color: var(--bs-success); box-shadow: 0 0 0 2px var(--bs-success-bg-subtle); }
			.pc-media-item img { width: 100%; height: 140px; object-fit: contain; background: var(--bs-tertiary-bg); cursor: grab; }
			.pc-cat-tree ul { list-style: none; padding-left: 1.25rem; margin: 0; }
			.pc-cat-tree > ul { padding-left: 0; }
			.pc-attr-row { border-bottom: 1px solid var(--bs-border-color-translucent); padding: 0.5rem 0; }
			.pc-opt { border: 1px solid var(--bs-border-color); margin-bottom: 1rem; }
			.pc-opt > .pc-opt-head { background: var(--bs-tertiary-bg); padding: 0.5rem 0.75rem; }
			.pc-opt td, .pc-opt th { vertical-align: middle; white-space: nowrap; }
			.pc-readonly .js-editable { pointer-events: none; opacity: 0.65; }
			.sortable-ghost { opacity: 0.4; }
		</style>
	</head>
	<body class="d-flex flex-column h-100">
		<%- include('../../../partials/header'); %>

		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<ol class="breadcrumb mb-0">
					<li class="breadcrumb-item"><a href="/"><%= i18n.__('catalog.common.home') %></a></li>
					<li class="breadcrumb-item"><a href="/catalog/products/"><%= i18n.__('catalog.products.title') %></a></li>
					<li class="breadcrumb-item active" id="bc-title"><%= productId ? '#' + productId : i18n.__('catalog.products.add') %></li>
				</ol>
			</div>
		</div>

		<main class="flex-shrink-0">
			<div class="container-fluid pb-5">
				<div class="pc-sticky py-2 mb-3 border-bottom d-flex flex-wrap gap-2 align-items-center">
					<h1 class="h4 mb-0 me-auto" id="pc-title"><%= productId ? '' : i18n.__('catalog.products.add') %></h1>
					<span class="badge text-bg-light border" id="pc-version"></span>
					<% if (productId) { %>
					<a class="btn btn-outline-secondary rounded-0 js-type-link" data-type="variable" href="/catalog/products/<%= productId %>/variants/"><i class="fa-solid fa-layer-group"></i> <%= i18n.__('catalog.variants.title') %></a>
					<a class="btn btn-outline-secondary rounded-0 js-type-link" data-type="bundle" href="/catalog/products/<%= productId %>/bundle/"><i class="fa-solid fa-boxes-stacked"></i> <%= i18n.__('catalog.products.bundle_btn') %></a>
					<a class="btn btn-outline-secondary rounded-0 js-type-link" data-type="digital" href="/catalog/products/<%= productId %>/downloads/"><i class="fa-solid fa-file-arrow-down"></i> <%= i18n.__('catalog.products.downloads_btn') %></a>
					<% } %>
					<% if (productId && perms.add) { %>
					<button type="button" class="btn btn-outline-secondary rounded-0" id="btn-copy"><i class="fa-regular fa-copy"></i> <%= i18n.__('catalog.products.copy') %></button>
					<% } %>
					<% if (productId && perms.delete) { %>
					<button type="button" class="btn btn-outline-danger rounded-0" id="btn-delete"><i class="fa-solid fa-trash"></i> <%= i18n.__('catalog.common.delete') %></button>
					<% } %>
					<% if (perms.add || perms.edit) { %>
					<button type="submit" form="pc-form" class="btn btn-primary rounded-0" id="btn-save"><i class="fa-solid fa-floppy-disk"></i> <%= i18n.__('catalog.common.save') %></button>
					<% } %>
				</div>

				<div class="alert alert-warning rounded-0 align-items-center gap-3" id="lock-banner" style="display: none">
					<i class="fa-solid fa-lock"></i>
					<span class="me-auto" id="lock-text"></span>
					<% if (perms.edit) { %>
					<button type="button" class="btn btn-sm btn-warning rounded-0" id="btn-takeover"><%= i18n.__('catalog.products.lock.takeover') %></button>
					<% } %>
				</div>
				<div class="alert alert-info rounded-0 align-items-center gap-3" id="saved-banner" style="display: none">
					<i class="fa-solid fa-rotate"></i>
					<span class="me-auto"><%= i18n.__('catalog.products.lock.changed_by_other') %></span>
					<button type="button" class="btn btn-sm btn-info rounded-0" id="btn-reload"><%= i18n.__('catalog.products.reload') %></button>
				</div>

				<form id="pc-form" novalidate>
					<ul class="nav nav-tabs mb-3" role="tablist">
						<li class="nav-item"><button class="nav-link rounded-0 active" data-bs-toggle="tab" data-bs-target="#t-general" type="button"><%= i18n.__('catalog.products.tabs.general') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-content" type="button"><%= i18n.__('catalog.products.tabs.content') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-prices" type="button"><%= i18n.__('catalog.products.tabs.prices') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-stock" type="button"><%= i18n.__('catalog.products.tabs.stock') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-media" type="button"><%= i18n.__('catalog.products.tabs.media') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-categories" type="button"><%= i18n.__('catalog.products.tabs.categories') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-attributes" type="button"><%= i18n.__('catalog.products.tabs.attributes') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-options" type="button"><%= i18n.__('catalog.products.tabs.options') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-shipping" type="button"><%= i18n.__('catalog.products.tabs.shipping') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-links" type="button"><%= i18n.__('catalog.products.tabs.links') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-extra" type="button"><%= i18n.__('catalog.products.tabs.extra') %></button></li>
					</ul>

					<div class="tab-content js-editable">
						<!-- ═══ ОСНОВНЕ ═══ -->
						<div class="tab-pane fade show active" id="t-general">
							<div class="row g-3">
								<div class="col-md-3" data-field="type">
									<label class="form-label"><%= i18n.__('catalog.products.f.type') %></label>
									<select class="form-select rounded-0" name="type">
										<option value="simple"><%= i18n.__('catalog.products.types.simple') %></option>
										<option value="variable"><%= i18n.__('catalog.products.types.variable') %></option>
										<option value="bundle"><%= i18n.__('catalog.products.types.bundle') %></option>
										<option value="digital"><%= i18n.__('catalog.products.types.digital') %></option>
										<option value="service"><%= i18n.__('catalog.products.types.service') %></option>
										<option value="gift_card"><%= i18n.__('catalog.products.types.gift_card') %></option>
									</select>
									<div class="form-text"><%= i18n.__('catalog.products.hints.type') %></div>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="status">
									<label class="form-label"><%= i18n.__('catalog.products.f.status') %></label>
									<select class="form-select rounded-0" name="status">
										<option value="draft"><%= i18n.__('catalog.products.status.draft') %></option>
										<option value="active"><%= i18n.__('catalog.products.status.active') %></option>
										<option value="archived"><%= i18n.__('catalog.products.status.archived') %></option>
									</select>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="visibility">
									<label class="form-label"><%= i18n.__('catalog.products.f.visibility') %></label>
									<select class="form-select rounded-0" name="visibility">
										<option value="all"><%= i18n.__('catalog.products.visibility.all') %></option>
										<option value="catalog"><%= i18n.__('catalog.products.visibility.catalog') %></option>
										<option value="search"><%= i18n.__('catalog.products.visibility.search') %></option>
										<option value="none"><%= i18n.__('catalog.products.visibility.none') %></option>
									</select>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="item_condition">
									<label class="form-label"><%= i18n.__('catalog.products.f.item_condition') %></label>
									<select class="form-select rounded-0" name="item_condition">
										<option value="new"><%= i18n.__('catalog.products.condition.new') %></option>
										<option value="used"><%= i18n.__('catalog.products.condition.used') %></option>
										<option value="refurbished"><%= i18n.__('catalog.products.condition.refurbished') %></option>
									</select>
									<div class="invalid-feedback"></div>
								</div>

								<div class="col-md-3" data-field="sku">
									<label class="form-label"><%= i18n.__('catalog.products.f.sku') %></label>
									<input class="form-control rounded-0" name="sku" maxlength="64" placeholder="<%= cfg.skuAuto ? i18n.__('catalog.products.hints.auto') : '' %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="model">
									<label class="form-label"><%= i18n.__('catalog.products.f.model') %></label>
									<input class="form-control rounded-0" name="model" maxlength="128" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="mpn">
									<label class="form-label"><%= i18n.__('catalog.products.f.mpn') %></label>
									<input class="form-control rounded-0" name="mpn" maxlength="64" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="ean">
									<label class="form-label"><%= i18n.__('catalog.products.f.ean') %></label>
									<input class="form-control rounded-0" name="ean" maxlength="14" inputmode="numeric" placeholder="<%= cfg.eanAuto ? i18n.__('catalog.products.hints.auto') : '' %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="upc">
									<label class="form-label">UPC</label>
									<input class="form-control rounded-0" name="upc" maxlength="12" inputmode="numeric" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="jan">
									<label class="form-label">JAN</label>
									<input class="form-control rounded-0" name="jan" maxlength="13" inputmode="numeric" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="isbn">
									<label class="form-label">ISBN</label>
									<input class="form-control rounded-0" name="isbn" maxlength="17" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="id_brand">
									<label class="form-label"><%= i18n.__('catalog.products.f.brand') %></label>
									<div class="input-group">
										<input type="search" class="form-control rounded-0" id="brand-search" placeholder="<%= i18n.__('catalog.common.search') %>" style="max-width: 40%" />
										<select class="form-select rounded-0" name="id_brand" data-type="intnull"><option value=""><%= i18n.__('catalog.common.none') %></option></select>
									</div>
									<div class="invalid-feedback"></div>
								</div>

								<div class="col-md-3" data-field="id_attribute_set">
									<label class="form-label"><%= i18n.__('catalog.products.f.attribute_set') %></label>
									<select class="form-select rounded-0" name="id_attribute_set" data-type="intnull"><option value=""><%= i18n.__('catalog.common.none') %></option></select>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="product_type_label">
									<label class="form-label"><%= i18n.__('catalog.products.f.product_type_label') %></label>
									<input class="form-control rounded-0" name="product_type_label" maxlength="128" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="vendor">
									<label class="form-label"><%= i18n.__('catalog.products.f.vendor') %></label>
									<input class="form-control rounded-0" name="vendor" maxlength="128" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="sort_order">
									<label class="form-label"><%= i18n.__('catalog.products.f.sort_order') %></label>
									<input class="form-control rounded-0" type="number" name="sort_order" data-type="int" value="0" />
									<div class="invalid-feedback"></div>
								</div>

								<div class="col-12 d-flex flex-wrap gap-4">
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="is_featured" data-type="bool" id="pf-featured" /><label class="form-check-label" for="pf-featured"><%= i18n.__('catalog.products.f.is_featured') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="on_sale_flag" data-type="bool" id="pf-sale" /><label class="form-check-label" for="pf-sale"><%= i18n.__('catalog.products.f.on_sale_flag') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="online_only" data-type="bool" id="pf-online" /><label class="form-check-label" for="pf-online"><%= i18n.__('catalog.products.f.online_only') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="show_condition" data-type="bool" id="pf-showcond" /><label class="form-check-label" for="pf-showcond"><%= i18n.__('catalog.products.f.show_condition') %></label></div>
								</div>
							</div>
						</div>

						<!-- ═══ ОПИС І SEO ═══ -->
						<div class="tab-pane fade" id="t-content">
							<div class="form-check form-switch mb-3">
								<input class="form-check-input" type="checkbox" id="slug-shared" />
								<label class="form-check-label" for="slug-shared"><%= i18n.__('catalog.languages.slug_shared') %></label>
								<div class="form-text"><%= i18n.__('catalog.languages.slug_shared_hint') %></div>
							</div>
							<ul class="nav nav-pills mb-3">
								<% languages.forEach((l, i) => { %>
								<li class="nav-item"><button class="nav-link rounded-0<%= i === 0 ? ' active' : '' %>" type="button" data-bs-toggle="tab" data-bs-target="#lang-<%= l.id %>"><%= String(l.iso).toUpperCase() %><% if (i === 0) { %> *<% } %></button></li>
								<% }) %>
							</ul>
							<div class="tab-content">
								<% languages.forEach((l, i) => { %>
								<div class="tab-pane fade<%= i === 0 ? ' show active' : '' %>" id="lang-<%= l.id %>">
									<div class="row g-3">
										<div class="col-md-8" data-field="descriptions.<%= l.id %>.name">
											<label class="form-label"><%= i18n.__('catalog.products.f.name') %><% if (i === 0) { %> *<% } %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="name" maxlength="255" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-4" data-field="descriptions.<%= l.id %>.unit_label">
											<label class="form-label"><%= i18n.__('catalog.products.f.unit_label') %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="unit_label" maxlength="32" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-12" data-field="descriptions.<%= l.id %>.short_description">
											<label class="form-label"><%= i18n.__('catalog.products.f.short_description') %></label>
											<textarea class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="short_description" rows="3"></textarea>
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-12" data-field="descriptions.<%= l.id %>.description">
											<label class="form-label"><%= i18n.__('catalog.products.f.description') %></label>
											<textarea class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="description" rows="10"></textarea>
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-6" data-field="descriptions.<%= l.id %>.h1">
											<label class="form-label">H1</label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="h1" maxlength="255" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-6" data-field="descriptions.<%= l.id %>.slug">
											<label class="form-label"><%= i18n.__('catalog.products.f.slug') %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="slug" maxlength="191" />
											<div class="form-text"><%= i18n.__('catalog.products.hints.slug') %></div>
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-6" data-field="descriptions.<%= l.id %>.meta_title">
											<label class="form-label">Meta title</label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="meta_title" maxlength="255" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-6" data-field="descriptions.<%= l.id %>.meta_keywords">
											<label class="form-label">Meta keywords</label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="meta_keywords" maxlength="512" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-12" data-field="descriptions.<%= l.id %>.meta_description">
											<label class="form-label">Meta description</label>
											<textarea class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="meta_description" rows="2" maxlength="512"></textarea>
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-6" data-field="descriptions.<%= l.id %>.tags">
											<label class="form-label"><%= i18n.__('catalog.products.f.tags') %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="tags" maxlength="512" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-6" data-field="descriptions.<%= l.id %>.search_keywords">
											<label class="form-label"><%= i18n.__('catalog.products.f.search_keywords') %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="search_keywords" maxlength="512" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-3" data-field="descriptions.<%= l.id %>.text_in_stock">
											<label class="form-label"><%= i18n.__('catalog.products.f.text_in_stock') %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="text_in_stock" maxlength="255" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-3" data-field="descriptions.<%= l.id %>.text_out_of_stock">
											<label class="form-label"><%= i18n.__('catalog.products.f.text_out_of_stock') %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="text_out_of_stock" maxlength="255" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-3" data-field="descriptions.<%= l.id %>.delivery_text_in_stock">
											<label class="form-label"><%= i18n.__('catalog.products.f.delivery_text_in_stock') %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="delivery_text_in_stock" maxlength="255" />
											<div class="invalid-feedback"></div>
										</div>
										<div class="col-md-3" data-field="descriptions.<%= l.id %>.delivery_text_out_stock">
											<label class="form-label"><%= i18n.__('catalog.products.f.delivery_text_out_stock') %></label>
											<input class="form-control rounded-0" data-lang="<%= l.id %>" data-desc="delivery_text_out_stock" maxlength="255" />
											<div class="invalid-feedback"></div>
										</div>
									</div>
								</div>
								<% }) %>
							</div>
						</div>

						<!-- ═══ ЦІНИ ═══ -->
						<div class="tab-pane fade" id="t-prices">
							<div class="row g-3 mb-4">
								<div class="col-md-3" data-field="price">
									<label class="form-label"><%= i18n.__('catalog.products.f.price') %>, <%= cfg.currency %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="price" data-type="number0" value="0" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="compare_at_price">
									<label class="form-label"><%= i18n.__('catalog.products.f.compare_at_price') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="compare_at_price" data-type="number" />
									<div class="invalid-feedback"></div>
								</div>
								<% if (perms.cost) { %>
								<div class="col-md-3" data-field="cost_price">
									<label class="form-label"><%= i18n.__('catalog.products.f.cost_price') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="cost_price" data-type="number" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="wholesale_price">
									<label class="form-label"><%= i18n.__('catalog.products.f.wholesale_price') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="wholesale_price" data-type="number" />
									<div class="invalid-feedback"></div>
