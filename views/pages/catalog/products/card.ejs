								<table class="table table-sm align-middle" style="max-width: 520px">
									<thead><tr><th><%= i18n.__('catalog.products.prices.customer_group') %></th><th><%= i18n.__('catalog.products.rewards.points') %></th><th></th></tr></thead>
									<tbody id="rewards-body">
										<% product.rewards.forEach((r) => { %>
										<tr>
											<td><select class="form-select form-select-sm rounded-0" data-r="id_customer_group"><% groupList.forEach((g) => { %><option value="<%= g.id %>"<%= Number(g.id) === Number(r.id_customer_group || 0) ? ' selected' : '' %>><%= g.name %></option><% }) %></select></td>
											<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="1" data-r="points" value="<%= r.points == null ? '' : r.points %>"></td>
											<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button></td>
										</tr>
										<% }) %>
									</tbody>
								</table>
							</div>

							<div data-field="customer_groups" class="mt-4">
								<strong class="d-block mb-1"><%= i18n.__('catalog.groups.visibility.title') %></strong>
								<div class="form-text mb-2"><%= i18n.__('catalog.groups.visibility.hint') %></div>
								<div class="d-flex flex-wrap gap-3" id="cg-visibility">
									<% customerGroups.forEach((g) => { %>
									<div class="form-check"><input class="form-check-input" type="checkbox" value="<%= g.id %>" id="cg-vis-<%= g.id %>"<%= product.customer_groups.includes(g.id) ? ' checked' : '' %> /><label class="form-check-label" for="cg-vis-<%= g.id %>"><%= g.name %></label></div>
									<% }) %>
								</div>
								<div class="invalid-feedback"></div>
							</div>

							<% if (productId) { %>
							<div class="mt-4" id="price-schedule">
								<strong class="d-block mb-1"><%= i18n.__('catalog.schedule.title') %></strong>
								<div class="form-text mb-2"><%= i18n.__('catalog.schedule.hint') %></div>
								<% if (perms.edit) { %>
								<div class="row g-2 align-items-end mb-2" id="ps-form">
									<div class="col-md-2" data-ps="field">
										<label class="form-label small"><%= i18n.__('catalog.schedule.f.field') %></label>
										<select class="form-select form-select-sm rounded-0" data-psf="field">
											<option value="price"><%= i18n.__('catalog.products.f.price') %></option>
											<option value="compare_at_price"><%= i18n.__('catalog.products.f.compare_at_price') %></option>
										</select>
									</div>
									<div class="col-md-2" data-ps="value">
										<label class="form-label small"><%= i18n.__('catalog.schedule.f.value') %>, <%= product.price_currency || cfg.currency %></label>
										<input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.0001" data-psf="value" />
										<div class="invalid-feedback"></div>
									</div>
									<div class="col-md-2" data-ps="run_at">
										<label class="form-label small"><%= i18n.__('catalog.schedule.f.run_at') %></label>
										<input class="form-control form-control-sm rounded-0" type="datetime-local" data-psf="run_at" />
										<div class="invalid-feedback"></div>
									</div>
									<div class="col-md-2" data-ps="revert_at">
										<label class="form-label small"><%= i18n.__('catalog.schedule.f.revert_at') %></label>
										<input class="form-control form-control-sm rounded-0" type="datetime-local" data-psf="revert_at" />
										<div class="invalid-feedback"></div>
									</div>
									<div class="col-md-2" data-ps="comment">
										<label class="form-label small"><%= i18n.__('catalog.schedule.f.comment') %></label>
										<input class="form-control form-control-sm rounded-0" maxlength="255" data-psf="comment" />
									</div>
									<div class="col-md-2">
										<div class="form-check mb-1"><input class="form-check-input" type="checkbox" data-psf="set_compare_at" id="ps-cmp" checked /><label class="form-check-label small" for="ps-cmp"><%= i18n.__('catalog.schedule.f.set_compare_at') %></label></div>
										<button type="button" class="btn btn-sm btn-outline-primary rounded-0 w-100" id="ps-add"><i class="fa-solid fa-calendar-plus"></i> <%= i18n.__('catalog.schedule.add') %></button>
									</div>
								</div>
								<% } %>
								<div class="table-responsive">
									<table class="table table-sm align-middle">
										<thead>
											<tr>
												<th><%= i18n.__('catalog.schedule.f.field') %></th>
												<th class="text-end"><%= i18n.__('catalog.schedule.f.value') %></th>
												<th><%= i18n.__('catalog.schedule.f.run_at') %></th>
												<th><%= i18n.__('catalog.schedule.f.revert_at') %></th>
												<th><%= i18n.__('catalog.schedule.f.status') %></th>
												<th class="text-end"><%= i18n.__('catalog.schedule.f.old_price') %></th>
												<th><%= i18n.__('catalog.schedule.f.comment') %></th>
												<th></th>
											</tr>
										</thead>
										<tbody id="ps-body">
											<% if (!schedule.length) { %>
											<tr><td colspan="8" class="text-muted">—</td></tr>
											<% } %>
											<% schedule.forEach((s) => { %>
											<tr>
												<td><%= s.field_label %><% if (Number(s.set_compare_at)) { %> <i class="fa-solid fa-tag text-muted" title="<%= i18n.__('catalog.schedule.f.set_compare_at') %>"></i><% } %></td>
												<td class="text-end"><%= s.value_text %></td>
												<td><%= s.run_text %></td>
												<td><%= s.revert_text %></td>
												<td><span class="badge text-bg-<%= s.status_cls %>" title="<%= s.error || '' %>"><%= s.status_label %></span><% if (s.error) { %> <small class="text-muted"><%= s.error %></small><% } %></td>
												<td class="text-end"><%= s.old_text %></td>
												<td><small><%= s.comment || '' %></small><br><small class="text-muted"><%= s.user_name || '' %></small></td>
												<td class="text-end"><% if (s.can_cancel) { %><button type="button" class="btn btn-sm btn-outline-danger rounded-0" data-cancel="<%= s.id %>" title="<%= i18n.__('catalog.schedule.cancel') %>"><i class="fa-solid fa-ban"></i></button><% } %></td>
											</tr>
											<% }) %>
										</tbody>
									</table>
								</div>
							</div>
							<% } %>
						</div>

