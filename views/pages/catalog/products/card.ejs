												<th style="width: 120px"><%= i18n.__('catalog.products.stock.reorder_point') %></th>
												<th style="width: 120px"><%= i18n.__('catalog.products.stock.reorder_qty') %></th>
											</tr>
										</thead>
										<tbody id="stock-body">
