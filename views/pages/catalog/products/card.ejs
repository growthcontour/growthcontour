								<strong class="d-block mb-2"><%= i18n.__('catalog.products.suppliers.title') %></strong>
								<div class="d-flex gap-2 mb-2">
									<input type="search" class="form-control rounded-0" id="supplier-search" placeholder="<%= i18n.__('catalog.common.search') %>" style="max-width: 240px" />
									<select class="form-select rounded-0" id="supplier-select" style="max-width: 320px">
										<% supplierOptions.forEach((s) => { %><option value="<%= s.id %>"><%= s.name %><%= s.code ? ' (' + s.code + ')' : '' %></option><% }) %>
									</select>
									<button type="button" class="btn btn-outline-secondary rounded-0" id="btn-add-supplier"><i class="fa-solid fa-plus"></i></button>
