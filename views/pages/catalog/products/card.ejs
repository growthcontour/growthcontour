									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="subtract_stock" data-type="bool" id="pf-subtract"<%= (Number(product.subtract_stock ?? 1) ? ' checked' : '') %> /><label class="form-check-label" for="pf-subtract"><%= i18n.__('catalog.products.f.subtract_stock') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="low_stock_alert" data-type="bool" id="pf-lowalert"<%= (Number(product.low_stock_alert ?? 0) ? ' checked' : '') %> /><label class="form-check-label" for="pf-lowalert"><%= i18n.__('catalog.products.f.low_stock_alert') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="sold_individually" data-type="bool" id="pf-single"<%= (Number(product.sold_individually ?? 0) ? ' checked' : '') %> /><label class="form-check-label" for="pf-single"><%= i18n.__('catalog.products.f.sold_individually') %></label></div>
								</div>
							</div>

							<div class="alert alert-light border rounded-0" id="stock-variable-note"<%- product.type === 'variable' ? '' : ' style="display: none"' %>><%= i18n.__('catalog.products.stock.variable_note') %></div>
							<div data-field="stock" id="stock-block"<%- product.type === 'variable' ? ' style="display: none"' : '' %>>
								<strong class="d-block mb-2"><%= i18n.__('catalog.products.stock.title') %></strong>
								<% if (!perms.stock) { %><div class="form-text mb-2"><%= i18n.__('catalog.products.stock.read_only') %></div><% } %>
								<div class="invalid-feedback"></div>
								<div class="table-responsive">
									<table class="table table-sm align-middle">
										<thead>
											<tr>
												<th><%= i18n.__('catalog.products.stock.warehouse') %></th>
												<th style="width: 140px"><%= i18n.__('catalog.products.stock.on_hand') %></th>
												<th class="text-end"><%= i18n.__('catalog.products.stock.reserved') %></th>
												<th class="text-end"><%= i18n.__('catalog.products.stock.incoming') %></th>
												<th class="text-end"><%= i18n.__('catalog.products.stock.available') %></th>
