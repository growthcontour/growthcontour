									<input class="form-control rounded-0" type="date" name="available_date" data-type="date" value="<%= product.available_date %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="preorder_release_date">
									<label class="form-label"><%= i18n.__('catalog.products.f.preorder_release_date') %></label>
									<input class="form-control rounded-0" type="date" name="preorder_release_date" data-type="date" value="<%= product.preorder_release_date %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-8 d-flex flex-wrap gap-4 pt-md-4">
