												<th></th>
											</tr>
										</thead>
										<tbody id="suppliers-body"></tbody>
									</table>
								</div>
							</div>
						</div>

						<!-- ═══ ДОДАТКОВО ═══ -->
						<div class="tab-pane fade" id="t-extra">
							<div class="row g-3">
								<div class="col-md-3" data-field="published_at">
									<label class="form-label"><%= i18n.__('catalog.products.f.published_at') %></label>
									<input class="form-control rounded-0" type="datetime-local" name="published_at" data-type="datetime" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="unpublished_at">
									<label class="form-label"><%= i18n.__('catalog.products.f.unpublished_at') %></label>
									<input class="form-control rounded-0" type="datetime-local" name="unpublished_at" data-type="datetime" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="redirect_type">
									<label class="form-label"><%= i18n.__('catalog.products.f.redirect_type') %></label>
									<select class="form-select rounded-0" name="redirect_type">
										<option value="none"><%= i18n.__('catalog.products.redirect.none') %></option>
										<option value="301_product">301 → <%= i18n.__('catalog.products.redirect.product') %></option>
										<option value="302_product">302 → <%= i18n.__('catalog.products.redirect.product') %></option>
										<option value="301_category">301 → <%= i18n.__('catalog.products.redirect.category') %></option>
										<option value="302_category">302 → <%= i18n.__('catalog.products.redirect.category') %></option>
										<option value="404">404</option>
										<option value="410">410</option>
									</select>
									<div class="form-text"><%= i18n.__('catalog.products.hints.redirect') %></div>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="redirect_target_id">
									<label class="form-label"><%= i18n.__('catalog.products.f.redirect_target_id') %></label>
									<input class="form-control rounded-0" type="number" min="1" name="redirect_target_id" data-type="intnull" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="age_restriction">
									<label class="form-label"><%= i18n.__('catalog.products.f.age_restriction') %></label>
									<input class="form-control rounded-0" type="number" min="0" max="99" name="age_restriction" data-type="intnull" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="layout_template">
									<label class="form-label"><%= i18n.__('catalog.products.f.layout_template') %></label>
									<input class="form-control rounded-0" name="layout_template" maxlength="64" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="gift_card_value">
									<label class="form-label"><%= i18n.__('catalog.products.f.gift_card_value') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.01" name="gift_card_value" data-type="number" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="gift_card_expiry_days">
									<label class="form-label"><%= i18n.__('catalog.products.f.gift_card_expiry_days') %></label>
									<input class="form-control rounded-0" type="number" min="1" name="gift_card_expiry_days" data-type="intnull" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-12">
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="allow_gift_wrap" data-type="bool" id="pf-giftwrap" /><label class="form-check-label" for="pf-giftwrap"><%= i18n.__('catalog.products.f.allow_gift_wrap') %></label></div>
								</div>
								<div class="col-12" data-field="internal_note">
									<label class="form-label"><%= i18n.__('catalog.products.f.internal_note') %></label>
									<textarea class="form-control rounded-0" name="internal_note" rows="4" maxlength="10000"></textarea>
									<div class="form-text"><%= i18n.__('catalog.products.hints.internal_note') %></div>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-12 text-muted small" id="pc-meta"></div>
							</div>
						</div>
					</div>
				</form>
			</div>
		</main>

		<%- include('../../../partials/footer'); %>
		<%- include('../../../partials/script'); %>
		<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
		<script src="/assets/js/notyf/notyf.min.js"></script>
		<script>
			(function () {
				"use strict";

				// ═══ КОНТЕКСТ ══════════════════════════════════
				const PRODUCT_ID = <%= productId ? Number(productId) : 'null' %>;
				const PERMS = { add: <%= perms.add %>, edit: <%= perms.edit %>, delete: <%= perms.delete %>, cost: <%= perms.cost %>, stock: <%= perms.stock %>, locations: <%= perms.locations %> };
				const LANGS = [<% languages.forEach((l) => { %><%= Number(l.id) %>,<% }) %>];
				const LANG_ISO = { <% languages.forEach((l) => { %><%= Number(l.id) %>: "<%= String(l.iso).toUpperCase() %>", <% }) %> };
				const PRIMARY_LANG = LANGS[0];
				const DEFAULT_STATUS = "<%= cfg.defaultStatus %>";
				const DEFAULT_SET = <%= cfg.defaultAttributeSet ? Number(cfg.defaultAttributeSet) : 'null' %>;
				const HEARTBEAT_MS = <%= Number(cfg.lock.heartbeat_seconds) * 1000 %>;
				const ME = <%= Number(user.id) %>;
				const VALUE_OPTION_TYPES = ["select", "radio", "checkbox", "color"];

				const notyf = new Notyf({ duration: 3500, position: { x: "right", y: "top" } });
				const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch]);
				const errMsg = (err) => err.error || "<%= i18n.__('catalog.common.error') %>";
				const form = document.getElementById("pc-form");

				async function api(url, body) {
					const res = await fetch(url, { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(body || {}) });
					const json = await res.json().catch(() => ({}));
					if (!res.ok || json.ok === false) throw json;
					return json;
				}

				let product = null;
				let canWrite = PRODUCT_ID ? PERMS.edit : PERMS.add;
				let dirty = false;
				form.addEventListener("input", () => (dirty = true));
				form.addEventListener("change", () => (dirty = true));

				// ═══ ПРОСТІ ПОЛЯ ═══════════════════════════════
				const toInputDatetime = (v) => (v ? String(v).replace(" ", "T").slice(0, 16) : "");
				const fromInputDatetime = (v) => (v ? v.replace("T", " ") + ":00" : null);

				function readCore() {
					const out = {};
					form.querySelectorAll("[name]").forEach((el) => {
						if (el.name.startsWith("_")) return;
						const t = el.dataset.type;
						const v = el.value.trim();
						if (t === "bool") out[el.name] = el.checked;
						else if (t === "int") out[el.name] = v === "" ? 0 : parseInt(v, 10);
						else if (t === "intnull") out[el.name] = v === "" ? null : parseInt(v, 10);
						else if (t === "number") out[el.name] = v === "" ? null : Number(v);
						else if (t === "number0") out[el.name] = v === "" ? 0 : Number(v);
						else if (t === "datetime") out[el.name] = fromInputDatetime(v);
						else out[el.name] = v === "" ? null : v;
					});
					return out;
				}
				function fillCore(row) {
					form.querySelectorAll("[name]").forEach((el) => {
						if (el.name.startsWith("_")) return;
						const v = row[el.name];
						const t = el.dataset.type;
						if (t === "bool") el.checked = v === undefined ? el.defaultChecked : !!Number(v);
						else if (t === "datetime") el.value = toInputDatetime(v);
						else if (t === "date") el.value = v ? String(v).slice(0, 10) : "";
						else if (v === undefined) el.value = el.defaultValue;
						else el.value = v == null ? "" : v;
					});
				}
				function readDescriptions() {
					const out = {};
					form.querySelectorAll("[data-desc]").forEach((el) => ((out[el.dataset.lang] = out[el.dataset.lang] || {})[el.dataset.desc] = el.value));
					return out;
				}
				// Один URL для всіх мов: поле slug лишається тільки в основній мові
				function applySlugShared() {
					const on = document.getElementById("slug-shared").checked;
					document.querySelectorAll('#t-content [data-field$=".slug"]').forEach((el) => {
						const lang = Number(el.dataset.field.split(".")[1]);
						el.classList.toggle("d-none", on && lang !== PRIMARY_LANG);
					});
				}
				document.getElementById("slug-shared").addEventListener("change", applySlugShared);

				function fillDescriptions(d) {
					form.querySelectorAll("[data-desc]").forEach((el) => (el.value = ((d || {})[el.dataset.lang] || {})[el.dataset.desc] || ""));
				}

				// ═══ ПОМИЛКИ ═══════════════════════════════════
				function clearErrors() {
					form.querySelectorAll(".is-invalid").forEach((el) => el.classList.remove("is-invalid"));
					form.querySelectorAll(".invalid-feedback").forEach((el) => {
						el.textContent = "";
						el.style.display = "";
					});
				}
				function showErrors(errors) {
					let first = null;
					(errors || []).forEach((e) => {
						const field = String(e.field || "");
						const parts = field.split(".");
						let box = null;
						for (let n = parts.length; n > 0 && !box; n--) box = form.querySelector(`[data-field="${CSS.escape(parts.slice(0, n).join("."))}"]`);
						if (!box) return;
						box.querySelectorAll(":scope > input, :scope > select, :scope > textarea, :scope > .input-group > *").forEach((el) => el.classList.add("is-invalid"));
						const fb = box.querySelector(".invalid-feedback");
						if (fb) {
							fb.textContent = (fb.textContent ? fb.textContent + "; " : "") + (box.dataset.field !== field ? field + ": " : "") + e.message;
							fb.style.display = "block";
						}
						if (!first) first = box;
					});
					if (first) {
						const panes = [];
						let p = first.closest(".tab-pane");
						while (p) {
							panes.unshift(p);
							p = p.parentElement.closest(".tab-pane");
						}
						panes.forEach((pane) => {
							const btn = document.querySelector(`[data-bs-target="#${pane.id}"]`);
							if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
						});
						first.scrollIntoView({ behavior: "smooth", block: "center" });
					}
				}

				// ═══ БРЕНД ═════════════════════════════════════
				const brandSelect = form.querySelector('[name="id_brand"]');
				async function loadBrands(search, keepId) {
					const r = await api("/api/catalog/products/brands/options/", { search });
					const current = keepId || brandSelect.value;
					brandSelect.querySelectorAll("option:not(:first-child)").forEach((o) => o.remove());
					r.rows.forEach((b) => brandSelect.add(new Option(b.name, b.id)));
					if (current && !r.rows.some((b) => String(b.id) === String(current))) brandSelect.add(new Option("#" + current, current));
					brandSelect.value = current || "";
				}
				let brandTimer;
				document.getElementById("brand-search").addEventListener("input", (e) => {
					clearTimeout(brandTimer);
					brandTimer = setTimeout(() => loadBrands(e.target.value.trim()).catch(() => {}), 300);
				});

				// ═══ ЦІНИ І БОНУСИ ═════════════════════════════
				const pricesBody = document.getElementById("prices-body");
				function priceRow(p) {
					const tr = document.createElement("tr");
					tr.innerHTML = `
						<td><select class="form-select form-select-sm rounded-0" data-p="kind">
							<option value="special"><%= i18n.__('catalog.products.prices.kinds.special') %></option>
							<option value="tier"><%= i18n.__('catalog.products.prices.kinds.tier') %></option></select></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" min="0" data-p="id_customer_group" value="${Number(p.id_customer_group || 0)}" style="width:90px"></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" min="0.001" step="0.001" data-p="min_qty" value="${esc(p.min_qty || 1)}" style="width:100px"></td>
						<td><select class="form-select form-select-sm rounded-0" data-p="reduction_type">
							<option value="new_price"><%= i18n.__('catalog.products.prices.types.new_price') %></option>
							<option value="fixed"><%= i18n.__('catalog.products.prices.types.fixed') %></option>
							<option value="percent"><%= i18n.__('catalog.products.prices.types.percent') %></option></select></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.0001" data-p="value" value="${esc(p.value ?? "")}" style="width:120px"></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" data-p="priority" value="${Number(p.priority || 0)}" style="width:80px"></td>
						<td><input class="form-control form-control-sm rounded-0" type="datetime-local" data-p="date_start" value="${esc(toInputDatetime(p.date_start))}"></td>
						<td><input class="form-control form-control-sm rounded-0" type="datetime-local" data-p="date_end" value="${esc(toInputDatetime(p.date_end))}"></td>
						<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button></td>`;
					tr.querySelector('[data-p="kind"]').value = p.kind || "special";
					tr.querySelector('[data-p="reduction_type"]').value = p.reduction_type || "new_price";
					return tr;
				}
				function readPrices() {
					return Array.from(pricesBody.querySelectorAll("tr"))
						.map((tr) => {
							const g = (k) => tr.querySelector(`[data-p="${k}"]`).value;
							return {
								kind: g("kind"),
								id_customer_group: parseInt(g("id_customer_group"), 10) || 0,
								min_qty: Number(g("min_qty")) || 1,
								reduction_type: g("reduction_type"),
								value: g("value") === "" ? null : Number(g("value")),
								priority: parseInt(g("priority"), 10) || 0,
								date_start: fromInputDatetime(g("date_start")),
								date_end: fromInputDatetime(g("date_end")),
							};
						})
						.filter((p) => p.value !== null);
				}
				document.getElementById("btn-add-price").addEventListener("click", () => pricesBody.appendChild(priceRow({})));

				const rewardsBody = document.getElementById("rewards-body");
				function rewardRow(r) {
					const tr = document.createElement("tr");
					tr.innerHTML = `
						<td><input class="form-control form-control-sm rounded-0" type="number" min="0" data-r="id_customer_group" value="${Number(r.id_customer_group || 0)}"></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="1" data-r="points" value="${esc(r.points ?? "")}"></td>
						<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button></td>`;
					return tr;
				}
				function readRewards() {
					return Array.from(rewardsBody.querySelectorAll("tr"))
						.map((tr) => ({ id_customer_group: parseInt(tr.querySelector('[data-r="id_customer_group"]').value, 10) || 0, points: parseInt(tr.querySelector('[data-r="points"]').value, 10) }))
						.filter((r) => Number.isInteger(r.points));
				}
				document.getElementById("btn-add-reward").addEventListener("click", () => rewardsBody.appendChild(rewardRow({})));
				form.addEventListener("click", (e) => {
					const del = e.target.closest(".js-row-del");
					if (del) {
						del.closest("tr, li").remove();
						dirty = true;
					}
				});

				// ═══ ЗАЛИШКИ ═══════════════════════════════════
				const stockBody = document.getElementById("stock-body");
				const locationsCache = {};
				async function locationsOf(idWarehouse) {
					if (!PERMS.locations) return [];
					if (!locationsCache[idWarehouse]) {
						locationsCache[idWarehouse] = api(`/api/catalog/products/warehouses/${idWarehouse}/locations/list/`)
							.then((r) => r.rows)
							.catch(() => []);
					}
					return locationsCache[idWarehouse];
				}
				async function renderStock(rows) {
					stockBody.innerHTML = "";
					for (const s of rows) {
						const tr = document.createElement("tr");
						tr.dataset.wh = s.id_warehouse;
						tr.dataset.orig = Number(s.on_hand);
						let html = `<td>${esc(s.code)} — ${esc(s.name)}${Number(s.is_sellable) ? "" : ` <span class="badge text-bg-light border"><%= i18n.__('catalog.products.stock.not_sellable') %></span>`}</td>`;
						html += `<td><input class="form-control form-control-sm rounded-0" type="number" step="0.001" data-s="on_hand" value="${Number(s.on_hand)}"></td>`;
						html += `<td class="text-end">${Number(s.reserved).toLocaleString()}</td><td class="text-end">${Number(s.incoming).toLocaleString()}</td><td class="text-end fw-semibold">${Number(s.available).toLocaleString()}</td>`;
						if (PERMS.locations) html += `<td><select class="form-select form-select-sm rounded-0" data-s="id_location"><option value=""></option></select></td>`;
						html += `<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.001" data-s="reorder_point" value="${s.reorder_point ?? ""}"></td>`;
						html += `<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.001" data-s="reorder_qty" value="${s.reorder_qty ?? ""}"></td>`;
						tr.innerHTML = html;
						stockBody.appendChild(tr);
						if (PERMS.locations) {
							const sel = tr.querySelector('[data-s="id_location"]');
							(await locationsOf(s.id_warehouse)).forEach((l) => sel.add(new Option(l.code + (l.name ? " — " + l.name : ""), l.id)));
							sel.value = s.id_location || "";
						}
						tr.querySelectorAll("[data-s]").forEach((el) => (el.disabled = !canWrite || !PERMS.stock));
					}
				}
				function readStock() {
					if (!PERMS.stock) return [];
					return Array.from(stockBody.querySelectorAll("tr")).map((tr) => {
						const g = (k) => {
							const el = tr.querySelector(`[data-s="${k}"]`);
							return el ? el.value : "";
						};
						const onHand = g("on_hand") === "" ? null : Number(g("on_hand"));
						return {
							id_warehouse: parseInt(tr.dataset.wh, 10),
							on_hand: onHand !== null && onHand !== Number(tr.dataset.orig) ? onHand : null,
							id_location: g("id_location") ? parseInt(g("id_location"), 10) : null,
							reorder_point: g("reorder_point") === "" ? null : Number(g("reorder_point")),
							reorder_qty: g("reorder_qty") === "" ? null : Number(g("reorder_qty")),
						};
					});
				}
				function applyTypeUi() {
					// Кнопки розділів — лише для збереженого типу (сторінки працюють зі збереженим товаром)
					const savedType = product && product.type;
					document.querySelectorAll(".js-type-link").forEach((a) => (a.style.display = a.dataset.type === savedType ? "" : "none"));
					const variable = form.querySelector('[name="type"]').value === "variable";
					document.getElementById("stock-variable-note").style.display = variable ? "" : "none";
					document.getElementById("stock-block").style.display = variable ? "none" : "";
				}
				form.querySelector('[name="type"]').addEventListener("change", applyTypeUi);

				// ═══ ФОТО ══════════════════════════════════════
				const mediaList = document.getElementById("media-list");
				let media = [];
				function renderMedia() {
					mediaList.innerHTML = "";
					media.forEach((m, i) => {
						const div = document.createElement("div");
						div.className = "pc-media-item" + (m.is_cover ? " cover" : "");
						div.dataset.index = i;
						let alts = "";
						LANGS.forEach((l) => (alts += `<input class="form-control form-control-sm rounded-0 mt-1" data-alt="${l}" placeholder="alt ${LANG_ISO[l]}" maxlength="255" value="${esc((m.alt || {})[l] || "")}" ${canWrite ? "" : "disabled"}>`));
						div.innerHTML = `
							<img src="${esc(m.url_medium)}" alt="">
							<div class="d-flex justify-content-between align-items-center mt-1">
								<div class="form-check mb-0"><input class="form-check-input js-cover" type="radio" name="_cover" ${m.is_cover ? "checked" : ""} ${canWrite ? "" : "disabled"}><label class="form-check-label small"><%= i18n.__('catalog.products.media.cover') %></label></div>
								<button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-media-del" ${canWrite ? "" : "disabled"}><i class="fa-solid fa-xmark"></i></button>
							</div>${alts}`;
						mediaList.appendChild(div);
					});
				}
				function syncAltsFromDom() {
					mediaList.querySelectorAll(".pc-media-item").forEach((div) => {
						const m = media[parseInt(div.dataset.index, 10)];
						div.querySelectorAll("[data-alt]").forEach((el) => ((m.alt = m.alt || {})[el.dataset.alt] = el.value));
					});
				}
				Sortable.create(mediaList, {
					animation: 150,
					filter: "input,button",
					preventOnFilter: false,
					onEnd: () => {
						syncAltsFromDom();
						media = Array.from(mediaList.children).map((div) => media[parseInt(div.dataset.index, 10)]);
						renderMedia();
						dirty = true;
					},
				});
				mediaList.addEventListener("click", (e) => {
					const div = e.target.closest(".pc-media-item");
					if (!div || !canWrite) return;
					syncAltsFromDom();
					const i = parseInt(div.dataset.index, 10);
					if (e.target.closest(".js-media-del")) {
						const wasCover = media[i].is_cover;
						media.splice(i, 1);
						if (wasCover && media[0]) media[0].is_cover = true;
					} else if (e.target.closest(".js-cover")) {
						media.forEach((m, k) => (m.is_cover = k === i));
					} else return;
					renderMedia();
					dirty = true;
				});
				document.getElementById("media-input").addEventListener("change", async (e) => {
					const input = e.target;
					const files = Array.from(input.files);
					input.disabled = true;
					syncAltsFromDom();
					for (const file of files) {
						try {
							const fd = new FormData();
							fd.append("file", file);
							const res = await fetch("/api/catalog/products/images/products/upload/", { method: "POST", credentials: "same-origin", headers: { Accept: "application/json" }, body: fd });
							const json = await res.json().catch(() => ({}));
							if (!res.ok || json.ok === false) throw json;
							if (media.some((m) => m.file === json.file)) continue;
							media.push({ id: null, file: json.file, url_medium: json.url, is_cover: media.length === 0, alt: {} });
							dirty = true;
						} catch (err) {
							notyf.error(file.name + ": " + errMsg(err));
						}
					}
					renderMedia();
					input.disabled = !canWrite;
					input.value = "";
				});
				function readMedia() {
					syncAltsFromDom();
					return media.map((m) => ({ id: m.id || null, file: m.file, is_cover: !!m.is_cover, alt: m.alt || {} }));
				}

				// ═══ КАТЕГОРІЇ ═════════════════════════════════
				const catTree = document.getElementById("cat-tree");
				let catRows = [];
				function renderCategories(selected, main) {
					const sel = new Set(selected.map(Number));
					const build = (parent) => {
						const kids = catRows.filter((c) => (c.id_parent || null) === parent);
						if (!kids.length) return "";
						return (
							"<ul>" +
							kids
								.map(
									(c) => `<li data-name="${esc(String(c.name).toLowerCase())}">
										<div class="d-flex align-items-center gap-2 py-1">
											<input class="form-check-input mt-0 js-cat" type="checkbox" value="${c.id}" ${sel.has(c.id) ? "checked" : ""}>
											<span class="${c.status ? "" : "text-decoration-line-through text-muted"}">${esc(c.name)}</span>
											<label class="small text-muted ms-2"><input class="form-check-input mt-0 js-cat-main" type="radio" name="_main" value="${c.id}" ${main === c.id ? "checked" : ""} ${sel.has(c.id) ? "" : "disabled"}> <%= i18n.__('catalog.products.categories.main') %></label>
										</div>${build(c.id)}</li>`
								)
								.join("") +
							"</ul>"
						);
					};
					catTree.innerHTML = build(null) || `<div class="text-muted"><%= i18n.__('catalog.products.categories.empty') %></div>`;
				}
				catTree.addEventListener("change", (e) => {
					const cb = e.target.closest(".js-cat");
					if (!cb) return;
					const radio = cb.closest("div").querySelector(".js-cat-main");
					radio.disabled = !cb.checked;
					if (!cb.checked && radio.checked) radio.checked = false;
					if (cb.checked && !catTree.querySelector(".js-cat-main:checked")) radio.checked = true;
				});
				document.getElementById("cat-search").addEventListener("input", (e) => {
					const q = e.target.value.trim().toLowerCase();
					catTree.querySelectorAll("li").forEach((li) => (li.style.display = !q || li.dataset.name.includes(q) || li.querySelector(`li[data-name*="${CSS.escape(q)}"]`) ? "" : "none"));
				});
				const readCategories = () => Array.from(catTree.querySelectorAll(".js-cat:checked")).map((cb) => parseInt(cb.value, 10));
				function readMainCategory() {
					const r = catTree.querySelector(".js-cat-main:checked");
					return r ? parseInt(r.value, 10) : null;
				}

				// ═══ ХАРАКТЕРИСТИКИ ════════════════════════════
				const attrList = document.getElementById("attr-list");
				const attrAddSelect = document.getElementById("attr-add-select");
				let dict = { groups: [], attributes: [], values: [] };
				const attrById = () => new Map(dict.attributes.map((a) => [a.id, a]));
				const valuesOf = (idAttribute) => dict.values.filter((v) => v.id_attribute === idAttribute);

				function attrInput(a, val) {
					const v = val || { value_ids: [], number: null, date: null, text: {} };
					if (a.type === "select" || a.type === "color") {
						return `<select class="form-select form-select-sm rounded-0" data-a="value"><option value=""></option>${valuesOf(a.id)
							.map((x) => `<option value="${x.id}" ${v.value_ids.includes(x.id) ? "selected" : ""}>${esc(x.name)}${x.color_hex ? " ■" : ""}</option>`)
							.join("")}</select>`;
					}
					if (a.type === "multiselect") {
						return `<select class="form-select form-select-sm rounded-0" data-a="values" multiple size="${Math.min(valuesOf(a.id).length || 1, 6)}">${valuesOf(a.id)
							.map((x) => `<option value="${x.id}" ${v.value_ids.includes(x.id) ? "selected" : ""}>${esc(x.name)}</option>`)
							.join("")}</select>`;
					}
					if (a.type === "integer" || a.type === "decimal") {
						return `<div class="input-group input-group-sm"><input class="form-control rounded-0" type="number" step="${a.type === "integer" ? 1 : "any"}" data-a="number" value="${v.number ?? ""}">${a.unit ? `<span class="input-group-text rounded-0">${esc(a.unit)}</span>` : ""}</div>`;
					}
					if (a.type === "boolean") {
						return `<select class="form-select form-select-sm rounded-0" data-a="bool"><option value=""></option><option value="1" ${v.number === 1 ? "selected" : ""}><%= i18n.__('catalog.common.yes') %></option><option value="0" ${v.number === 0 ? "selected" : ""}><%= i18n.__('catalog.common.no') %></option></select>`;
					}
					if (a.type === "date") return `<input class="form-control form-control-sm rounded-0" type="date" data-a="date" value="${esc(v.date ? String(v.date).slice(0, 10) : "")}">`;
					const text = { ...(v.text || {}) };
					if (text[0] && !text[PRIMARY_LANG]) text[PRIMARY_LANG] = text[0];
					return LANGS.map((l) =>
						a.type === "textarea"
							? `<textarea class="form-control form-control-sm rounded-0 mb-1" data-a="text" data-lang="${l}" rows="2" placeholder="${LANG_ISO[l]}">${esc(text[l] || "")}</textarea>`
							: `<input class="form-control form-control-sm rounded-0 mb-1" data-a="text" data-lang="${l}" placeholder="${LANG_ISO[l]}" value="${esc(text[l] || "")}">`
					).join("");
				}
				function addAttributeRow(idAttribute, val) {
					const a = attrById().get(idAttribute);
					if (!a || attrList.querySelector(`[data-attr="${idAttribute}"]`)) return;
					const div = document.createElement("div");
					div.className = "row g-2 align-items-start pc-attr-row";
					div.dataset.attr = idAttribute;
					div.innerHTML = `
						<div class="col-md-4"><strong>${esc(a.name)}</strong>${Number(a.is_required) ? ' <span class="text-danger">*</span>' : ""}
							<div class="small text-muted">${esc(a.group_name || "")}${a.unit ? " · " + esc(a.unit) : ""}</div></div>
						<div class="col-md-7">${attrInput(a, val)}</div>
						<div class="col-md-1 text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-attr-del"><i class="fa-solid fa-xmark"></i></button></div>`;
					attrList.appendChild(div);
					refreshAttrSelect();
				}
				function refreshAttrSelect() {
					const used = new Set(Array.from(attrList.children).map((d) => parseInt(d.dataset.attr, 10)));
					attrAddSelect.innerHTML = "";
					dict.attributes.filter((a) => !used.has(a.id)).forEach((a) => attrAddSelect.add(new Option((a.group_name ? a.group_name + " → " : "") + a.name, a.id)));
				}
				attrList.addEventListener("click", (e) => {
					if (e.target.closest(".js-attr-del")) {
						e.target.closest(".pc-attr-row").remove();
						refreshAttrSelect();
						dirty = true;
					}
				});
				document.getElementById("btn-add-attr").addEventListener("click", () => {
					const id = parseInt(attrAddSelect.value, 10);
					if (id) addAttributeRow(id);
				});
				async function applySet(idSet) {
					if (!idSet) return;
					const r = await api(`/api/catalog/products/attributes/sets/${idSet}/get/`).catch(() => null);
					if (r) r.row.items.forEach((it) => addAttributeRow(it.id_attribute));
				}
				document.getElementById("btn-apply-set").addEventListener("click", () => applySet(parseInt(form.querySelector('[name="id_attribute_set"]').value, 10)));
				function readAttributes() {
					return Array.from(attrList.children).map((div) => {
						const out = { id_attribute: parseInt(div.dataset.attr, 10), value_ids: [], number: null, date: null, text: {} };
						const one = div.querySelector('[data-a="value"]');
						if (one && one.value) out.value_ids = [parseInt(one.value, 10)];
						const many = div.querySelector('[data-a="values"]');
						if (many) out.value_ids = Array.from(many.selectedOptions).map((o) => parseInt(o.value, 10));
						const num = div.querySelector('[data-a="number"]');
						if (num && num.value !== "") out.number = Number(num.value);
						const bool = div.querySelector('[data-a="bool"]');
						if (bool && bool.value !== "") out.number = Number(bool.value);
						const date = div.querySelector('[data-a="date"]');
						if (date && date.value) out.date = date.value;
						div.querySelectorAll('[data-a="text"]').forEach((el) => (out.text[el.dataset.lang] = el.value));
						if (Object.keys(out.text).length) out.text[0] = out.text[PRIMARY_LANG] || "";
						return out;
					});
				}

				// ═══ ОПЦІЇ ═════════════════════════════════════
				const optList = document.getElementById("opt-list");
				const optAddSelect = document.getElementById("opt-add-select");
				let optDict = { options: [], values: [] };
				const optById = () => new Map(optDict.options.map((o) => [o.id, o]));
				const optValuesOf = (idOption) => optDict.values.filter((v) => v.id_option === idOption);
				const OPT_TYPES = {
					select: "<%= i18n.__('catalog.options.types.select') %>",
					radio: "<%= i18n.__('catalog.options.types.radio') %>",
					checkbox: "<%= i18n.__('catalog.options.types.checkbox') %>",
					color: "<%= i18n.__('catalog.options.types.color') %>",
					text: "<%= i18n.__('catalog.options.types.text') %>",
					textarea: "<%= i18n.__('catalog.options.types.textarea') %>",
					number: "<%= i18n.__('catalog.options.types.number') %>",
					file: "<%= i18n.__('catalog.options.types.file') %>",
					date: "<%= i18n.__('catalog.options.types.date') %>",
					time: "<%= i18n.__('catalog.options.types.time') %>",
					datetime: "<%= i18n.__('catalog.options.types.datetime') %>",
				};

				function optValueRow(o, v) {
					const value = optValuesOf(o.id).find((x) => x.id === v.id_option_value) || { name: "#" + v.id_option_value };
					const tr = document.createElement("tr");
					tr.dataset.value = v.id_option_value;
					tr.innerHTML = `
						<td>${value.color_hex ? `<span style="display:inline-block;width:12px;height:12px;background:${esc(value.color_hex)};border:1px solid #ccc"></span> ` : ""}${esc(value.name)}</td>
						<td><select class="form-select form-select-sm rounded-0" data-ov="price_mode"><option value="fixed">±</option><option value="percent">%</option></select></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" step="0.0001" data-ov="price" value="${Number(v.price || 0)}" style="width:110px"></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" step="1" data-ov="points" value="${Number(v.points || 0)}" style="width:80px"></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" step="0.0001" data-ov="weight" value="${Number(v.weight || 0)}" style="width:90px"></td>
						<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.001" data-ov="quantity" value="${v.quantity ?? ""}" style="width:90px"></td>
						<td class="text-center"><input class="form-check-input" type="checkbox" data-ov="subtract_stock" ${Number(v.subtract_stock) ? "checked" : ""}></td>
						<td><input class="form-control form-control-sm rounded-0" data-ov="sku_suffix" maxlength="32" value="${esc(v.sku_suffix || "")}" style="width:100px"></td>
						<td class="text-center"><input class="form-check-input" type="${o.type === "checkbox" ? "checkbox" : "radio"}" name="_ovdef_${o.id}" data-ov="is_default" ${Number(v.is_default) ? "checked" : ""}></td>
						<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button></td>`;
					tr.querySelector('[data-ov="price_mode"]').value = v.price_mode || "fixed";
					return tr;
				}
				function addOptionBlock(idOption, data) {
					const o = optById().get(idOption);
					if (!o || optList.querySelector(`[data-opt="${idOption}"]`)) return;
					const d = data || { is_required: false, default_value: null, values: [] };
					const isValueType = VALUE_OPTION_TYPES.includes(o.type);
					const div = document.createElement("div");
					div.className = "pc-opt";
					div.dataset.opt = idOption;
					div.innerHTML = `
						<div class="pc-opt-head d-flex flex-wrap align-items-center gap-3">
							<strong class="me-auto">${esc(o.name)} <span class="text-muted small">${esc(OPT_TYPES[o.type] || o.type)}</span></strong>
							<div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" data-o="is_required" ${Number(d.is_required) ? "checked" : ""}><label class="form-check-label small"><%= i18n.__('catalog.products.opt.required') %></label></div>
							${isValueType ? "" : `<input class="form-control form-control-sm rounded-0" data-o="default_value" maxlength="255" placeholder="<%= i18n.__('catalog.products.opt.default_value') %>" value="${esc(d.default_value || "")}" style="max-width:240px">`}
							<button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-opt-del"><i class="fa-solid fa-xmark"></i></button>
						</div>
						${
							isValueType
								? `<div class="p-2">
									<div class="d-flex gap-2 mb-2">
										<select class="form-select form-select-sm rounded-0 js-ov-select" style="max-width:300px"></select>
										<button type="button" class="btn btn-sm btn-outline-secondary rounded-0 js-ov-add"><i class="fa-solid fa-plus"></i> <%= i18n.__('catalog.products.opt.add_value') %></button>
										<button type="button" class="btn btn-sm btn-outline-secondary rounded-0 js-ov-all"><%= i18n.__('catalog.products.opt.add_all') %></button>
									</div>
									<div class="table-responsive"><table class="table table-sm mb-0">
										<thead><tr>
											<th><%= i18n.__('catalog.products.opt.value') %></th><th></th><th><%= i18n.__('catalog.products.opt.price') %></th><th><%= i18n.__('catalog.products.opt.points') %></th>
											<th><%= i18n.__('catalog.products.opt.weight') %></th><th><%= i18n.__('catalog.products.opt.quantity') %></th><th><%= i18n.__('catalog.products.opt.subtract') %></th>
											<th><%= i18n.__('catalog.products.opt.sku_suffix') %></th><th><%= i18n.__('catalog.products.opt.is_default') %></th><th></th>
										</tr></thead>
										<tbody class="js-ov-body"></tbody>
									</table></div>
								</div>`
								: ""
						}`;
					optList.appendChild(div);
					if (isValueType) {
						const body = div.querySelector(".js-ov-body");
						(d.values || []).forEach((v) => body.appendChild(optValueRow(o, v)));
						refreshOptValueSelect(div);
					}
					refreshOptSelect();
				}
				function refreshOptValueSelect(div) {
					const o = optById().get(parseInt(div.dataset.opt, 10));
					const used = new Set(Array.from(div.querySelectorAll(".js-ov-body tr")).map((tr) => parseInt(tr.dataset.value, 10)));
					const sel = div.querySelector(".js-ov-select");
					sel.innerHTML = "";
					optValuesOf(o.id).filter((v) => !used.has(v.id)).forEach((v) => sel.add(new Option(v.name, v.id)));
				}
				function refreshOptSelect() {
					const used = new Set(Array.from(optList.children).map((d) => parseInt(d.dataset.opt, 10)));
					optAddSelect.innerHTML = "";
					optDict.options.filter((o) => !used.has(o.id)).forEach((o) => optAddSelect.add(new Option(`${o.name} (${OPT_TYPES[o.type] || o.type})`, o.id)));
				}
				optList.addEventListener("click", (e) => {
					const block = e.target.closest(".pc-opt");
					if (!block) return;
					const o = optById().get(parseInt(block.dataset.opt, 10));
					if (e.target.closest(".js-opt-del")) {
						block.remove();
						refreshOptSelect();
						dirty = true;
						return;
					}
					const body = block.querySelector(".js-ov-body");
					if (e.target.closest(".js-ov-add")) {
						const id = parseInt(block.querySelector(".js-ov-select").value, 10);
						if (id) body.appendChild(optValueRow(o, { id_option_value: id }));
					} else if (e.target.closest(".js-ov-all")) {
						const used = new Set(Array.from(body.querySelectorAll("tr")).map((tr) => parseInt(tr.dataset.value, 10)));
						optValuesOf(o.id).filter((v) => !used.has(v.id)).forEach((v) => body.appendChild(optValueRow(o, { id_option_value: v.id })));
					} else if (!e.target.closest(".js-row-del")) return;
					setTimeout(() => refreshOptValueSelect(block));
					dirty = true;
				});
				document.getElementById("btn-add-opt").addEventListener("click", () => {
					const id = parseInt(optAddSelect.value, 10);
					if (id) addOptionBlock(id);
					dirty = true;
				});
				function readOptions() {
					return Array.from(optList.children).map((div) => {
						const req = div.querySelector('[data-o="is_required"]');
						const def = div.querySelector('[data-o="default_value"]');
						return {
							id_option: parseInt(div.dataset.opt, 10),
							is_required: req.checked,
							default_value: def && def.value.trim() ? def.value.trim() : null,
							values: Array.from(div.querySelectorAll(".js-ov-body tr")).map((tr) => {
								const g = (k) => tr.querySelector(`[data-ov="${k}"]`);
								return {
									id_option_value: parseInt(tr.dataset.value, 10),
									price_mode: g("price_mode").value,
									price: Number(g("price").value || 0),
									points: parseInt(g("points").value, 10) || 0,
									weight: Number(g("weight").value || 0),
									quantity: g("quantity").value === "" ? null : Number(g("quantity").value),
									subtract_stock: g("subtract_stock").checked,
									sku_suffix: g("sku_suffix").value.trim() || null,
									is_default: g("is_default").checked,
								};
							}),
						};
					});
				}

				// ═══ ПЕРСОНАЛІЗАЦІЯ ════════════════════════════
				const customBody = document.getElementById("custom-body");
				function customRow(c) {
					const tr = document.createElement("tr");
					tr.dataset.id = c.id || "";
					let html = `<td><select class="form-select form-select-sm rounded-0" data-c="type"><option value="text"><%= i18n.__('catalog.products.custom.types.text') %></option><option value="file"><%= i18n.__('catalog.products.custom.types.file') %></option></select></td>`;
					LANGS.forEach((l) => (html += `<td><input class="form-control form-control-sm rounded-0" data-c="label" data-lang="${l}" maxlength="255" value="${esc(((c.labels || {})[l] || {}).label || "")}"></td>`));
					html += `<td><input class="form-control form-control-sm rounded-0" type="number" min="1" max="65535" data-c="max_length" value="${c.max_length ?? ""}" style="width:90px"></td>`;
					html += `<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.0001" data-c="price" value="${Number(c.price || 0)}" style="width:110px"></td>`;
					html += `<td class="text-center"><input class="form-check-input" type="checkbox" data-c="is_required" ${Number(c.is_required) ? "checked" : ""}></td>`;
					html += `<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button></td>`;
					tr.innerHTML = html;
					tr.querySelector('[data-c="type"]').value = c.type || "text";
					return tr;
				}
				document.getElementById("btn-add-custom").addEventListener("click", () => {
					customBody.appendChild(customRow({}));
					dirty = true;
				});
				function readCustomization() {
					return Array.from(customBody.querySelectorAll("tr")).map((tr) => {
						const labels = {};
						tr.querySelectorAll('[data-c="label"]').forEach((el) => (labels[el.dataset.lang] = { label: el.value }));
						const max = tr.querySelector('[data-c="max_length"]').value;
						return {
							id: tr.dataset.id ? parseInt(tr.dataset.id, 10) : null,
							type: tr.querySelector('[data-c="type"]').value,
							max_length: max === "" ? null : parseInt(max, 10),
							price: Number(tr.querySelector('[data-c="price"]').value || 0),
							is_required: tr.querySelector('[data-c="is_required"]').checked,
							labels,
						};
					});
				}

				// ═══ ПОВ’ЯЗАНІ ═════════════════════════════════
				const relatedList = document.getElementById("related-list");
				const RELATED_TYPES = {
					related: "<%= i18n.__('catalog.products.related.types.related') %>",
					upsell: "<%= i18n.__('catalog.products.related.types.upsell') %>",
					crosssell: "<%= i18n.__('catalog.products.related.types.crosssell') %>",
					accessory: "<%= i18n.__('catalog.products.related.types.accessory') %>",
				};
				let relatedFound = [];
				function relatedItem(r) {
					const li = document.createElement("li");
					li.className = "list-group-item d-flex align-items-center gap-2 rounded-0";
					li.dataset.id = r.id_related;
					li.dataset.type = r.type;
					li.innerHTML = `<span class="badge text-bg-light border">${esc(RELATED_TYPES[r.type])}</span><a class="flex-grow-1" href="/catalog/products/${r.id_related}/" target="_blank">${esc(r.name)}</a><span class="text-muted small">${esc(r.sku || "")}</span><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button>`;
					return li;
				}
				let relTimer;
				document.getElementById("related-search").addEventListener("input", (e) => {
					clearTimeout(relTimer);
					relTimer = setTimeout(async () => {
						const r = await api("/api/catalog/products/search/", { search: e.target.value.trim(), exclude: PRODUCT_ID || 0 }).catch(() => ({ rows: [] }));
						relatedFound = r.rows;
						document.getElementById("related-options").innerHTML = r.rows.map((p) => `<option value="${esc(p.name)} [#${p.id}]"></option>`).join("");
					}, 300);
				});
				document.getElementById("btn-add-related").addEventListener("click", () => {
					const input = document.getElementById("related-search");
					const m = input.value.match(/\[#(\d+)\]$/);
					const p = m && relatedFound.find((x) => x.id === parseInt(m[1], 10));
					if (!p) return;
					const type = document.getElementById("related-type").value;
					if (relatedList.querySelector(`[data-id="${p.id}"][data-type="${type}"]`)) return;
					relatedList.appendChild(relatedItem({ id_related: p.id, type, name: p.name, sku: p.sku }));
					input.value = "";
					dirty = true;
				});
				Sortable.create(relatedList, { animation: 150 });
				const readRelated = () => Array.from(relatedList.children).map((li) => ({ id_related: parseInt(li.dataset.id, 10), type: li.dataset.type }));

				// ═══ ПОСТАЧАЛЬНИКИ ═════════════════════════════
				const suppliersBody = document.getElementById("suppliers-body");
				const supplierSelect = document.getElementById("supplier-select");
				async function loadSupplierOptions(search) {
					const r = await api("/api/catalog/products/suppliers/options/", { search }).catch(() => ({ rows: [] }));
					supplierSelect.innerHTML = "";
					r.rows.forEach((s) => supplierSelect.add(new Option(s.name + (s.code ? ` (${s.code})` : ""), s.id)));
				}
				let supTimer;
				document.getElementById("supplier-search").addEventListener("input", (e) => {
					clearTimeout(supTimer);
					supTimer = setTimeout(() => loadSupplierOptions(e.target.value.trim()), 300);
				});
				function supplierRow(s) {
					const tr = document.createElement("tr");
					tr.dataset.id = s.id_supplier;
					tr.innerHTML =
						`<td>${esc(s.name)}</td>` +
						`<td><input class="form-control form-control-sm rounded-0" data-sp="supplier_sku" maxlength="64" value="${esc(s.supplier_sku || "")}"></td>` +
						(PERMS.cost
							? `<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.0001" data-sp="supplier_price" value="${s.supplier_price ?? ""}"></td>
							   <td><input class="form-control form-control-sm rounded-0 text-uppercase" data-sp="currency" maxlength="3" value="${esc(s.currency || "")}" style="width:70px"></td>`
							: "") +
						`<td><input class="form-control form-control-sm rounded-0" type="number" min="0" data-sp="lead_time_days" value="${s.lead_time_days ?? ""}" style="width:90px"></td>` +
						`<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.001" data-sp="min_order_qty" value="${s.min_order_qty ?? ""}" style="width:100px"></td>` +
						`<td class="text-center"><input class="form-check-input" type="radio" name="_sup_default" data-sp="is_default" ${Number(s.is_default) ? "checked" : ""}></td>` +
						`<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button></td>`;
					return tr;
				}
				document.getElementById("btn-add-supplier").addEventListener("click", () => {
					const id = parseInt(supplierSelect.value, 10);
					if (!id || suppliersBody.querySelector(`[data-id="${id}"]`)) return;
					suppliersBody.appendChild(supplierRow({ id_supplier: id, name: supplierSelect.selectedOptions[0].text }));
					dirty = true;
				});
				function readSuppliers() {
					return Array.from(suppliersBody.querySelectorAll("tr")).map((tr) => {
						const g = (k) => {
							const el = tr.querySelector(`[data-sp="${k}"]`);
							return el ? el.value.trim() : "";
						};
						const out = {
							id_supplier: parseInt(tr.dataset.id, 10),
							supplier_sku: g("supplier_sku") || null,
							lead_time_days: g("lead_time_days") === "" ? null : parseInt(g("lead_time_days"), 10),
							min_order_qty: g("min_order_qty") === "" ? null : Number(g("min_order_qty")),
							is_default: tr.querySelector('[data-sp="is_default"]').checked,
						};
						if (PERMS.cost) {
							out.supplier_price = g("supplier_price") === "" ? null : Number(g("supplier_price"));
							out.currency = g("currency") ? g("currency").toUpperCase() : null;
						}
						return out;
					});
				}

				// ═══ ЗАВАНТАЖЕННЯ / ЗАПОВНЕННЯ ═════════════════
				async function loadDictionaries() {
					const [cats, attrs, setsRes, opts] = await Promise.all([
						api("/api/catalog/products/categories/tree/").catch(() => ({ rows: [] })),
						api("/api/catalog/products/attributes/dictionary/").catch(() => ({ groups: [], attributes: [], values: [] })),
						api("/api/catalog/products/attributes/sets/list/").catch(() => ({ rows: [] })),
						api("/api/catalog/products/options/dictionary/").catch(() => ({ options: [], values: [] })),
					]);
					catRows = cats.rows;
					dict = attrs;
					optDict = opts;
					const setSelect = form.querySelector('[name="id_attribute_set"]');
					setsRes.rows.forEach((s) => setSelect.add(new Option(s.name, s.id)));
					loadSupplierOptions("");
				}

				function fillAll(p) {
					product = p;
					clearErrors();
					fillCore(p);
					fillDescriptions(p.descriptions);
					document.getElementById("slug-shared").checked = Number(p.slug_shared) === 1;
					applySlugShared();
					pricesBody.innerHTML = "";
					(p.prices || []).forEach((x) => pricesBody.appendChild(priceRow(x)));
					rewardsBody.innerHTML = "";
					(p.rewards || []).forEach((x) => rewardsBody.appendChild(rewardRow(x)));
					renderStock(p.stock || []);
					media = (p.media || []).filter((m) => m.type === "image").map((m) => ({ ...m, alt: { ...(m.alt || {}) } }));
					renderMedia();
					renderCategories(p.categories || [], p.id_category_main || null);
					attrList.innerHTML = "";
					(p.attributes || []).forEach((a) => addAttributeRow(a.id_attribute, a));
					refreshAttrSelect();
					optList.innerHTML = "";
					(p.options || []).forEach((o) => addOptionBlock(o.id_option, o));
					refreshOptSelect();
					customBody.innerHTML = "";
					(p.customization || []).forEach((c) => customBody.appendChild(customRow(c)));
					relatedList.innerHTML = "";
					(p.related || []).forEach((r) => relatedList.appendChild(relatedItem(r)));
					suppliersBody.innerHTML = "";
					(p.suppliers || []).forEach((s) => suppliersBody.appendChild(supplierRow(s)));
					loadBrands("", p.id_brand).catch(() => {});
					applyTypeUi();

					const name = ((p.descriptions || {})[PRIMARY_LANG] || {}).name || (PRODUCT_ID ? "#" + PRODUCT_ID : "");
					document.getElementById("pc-title").textContent = name || "<%= i18n.__('catalog.products.add') %>";
					document.getElementById("bc-title").textContent = name || "<%= i18n.__('catalog.products.add') %>";
					document.getElementById("pc-version").textContent = p.version ? "v" + p.version : "";
					document.getElementById("pc-meta").textContent = p.id ? `ID ${p.id} · UUID ${p.uuid} · <%= i18n.__('catalog.products.f.date_add') %>: ${p.date_add} · <%= i18n.__('catalog.products.f.date_edit') %>: ${p.date_edit}` : "";
					setReadOnly(!canWrite);
					dirty = false;
				}

				async function loadProduct() {
					const r = await api(`/api/catalog/products/${PRODUCT_ID}/get/`);
					fillAll(r.row);
				}

				// ═══ РЕЖИМ ЧИТАННЯ ═════════════════════════════
				function setReadOnly(on) {
					canWrite = !on && (PRODUCT_ID ? PERMS.edit : PERMS.add);
					document.body.classList.toggle("pc-readonly", !canWrite);
					form.querySelectorAll("input, select, textarea, button").forEach((el) => {
						if (el.closest(".nav")) return;
						if (el.id === "cat-search") return;
						el.disabled = !canWrite || (!!el.dataset.s && !PERMS.stock);
					});
					const save = document.getElementById("btn-save");
					if (save) save.disabled = !canWrite;
				}

				// ═══ ЖИВЕ БЛОКУВАННЯ ═══════════════════════════
				const lockToken = crypto.randomUUID();
				let haveLock = false;
				let heartbeatTimer = null;
				const lockBanner = document.getElementById("lock-banner");
				const savedBanner = document.getElementById("saved-banner");
				const show = (el, on) => (el.style.display = on ? "flex" : "none");

				function showHolder(holder) {
					if (!holder || haveLock) return show(lockBanner, false);
					const since = holder.since ? new Date(String(holder.since).replace(" ", "T")).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) : "";
					document.getElementById("lock-text").textContent = "<%= i18n.__('catalog.products.lock.editing') %> " + (holder.user_name || "#" + holder.id_user) + (since ? " <%= i18n.__('catalog.products.lock.since') %> " + since : "");
					show(lockBanner, true);
				}
				function emitAck(event, payload) {
					return new Promise((resolve) => {
						const t = setTimeout(() => resolve({ ok: false, error: "timeout" }), 8000);
						socket.emit(event, payload, (r) => {
							clearTimeout(t);
							resolve(r || { ok: false });
						});
					});
				}
				async function acquireLock(force) {
					if (!PERMS.edit) {
						setReadOnly(true);
						return false;
					}
					const r = await emitAck("product:lock", { id: PRODUCT_ID, token: lockToken, force: !!force });
					haveLock = r.ok === true;
					if (haveLock) {
						show(lockBanner, false);
						setReadOnly(false);
						clearInterval(heartbeatTimer);
						heartbeatTimer = setInterval(async () => {
							const hb = await emitAck("product:heartbeat", { id: PRODUCT_ID, token: lockToken });
							if (!hb.ok) lostLock();
						}, HEARTBEAT_MS);
					} else {
						setReadOnly(true);
						if (r.holder) showHolder(r.holder);
					}
					return haveLock;
				}
				function lostLock() {
					if (!haveLock) return;
					haveLock = false;
					clearInterval(heartbeatTimer);
					setReadOnly(true);
					notyf.error("<%= i18n.__('catalog.products.lock.lost') %>");
					emitAck("product:watch", { id: PRODUCT_ID }).then((r) => r.ok && showHolder(r.holder));
				}

				if (PRODUCT_ID) {
					socket.on("product:lock:state", (d) => d.id === PRODUCT_ID && !haveLock && showHolder(d.holder));
					socket.on("product:lock:lost", (d) => d.id === PRODUCT_ID && lostLock());
					socket.on("product:saved", (d) => {
						if (d.id !== PRODUCT_ID || (haveLock && d.by === ME)) return;
						if (!haveLock) show(savedBanner, true);
					});
					socket.on("product:deleted", (d) => {
						if (d.id !== PRODUCT_ID) return;
						notyf.error("<%= i18n.__('catalog.products.deleted_by_other') %>");
						setTimeout(() => (window.location.href = "/catalog/products/"), 1500);
					});
					socket.on("connect", () => {
						if (haveLock) {
							haveLock = false;
							acquireLock(false);
						} else emitAck("product:watch", { id: PRODUCT_ID }).then((r) => r.ok && showHolder(r.holder));
					});
					window.addEventListener("pagehide", () => haveLock && socket.emit("product:unlock", { id: PRODUCT_ID, token: lockToken }));
				}

				const takeover = document.getElementById("btn-takeover");
				if (takeover)
					takeover.addEventListener("click", async () => {
						if (!confirm("<%= i18n.__('catalog.products.lock.confirm_takeover') %>")) return;
						await loadProduct();
						if (await acquireLock(true)) notyf.success("<%= i18n.__('catalog.products.lock.taken') %>");
					});
				document.getElementById("btn-reload").addEventListener("click", async () => {
					show(savedBanner, false);
					await loadProduct().catch((err) => notyf.error(errMsg(err)));
				});

				// ═══ ЗБЕРЕЖЕННЯ ════════════════════════════════
				form.addEventListener("submit", async (e) => {
					e.preventDefault();
					if (!canWrite) return;
					clearErrors();
					const btn = document.getElementById("btn-save");
					btn.disabled = true;
					try {
						const data = readCore();
						data.id_category_main = readMainCategory();
						const payload = {
							id: PRODUCT_ID,
							version: product ? product.version : null,
							lock_token: PRODUCT_ID ? lockToken : null,
							data,
							descriptions: readDescriptions(),
							slug_shared: document.getElementById("slug-shared").checked,
							categories: readCategories(),
							media: readMedia(),
							attributes: readAttributes(),
							options: readOptions(),
							customization: readCustomization(),
							stock: data.type === "variable" ? [] : readStock(),
							prices: readPrices(),
							rewards: readRewards(),
							related: readRelated(),
							suppliers: readSuppliers(),
						};
						const r = await api("/api/catalog/products/save/", payload);
						notyf.success("<%= i18n.__('catalog.common.saved') %>");
						dirty = false;
						if (!PRODUCT_ID) return (window.location.href = `/catalog/products/${r.id}/`);
						await loadProduct();
					} catch (err) {
						if (err.code === "version_conflict") {
							if (confirm("<%= i18n.__('catalog.products.lock.version_conflict') %>")) await loadProduct();
						} else if (err.code === "lock_lost" || err.code === "lock_required") {
							lostLock();
						} else {
							showErrors(err.errors);
							notyf.error(errMsg(err));
						}
					} finally {
						btn.disabled = !canWrite;
					}
				});

				window.addEventListener("beforeunload", (e) => {
					if (dirty && canWrite) {
						e.preventDefault();
						e.returnValue = "";
					}
				});

				// ═══ КОПІЮВАННЯ / ВИДАЛЕННЯ ════════════════════
				const copyBtn = document.getElementById("btn-copy");
				if (copyBtn)
					copyBtn.addEventListener("click", async () => {
						if (dirty && !confirm("<%= i18n.__('catalog.products.unsaved_copy') %>")) return;
						try {
							const r = await api(`/api/catalog/products/${PRODUCT_ID}/copy/`);
							notyf.success("<%= i18n.__('catalog.products.copied') %>");
							dirty = false;
							window.location.href = `/catalog/products/${r.id}/`;
						} catch (err) {
							notyf.error(errMsg(err));
						}
					});
				const delBtn = document.getElementById("btn-delete");
				if (delBtn)
					delBtn.addEventListener("click", async () => {
						const name = ((product.descriptions || {})[PRIMARY_LANG] || {}).name || "#" + PRODUCT_ID;
						if (!confirm("<%= i18n.__('catalog.products.confirm_delete') %>".replace("%s", name))) return;
						try {
							await api(`/api/catalog/products/${PRODUCT_ID}/delete/`);
							dirty = false;
							if (haveLock) socket.emit("product:unlock", { id: PRODUCT_ID, token: lockToken });
							window.location.href = "/catalog/products/";
						} catch (err) {
							notyf.error(errMsg(err));
						}
					});

				// ═══ СТАРТ ═════════════════════════════════════
				(async () => {
					try {
						await loadDictionaries();
						if (PRODUCT_ID) {
							setReadOnly(true);
							await loadProduct();
							const w = await emitAck("product:watch", { id: PRODUCT_ID });
							if (w.ok && w.holder && w.holder.id_user !== ME) showHolder(w.holder);
							else await acquireLock(false);
						} else {
							fillAll({ status: DEFAULT_STATUS, id_attribute_set: DEFAULT_SET, descriptions: {}, stock: [], media: [], categories: [], attributes: [], options: [], customization: [], prices: [], rewards: [], related: [], suppliers: [] });
							form.querySelector('[name="id_attribute_set"]').value = DEFAULT_SET || "";
							if (DEFAULT_SET) await applySet(DEFAULT_SET);
						}
					} catch (err) {
						notyf.error(errMsg(err));
					}
				})();
			})();
		</script>
	</body>
</html>