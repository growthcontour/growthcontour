									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="max_qty">
									<label class="form-label"><%= i18n.__('catalog.products.f.max_qty') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.001" name="max_qty" data-type="number" value="<%= (product.max_qty ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="qty_step">
									<label class="form-label"><%= i18n.__('catalog.products.f.qty_step') %></label>
									<input class="form-control rounded-0" type="number" min="0.001" step="0.001" name="qty_step" data-type="number0" value="<%= (product.qty_step ?? 1) %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="low_stock_threshold">
									<label class="form-label"><%= i18n.__('catalog.products.f.low_stock_threshold') %></label>
