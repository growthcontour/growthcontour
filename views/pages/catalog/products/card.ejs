									<div class="invalid-feedback"></div>
								</div>
							</div>
						</div>

						<!-- ═══ ПОВ’ЯЗАНІ ТА ПОСТАЧАЛЬНИКИ ═══ -->
						<div class="tab-pane fade" id="t-links">
							<div data-field="related" class="mb-4">
								<strong class="d-block mb-2"><%= i18n.__('catalog.products.related.title') %></strong>
								<div class="d-flex gap-2 mb-2">
									<input type="search" class="form-control rounded-0" id="related-search" placeholder="<%= i18n.__('catalog.products.related.search') %>" style="max-width: 360px" list="related-options" />
									<datalist id="related-options"></datalist>
									<select class="form-select rounded-0" id="related-type" style="max-width: 200px">
										<% ['related', 'upsell', 'crosssell', 'accessory'].forEach((t) => { %><option value="<%= t %>"><%= i18n.__('catalog.products.related.types.' + t) %></option><% }) %>
									</select>
