												<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.0001" data-sp="supplier_price" value="<%= s.supplier_price == null ? '' : s.supplier_price %>"></td>
												<td><input class="form-control form-control-sm rounded-0 text-uppercase" data-sp="currency" maxlength="3" value="<%= s.currency || '' %>" style="width:70px"></td>
												<% } %>
												<td><input class="form-control form-control-sm rounded-0" type="number" min="0" data-sp="lead_time_days" value="<%= s.lead_time_days == null ? '' : s.lead_time_days %>" style="width:90px"></td>
												<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.001" data-sp="min_order_qty" value="<%= s.min_order_qty == null ? '' : s.min_order_qty %>" style="width:100px"></td>
												<td class="text-center"><input class="form-check-input" type="radio" name="_sup_default" data-sp="is_default"<%= Number(s.is_default) ? ' checked' : '' %>></td>
