<!doctype html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('catalog.products.card_title') %></title>
		<%- include('../../../partials/head'); %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
		<style>
			.pc-sticky { position: sticky; top: 0; z-index: 1020; background: var(--bs-body-bg); }
			.pc-media { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px; }
			.pc-media-item { border: 1px solid var(--bs-border-color); padding: 6px; background: var(--bs-body-bg); }
			.pc-media-item.cover { border-color: var(--bs-success); box-shadow: 0 0 0 2px var(--bs-success-bg-subtle); }
			.pc-media-item img { width: 100%; height: 140px; object-fit: contain; background: var(--bs-tertiary-bg); cursor: grab; }
			.pc-cat-tree ul { list-style: none; padding-left: 1.25rem; margin: 0; }
			.pc-cat-tree > ul { padding-left: 0; }
			.pc-attr-row { border-bottom: 1px solid var(--bs-border-color-translucent); padding: 0.5rem 0; }
			.pc-opt { border: 1px solid var(--bs-border-color); margin-bottom: 1rem; }
			.pc-opt > .pc-opt-head { background: var(--bs-tertiary-bg); padding: 0.5rem 0.75rem; }
			.pc-opt td, .pc-opt th { vertical-align: middle; white-space: nowrap; }
			.pc-readonly .js-editable { opacity: 0.65; }
			.sortable-ghost { opacity: 0.4; }
		</style>
	</head>
	<body class="d-flex flex-column h-100<%= canWrite ? '' : ' pc-readonly' %>">
		<%- include('../../../partials/header'); %>

		<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= title %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('catalog.card.breadcrumb.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/catalog/products/"><%= i18n.__('catalog.card.breadcrumb.products') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= title %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/catalog/products/" class="btn btn-primary rounded-0">
							<i class="fa-solid fa-angle-left"></i>
						</a>
					</div>
				</div>
			</div>
		</div>

		<main class="flex-shrink-0">
			<div class="container-fluid pb-5">
				<div class="pc-sticky py-2 mb-3 border-bottom d-flex flex-wrap gap-2 align-items-center">
					<h1 class="h4 mb-0 me-auto" id="pc-title"><%= title %></h1>
					<% if (productId) { %>
					<span class="badge text-bg-light border">v<%= product.version %></span>
					<% } %>
					<% if (quality) { %>
					<a class="badge text-decoration-none text-bg-<%= quality.cls %>" href="/catalog/quality/" target="_blank" title="<%= quality.title %>"><%= quality.label %></a>
					<% } %>
					<% if (productId) { %>
					<% if (product.type === 'variable') { %>
					<a class="btn btn-outline-secondary rounded-0" href="/catalog/products/<%= productId %>/variants/"><i class="fa-solid fa-layer-group"></i> <%= i18n.__('catalog.variants.title') %></a>
					<% } %>
					<% if (product.type === 'bundle') { %>
					<a class="btn btn-outline-secondary rounded-0" href="/catalog/products/<%= productId %>/bundle/"><i class="fa-solid fa-boxes-stacked"></i> <%= i18n.__('catalog.products.bundle_btn') %></a>
					<% } %>
					<a class="btn btn-outline-secondary rounded-0" href="/catalog/reviews/?product=<%= productId %>"><i class="fa-regular fa-star"></i> <%= i18n.__('catalog.products.reviews_btn') %></a>
					<% if (product.type === 'digital') { %>
					<a class="btn btn-outline-secondary rounded-0" href="/catalog/products/<%= productId %>/downloads/"><i class="fa-solid fa-file-arrow-down"></i> <%= i18n.__('catalog.products.downloads_btn') %></a>
					<% } %>
					<% } %>
					<% if (productId && perms.add) { %>
					<button type="button" class="btn btn-outline-secondary rounded-0" id="btn-copy"><i class="fa-regular fa-copy"></i> <%= i18n.__('catalog.products.copy') %></button>
					<% } %>
					<% if (productId && perms.delete) { %>
					<button type="button" class="btn btn-outline-danger rounded-0" id="btn-delete"><i class="fa-solid fa-trash"></i> <%= i18n.__('catalog.common.delete') %></button>
					<% } %>
					<% if (publish) { %>
					<span class="badge rounded-0 <%= publish.cls %>" id="pc-publish" title="<%= publish.tip %>"><%= publish.label %></span>
					<% if (publish.blocked) { %>
					<span class="badge rounded-0 text-bg-danger" title="<%= publish.blocked %>"><i class="fa-solid fa-triangle-exclamation"></i> <%= i18n.__('catalog.publish.not_ready') %></span>
					<% } %>
					<% if (publish.schedule_text) { %>
					<span class="badge rounded-0 text-bg-info"><i class="fa-regular fa-clock"></i> <%= publish.schedule_text %></span>
					<% } %>
					<% if (perms.publish) { %>
					<div class="btn-group">
						<% if (publish.state !== 'published') { %>
						<button type="button" class="btn btn-outline-success rounded-0" id="btn-publish"<%= publish.blocked ? ' disabled' : '' %> title="<%= publish.blocked %>"><i class="fa-solid fa-upload"></i> <%= i18n.__('catalog.publish.btn') %></button>
						<% } %>
						<button type="button" class="btn btn-outline-success rounded-0 dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false"></button>
						<ul class="dropdown-menu dropdown-menu-end rounded-0">
							<li><button type="button" class="dropdown-item" data-bs-toggle="collapse" data-bs-target="#pub-schedule"><i class="fa-regular fa-clock"></i> <%= i18n.__('catalog.publish.schedule') %></button></li>
							<% if (publish.state === 'published' || publish.state === 'changed') { %>
							<li><button type="button" class="dropdown-item text-danger" id="btn-unpublish"><i class="fa-solid fa-ban"></i> <%= i18n.__('catalog.publish.unpublish') %></button></li>
							<% } %>
						</ul>
					</div>
					<% } %>
					<% } %>
					<% if (perms.add || perms.edit) { %>
					<button type="submit" form="pc-form" class="btn btn-primary rounded-0" id="btn-save"<%= canWrite ? '' : ' disabled' %>><i class="fa-solid fa-floppy-disk"></i> <%= i18n.__('catalog.common.save') %></button>
					<% } %>
				</div>

				<div class="alert alert-warning rounded-0 align-items-center gap-3 <%= holder ? 'd-flex' : 'd-none' %>" id="lock-banner">
					<i class="fa-solid fa-lock"></i>
					<span class="me-auto" id="lock-text"><%= holderText %></span>
					<% if (perms.edit) { %>
					<button type="button" class="btn btn-sm btn-warning rounded-0" id="btn-takeover"><%= i18n.__('catalog.products.lock.takeover') %></button>
					<% } %>
				</div>
				<div class="alert alert-info rounded-0 align-items-center gap-3 d-none" id="saved-banner">
					<i class="fa-solid fa-rotate"></i>
					<span class="me-auto"><%= i18n.__('catalog.products.lock.changed_by_other') %></span>
					<button type="button" class="btn btn-sm btn-info rounded-0" id="btn-reload"><%= i18n.__('catalog.products.reload') %></button>
				</div>

				<% if (publish && perms.publish) { %>
				<div class="collapse mb-3" id="pub-schedule">
					<div class="border bg-light p-3 rounded-0">
						<div class="row g-2 align-items-end">
							<div class="col-md-3">
								<label class="form-label small mb-1"><%= i18n.__('catalog.publish.publish_at') %></label>
								<input type="datetime-local" class="form-control form-control-sm rounded-0" id="pub-at" value="<%= publish.publish_at %>" />
							</div>
							<div class="col-md-3">
								<label class="form-label small mb-1"><%= i18n.__('catalog.publish.unpublish_at') %></label>
								<input type="datetime-local" class="form-control form-control-sm rounded-0" id="unpub-at" value="<%= publish.unpublish_at %>" />
							</div>
							<div class="col-md-auto d-flex gap-1">
								<button type="button" class="btn btn-sm btn-primary rounded-0" id="btn-pub-schedule"><%= i18n.__('catalog.common.save') %></button>
								<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="btn-pub-unschedule"><%= i18n.__('catalog.publish.schedule_clear') %></button>
							</div>
						</div>
						<div class="form-text"><%= i18n.__('catalog.publish.schedule_hint') %></div>
					</div>
				</div>
				<% } %>

				<form id="pc-form" novalidate data-version="<%= product.version || '' %>" data-saved-type="<%= productId ? product.type : '' %>">
					<ul class="nav nav-tabs mb-3" role="tablist">
						<li class="nav-item"><button class="nav-link rounded-0 active" data-bs-toggle="tab" data-bs-target="#t-general" type="button"><%= i18n.__('catalog.products.tabs.general') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-content" type="button"><%= i18n.__('catalog.products.tabs.content') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-prices" type="button"><%= i18n.__('catalog.products.tabs.prices') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-stock" type="button"><%= i18n.__('catalog.products.tabs.stock') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-media" type="button"><%= i18n.__('catalog.products.tabs.media') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-categories" type="button"><%= i18n.__('catalog.products.tabs.categories') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-attributes" type="button"><%= i18n.__('catalog.products.tabs.attributes') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-options" type="button"><%= i18n.__('catalog.products.tabs.options') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-shipping" type="button"><%= i18n.__('catalog.products.tabs.shipping') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-links" type="button"><%= i18n.__('catalog.products.tabs.links') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-extra" type="button"><%= i18n.__('catalog.products.tabs.extra') %></button></li>
						<% if (productId) { %>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-channels" type="button"><i class="fa-solid fa-store"></i> <%= i18n.__('catalog.channels.tab') %></button></li>
						<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#t-history" type="button"><i class="fa-solid fa-clock-rotate-left"></i> <%= i18n.__('catalog.history.tab') %></button></li>
						<% } %>
					</ul>

					<div class="tab-content js-editable">
						<!-- ═══ ОСНОВНЕ ═══ -->
						<div class="tab-pane fade show active" id="t-general">
							<div class="row g-3">
								<div class="col-md-3" data-field="type">
									<label class="form-label"><%= i18n.__('catalog.products.f.type') %></label>
									<select class="form-select rounded-0" name="type">
										<% ['simple', 'variable', 'bundle', 'digital', 'service', 'gift_card'].forEach((t) => { %>
										<option value="<%= t %>"<%= (String((product.type ?? 'simple')) === String(t) ? ' selected' : '') %>><%= i18n.__('catalog.products.types.' + t) %></option>
										<% }) %>
									</select>
									<div class="form-text"><%= i18n.__('catalog.products.hints.type') %></div>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="status">
									<label class="form-label"><%= i18n.__('catalog.products.f.status') %></label>
									<select class="form-select rounded-0" name="status">
										<% ['draft', 'active', 'archived'].forEach((s) => { %>
										<option value="<%= s %>"<%= (String(product.status) === String(s) ? ' selected' : '') %>><%= i18n.__('catalog.products.status.' + s) %></option>
										<% }) %>
									</select>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="visibility">
									<label class="form-label"><%= i18n.__('catalog.products.f.visibility') %></label>
									<select class="form-select rounded-0" name="visibility">
										<% ['all', 'catalog', 'search', 'none'].forEach((s) => { %>
										<option value="<%= s %>"<%= (String((product.visibility ?? 'all')) === String(s) ? ' selected' : '') %>><%= i18n.__('catalog.products.visibility.' + s) %></option>
										<% }) %>
									</select>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="item_condition">
									<label class="form-label"><%= i18n.__('catalog.products.f.item_condition') %></label>
									<select class="form-select rounded-0" name="item_condition">
										<% ['new', 'used', 'refurbished'].forEach((s) => { %>
										<option value="<%= s %>"<%= (String((product.item_condition ?? 'new')) === String(s) ? ' selected' : '') %>><%= i18n.__('catalog.products.condition.' + s) %></option>
										<% }) %>
									</select>
									<div class="invalid-feedback"></div>
								</div>

								<div class="col-md-3" data-field="sku">
									<label class="form-label"><%= i18n.__('catalog.products.f.sku') %></label>
									<input class="form-control rounded-0" name="sku" maxlength="64" value="<%= (product.sku ?? '') %>" placeholder="<%= cfg.skuAuto ? i18n.__('catalog.products.hints.auto') : '' %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="model">
									<label class="form-label"><%= i18n.__('catalog.products.f.model') %></label>
									<input class="form-control rounded-0" name="model" maxlength="128" value="<%= (product.model ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="mpn">
									<label class="form-label"><%= i18n.__('catalog.products.f.mpn') %></label>
									<input class="form-control rounded-0" name="mpn" maxlength="64" value="<%= (product.mpn ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="ean">
									<label class="form-label"><%= i18n.__('catalog.products.f.ean') %></label>
									<input class="form-control rounded-0" name="ean" maxlength="14" inputmode="numeric" value="<%= (product.ean ?? '') %>" placeholder="<%= cfg.eanAuto ? i18n.__('catalog.products.hints.auto') : '' %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="upc">
									<label class="form-label">UPC</label>
									<input class="form-control rounded-0" name="upc" maxlength="12" inputmode="numeric" value="<%= (product.upc ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="jan">
									<label class="form-label">JAN</label>
									<input class="form-control rounded-0" name="jan" maxlength="13" inputmode="numeric" value="<%= (product.jan ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="isbn">
									<label class="form-label">ISBN</label>
									<input class="form-control rounded-0" name="isbn" maxlength="17" value="<%= (product.isbn ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="id_brand">
									<label class="form-label"><%= i18n.__('catalog.products.f.brand') %></label>
									<div class="input-group">
										<input type="search" class="form-control rounded-0" id="brand-search" placeholder="<%= i18n.__('catalog.common.search') %>" style="max-width: 40%" />
										<select class="form-select rounded-0" name="id_brand" data-type="intnull">
											<option value=""><%= i18n.__('catalog.common.none') %></option>
											<% brandOptions.forEach((b) => { %><option value="<%= b.id %>"<%= (String((product.id_brand ?? '')) === String(b.id) ? ' selected' : '') %>><%= b.name %></option><% }) %>
										</select>
									</div>
									<div class="invalid-feedback"></div>
								</div>

								<div class="col-md-3" data-field="id_attribute_set">
									<label class="form-label"><%= i18n.__('catalog.products.f.attribute_set') %></label>
									<select class="form-select rounded-0" name="id_attribute_set" data-type="intnull">
										<option value=""><%= i18n.__('catalog.common.none') %></option>
										<% attrSets.forEach((s) => { %><option value="<%= s.id %>"<%= (String((product.id_attribute_set ?? '')) === String(s.id) ? ' selected' : '') %>><%= s.name %></option><% }) %>
									</select>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="product_type_label">
									<label class="form-label"><%= i18n.__('catalog.products.f.product_type_label') %></label>
									<input class="form-control rounded-0" name="product_type_label" maxlength="128" value="<%= (product.product_type_label ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="vendor">
									<label class="form-label"><%= i18n.__('catalog.products.f.vendor') %></label>
									<input class="form-control rounded-0" name="vendor" maxlength="128" value="<%= (product.vendor ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="sort_order">
									<label class="form-label"><%= i18n.__('catalog.products.f.sort_order') %></label>
									<input class="form-control rounded-0" type="number" name="sort_order" data-type="int" value="<%= (product.sort_order ?? 0) %>" />
									<div class="invalid-feedback"></div>
								</div>

								<div class="col-12 d-flex flex-wrap gap-4">
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="is_featured" data-type="bool" id="pf-featured"<%= (Number(product.is_featured ?? 0) ? ' checked' : '') %> /><label class="form-check-label" for="pf-featured"><%= i18n.__('catalog.products.f.is_featured') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="on_sale_flag" data-type="bool" id="pf-sale"<%= (Number(product.on_sale_flag ?? 0) ? ' checked' : '') %> /><label class="form-check-label" for="pf-sale"><%= i18n.__('catalog.products.f.on_sale_flag') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="online_only" data-type="bool" id="pf-online"<%= (Number(product.online_only ?? 0) ? ' checked' : '') %> /><label class="form-check-label" for="pf-online"><%= i18n.__('catalog.products.f.online_only') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="show_condition" data-type="bool" id="pf-showcond"<%= (Number(product.show_condition ?? 0) ? ' checked' : '') %> /><label class="form-check-label" for="pf-showcond"><%= i18n.__('catalog.products.f.show_condition') %></label></div>
								</div>
							</div>
						</div>

						<!-- ═══ ОПИС І SEO ═══ -->
						<div class="tab-pane fade" id="t-content">
							<div class="form-check form-switch mb-3">
								<input class="form-check-input" type="checkbox" id="slug-shared"<%= Number(product.slug_shared) ? ' checked' : '' %> />
								<label class="form-check-label" for="slug-shared"><%= i18n.__('catalog.languages.slug_shared') %></label>
								<div class="form-text"><%= i18n.__('catalog.languages.slug_shared_hint') %></div>
							</div>
							<div class="row g-3 mb-3">
								<div class="col-md-5">
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="robots_index" data-type="bool" id="pf-robots-index"<%= (Number(product.robots_index ?? 1) ? ' checked' : '') %> /><label class="form-check-label" for="pf-robots-index"><%= i18n.__('catalog.seo.f.robots_index') %></label></div>
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="robots_follow" data-type="bool" id="pf-robots-follow"<%= (Number(product.robots_follow ?? 1) ? ' checked' : '') %> /><label class="form-check-label" for="pf-robots-follow"><%= i18n.__('catalog.seo.f.robots_follow') %></label></div>
									<div class="form-text"><%= i18n.__('catalog.seo.robots_hint') %></div>
								</div>
								<div class="col-md-7" data-field="og_image">
									<label class="form-label"><%= i18n.__('catalog.seo.f.og_image') %></label>
									<input type="hidden" name="og_image" value="<%= (product.og_image ?? '') %>" />
									<div class="d-flex gap-2 align-items-center">
										<img id="og-image-preview" alt="" src="<%= product.og_image ? '/assets/images/products/' + product.og_image : '' %>" style="height: 63px; width: 120px; object-fit: cover;<%= product.og_image ? '' : ' display: none' %>" />
										<input type="file" class="form-control form-control-sm rounded-0" id="og-image-file" accept="image/*" />
										<button type="button" class="btn btn-sm btn-outline-danger rounded-0" id="og-image-clear"><i class="fa-solid fa-xmark"></i></button>
									</div>
									<div class="form-text"><%= i18n.__('catalog.seo.og_image_hint') %></div>
									<div class="invalid-feedback"></div>
								</div>
							</div>
							<ul class="nav nav-pills mb-3">
								<% languages.forEach((l, i) => { %>
								<li class="nav-item"><button class="nav-link rounded-0<%= i === 0 ? ' active' : '' %>" type="button" data-bs-toggle="tab" data-bs-target="#lang-<%= l.id %>"><%= String(l.iso).toUpperCase() %><% if (i === 0) { %> *<% } %></button></li>
								<% }) %>
