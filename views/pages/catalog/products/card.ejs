												<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.001" data-s="reorder_point" value="<%= s.reorder_point == null ? '' : s.reorder_point %>"<%= perms.stock ? '' : ' disabled' %>></td>
