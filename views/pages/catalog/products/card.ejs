								<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="btn-apply-set"><i class="fa-solid fa-list-check"></i> <%= i18n.__('catalog.products.attributes.apply_set') %></button>
								<select class="form-select form-select-sm rounded-0" id="attr-add-select" style="max-width: 360px">
									<% attrAddList.forEach((a) => { %><option value="<%= a.id %>"><%= a.group_name ? a.group_name + ' → ' : '' %><%= a.name %></option><% }) %>
								</select>
								<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="btn-add-attr"><i class="fa-solid fa-plus"></i> <%= i18n.__('catalog.products.attributes.add') %></button>
							</div>
							<div data-field="attributes"><div class="invalid-feedback"></div></div>
							<div id="attr-list">
								<% attributeRows.forEach((a) => { %>
								<div class="row g-2 align-items-start pc-attr-row" data-attr="<%= a.id %>">
									<div class="col-md-4"><strong><%= a.name %></strong><% if (Number(a.is_required)) { %> <span class="text-danger">*</span><% } %>
										<div class="small text-muted"><%= a.group_name || '' %><%= a.unit ? ' · ' + a.unit : '' %></div></div>
									<div class="col-md-7">
										<% if (a.type === 'select' || a.type === 'color') { %>
										<select class="form-select form-select-sm rounded-0" data-a="value"><option value=""></option><% a.values.forEach((x) => { %><option value="<%= x.id %>"<%= x.selected ? ' selected' : '' %>><%= x.name %><%= x.color_hex ? ' ■' : '' %></option><% }) %></select>
										<% } else if (a.type === 'multiselect') { %>
										<select class="form-select form-select-sm rounded-0" data-a="values" multiple size="<%= Math.min(a.values.length || 1, 6) %>"><% a.values.forEach((x) => { %><option value="<%= x.id %>"<%= x.selected ? ' selected' : '' %>><%= x.name %></option><% }) %></select>
										<% } else if (a.type === 'integer' || a.type === 'decimal') { %>
										<div class="input-group input-group-sm"><input class="form-control rounded-0" type="number" step="<%= a.type === 'integer' ? 1 : 'any' %>" data-a="number" value="<%= a.number ?? '' %>"><% if (a.unit) { %><span class="input-group-text rounded-0"><%= a.unit %></span><% } %></div>
										<% } else if (a.type === 'boolean') { %>
										<select class="form-select form-select-sm rounded-0" data-a="bool"><option value=""></option><option value="1"<%= a.number === 1 ? ' selected' : '' %>><%= i18n.__('catalog.common.yes') %></option><option value="0"<%= a.number === 0 ? ' selected' : '' %>><%= i18n.__('catalog.common.no') %></option></select>
										<% } else if (a.type === 'date') { %>
										<input class="form-control form-control-sm rounded-0" type="date" data-a="date" value="<%= a.date %>">
										<% } else if (a.type === 'textarea') { %>
										<% languages.forEach((l) => { %><textarea class="form-control form-control-sm rounded-0 mb-1" data-a="text" data-lang="<%= l.id %>" rows="2" placeholder="<%= String(l.iso).toUpperCase() %>"><%= a.text[l.id] || '' %></textarea><% }) %>
										<% } else { %>
										<% languages.forEach((l) => { %><input class="form-control form-control-sm rounded-0 mb-1" data-a="text" data-lang="<%= l.id %>" placeholder="<%= String(l.iso).toUpperCase() %>" value="<%= a.text[l.id] || '' %>"><% }) %>
										<% } %>
									</div>
									<div class="col-md-1 text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-attr-del"><i class="fa-solid fa-xmark"></i></button></div>
								</div>
								<% }) %>
							</div>
						</div>

						<!-- ═══ ОПЦІЇ ═══ -->
						<div class="tab-pane fade" id="t-options">
							<div class="form-text mb-2"><%= i18n.__('catalog.products.opt.hint') %></div>
							<div class="d-flex flex-wrap gap-2 mb-3">
								<select class="form-select form-select-sm rounded-0" id="opt-add-select" style="max-width: 360px">
									<% optAddList.forEach((o) => { %><option value="<%= o.id %>"><%= o.name %> (<%= i18n.__('catalog.options.types.' + o.type) %>)</option><% }) %>
								</select>
								<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="btn-add-opt"><i class="fa-solid fa-plus"></i> <%= i18n.__('catalog.products.opt.add') %></button>
							</div>
							<div data-field="options"><div class="invalid-feedback"></div></div>
							<div id="opt-list">
								<% optionBlocks.forEach((o) => { %>
								<div class="pc-opt" data-opt="<%= o.id %>">
									<div class="pc-opt-head d-flex flex-wrap align-items-center gap-3">
										<strong class="me-auto"><%= o.name %> <span class="text-muted small"><%= i18n.__('catalog.options.types.' + o.type) %></span></strong>
										<div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" data-o="is_required"<%= o.is_required ? ' checked' : '' %>><label class="form-check-label small"><%= i18n.__('catalog.products.opt.required') %></label></div>
										<% if (!o.is_value_type) { %><input class="form-control form-control-sm rounded-0" data-o="default_value" maxlength="255" placeholder="<%= i18n.__('catalog.products.opt.default_value') %>" value="<%= o.default_value %>" style="max-width:240px"><% } %>
										<button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-opt-del"><i class="fa-solid fa-xmark"></i></button>
									</div>
									<% if (o.is_value_type) { %>
									<div class="p-2">
										<div class="d-flex gap-2 mb-2">
											<select class="form-select form-select-sm rounded-0 js-ov-select" style="max-width:300px"><% o.free_values.forEach((x) => { %><option value="<%= x.id %>"><%= x.name %></option><% }) %></select>
											<button type="button" class="btn btn-sm btn-outline-secondary rounded-0 js-ov-add"><i class="fa-solid fa-plus"></i> <%= i18n.__('catalog.products.opt.add_value') %></button>
											<button type="button" class="btn btn-sm btn-outline-secondary rounded-0 js-ov-all"><%= i18n.__('catalog.products.opt.add_all') %></button>
										</div>
										<div class="table-responsive"><table class="table table-sm mb-0">
											<thead><tr>
												<th><%= i18n.__('catalog.products.opt.value') %></th><th></th><th><%= i18n.__('catalog.products.opt.price') %></th><th><%= i18n.__('catalog.products.opt.points') %></th>
												<th><%= i18n.__('catalog.products.opt.weight') %></th><th><%= i18n.__('catalog.products.opt.quantity') %></th><th><%= i18n.__('catalog.products.opt.subtract') %></th>
												<th><%= i18n.__('catalog.products.opt.sku_suffix') %></th><th><%= i18n.__('catalog.products.opt.is_default') %></th><th></th>
											</tr></thead>
											<tbody class="js-ov-body">
												<% o.rows.forEach((x) => { %>
												<tr data-value="<%= x.id_option_value %>">
													<td><% if (x.value.color_hex) { %><span style="display:inline-block;width:12px;height:12px;background:<%= x.value.color_hex %>;border:1px solid #ccc"></span> <% } %><%= x.value.name %></td>
													<td><div class="d-flex gap-1"><select class="form-select form-select-sm rounded-0" data-ov="price_mode"><option value="fixed"<%= x.price_mode !== 'percent' ? ' selected' : '' %>>±</option><option value="percent"<%= x.price_mode === 'percent' ? ' selected' : '' %>>%</option></select>
														<% if (cfg.currencies.length) { %><select class="form-select form-select-sm rounded-0" data-ov="price_currency" title="<%= i18n.__('catalog.products.opt.currency') %>" style="width:96px"><option value=""><%= i18n.__('catalog.products.opt.currency_product') %></option><option value="<%= cfg.currency %>"<%= x.price_currency === cfg.currency ? ' selected' : '' %>><%= cfg.currency %></option><% cfg.currencies.forEach((c) => { %><option value="<%= c.code %>"<%= x.price_currency === c.code ? ' selected' : '' %>><%= c.code %></option><% }) %></select><% } %></div></td>
													<td><input class="form-control form-control-sm rounded-0" type="number" step="0.0001" data-ov="price" value="<%= Number(x.price_cur != null ? x.price_cur : (x.price || 0)) %>" style="width:110px"></td>
													<td><input class="form-control form-control-sm rounded-0" type="number" step="1" data-ov="points" value="<%= Number(x.points || 0) %>" style="width:80px"></td>
													<td><input class="form-control form-control-sm rounded-0" type="number" step="0.0001" data-ov="weight" value="<%= Number(x.weight || 0) %>" style="width:90px"></td>
													<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.001" data-ov="quantity" value="<%= x.quantity ?? '' %>" style="width:90px"></td>
													<td class="text-center"><input class="form-check-input" type="checkbox" data-ov="subtract_stock"<%= Number(x.subtract_stock) ? ' checked' : '' %>></td>
													<td><input class="form-control form-control-sm rounded-0" data-ov="sku_suffix" maxlength="32" value="<%= x.sku_suffix || '' %>" style="width:100px"></td>
													<td class="text-center"><input class="form-check-input" type="<%= o.type === 'checkbox' ? 'checkbox' : 'radio' %>" name="_ovdef_<%= o.id %>" data-ov="is_default"<%= Number(x.is_default) ? ' checked' : '' %>></td>
													<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button></td>
												</tr>
												<% }) %>
											</tbody>
										</table></div>
									</div>
									<% } %>
								</div>
								<% }) %>
							</div>

							<hr class="my-4" />

							<div data-field="customization">
								<div class="d-flex align-items-center mb-2">
									<strong class="me-auto"><%= i18n.__('catalog.products.custom.title') %></strong>
									<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="btn-add-custom"><i class="fa-solid fa-plus"></i> <%= i18n.__('catalog.products.custom.add') %></button>
								</div>
								<div class="form-text mb-2"><%= i18n.__('catalog.products.custom.hint') %></div>
								<div class="invalid-feedback"></div>
								<div class="table-responsive">
									<table class="table table-sm align-middle">
										<thead>
											<tr>
												<th><%= i18n.__('catalog.products.custom.type') %></th>
												<% languages.forEach((l) => { %><th><%= i18n.__('catalog.products.custom.label') %> (<%= String(l.iso).toUpperCase() %>)</th><% }) %>
												<th><%= i18n.__('catalog.products.custom.max_length') %></th>
												<th><%= i18n.__('catalog.products.custom.price') %></th>
												<th><%= i18n.__('catalog.products.custom.required') %></th>
												<th></th>
											</tr>
										</thead>
										<tbody id="custom-body">
											<% product.customization.forEach((c) => { %>
											<tr data-id="<%= c.id || '' %>">
												<td><select class="form-select form-select-sm rounded-0" data-c="type"><option value="text"<%= (String(c.type || 'text') === String('text') ? ' selected' : '') %>><%= i18n.__('catalog.products.custom.types.text') %></option><option value="file"<%= (String(c.type) === String('file') ? ' selected' : '') %>><%= i18n.__('catalog.products.custom.types.file') %></option></select></td>
												<% languages.forEach((l) => { %><td><input class="form-control form-control-sm rounded-0" data-c="label" data-lang="<%= l.id %>" maxlength="255" value="<%= ((c.labels || {})[l.id] || {}).label || '' %>"></td><% }) %>
												<td><input class="form-control form-control-sm rounded-0" type="number" min="1" max="65535" data-c="max_length" value="<%= c.max_length == null ? '' : c.max_length %>" style="width:90px"></td>
												<td><input class="form-control form-control-sm rounded-0" type="number" min="0" step="0.0001" data-c="price" value="<%= Number(c.price || 0) %>" style="width:110px"></td>
												<td class="text-center"><input class="form-check-input" type="checkbox" data-c="is_required"<%= Number(c.is_required) ? ' checked' : '' %>></td>
												<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-row-del"><i class="fa-solid fa-xmark"></i></button></td>
											</tr>
											<% }) %>
										</tbody>
									</table>
								</div>
							</div>
						</div>

						<!-- ═══ ДОСТАВКА ═══ -->
						<div class="tab-pane fade" id="t-shipping">
							<div class="row g-3">
								<div class="col-12">
									<div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="requires_shipping" data-type="bool" id="pf-ship"<%= (Number(product.requires_shipping ?? 1) ? ' checked' : '') %> /><label class="form-check-label" for="pf-ship"><%= i18n.__('catalog.products.f.requires_shipping') %></label></div>
								</div>
								<div class="col-md-2" data-field="weight">
									<label class="form-label"><%= i18n.__('catalog.products.f.weight') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="weight" data-type="number" value="<%= (product.weight ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="weight_unit">
									<label class="form-label"><%= i18n.__('catalog.products.f.weight_unit') %></label>
									<select class="form-select rounded-0" name="weight_unit" data-type="textnull">
										<option value=""><%= i18n.__('catalog.products.hints.default_unit') %> (<%= cfg.units.weight %>)</option>
										<% ['kg', 'g', 'lb', 'oz'].forEach((u) => { %><option value="<%= u %>"<%= (String((product.weight_unit ?? '')) === String(u) ? ' selected' : '') %>><%= u %></option><% }) %>
									</select>
								</div>
								<div class="col-md-2" data-field="length">
									<label class="form-label"><%= i18n.__('catalog.products.f.length') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="length" data-type="number" value="<%= (product.length ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="width">
									<label class="form-label"><%= i18n.__('catalog.products.f.width') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="width" data-type="number" value="<%= (product.width ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="height">
									<label class="form-label"><%= i18n.__('catalog.products.f.height') %></label>
									<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="height" data-type="number" value="<%= (product.height ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="length_unit">
									<label class="form-label"><%= i18n.__('catalog.products.f.length_unit') %></label>
									<select class="form-select rounded-0" name="length_unit" data-type="textnull">
										<option value=""><%= i18n.__('catalog.products.hints.default_unit') %> (<%= cfg.units.length %>)</option>
										<% ['cm', 'mm', 'm', 'in'].forEach((u) => { %><option value="<%= u %>"<%= (String((product.length_unit ?? '')) === String(u) ? ' selected' : '') %>><%= u %></option><% }) %>
									</select>
								</div>
								<div class="col-md-3" data-field="shipping_class">
									<label class="form-label"><%= i18n.__('catalog.products.f.shipping_class') %></label>
									<input class="form-control rounded-0" name="shipping_class" maxlength="64" value="<%= (product.shipping_class ?? '') %>" />
									<div class="invalid-feedback"></div>
								</div>
