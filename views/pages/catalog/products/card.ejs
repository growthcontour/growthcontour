												<th><%= i18n.__('catalog.products.suppliers.lead_time_days') %></th>
												<th><%= i18n.__('catalog.products.suppliers.min_order_qty') %></th>
												<th><%= i18n.__('catalog.products.suppliers.is_default') %></th>
												<th></th>
											</tr>
										</thead>
										<tbody id="suppliers-body">
