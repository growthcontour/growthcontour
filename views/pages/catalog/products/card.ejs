									<select class="form-select rounded-0" name="out_of_stock_action">
										<% ['default', 'deny', 'backorder', 'preorder'].forEach((s) => { %>
										<option value="<%= s %>"<%= (String((product.out_of_stock_action ?? 'default')) === String(s) ? ' selected' : '') %>><%= i18n.__('catalog.products.oos.' + s) %></option>
										<% }) %>
									</select>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="id_stock_status">
									<label class="form-label"><%= i18n.__('catalog.products.f.stock_status') %></label>
									<select class="form-select rounded-0" name="id_stock_status" data-type="intnull">
										<option value=""><%= i18n.__('catalog.common.none') %></option>
										<% stockStatuses.forEach((s) => { %><option value="<%= s.id %>"<%= (String((product.id_stock_status ?? '')) === String(s.id) ? ' selected' : '') %>><%= s.name %></option><% }) %>
									</select>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-2" data-field="available_date">
