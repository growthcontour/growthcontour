						<!-- ═══ ЦІНИ ═══ -->
						<div class="tab-pane fade" id="t-prices">
							<%
								// Ціни у валютах: якщо в групи цін є валюта — у полях суми в цій валюті (*_cur), під полем — «≈ у базовій»
								const hasCur = cfg.currencies.length > 0;
								const curSel = (name, sel) => '<select class="form-select rounded-0 js-cur" name="' + name + '" data-type="text" style="max-width:92px">' +
									'<option value="">' + cfg.currency + '</option>' + cfg.currencies.map((c) => '<option value="' + c.code + '"' + (sel === c.code ? ' selected' : '') + '>' + c.code + '</option>').join('') + '</select>';
								const amt = (cur, curVal, baseVal, def) => (cur ? (curVal ?? def) : (baseVal ?? def));
							%>
							<div class="row g-3 mb-4">
								<div class="col-md-3" data-field="price">
									<label class="form-label"><%= i18n.__('catalog.products.f.price') %><% if (!hasCur) { %>, <%= cfg.currency %><% } %></label>
									<div class="input-group">
										<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="price" data-type="number0" data-cur-group="price_currency" data-kind="price" value="<%= amt(product.price_currency, product.price_cur, product.price, 0) %>" />
										<% if (hasCur) { %><%- curSel('price_currency', product.price_currency) %><% } %>
									</div>
									<small class="text-muted js-cur-hint" data-for="price"></small>
									<% if (perms.cost) { %>
									<div class="form-check mt-1" title="<%= i18n.__('catalog.products.hints.price_auto') %>">
										<input class="form-check-input" type="checkbox" id="f-price-auto" name="price_auto" data-type="bool"<%= Number(product.price_auto) ? ' checked' : '' %> />
										<label class="form-check-label small" for="f-price-auto"><%= i18n.__('catalog.products.f.price_auto') %></label>
									</div>
									<script>
										// Ціна за формулою: ціну рахує сервер із собівартості — поле ціни лише для перегляду
										(function () {
											const cb = document.getElementById("f-price-auto");
											const sync = () => {
												const price = document.querySelector('#t-prices [name="price"]');
												const cur = document.querySelector('#t-prices [name="price_currency"]');
												if (price) price.readOnly = cb.checked;
												if (cur) cur.disabled = cb.checked;
											};
											cb.addEventListener("change", sync);
											sync();
										})();
									</script>
									<% } %>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="compare_at_price">
									<label class="form-label"><%= i18n.__('catalog.products.f.compare_at_price') %></label>
									<div class="input-group">
										<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="compare_at_price" data-type="number" data-cur-group="price_currency" data-kind="price" value="<%= amt(product.price_currency, product.compare_cur, product.compare_at_price, '') %>" />
										<% if (hasCur) { %><span class="input-group-text rounded-0 js-cur-label" data-group="price_currency"></span><% } %>
									</div>
									<small class="text-muted js-cur-hint" data-for="compare_at_price"></small>
									<div class="invalid-feedback"></div>
								</div>
								<% if (perms.cost) { %>
								<div class="col-md-3" data-field="cost_price">
									<label class="form-label"><%= i18n.__('catalog.products.f.cost_price') %></label>
									<div class="input-group">
										<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="cost_price" data-type="number" data-cur-group="cost_currency" data-kind="plain" value="<%= amt(product.cost_currency, product.cost_cur, product.cost_price, '') %>" />
										<% if (hasCur) { %><%- curSel('cost_currency', product.cost_currency) %><% } %>
									</div>
									<small class="text-muted js-cur-hint" data-for="cost_price"></small>
									<div class="invalid-feedback"></div>
								</div>
								<div class="col-md-3" data-field="wholesale_price">
									<label class="form-label"><%= i18n.__('catalog.products.f.wholesale_price') %></label>
									<div class="input-group">
										<input class="form-control rounded-0" type="number" min="0" step="0.0001" name="wholesale_price" data-type="number" data-cur-group="wholesale_currency" data-kind="price" value="<%= amt(product.wholesale_currency, product.wholesale_cur, product.wholesale_price, '') %>" />
										<% if (hasCur) { %><%- curSel('wholesale_currency', product.wholesale_currency) %><% } %>
									</div>
									<small class="text-muted js-cur-hint" data-for="wholesale_price"></small>
									<div class="invalid-feedback"></div>
								</div>
								<% } %>
								<% if (hasCur) { const fixed = (() => { try { return product.price_fixed ? JSON.parse(product.price_fixed) : {}; } catch (e) { return {}; } })(); %>
								<!-- Фіксовані ціни у валютах: сайт у цій валюті отримує саме цю ціну, курс її не чіпає -->
								<div class="col-12" data-field="price_fixed">
									<label class="form-label"><%= i18n.__('catalog.products.f.price_fixed') %></label>
									<div class="d-flex flex-wrap gap-2">
										<% cfg.currencies.forEach((c) => { %>
										<div class="input-group input-group-sm" style="width:170px">
											<input class="form-control rounded-0 js-fixed" type="number" min="0" step="0.0001" data-code="<%= c.code %>" value="<%= fixed[c.code] ?? '' %>" />
											<span class="input-group-text rounded-0"><%= c.code %></span>
										</div>
										<% }) %>
									</div>
									<input type="hidden" name="price_fixed" data-type="text" value="<%= product.price_fixed || '' %>" />
									<small class="text-muted"><%= i18n.__('catalog.products.hints.price_fixed') %></small>
									<div class="invalid-feedback"></div>
								</div>
								<script>
									// Фіксовані ціни → прихованe поле price_fixed (JSON)
									(function () {
										const pane = document.getElementById("t-prices");
										const hidden = pane.querySelector('input[name="price_fixed"]');
										pane.addEventListener("input", (e) => {
											if (!e.target.classList.contains("js-fixed")) return;
											const out = {};
											pane.querySelectorAll(".js-fixed").forEach((i) => i.value !== "" && Number(i.value) > 0 && (out[i.dataset.code] = Number(i.value)));
											hidden.value = Object.keys(out).length ? JSON.stringify(out) : "";
										});
									})();
								</script>
								<script>
									// «≈ у базовій»: той самий курс і округлення, що й на сервері (остаточно рахує сервер під час збереження)
									(function () {
										const CUR = <%- JSON.stringify(cfg.currencies).replace(/</g, '\\u003c') %>;
										const BASE = <%- JSON.stringify(cfg.currency) %>;
										const byCode = new Map(CUR.map((c) => [c.code, c]));
										const r4 = (n) => Math.round(n * 10000) / 10000;
										const roundMoney = (v, c) => {
											if (!c || c.round === "none") return Math.round(v * 100) / 100;
											const step = Number(c.step) > 0 ? Number(c.step) : 1;
											const f = c.round === "up" ? Math.ceil : c.round === "down" ? Math.floor : Math.round;
											let out = f(r4(v / step)) * step;
											if (Number(c.minus) > 0 && out - Number(c.minus) > 0) out -= Number(c.minus);
											return Math.max(0, r4(out));
										};
										const pane = document.getElementById("t-prices");
										function update() {
											pane.querySelectorAll("[data-cur-group]").forEach((inp) => {
												const sel = pane.querySelector('select[name="' + inp.dataset.curGroup + '"]');
												const code = sel ? sel.value : "";
												const c = byCode.get(code);
												const hint = pane.querySelector('.js-cur-hint[data-for="' + inp.name + '"]');
												if (!hint) return;
												if (!c || inp.value === "") return (hint.textContent = "");
												const v = Number(inp.value) * c.rate;
												const base = inp.dataset.kind === "plain" ? r4(v) : roundMoney(v, c);
												hint.textContent = "≈ " + base.toLocaleString("uk-UA", { maximumFractionDigits: 4 }) + " " + BASE + " (" + c.rate.toLocaleString("uk-UA", { maximumFractionDigits: 6 }) + ")";
											});
											pane.querySelectorAll(".js-cur-label").forEach((el) => {
												const sel = pane.querySelector('select[name="' + el.dataset.group + '"]');
												el.textContent = (sel && sel.value) || BASE;
											});
										}
										pane.addEventListener("input", update);
										pane.addEventListener("change", update);
										update();
									})();
								</script>
								<% } %>
								<div class="col-md-3" data-field="id_tax_class">
									<label class="form-label"><%= i18n.__('catalog.products.f.tax_class') %></label>
									<select class="form-select rounded-0" name="id_tax_class" data-type="intnull">
										<option value=""><%= i18n.__('catalog.common.none') %></option>
										<% taxClasses.forEach((t) => { %><option value="<%= t.id %>"<%= (String((product.id_tax_class ?? '')) === String(t.id) ? ' selected' : '') %>><%= t.name %> (<%= Number(t.rate) %>%)</option><% }) %>
									</select>
