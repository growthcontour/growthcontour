											<div class="form-check mb-0"><input class="form-check-input js-cover" type="radio" name="_cover"<%= Number(m.is_cover) ? ' checked' : '' %>><label class="form-check-label small"><%= i18n.__('catalog.products.media.cover') %></label></div>
											<button type="button" class="btn btn-sm btn-outline-danger rounded-0 js-media-del"><i class="fa-solid fa-xmark"></i></button>
										</div>
										<% languages.forEach((l) => { %><input class="form-control form-control-sm rounded-0 mt-1" data-alt="<%= l.id %>" placeholder="alt <%= String(l.iso).toUpperCase() %>" maxlength="255" value="<%= (m.alt || {})[l.id] || '' %>"><% }) %>
									</div>
									<% }) %>
								</div>
							</div>
						</div>

						<!-- ═══ КАТЕГОРІЇ ═══ -->
						<div class="tab-pane fade" id="t-categories">
							<div class="form-text mb-2"><%= i18n.__('catalog.products.categories.hint') %></div>
							<input type="search" class="form-control form-control-sm rounded-0 mb-2" id="cat-search" placeholder="<%= i18n.__('catalog.common.search') %>" style="max-width: 320px" />
							<div data-field="categories"><div class="invalid-feedback"></div></div>
							<div data-field="id_category_main"><div class="invalid-feedback"></div></div>
