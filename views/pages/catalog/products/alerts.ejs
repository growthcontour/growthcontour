<!doctype html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('catalog.alerts.title') %></title>
		<%- include('../../../partials/head'); %>
		<link rel="stylesheet" href="/assets/css/tabulator/tabulator_bootstrap5.min.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	</head>
	<body class="d-flex flex-column h-100">
		<%- include('../../../partials/header'); %>

		<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('catalog.alerts.title') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('catalog.common.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/catalog"><%= i18n.__('catalog.menu.catalog') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= i18n.__('catalog.alerts.title') %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/catalog" class="btn btn-primary rounded-0">
							<i class="fa-solid fa-angle-left"></i>
						</a>
					</div>
				</div>
			</div>
		</div>

		<main class="flex-shrink-0">
			<div class="container-fluid pb-5">
				<h1 class="h4 mb-3"><%= i18n.__('catalog.alerts.title') %></h1>

				<% if (perms.settings) { %>
				<div class="card rounded-0 mb-4">
					<div class="card-header fw-semibold"><%= i18n.__('catalog.alerts.settings') %></div>
					<div class="card-body">
						<div class="form-text mb-3"><%= i18n.__('catalog.alerts.help') %></div>
						<div class="alert alert-warning rounded-0 py-2 small d-none" id="no-recipients"><%= i18n.__('catalog.alerts.no_recipients') %></div>
						<% if (perms.edit) { %>
						<div class="row g-2 mb-3">
							<div class="col-md-6 position-relative">
								<input class="form-control rounded-0" id="user-search" autocomplete="off" placeholder="<%= i18n.__('catalog.alerts.user_search') %>" />
								<div class="list-group rounded-0 position-absolute w-100 d-none" style="z-index: 1060; max-height: 240px; overflow: auto" id="user-results"></div>
							</div>
							<div class="col-md-6">
								<select class="form-select rounded-0" id="group-select">
									<option value=""><%= i18n.__('catalog.alerts.group_select') %></option>
								</select>
							</div>
						</div>
						<% } %>
						<div class="table-responsive">
							<table class="table table-sm align-middle">
								<thead>
									<tr>
										<th><%= i18n.__('catalog.alerts.recipient') %></th>
										<% events.forEach((ev) => { %>
										<th class="text-center small" style="max-width: 120px"><%= i18n.__('catalog.alerts.ev.' + ev) %></th>
										<% }) %>
										<th></th>
									</tr>
								</thead>
								<tbody id="rec-body"></tbody>
							</table>
						</div>
						<div class="form-text"><%= i18n.__('catalog.alerts.digital_hint') %></div>
						<% if (perms.edit) { %>
						<div class="mt-3 d-flex gap-2">
							<button class="btn btn-primary rounded-0" id="btn-save"><%= i18n.__('catalog.common.save') %></button>
							<button class="btn btn-outline-secondary rounded-0" id="btn-run"><i class="fa-solid fa-play"></i> <%= i18n.__('catalog.alerts.run_now') %></button>
						</div>
						<% } %>
					</div>
				</div>
				<% } %>

				<h2 class="h5 mb-2"><%= i18n.__('catalog.alerts.low_stock_title') %></h2>
				<div class="form-text mb-2"><%= i18n.__('catalog.alerts.low_stock_hint') %></div>
				<div id="grid"></div>
			</div>
		</main>

		<%- include('../../../partials/footer'); %> <%- include('../../../partials/script'); %>
		<script src="/assets/js/tabulator/tabulator.min.js"></script>
		<script src="/assets/js/notyf/notyf.min.js"></script>
		<script>
			(function () {
				"use strict";

				const PERMS = { settings: <%= perms.settings %>, edit: <%= perms.edit %> };
				const EVENTS = <%- JSON.stringify(events) %>;
				const notyf = new Notyf({ duration: 3000, position: { x: "right", y: "top" } });
				const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[ch]);
				const errMsg = (e) => notyf.error((e && e.error) || "<%= i18n.__('catalog.common.error') %>");

				async function api(url, body) {
					const res = await fetch(url, { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(body || {}) });
					const json = await res.json().catch(() => ({}));
					if (!res.ok || json.ok === false) throw json;
					return json;
				}
				// Існуючі API користувачів/груп приймають form-urlencoded
				async function form(url, data) {
					const res = await fetch(url, { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/x-www-form-urlencoded", Accept: "application/json" }, body: new URLSearchParams(data || {}) });
					return res.json();
				}

				// ── Низький залишок ──
				const grid = new Tabulator("#grid", {
					layout: "fitColumns",
					placeholder: "<%= i18n.__('catalog.alerts.empty') %>",
					pagination: true,
					paginationSize: 50,
					columns: [
						{ title: "<%= i18n.__('catalog.alerts.col.product') %>", field: "name", formatter: (c) => `<a href="/catalog/products/${c.getRow().getData().id_product}/" target="_blank">${esc(c.getValue())}</a>` },
						{ title: "SKU", field: "sku", width: 150, formatter: (c) => esc(c.getValue()) },
						{ title: "<%= i18n.__('catalog.alerts.col.warehouse') %>", field: "warehouse", width: 170, formatter: (c) => esc(c.getValue()) },
						{ title: "<%= i18n.__('catalog.alerts.col.available') %>", field: "available", width: 120, hozAlign: "right", formatter: (c) => `<span class="${Number(c.getValue()) <= 0 ? "text-danger fw-semibold" : "text-warning"}">${Number(c.getValue())}</span>` },
						{ title: "<%= i18n.__('catalog.alerts.col.reserved') %>", field: "reserved", width: 110, hozAlign: "right", formatter: (c) => Number(c.getValue()) },
						{ title: "<%= i18n.__('catalog.alerts.col.reorder_point') %>", field: "reorder_point", width: 140, hozAlign: "right", formatter: (c) => Number(c.getValue()) },
						{ title: "<%= i18n.__('catalog.alerts.col.reorder_qty') %>", field: "reorder_qty", width: 140, hozAlign: "right", formatter: (c) => (c.getValue() == null ? "—" : Number(c.getValue())) },
					],
				});
				grid.on("tableBuilt", () => api("/api/catalog/products/alerts/low-stock/").then((r) => grid.replaceData(r.rows)).catch(errMsg));

				if (!PERMS.settings) return;

				// ── Отримувачі: рядок на користувача/групу, прапорці подій — в options отримувача ──
				const rec = new Map(); // "user:5" → { kind, ref, name, events }
				const body = document.getElementById("rec-body");
				function render() {
					body.innerHTML = [...rec.values()]
						.map((r) => {
							const k = r.kind + ":" + r.ref;
							const cells = EVENTS.map((ev) => `<td class="text-center"><input class="form-check-input" type="checkbox" data-k="${esc(k)}" data-ev="${ev}" ${r.events[ev] ? "checked" : ""} ${PERMS.edit ? "" : "disabled"}></td>`).join("");
							const icon = r.kind === "group" ? "fa-users" : "fa-user";
							return `<tr><td><i class="fa-solid ${icon} text-muted me-1"></i>${esc(r.name)}</td>${cells}<td class="text-end">${PERMS.edit ? `<button type="button" class="btn btn-sm btn-outline-danger rounded-0" data-rm="${esc(k)}"><i class="fa-solid fa-xmark"></i></button>` : ""}</td></tr>`;
						})
						.join("");
					document.getElementById("no-recipients").classList.toggle("d-none", rec.size > 0);
				}
				const add = (kind, ref, name) => {
					const k = kind + ":" + ref;
					if (rec.has(k)) return;
					const events = {};
					EVENTS.forEach((ev) => (events[ev] = true));
					rec.set(k, { kind, ref: String(ref), name, events });
					render();
				};
				body.addEventListener("change", (e) => {
					const cb = e.target.closest("[data-ev]");
					if (cb && rec.has(cb.dataset.k)) rec.get(cb.dataset.k).events[cb.dataset.ev] = cb.checked;
				});
				body.addEventListener("click", (e) => {
					const b = e.target.closest("[data-rm]");
					if (!b) return;
					rec.delete(b.dataset.rm);
					render();
				});

				const search = document.getElementById("user-search");
				const results = document.getElementById("user-results");
				if (search) {
					let st;
					search.addEventListener("input", () => {
						clearTimeout(st);
						const q = search.value.trim();
						if (q.length < 2) return results.classList.add("d-none");
						st = setTimeout(async () => {
							try {
								const list = await form("/api/calendar/users/search", { q });
								results.innerHTML = (list || [])
									.map((u) => {
										const name = u.user_name || [u.first_name, u.last_name].filter(Boolean).join(" ") || "#" + u.id;
										return `<button type="button" class="list-group-item list-group-item-action small py-1" data-uid="${esc(u.id)}" data-name="${esc(name)}">${esc(name)}</button>`;
									})
									.join("");
								results.classList.toggle("d-none", !(list && list.length));
							} catch (err) {
								errMsg(err);
							}
						}, 300);
					});
					results.addEventListener("click", (e) => {
						const b = e.target.closest("[data-uid]");
						if (!b) return;
						add("user", b.dataset.uid, b.dataset.name);
						search.value = "";
						results.classList.add("d-none");
					});
				}
				const groupSel = document.getElementById("group-select");
				if (groupSel) {
					groupSel.addEventListener("change", () => {
						if (!groupSel.value) return;
						add("group", groupSel.value, groupSel.selectedOptions[0].textContent);
						groupSel.value = "";
					});
				}

				async function load() {
					const [r, gr] = await Promise.all([api("/api/catalog/products/alerts/recipients/"), groupSel ? form("/api/users/groups/list").catch(() => ({})) : {}]);
					if (groupSel) ((gr && gr.data) || []).forEach((g) => groupSel.add(new Option(g.name, g.id)));
					r.rows.forEach((x) => rec.set(x.kind + ":" + x.ref, { kind: x.kind, ref: String(x.ref), name: x.name || "#" + x.ref, events: x.events }));
					render();
				}
				load().catch(errMsg);

				const saveBtn = document.getElementById("btn-save");
				if (saveBtn)
					saveBtn.addEventListener("click", async () => {
						saveBtn.disabled = true;
						try {
							await api("/api/catalog/products/alerts/recipients/save/", { recipients: [...rec.values()].map((r) => ({ kind: r.kind, ref: r.ref, events: r.events })) });
							notyf.success("<%= i18n.__('catalog.common.saved') %>");
						} catch (err) {
							errMsg(err);
						} finally {
							saveBtn.disabled = false;
						}
					});
				const runBtn = document.getElementById("btn-run");
				if (runBtn)
					runBtn.addEventListener("click", async () => {
						runBtn.disabled = true;
						try {
							await api("/api/catalog/products/alerts/run/");
							notyf.success("<%= i18n.__('catalog.alerts.run_done') %>");
						} catch (err) {
							errMsg(err);
						} finally {
							runBtn.disabled = false;
						}
					});
			})();
		</script>
	</body>
</html>
