                    var _cfCurrentData = null;

                    window.cfOpenEditModal = function (d) {
                        _cfCurrentData = d;
                        $('#cf_id_field').val(d.id);
                        $('#modalCFTitle').text((d.icon ? '' : '') + (d.label || 'Редагувати поле') + (d.is_required ? ' *' : ''));
                        $('#cf_label').text(d.label + (d.is_required ? ' *' : ''));
                        $('#cf_hint').text(d.hint || '').toggle(!!d.hint);

                        var wrap = $('#cf_input_wrap');
                        wrap.empty();
                        var val = d.value;
                        var ph = d.placeholder || '';

                        switch (d.field_type) {

                            case 'text':
                            case 'phone':
                            case 'auto':
                                wrap.html('<input type="text" class="form-control form-control-sm rounded-0" id="cf_value" value="' + (val || '') + '" placeholder="' + ph + '">');
                                break;

                            case 'textarea':
                                wrap.html('<textarea class="form-control form-control-sm rounded-0" id="cf_value" rows="4" placeholder="' + ph + '">' + (val || '') + '</textarea>');
                                break;

                            case 'editor':
                                wrap.html('<textarea class="form-control form-control-sm rounded-0" id="cf_value" rows="6">' + (val || '') + '</textarea>');
                                if (typeof tinymce !== 'undefined') {
                                    tinymce.remove('#cf_value');
                                    tinymce.init({
                                        selector: '#cf_value',
                                        height: 250,
                                        menubar: false,
                                        plugins: 'lists link',
                                        toolbar: 'bold italic underline | bullist numlist | link',
                                    });
                                }
                                break;

                            case 'number':
                                wrap.html('<input type="number" class="form-control form-control-sm rounded-0" id="cf_value" value="' + (val || '') + '" step="1" placeholder="' + ph + '">');
                                break;

                            case 'decimal':
                                wrap.html('<input type="number" class="form-control form-control-sm rounded-0" id="cf_value" value="' + (val || '') + '" step="0.01" placeholder="' + ph + '">');
                                break;

                            case 'email':
                                wrap.html('<input type="email" class="form-control form-control-sm rounded-0" id="cf_value" value="' + (val || '') + '" placeholder="' + (ph || 'email@example.com') + '">');
                                break;

                            case 'url':
                                wrap.html('<input type="url" class="form-control form-control-sm rounded-0" id="cf_value" value="' + (val || '') + '" placeholder="' + (ph || 'https://') + '">');
                                break;

                            case 'date':
                                wrap.html('<input type="date" class="form-control form-control-sm rounded-0" id="cf_value" value="' + (val ? val.substring(0, 10) : '') + '">');
                                break;

                            case 'datetime':
                                wrap.html('<input type="datetime-local" class="form-control form-control-sm rounded-0" id="cf_value" value="' + (val ? val.substring(0, 16) : '') + '">');
                                break;

                            case 'checkbox':
                                wrap.html(
                                    '<div class="form-check">' +
                                    '<input class="form-check-input" type="checkbox" id="cf_value" ' + (val == 1 ? 'checked' : '') + '>' +
                                    '<label class="form-check-label small" for="cf_value">Так</label>' +
                                    '</div>'
                                );
                                break;

                            case 'radio':
                                var radioHtml = '';
                                (d.options || []).forEach(function (o) {
                                    var checked = (val === o.value || val === o.name) ? 'checked' : '';
                                    radioHtml +=
                                        '<div class="form-check">' +
                                        '<input class="form-check-input" type="radio" name="cf_radio" id="cf_radio_' + o.id + '" value="' + (o.value || o.name) + '" ' + checked + '>' +
                                        '<label class="form-check-label small" for="cf_radio_' + o.id + '">' + o.name + '</label>' +
                                        '</div>';
                                });
                                wrap.html(radioHtml || '<span class="text-muted small">Немає варіантів</span>');
                                break;

                            case 'select':
                                var selHtml = '<select class="form-select form-select-sm rounded-0" id="cf_value"><option value="">— не вказано —</option>';
                                (d.options || []).forEach(function (o) {
                                    var v = o.value || o.name;
                                    var sel = (val === v) ? 'selected' : '';
                                    selHtml += '<option value="' + v + '" ' + sel + '>' + o.name + '</option>';
                                });
                                selHtml += '</select>';
                                wrap.html(selHtml);
                                break;

                            case 'multiselect':
                                var msVal = [];
                                try { msVal = typeof val === 'string' ? JSON.parse(val) : (val || []); } catch (e) { }
                                var msHtml = '<select class="form-select form-select-sm rounded-0" id="cf_value" multiple size="5">';
                                (d.options || []).forEach(function (o) {
                                    var v = o.value || o.name;
                                    var sel = msVal.includes(v) ? 'selected' : '';
                                    msHtml += '<option value="' + v + '" ' + sel + '>' + o.name + '</option>';
                                });
                                msHtml += '</select><div class="form-text">Ctrl+клік для вибору кількох</div>';
                                wrap.html(msHtml);
                                break;

                            case 'tags':
                                var tagsVal = [];
                                try { tagsVal = typeof val === 'string' ? JSON.parse(val) : (val || []); } catch (e) { }
                                wrap.html(
                                    '<input type="text" class="form-control form-control-sm rounded-0" id="cf_value" value="' + tagsVal.join(', ') + '" placeholder="Тег1, Тег2, Тег3">' +
                                    '<div class="form-text">Вводьте теги через кому</div>'
                                );
                                break;

                            default:
                                wrap.html('<input type="text" class="form-control form-control-sm rounded-0" id="cf_value" value="' + (val || '') + '" placeholder="' + ph + '">');
                        }

                        $('#modalCustomField').modal('show');
                    };

                    // Збереження значення
                    $('#btnSaveCF').on('click', function () {
                        var d = _cfCurrentData;
                        var id = $('#cf_id_field').val();
                        var value = null;

                        switch (d.field_type) {
                            case 'checkbox':
                                value = $('#cf_value').is(':checked') ? 1 : 0;
                                break;
                            case 'radio':
                                value = $('input[name="cf_radio"]:checked').val() || null;
                                break;
                            case 'multiselect':
                                value = JSON.stringify($('#cf_value').val() || []);
                                break;
                            case 'tags':
                                var tags = $('#cf_value').val().split(',').map(function (t) { return t.trim(); }).filter(Boolean);
                                value = JSON.stringify(tags);
                                break;
                            case 'editor':
                                value = typeof tinymce !== 'undefined' && tinymce.get('cf_value')
                                    ? tinymce.get('cf_value').getContent()
                                    : $('#cf_value').val();
                                break;
                            default:
                                value = $('#cf_value').val();
                        }

                        if (d.is_required && (value === null || value === '' || value === '[]')) {
                            alert('Поле "' + d.label + '" є обов\'язковим');
                            return;
                        }

                        $.post('/api/deals/' + DEAL_ID + '/custom-fields/' + id + '/save', {
                            field_type: d.field_type,
                            value: value
                        })
                            .done(function () {
                                $('#modalCustomField').modal('hide');
                                customFieldsTable.replaceData();
                            })
                            .fail(function () { alert('Помилка збереження'); });
                    });


                    // ============================================================
                    // КАСТОМНІ ПОЛЯ — додавання / редагування поля
                    // ============================================================

                    function cfResetAddModal() {
                        $('#nf_id').val('');
                        $('#modalAddCFTitle').text('Додати поле');
                        $('#nf_type').val('').prop('disabled', false);
                        $('#nf_key').val('').removeData('manual');
                        $('#nf_label').val('');
                        $('#nf_hint').val('');
                        $('#nf_icon').val('');
                        $('#nf_icon_preview').html('<i class="fa-solid fa-circle-question"></i>');
                        $('#nf_pipeline').val('');
                        $('#nf_default').val('');
                        $('#nf_sort').val(0);
                        $('#nf_required').prop('checked', false);
                        $('#nf_unique').prop('checked', false);
                        $('#nf_show_list').prop('checked', false);
                        $('#nf_show_kanban').prop('checked', false);
                        $('#nf_options_wrap').hide();
                        $('#nf_options_list').empty();
                        $('#nf_default_wrap').show();
                    }

                    // Відкрити modal — додати
                    $('#btnAddCustomField').on('click', function () {
                        cfResetAddModal();
                        $('#modalAddCustomField').modal('show');
                    });

                    // Відкрити modal — редагувати поле (викликається з Tabulator)
                    window.cfOpenFieldModal = function (d) {
                        cfResetAddModal();
                        $('#nf_id').val(d.id);
                        $('#modalAddCFTitle').text('Редагувати поле');
                        $('#nf_type').val(d.field_type).prop('disabled', true); // тип не міняємо
                        $('#nf_key').val(d.field_key);
                        $('#nf_label').val(d.label);
                        $('#nf_hint').val(d.hint || '');
                        $('#nf_icon').val(d.icon || '');
                        $('#nf_icon_preview').html(d.icon ? '<i class="' + d.icon + '"></i>' : '<i class="fa-solid fa-circle-question"></i>');
                        $('#nf_pipeline').val(d.id_pipeline || '');
                        $('#nf_default').val(d.default_value || '');
                        $('#nf_sort').val(d.sort_order || 0);
                        $('#nf_required').prop('checked', d.is_required == 1);
                        $('#nf_unique').prop('checked', d.is_unique == 1);
                        $('#nf_show_list').prop('checked', d.show_in_list == 1);
                        $('#nf_show_kanban').prop('checked', d.show_in_kanban == 1);

                        // Показуємо варіанти якщо потрібно
                        if (['select', 'multiselect', 'radio'].includes(d.field_type)) {
                            $('#nf_options_wrap').show();
                            (d.options || []).forEach(function (o) {
                                $('#nf_options_list').append(cfOptionRow(o.name, o.value || ''));
                            });
                        }

                        var hideDefault = ['checkbox', 'editor'].includes(d.field_type);
                        $('#nf_default_wrap').toggle(!hideDefault);

                        $('#modalAddCustomField').modal('show');
                    };

                    // Рядок варіанту
                    function cfOptionRow(name, value) {
                        return '<div class="d-flex gap-2 mb-2 nf-option-row">' +
                            '<input type="text" class="form-control form-control-sm rounded-0 nf-opt-name" placeholder="Назва" value="' + (name || '') + '">' +
                            '<input type="text" class="form-control form-control-sm rounded-0 nf-opt-value" placeholder="Значення (необов\'язково)" value="' + (value || '') + '" style="max-width:180px">' +
                            '<button type="button" class="btn btn-outline-danger btn-sm rounded-0 btn-remove-option">' +
                            '<i class="fa-solid fa-xmark"></i></button>' +
                            '</div>';
                    }

                    // Показати/сховати варіанти і default залежно від типу
                    $('#nf_type').on('change', function () {
                        var t = $(this).val();
                        $('#nf_options_wrap').toggle(['select', 'multiselect', 'radio'].includes(t));
                        $('#nf_default_wrap').toggle(!['checkbox', 'editor'].includes(t));
                    });

                    // Preview іконки
                    $('#nf_icon').on('input', function () {
                        var v = $.trim($(this).val());
                        $('#nf_icon_preview').html(v ? '<i class="' + v + '"></i>' : '<i class="fa-solid fa-circle-question"></i>');
                    });

                    // Додати варіант
                    $('#btnAddOption').on('click', function () {
                        $('#nf_options_list').append(cfOptionRow('', ''));
                    });

                    // Видалити варіант
                    $(document).on('click', '.btn-remove-option', function () {
                        $(this).closest('.nf-option-row').remove();
                    });

                    // Авто-генерація ключа з назви (тільки при додаванні)
                    $('#nf_label').on('input', function () {
                        if ($('#nf_id').val()) return; // не міняємо при редагуванні
                        if ($('#nf_key').data('manual')) return;
                        var key = $(this).val()
                            .toLowerCase()
                            .replace(/\s+/g, '_')
                            .replace(/[^a-z0-9_]/g, '')
                            .substring(0, 50);
                        $('#nf_key').val(key);
                    });

                    $('#nf_key').on('input', function () {
                        $(this).data('manual', true);
                    });

                    // Збереження поля
                    $('#btnSaveNewField').on('click', function () {
                        var id = $('#nf_id').val();
                        var type = $('#nf_type').val();
                        var label = $.trim($('#nf_label').val());

                        if (!type) { alert('Оберіть тип поля'); return; }
                        if (!label) { alert('Вкажіть назву поля'); return; }

                        // Збираємо варіанти
                        var options = [];
                        $('#nf_options_list .nf-option-row').each(function () {
                            var name = $.trim($(this).find('.nf-opt-name').val());
                            var val = $.trim($(this).find('.nf-opt-value').val());
                            if (name) options.push({ name: name, value: val || name });
                        });

                        var url = id
                            ? '/api/deals/custom-fields/' + id + '/edit'
                            : '/api/deals/custom-fields/add';

                        $.post(url, {
                            field_type: type,
                            field_key: $.trim($('#nf_key').val()),
                            label: label,
                            hint: $('#nf_hint').val(),
                            icon: $('#nf_icon').val(),
                            id_pipeline: $('#nf_pipeline').val(),
                            default_value: $('#nf_default').val(),
                            sort_order: $('#nf_sort').val(),
                            is_required: $('#nf_required').is(':checked') ? 1 : 0,
                            is_unique: $('#nf_unique').is(':checked') ? 1 : 0,
                            show_in_list: $('#nf_show_list').is(':checked') ? 1 : 0,
                            show_in_kanban: $('#nf_show_kanban').is(':checked') ? 1 : 0,
                            options: JSON.stringify(options)
                        })
                            .done(function (r) {
                                if (r.ok) {
                                    $('#modalAddCustomField').modal('hide');
                                    customFieldsTable.replaceData();
                                } else {
                                    alert(r.error || 'Помилка збереження');
                                }
                            })
                            .fail(function () { alert('Помилка збереження'); });
                    });
                </script>
                <script>
                    // ============================================================
                    // КАЛЕНДАР УГОДИ — FullCalendar 6.x + Flatpickr + Tabulator
                    // ============================================================

                    // ------------------------------------------------------------
                    // Flatpickr — інціалізація полів дати/часу
                    // ------------------------------------------------------------
                    var fpStartDate = flatpickr("#ce_date_start", {
                        dateFormat: "d.m.Y",
                        locale: "uk",
                        allowInput: true
                    });
                    var fpEndDate = flatpickr("#ce_date_end", {
                        dateFormat: "d.m.Y",
                        locale: "uk",
                        allowInput: true
                    });
                    var fpStartTime = flatpickr("#ce_time_start", {
                        enableTime: true,
                        noCalendar: true,
                        dateFormat: "H:i",
                        time_24hr: true,
                        minuteIncrement: 5,
                        locale: "uk",
                        allowInput: true
                    });
                    var fpEndTime = flatpickr("#ce_time_end", {
                        enableTime: true,
                        noCalendar: true,
                        dateFormat: "H:i",
                        time_24hr: true,
                        minuteIncrement: 5,
                        locale: "uk",
                        allowInput: true
                    });

                    // Перемикання видимості полів часу при "Увесь день"
                    $('#ce_all_day').on('change', function () {
                        var allDay = $(this).is(':checked');
                        $('#ce_time_start_block, #ce_time_end_block').toggle(!allDay);
                    });

                    // Перемикання видимості мульти-select учасників при зміні видимості
                    $('#ce_visibility_type').on('change', function () {
                        $('#ce_custom_users_block').toggle($(this).val() === 'custom');
                    });

                    // Перемикання видимості блоку хвилин нагадування
                    $('#ce_reminder').on('change', function () {
                        $('#ce_reminder_minutes_block').toggle($(this).is(':checked'));
                    });

                    // ------------------------------------------------------------
                    // Допоміжні функції об'єднання/розбиття дати+часу
                    // ------------------------------------------------------------
                    function ceCombineDateTime(dateStr, timeStr, isAllDay, isEnd) {
                        // dateStr формат d.m.Y, timeStr формат H:i
                        if (!dateStr) return null;
                        var parts = dateStr.split('.');
                        var iso = parts[2] + '-' + parts[1] + '-' + parts[0];
                        if (isAllDay) {
                            return iso + ' ' + (isEnd ? '23:59:00' : '00:00:00');
                        }
                        var time = (timeStr || '00:00') + ':00';
                        return iso + ' ' + time;
                    }

                    function ceSplitDateTime(datetimeStr) {
                        // datetimeStr формат "YYYY-MM-DD HH:mm:ss" (з MySQL) -> { date: "d.m.Y", time: "H:i" }
                        if (!datetimeStr) return { date: '', time: '' };
                        var dt = new Date(datetimeStr.replace(' ', 'T'));
                        var d = String(dt.getDate()).padStart(2, '0');
                        var m = String(dt.getMonth() + 1).padStart(2, '0');
                        var y = dt.getFullYear();
                        var h = String(dt.getHours()).padStart(2, '0');
                        var min = String(dt.getMinutes()).padStart(2, '0');
                        return { date: d + '.' + m + '.' + y, time: h + ':' + min };
                    }

                    // ------------------------------------------------------------
                    // Підвантаження типів подій (AJAX, кожного разу при відкритті модалки)
                    // ------------------------------------------------------------
                    function ceLoadEventTypes(selectedId) {
                        return $.post('/api/deals/' + DEAL_ID + '/calendar/event-types')
                            .done(function (types) {
                                var $select = $('#ce_event_type');
                                $select.empty();
                                $select.append('<option value="">— не вказано —</option>');
                                types.forEach(function (t) {
                                    $select.append(
                                        '<option value="' + t.id + '" data-color="' + (t.color || '#6c757d') + '">'
                                        + (t.icon ? '' : '') + t.name + '</option>'
                                    );
                                });
                                if (selectedId) $select.val(selectedId);
                            })
                            .fail(function () {
                                console.error('Не вдалося завантажити типи подій');
                            });
                    }

                    // ------------------------------------------------------------
                    // Відкриття модалки — режим створення
                    // ------------------------------------------------------------
                    function ceOpenCreateModal(prefilledStart) {
                        $('#ce_id').val('');
                        $('#modalCalendarEventTitle').text('Нова подія');
                        ceLoadEventTypes();
                        $('#ce_priority').val(2);
                        $('#ce_title').val('');
                        $('#ce_description').val('');
                        $('#ce_all_day').prop('checked', false);
                        $('#ce_time_start_block, #ce_time_end_block').show();
                        $('#ce_visibility_type').val('all');
                        $('#ce_custom_users_block').hide();
                        $('#ce_custom_users').val([]);
                        $('#ce_status').val('planned');
                        $('#ce_reminder').prop('checked', false);
                        $('#ce_reminder_minutes_block').hide();
                        $('#ce_reminder_minutes').val(30);

                        if (prefilledStart) {
                            var d = String(prefilledStart.getDate()).padStart(2, '0');
                            var m = String(prefilledStart.getMonth() + 1).padStart(2, '0');
                            var y = prefilledStart.getFullYear();
                            fpStartDate.setDate(d + '.' + m + '.' + y, true);
                            fpEndDate.setDate(d + '.' + m + '.' + y, true);
                        } else {
                            fpStartDate.clear();
                            fpEndDate.clear();
                        }
                        fpStartTime.clear();
                        fpEndTime.clear();

                        $('#modalCalendarEvent').modal('show');
                    }

                    // ------------------------------------------------------------
                    // Відкриття модалки — режим редагування
                    // ------------------------------------------------------------
                    function ceOpenEditModal(eventId) {
                        $.post('/api/deals/' + DEAL_ID + '/calendar/events/' + eventId)
                            .done(function (d) {
                                $('#ce_id').val(d.id);
                                $('#modalCalendarEventTitle').text('Редагувати подію');
                                ceLoadEventTypes(d.id_event_type || '');
                                $('#ce_priority').val(d.priority || 2);
                                $('#ce_title').val(d.title);
                                $('#ce_description').val(d.description || '');
                                $('#ce_all_day').prop('checked', d.all_day == 1);
                                $('#ce_time_start_block, #ce_time_end_block').toggle(d.all_day != 1);

                                var startParts = ceSplitDateTime(d.date_start);
                                var endParts = ceSplitDateTime(d.date_end);
                                fpStartDate.setDate(startParts.date, true);
                                fpStartTime.setDate(startParts.time, true);
                                fpEndDate.setDate(endParts.date, true);
                                fpEndTime.setDate(endParts.time, true);

                                $('#ce_visibility_type').val(d.visibility_type || 'all');
                                $('#ce_custom_users_block').toggle(d.visibility_type === 'custom');
                                $('#ce_custom_users').val((d.custom_user_ids || []).map(String));

                                $('#ce_status').val(d.status || 'planned');
                                $('#ce_reminder').prop('checked', d.reminder == 1);
                                $('#ce_reminder_minutes_block').toggle(d.reminder == 1);
                                $('#ce_reminder_minutes').val(d.reminder_minutes || 30);

                                $('#modalCalendarEvent').modal('show');
                            })
                            .fail(function () { alert('Помилка завантаження події'); });
                    }

                    // Кнопки відкриття створення
                    $('#btnAddCalendarEvent, #btnAddCalendarEventFromTab').on('click', function () {
                        ceOpenCreateModal();
                    });

                    // ------------------------------------------------------------
                    // Збереження події (створення / редагування)
                    // ------------------------------------------------------------
                    $('#btnSaveCalendarEvent').on('click', function () {
                        var title = $.trim($('#ce_title').val());
                        if (!title) { alert('Вкажіть назву події'); return; }

                        var allDay = $('#ce_all_day').is(':checked');
                        var dateStartStr = $('#ce_date_start').val();
                        var dateEndStr = $('#ce_date_end').val();

                        if (!dateStartStr || !dateEndStr) { alert('Вкажіть дати початку і кінця'); return; }
                        if (!allDay && (!$('#ce_time_start').val() || !$('#ce_time_end').val())) {
                            alert('Вкажіть час початку і кінця');
                            return;
                        }

                        var date_start = ceCombineDateTime(dateStartStr, $('#ce_time_start').val(), allDay, false);
                        var date_end = ceCombineDateTime(dateEndStr, $('#ce_time_end').val(), allDay, true);

                        if (new Date(date_end.replace(' ', 'T')) < new Date(date_start.replace(' ', 'T'))) {
                            alert('Дата кінця не може бути раніше дати початку');
                            return;
                        }

                        var visibility_type = $('#ce_visibility_type').val();
                        var custom_user_ids = visibility_type === 'custom'
                            ? ($('#ce_custom_users').val() || []).map(Number)
                            : [];

                        var id = $('#ce_id').val();
                        var url = id
                            ? '/api/deals/' + DEAL_ID + '/calendar/events/' + id + '/edit'
                            : '/api/deals/' + DEAL_ID + '/calendar/events/add';

                        $.post(url, {
                            id_event_type: $('#ce_event_type').val() || null,
                            title: title,
                            description: $('#ce_description').val(),
                            date_start: date_start,
                            date_end: date_end,
                            all_day: allDay ? 1 : 0,
                            priority: $('#ce_priority').val(),
                            status: $('#ce_status').val(),
                            visibility_type: visibility_type,
                            custom_user_ids: custom_user_ids,
                            reminder: $('#ce_reminder').is(':checked') ? 1 : 0,
                            reminder_minutes: $('#ce_reminder_minutes').val()
                        })
                            .done(function () {
                                $('#modalCalendarEvent').modal('hide');
                                dealCalendar.refetchEvents();
                                if (calendarEventsTable) calendarEventsTable.replaceData();
                            })
                            .fail(function (xhr) {
                                alert(xhr.responseJSON && xhr.responseJSON.error ? xhr.responseJSON.error : 'Помилка збереження');
                            });
                    });

                    // ------------------------------------------------------------
                    // Видалення події (через делегування, працює і з календаря, і з таблиці)
                    // ------------------------------------------------------------
                    $(document).on('click', '.btn-calendar-event-delete', function (e) {
                        e.preventDefault();
                        var id = $(this).data('id');
                        $('#modalConfirmText').text('Видалити подію календаря?');
                        $('#modalConfirmDelete').modal('show');
                        $('#btnConfirmDelete').off('click').on('click', function () {
                            $.post('/api/deals/' + DEAL_ID + '/calendar/events/' + id + '/delete')
                                .done(function () {
                                    $('#modalConfirmDelete').modal('hide');
                                    dealCalendar.refetchEvents();
                                    if (calendarEventsTable) calendarEventsTable.replaceData();
                                })
                                .fail(function () { alert('Помилка видалення'); });
                        });
                    });

                    window.calendarEventDelete = function (id) {
                        $('.btn-calendar-event-delete[data-id="' + id + '"]').trigger('click');
                    };

                    // ------------------------------------------------------------
                    // FullCalendar 6.x — інціалізація (ES modules через CDN)
                    // ------------------------------------------------------------
                    var dealCalendar;
                    import('https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js')
                        .then(function () {
                            var calendarEl = document.getElementById('dealCalendar');
                            dealCalendar = new FullCalendar.Calendar(calendarEl, {
                                initialView: 'dayGridMonth',
                                locale: 'uk',
                                firstDay: 1,
                                height: 600,
                                themeSystem: 'bootstrap5',
                                headerToolbar: {
                                    left: 'prev,next today',
                                    center: 'title',
                                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                                },
                                buttonText: {
                                    today: 'Сьогодні',
                                    month: 'Місяць',
                                    week: 'Тиждень',
                                    day: 'День',
                                    list: 'Список'
                                },
                                selectable: true,
                                editable: true,
                                eventResizableFromStart: true,
                                events: function (info, successCallback, failureCallback) {
                                    $.post('/api/deals/' + DEAL_ID + '/calendar/events', {
                                        start: info.startStr,
                                        end: info.endStr
                                    })
                                        .done(function (events) { successCallback(events); })
                                        .fail(function () { failureCallback(); });
                                },
                                select: function (info) {
                                    ceOpenCreateModal(info.start);
                                },
                                eventClick: function (info) {
                                    ceOpenEditModal(info.event.id);
                                },
                                eventDrop: function (info) {
                                    ceReschedule(info.event);
                                },
                                eventResize: function (info) {
                                    ceReschedule(info.event);
                                }
                            });
                            dealCalendar.render();
                        });

                    function ceReschedule(event) {
                        var pad = function (n) { return String(n).padStart(2, '0'); };
                        var toMysql = function (dt) {
                            return dt.getFullYear() + '-' + pad(dt.getMonth() + 1) + '-' + pad(dt.getDate()) + ' ' +
                                pad(dt.getHours()) + ':' + pad(dt.getMinutes()) + ':00';
                        };
                        $.post('/api/deals/' + DEAL_ID + '/calendar/events/' + event.id + '/reschedule', {
                            date_start: toMysql(event.start),
                            date_end: toMysql(event.end || event.start)
                        })
                            .done(function () {
                                if (calendarEventsTable) calendarEventsTable.replaceData();
                            })
                            .fail(function () {
                                alert('Помилка перенесення події');
                                dealCalendar.refetchEvents();
                            });
                    }

                    // ------------------------------------------------------------
                    // Tabulator — повний список подій (таб "Календар")
                    // ------------------------------------------------------------
                    var calendarEventsTable = new Tabulator("#calendar-events-table", {
                        layout: "fitColumns",
                        ajaxURL: "/api/deals/" + DEAL_ID + "/calendar/events/list",
                        ajaxConfig: "POST",
                        pagination: true,
                        paginationMode: "local",
                        paginationSize: 20,
                        paginationSizeSelector: [10, 20, 50, 100],
                        movableColumns: true,
                        columns: [
                            {
                                title: "Тип", field: "type_name", width: 130, hozAlign: "center",
                                formatter: function (cell) {
                                    var d = cell.getRow().getData();
                                    if (!d.type_name) return '—';
                                    return '<span class="badge rounded-0" style="background:' + (d.type_color || '#6c757d') + ';color:#fff">'
                                        + (d.type_icon ? '<i class="' + d.type_icon + ' me-1"></i>' : '') + d.type_name + '</span>';
                                }
                            },
                            { title: "Назва", field: "title", widthGrow: 2 },
                            {
                                title: "Початок", field: "date_start", width: 140, hozAlign: "center",
                                formatter: function (cell) { return cell.getValue() ? new Date(cell.getValue().replace(' ', 'T')).toLocaleString('uk-UA') : '—'; }
                            },
                            {
                                title: "Кінець", field: "date_end", width: 140, hozAlign: "center",
                                formatter: function (cell) { return cell.getValue() ? new Date(cell.getValue().replace(' ', 'T')).toLocaleString('uk-UA') : '—'; }
                            },
                            {
                                title: "Статус", field: "status", width: 120, hozAlign: "center",
                                formatter: function (cell) {
                                    var labels = { planned: 'Заплановано', done: 'Виконано', canceled: 'Скасовано' };
                                    var classes = { planned: 'bg-primary', done: 'bg-success', canceled: 'bg-secondary' };
                                    var v = cell.getValue();
                                    return '<span class="badge rounded-0 ' + (classes[v] || 'bg-light') + '">' + (labels[v] || v) + '</span>';
                                }
                            },
                            {
                                title: "Пріоритет", field: "priority", width: 100, hozAlign: "center",
                                formatter: function (cell) {
                                    var labels = { 4: 'Критичний', 3: 'Високий', 2: 'Середній', 1: 'Низький' };
                                    var colors = { 4: 'text-danger', 3: 'text-warning', 2: 'text-secondary', 1: 'text-muted' };
                                    var v = cell.getValue();
                                    return '<span class="' + (colors[v] || 'text-muted') + '">' + (labels[v] || '—') + '</span>';
                                }
                            },
                            {
                                title: "Видимість", field: "visibility_type", width: 140,
                                formatter: function (cell) {
                                    var d = cell.getRow().getData();
                                    var labels = { all: 'Усі менеджери', private: 'Тільки я', custom: d.custom_users_names || 'Вибрані' };
                                    return labels[cell.getValue()] || '—';
                                }
                            },
                            {
                                title: "Створив", field: "creator_name", width: 150,
                                formatter: function (cell) { return cell.getValue() || '—'; }
                            },
                            {
                                title: "", field: "id", width: 70, hozAlign: "center", headerSort: false,
                                formatter: function (cell) {
                                    var id = cell.getValue();
                                    return '<a href="#" class="btn-calendar-event-edit text-primary me-2" data-id="' + id + '"><i class="fa-regular fa-pen-to-square fa-xs"></i></a>'
                                        + '<a href="#" class="btn-calendar-event-delete text-danger" data-id="' + id + '"><i class="fa-solid fa-trash fa-xs"></i></a>';
                                }
                            },
                        ]
                    });

                    $(document).on('click', '.btn-calendar-event-edit', function (e) {
                        e.preventDefault();
                        ceOpenEditModal($(this).data('id'));
                    });
                </script>
</body>

</html>