                </script>
                <script>
                    // ============================================================
                    // ЙМОВІРНІСТЬ — inline редагування
                    // ============================================================
                    (function () {
                        const display = document.getElementById('prob-display');
                        const input = document.getElementById('prob-input');
                        const icon = document.getElementById('prob-edit-icon');
                        const overrideIcon = document.querySelector('#prob-display ~ .fa-user');
                        const bar = document.getElementById('prob-progress-bar');
                        if (!display) return;

                        function getColorClass(v) {
                            if (v >= 75) return 'text-success';
                            if (v >= 50) return 'text-warning';
                            return 'text-danger';
                        }

                        function getBarClass(v) {
                            if (v >= 75) return 'bg-success';
                            if (v >= 50) return 'bg-warning';
                            if (v >= 25) return 'bg-info';
                            return 'bg-danger';
                        }

                        function enterEdit() {
                            if (overrideIcon) overrideIcon.classList.add('d-none');
                            display.classList.add('d-none');
                            icon.classList.add('d-none');
                            input.classList.remove('d-none');
                            input.focus();
                            input.select();
                        }

                        function exitEdit() {
                            if (overrideIcon) overrideIcon.classList.remove('d-none');
                            input.classList.add('d-none');
                            display.classList.remove('d-none');
                            icon.classList.remove('d-none');

                            // Повертаємо поточне значення
                            const currVal = parseInt(display.dataset.current);
                            input.value = currVal;

                            // Повертаємо колір прогрес-бару
                            bar.style.width = currVal + '%';
                            bar.className = bar.className
                                .replace(/bg-(success|warning|info|danger)/g, '') + ' ' + getBarClass(currVal);
                        }

                        function save() {
                            let newVal = parseInt(input.value);
                            if (isNaN(newVal)) { exitEdit(); return; }
                            if (newVal < 0) newVal = 0;
                            if (newVal > 100) newVal = 100;

                            const currVal = parseInt(display.dataset.current);
                            if (newVal === currVal) { exitEdit(); return; }

                            $.post('/api/deals/' + DEAL_ID + '/probability', { probability: newVal })
                                .done(function (r) {
                                    if (r.ok) {
                                        // Оновлюємо текст
                                        display.textContent = newVal + '%';
                                        display.dataset.current = newVal;

                                        // Оновлюємо колір тексту
                                        display.className = display.className
                                            .replace(/text-(success|warning|danger)/g, '') + ' ' + getColorClass(newVal);

                                        // Оновлюємо прогрес-бар
                                        bar.style.width = newVal + '%';
                                        bar.className = bar.className
                                            .replace(/bg-(success|warning|info|danger)/g, '') + ' ' + getBarClass(newVal);

                                        exitEdit();
                                    }
                                })
                                .fail(function () { alert('Помилка збереження'); exitEdit(); });
                        }

                        // Клік на текст або іконку — входимо в режим редагування
                        display.addEventListener('click', enterEdit);
                        icon.addEventListener('click', enterEdit);

                        // Enter — зберегти, ESC — вийти
                        input.addEventListener('keydown', function (e) {
                            if (e.key === 'Enter') { e.preventDefault(); save(); }
                            if (e.key === 'Escape') { exitEdit(); }
                        });

                        // Втрата фокусу — зберегти
                        input.addEventListener('blur', function () {
                            setTimeout(save, 150);
                        });

                        // Live preview прогрес-бару під час введення
                        input.addEventListener('input', function () {
                            const v = parseInt(this.value) || 0;
                            bar.style.width = Math.min(100, Math.max(0, v)) + '%';
                            bar.className = bar.className
                                .replace(/bg-(success|warning|info|danger)/g, '') + ' ' + getBarClass(v);
                        });
                    })();
                </script>
