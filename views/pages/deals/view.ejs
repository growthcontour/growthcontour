                    // ============================================================
                    window.taskEdit = function (d) {
                        $('#modalTaskTitle').text('Редагувати завдання');
                        $('#task_id').val(d.id);
                        $('#task_title').val(d.title || '');
                        $('#task_description').val(d.description || '');
