                        $('#task_date_due').val(d.date_due ? d.date_due.substring(0, 16) : '');
                        $('#task_priority').val(d.priority || 2);
                        $('#task_estimated').val(d.estimated_minutes || '');
                        $('#task_progress').val(d.progress || 0);
                        $('#task_progress_val').text(d.progress || 0);
                        $('#task_is_private').prop('checked', d.is_private == 1);
                        $('#modalTask').modal('show');
                    };

