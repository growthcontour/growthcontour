                    // ЗАВДАННЯ — збереження
                    // ============================================================
                    $('#btnSaveTask').on('click', function () {
                        var title = $.trim($('#task_title').val());
                        if (!title) { alert('Вкажіть назву завдання'); return; }

                        var id = $('#task_id').val();
                        var url = id
                            ? '/api/deals/' + DEAL_ID + '/tasks/' + id + '/edit'
                            : '/api/deals/' + DEAL_ID + '/tasks/add';

                        $.post(url, {
                            id_user: $('#task_id_user').val(),
                            title: title,
                            description: $('#task_description').val(),
                            date_start: $('#task_date_start').val(),
                            date_due: $('#task_date_due').val(),
                            estimated_minutes: $('#task_estimated').val(),
                            status: $('#task_status').val(),
                            priority: $('#task_priority').val(),
                            progress: $('#task_progress').val(),
                            is_private: $('#task_is_private').is(':checked') ? 1 : 0,
