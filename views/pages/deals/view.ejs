<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">

<head>
    <%- include('../../partials/head'); %>
        <link href="/assets/css/tabulator/tabulator.min.css" rel="stylesheet" />
        <link href="/assets/css/tabulator/tabulator_bootstrap5.min.css" rel="stylesheet" />
        <link href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css" rel="stylesheet">
        <link href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css' rel='stylesheet'>
        <style>
            .tabulator-table {
                border: 1px solid var(--bs-border-color);
                border-radius: 0.375rem;
                overflow: hidden;
            }

            .tabulator-table .tabulator-header {
                border-bottom: 1px solid var(--bs-border-color);
            }

            .tabulator-table .tabulator-cell,
            .tabulator-table .tabulator-row .tabulator-tabulator-cell,
            .tabulator-table .tabulator-headers .tabulator-col,
            .tabulator-table .tabulator-headers .tabulator-cell {
                border-right: 1px solid var(--bs-border-color);
            }

            .tabulator-table .tabulator-row {
                border-bottom: 1px solid var(--bs-border-color);
            }

            .tabulator-table .tabulator-cell:last-child,
            .tabulator-table .tabulator-tabulator-cell:last-child,
            .tabulator-table .tabulator-headers .tabulator-col:last-child,
            .tabulator-table .tabulator-headers .tabulator-cell:last-child {
                border-right: none;
            }

            .tabulator .tabulator-tableholder {
                overflow-x: hidden !important;
            }
        </style>
</head>

<body class="d-flex flex-column h-100">
    <%- include('../../partials/header'); %>
        <!-- Breadcrumb -->
        <div class="breadcrumbs pt-3 pb-3">
            <div class="container-fluid">
                <div class="row align-items-center">
                    <div class="col">
                        <span>
                            <%= i18n.__('deals.breadcrumbs.title') %>
                        </span>
                        <div>
                            <ul class="list-inline mb-0">
                                <li class="list-inline-item">
                                    <a href="/"><i class="fas fa-home"></i> <span>
                                            <%= i18n.__('deals.breadcrumbs.page1') %>
                                        </span></a>
                                </li>
                                <li class="list-inline-item">
                                    <i class="fas fa-chevron-right"></i>
                                    <%= i18n.__('deals.breadcrumbs.title') %>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-auto">
                        <button href="/" class="btn btn-primary rounded-0" id="btnCreateDeal">
                            <i class="fa-solid fa-plus"></i> Додати угоду
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- END Breadcrumb -->
        <div class="container-fluid mt-3">

            <!-- ================================================== -->
            <!-- ШАПКА -->
            <!-- ================================================== -->
            <div class="card border-primary rounded-0 mb-3">
                <div
                    class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="fw-semibold">
                            <%= data.deal.deal_number %>
                        </span>
                        <span class="opacity-75">·</span>
                        <span>
                            <%= data.deal.title %>
                        </span>
                        <% if (data.deal.deal_type_name) { %>
                            <span class="badge bg-white text-primary rounded-0 fw-normal">
                                <%= data.deal.deal_type_name %>
                            </span>
                            <% } %>
                                <% if (data.deal.is_rotting) { %>
                                    <span class="badge bg-danger rounded-0 fw-normal">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>Протухає <%=
                                            data.deal.rotting_days %> дн.
                                    </span>
                                    <% } %>
                    </div>
                    <div class="dropdown">
                        <button class="btn btn-outline-light btn-sm rounded-0" data-bs-toggle="dropdown">
                            <i class="fa-solid fa-ellipsis-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end rounded-0">
                            <li><a class="dropdown-item" href="#"><i
                                        class="fa-solid fa-copy me-2 text-muted"></i>Дублювати</a></li>
                            <li><a class="dropdown-item" href="#"><i
                                        class="fa-solid fa-file-export me-2 text-muted"></i>Експорт PDF</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item text-danger" href="#"><i
                                        class="fa-solid fa-trash me-2"></i>Видалити</a></li>
                        </ul>
                    </div>
                </div>
                <div class="card-body">

                    <div class="row g-3 mb-3">
                        <!-- Воронка і стадія -->
                        <div class="col-12 col-md-4">
                            <div class="small text-muted mb-1">Воронка / Стадія</div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="small"><i class="fa-solid fa-filter fa-xs me-1 text-muted"></i>
                                    <%= data.deal.pipeline_name %>
                                </span>
                                <i class="fa-solid fa-chevron-right fa-xs text-muted"></i>
                                <span class="badge rounded-0"
                                    style="background:<%= data.deal.stage_color_background %>;color:<%= data.deal.stage_color_text %>">
                                    <%= data.deal.stage_name %>
                                </span>
                            </div>
                        </div>
                        <!-- Сума -->
                        <div class="col-6 col-md-2 text-md-center">
                            <div class="small text-muted mb-1">Сума угоди</div>
                            <div class="fw-bold text-primary fs-5">
                                <%= parseFloat(data.deal.amount_final||0).toLocaleString('uk-UA',{minimumFractionDigits:2})
                                    %> ₴
                            </div>
                            <div class="small text-muted">
                                Зважена: <%=
                                    parseFloat(data.deal.amount_weighted||0).toLocaleString('uk-UA',{minimumFractionDigits:0})
                                    %> ₴
                            </div>
                        </div>
                        <!-- Ймовірність -->
                        <div class="col-6 col-md-2 text-md-center">
                            <div class="small text-muted mb-1">Ймовірність</div>
                            <div class="d-flex align-items-center justify-content-center gap-1 mb-1">
                                <span id="prob-display"
                                    class="fw-bold fs-5 <%= data.deal.probability >= 75 ? 'text-success' : data.deal.probability >= 50 ? 'text-warning' : 'text-danger' %>"
                                    style="cursor:pointer;border-bottom:2px dashed currentColor"
                                    title="Натисніть щоб змінити" data-current="<%= data.deal.probability %>">
                                    <%= data.deal.probability %>%
                                </span>
                                <i class="fa-solid fa-pen-to-square fa-xs text-muted" style="cursor:pointer"
                                    id="prob-edit-icon"></i>
                                <% if (data.deal.probability_override) { %>
                                    <i class="fa-solid fa-user fa-xs text-muted" title="Змінено вручну"></i>
                                    <% } %>
                            </div>
                            <input type="number" id="prob-input"
                                class="form-control form-control-sm rounded-0 text-center d-none" min="0" max="100"
                                step="1" value="<%= data.deal.probability %>" style="width:80px;margin:0 auto 4px">
                            <div class="progress rounded-0" id="prob-progress-wrap">
                                <div class="progress-bar progress-bar-striped progress-bar-animated
                            <%= data.deal.probability >= 75 ? 'bg-success' : data.deal.probability >= 50 ? 'bg-warning' : data.deal.probability >= 25 ? 'bg-info' : 'bg-danger' %>"
                                    id="prob-progress-bar" style="width:<%= data.deal.probability %>%">
                                </div>
                            </div>
                        </div>
                        <!-- Прогноз -->
                        <div class="col-6 col-md-2 text-md-center">
                            <div class="small text-muted mb-1">Прогноз</div>
                            <span class="badge bg-secondary rounded-0">
                                <%= data.deal.forecast_category %>
                            </span>
                        </div>
                        <!-- Менеджер -->
                        <div class="col-6 col-md-2 text-md-center">
                            <div class="small text-muted mb-1">Менеджер</div>
                            <div class="fw-semibold small">
                                <%= data.deal.user_name || '—' %>
                            </div>
                        </div>
                    </div>

                    <!-- СТЕППЕР СТАДІЙ -->
                    <div class="overflow-auto">
                        <div class="d-flex gap-1 flex-nowrap pb-1">
                            <% data.stages.forEach(function(stage) { %>
                                <button class="btn rounded-0 stage-btn 
                                <%
                                    if (stage.id == data.deal.id_stage) {
                                        if (stage.stage_type === 'won')      { %>btn-success<%
                                        } else if (stage.stage_type === 'lost')     { %>btn-danger<%
                                        } else if (stage.stage_type === 'canceled') { %>btn-secondary<%
                                        } else { %>btn-primary<% }
                                    } else {
                                        if (stage.stage_type === 'won')      { %>btn-success<%
                                        } else if (stage.stage_type === 'lost')     { %>btn-danger<%
                                        } else if (stage.stage_type === 'canceled') { %>btn-secondary<%
                                        } else { %>btn-primary<% }
                                    }
                                %>" data-stage-id="<%= stage.id %>" data-stage-type="<%= stage.stage_type %>"
                                    data-stage-name="<%= stage.name %>" <%=stage.id==data.deal.id_stage ? 'disabled'
                                    : '' %>>
                                    <% if (stage.stage_type==='won' ) { %><i class="fa-solid fa-trophy me-1"></i>
                                        <% } else if (stage.stage_type==='lost' ) { %><i
                                                class="fa-solid fa-xmark me-1"></i>
                                            <% } else if (stage.stage_type==='canceled' ) { %><i
                                                    class="fa-solid fa-ban me-1"></i>
                                                <% } else if (stage.id==data.deal.id_stage) { %><i
                                                        class="fa-solid fa-circle-dot me-1"></i>
                                                    <% } %>
                                                        <%= stage.name %>
                                </button>
                                <% }); %>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ================================================== -->
            <!-- РЯД 1: КОМПАНІЯ / КОНТАКТ / ДЕТАЛІ -->
            <!-- ================================================== -->
            <div class="row g-3 mb-3">

                <!-- Компанія -->
                <div class="col-12 col-md-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div
                            class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-building me-1"></i>Компанія</span>
                            <% if (data.deal.id_company) { %>
                                <a href="/companies/<%= data.deal.id_company %>"
                                    class="btn btn-outline-light btn-sm rounded-0 py-0 px-2">
                                    <i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i>
                                </a>
                                <% } %>
                        </div>
                        <div class="card-body">
                            <% if (data.deal.company_name) { %>
                                <div class="fw-semibold mb-1">
                                    <a href="/companies/<%= data.deal.id_company %>"
                                        class="text-decoration-none text-dark">
                                        <%= data.deal.company_name %>
                                    </a>
                                </div>
                                <% if (data.deal.company_city) { %>
                                    <div class="small text-muted"><i class="fa-solid fa-location-dot fa-xs me-1"></i>
                                        <%= data.deal.company_city %>
                                    </div>
                                    <% } %>
                                        <% } else { %>
                                            <span class="text-muted small">Не вказано</span>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Контакт -->
                <div class="col-12 col-md-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div
                            class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-user me-1"></i>Контакт</span>
                            <% if (data.deal.id_contact) { %>
                                <a href="/contacts/<%= data.deal.id_contact %>"
                                    class="btn btn-outline-light btn-sm rounded-0 py-0 px-2">
                                    <i class="fa-solid fa-arrow-up-right-from-square fa-xs"></i>
                                </a>
                                <% } %>
                        </div>
                        <div class="card-body">
                            <% if (data.deal.contact_name) { %>
                                <div class="fw-semibold mb-1">
                                    <a href="/contacts/<%= data.deal.id_contact %>"
                                        class="text-decoration-none text-dark">
                                        <%= data.deal.contact_name %>
                                    </a>
                                </div>
                                <% if (data.deal.contact_phone) { %>
                                    <div class="small text-muted"><i class="fa-solid fa-phone fa-xs me-1"></i>
                                        <%= data.deal.contact_phone %>
                                    </div>
                                    <% } %>
                                        <% if (data.deal.contact_email) { %>
                                            <div class="small text-muted"><i
                                                    class="fa-solid fa-envelope fa-xs me-1"></i>
                                                <%= data.deal.contact_email %>
                                            </div>
                                            <% } %>
                                                <% } else { %>
                                                    <span class="text-muted small">Не вказано</span>
                                                    <% } %>
                        </div>
                    </div>
                </div>

                <!-- Деталі -->
                <div class="col-12 col-md-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div class="card-header text-bg-primary rounded-0">
                            <i class="fa-solid fa-circle-info me-1"></i>Деталі
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-borderless mb-0 small">
                                <tbody>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3">ID</td>
                                        <td class="pe-3">
                                            <%= data.deal.deal_number %>
                                        </td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3" style="width:45%">Джерело</td>
                                        <td class="pe-3">
                                            <%= data.deal.source_name || '—' %>
                                        </td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3">Тип угоди</td>
                                        <td class="pe-3">
                                            <%= data.deal.deal_type_name || '—' %>
                                        </td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3">Конкурент</td>
                                        <td class="pe-3">
                                            <%= data.deal.competitor_name || '—' %>
                                        </td>
                                    </tr>
                                    <% if (data.deal.external_id) { %>
                                        <tr class="border-bottom">
                                            <td class="text-muted ps-3">ID в ERP</td>
                                            <td class="pe-3 text-muted">
                                                <%= data.deal.external_id %>
                                            </td>
                                        </tr>
                                        <% } %>
                                            <% if (data.deal.lost_reason_name) { %>
                                                <tr>
                                                    <td class="text-muted ps-3">Причина програшу</td>
                                                    <td class="pe-3 text-danger">
                                                        <%= data.deal.lost_reason_name %>
                                                    </td>
                                                </tr>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ================================================== -->
            <!-- РЯД 2: ФІНАНСИ / ДАТИ -->
            <!-- ================================================== -->
            <div class="row g-3 mb-3">

                <!-- Фінанси -->
                <div class="col-12 col-md-6">
                    <div class="card border-primary rounded-0 h-100">
                        <div class="card-header text-bg-primary rounded-0">
                            <i class="fa-solid fa-coins me-1"></i>Фінанси
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-borderless mb-0 small">
                                <tbody>
                                    <!-- Сума до знижки (gross) -->
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3" style="width:55%">Сума до знижки</td>
                                        <td class="pe-3 text-end fw-semibold">
                                            <%= parseFloat(data.deal.amount_gross||0).toLocaleString('uk-UA',{minimumFractionDigits:2})
                                                %> ₴
                                        </td>
                                    </tr>

                                    <!-- Знижка -->
                                    <% if (parseFloat(data.deal.discount_amount)> 0) { %>
                                        <tr class="border-bottom">
                                            <td class="text-muted ps-3">Знижка</td>
                                            <td class="pe-3 text-end text-danger">
                                                − <%=
                                                    parseFloat(data.deal.discount_amount||0).toLocaleString('uk-UA',{minimumFractionDigits:2})
                                                    %> ₴
                                            </td>
                                        </tr>
                                        <% } %>

                                            <!-- Сума без ПДВ -->
                                            <tr class="border-bottom">
                                                <td class="text-muted ps-3">Сума без ПДВ</td>
                                                <td class="pe-3 text-end">
                                                    <%= parseFloat(data.deal.amount||0).toLocaleString('uk-UA',{minimumFractionDigits:2})
                                                        %> ₴
                                                </td>
                                            </tr>

                                            <!-- ПДВ -->
                                            <tr class="border-bottom">
                                                <td class="text-muted ps-3">ПДВ</td>
                                                <td class="pe-3 text-end">
                                                    <%= parseFloat(data.deal.tax_amount||0).toLocaleString('uk-UA',{minimumFractionDigits:2})
                                                        %> ₴
                                                </td>
                                            </tr>

                                            <!-- Разом -->
                                            <tr class="border-bottom table-light">
                                                <td class="ps-3 fw-bold">Разом з ПДВ</td>
                                                <td class="pe-3 text-end fw-bold text-primary fs-6">
                                                    <%= parseFloat(data.deal.amount_final||0).toLocaleString('uk-UA',{minimumFractionDigits:2})
                                                        %> ₴
                                                </td>
                                            </tr>

                                            <!-- Зважена сума -->
                                            <tr class="border-bottom">
                                                <td class="text-muted ps-3">Зважена сума</td>
                                                <td class="pe-3 text-end text-muted">
                                                    <%= parseFloat(data.deal.amount_weighted||0).toLocaleString('uk-UA',{minimumFractionDigits:2})
                                                        %> ₴
                                                        <span class="badge bg-secondary rounded-0 ms-1">
                                                            <%= data.deal.probability %>%
                                                        </span>
                                                </td>
                                            </tr>

                                            <!-- Собівартість -->
                                            <tr class="border-bottom">
                                                <td class="text-muted ps-3">Собівартість</td>
                                                <td class="pe-3 text-end">
                                                    <%= parseFloat(data.deal.margin_amount !==undefined ?
                                                        (parseFloat(data.deal.amount_final||0) -
                                                        parseFloat(data.deal.margin_amount||0)) :
                                                        0).toLocaleString('uk-UA',{minimumFractionDigits:2}) %> ₴
                                                </td>
                                            </tr>

                                            <!-- Маржа -->
                                            <% if (parseFloat(data.deal.margin_amount) !==0) { %>
                                                <tr class="border-bottom">
                                                    <td class="text-muted ps-3">Маржа</td>
                                                    <td
                                                        class="pe-3 text-end <%= parseFloat(data.deal.margin_amount) >= 0 ? 'text-success' : 'text-danger' %>">
                                                        <%= parseFloat(data.deal.margin_amount||0).toLocaleString('uk-UA',{minimumFractionDigits:2})
                                                            %> ₴
                                                            <span
                                                                class="badge <%= parseFloat(data.deal.margin_amount) >= 0 ? 'bg-success' : 'bg-danger' %> rounded-0 ms-1">
                                                                <%= parseFloat(data.deal.margin_percent||0).toFixed(2)
                                                                    %>%
                                                            </span>
                                                    </td>
                                                </tr>
                                                <% } %>

                                                    <!-- Валюта -->
                                                    <tr>
                                                        <td class="text-muted ps-3">Валюта</td>
                                                        <td class="pe-3 text-end">
                                                            <%= data.deal.amount_currency || 'UAH' %>
                                                        </td>
                                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Дати -->
                <div class="col-12 col-md-6">
                    <div class="card border-primary rounded-0 h-100">
                        <div class="card-header text-bg-primary rounded-0">
                            <i class="fa-solid fa-calendar-days me-1"></i>Дати
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-sm table-borderless mb-0 small">
                                <tbody>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3" style="width:55%">Закриття (план)</td>
                                        <td
                                            class="pe-3 text-end fw-semibold <%= data.deal.date_close_plan && new Date(data.deal.date_close_plan) < new Date() ? 'text-danger' : '' %>">
                                            <%= data.deal.date_close_plan ? new
                                                Date(data.deal.date_close_plan).toLocaleDateString('uk-UA') : '—' %>
                                        </td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3">Закриття (факт)</td>
                                        <td class="pe-3 text-end">
                                            <%= data.deal.date_close_fact ? new
                                                Date(data.deal.date_close_fact).toLocaleDateString('uk-UA') : '—' %>
                                        </td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3">Наступна дія</td>
                                        <td class="pe-3 text-end">
                                            <%= data.deal.date_next_action ? new
                                                Date(data.deal.date_next_action).toLocaleDateString('uk-UA') : '—' %>
                                        </td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3">Зміна стадії</td>
                                        <td class="pe-3 text-end">
                                            <%= data.deal.date_stage_changed ? new
                                                Date(data.deal.date_stage_changed).toLocaleDateString('uk-UA') : '—' %>
                                        </td>
                                    </tr>
                                    <tr class="border-bottom">
                                        <td class="text-muted ps-3">Створено</td>
                                        <td class="pe-3 text-end">
                                            <%= new Date(data.deal.date_add).toLocaleDateString('uk-UA') %>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted ps-3">Оновлено</td>
                                        <td class="pe-3 text-end">
                                            <%= new Date(data.deal.date_edit).toLocaleDateString('uk-UA') %>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ================================================== -->
            <!-- РЯД 3: УЧАСНИКИ / НОТАТКИ / КАСТОМНІ ПОЛЯ -->
            <!-- ================================================== -->
            <div class="row g-3 mb-3">

                <!-- Учасники -->
                <div class="col-12 col-md-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div
                            class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-users me-1"></i>Учасники</span>
                            <button class="btn btn-outline-light btn-sm rounded-0 py-0 px-2">
                                <i class="fa-solid fa-plus fa-xs"></i>
                            </button>
                        </div>
                        <div class="card-body">
                            <% if (data.companies && data.companies.length) { %>
                                <div class="text-muted text-uppercase mb-2"
                                    style="font-size:.7rem;letter-spacing:.05em">Компанії</div>
                                <% data.companies.forEach(function(c) { %>
                                    <div
                                        class="d-flex align-items-center justify-content-between py-1 border-bottom small">
                                        <div>
                                            <a href="/companies/<%= c.id_company %>"
                                                class="text-decoration-none fw-semibold text-dark">
                                                <%= c.company_name %>
                                            </a>
                                            <% if (c.role) { %><span
                                                    class="badge bg-light text-secondary border rounded-0 ms-1"
                                                    style="font-size:.7rem">
                                                    <%= c.role %>
                                                </span>
                                                <% } %>
                                                    <% if (c.is_primary) { %><span
                                                            class="badge bg-primary rounded-0 ms-1"
                                                            style="font-size:.7rem">Основна</span>
                                                        <% } %>
                                        </div>
                                        <button class="btn btn-link btn-sm p-0 text-danger"><i
                                                class="fa-solid fa-xmark fa-xs"></i></button>
                                    </div>
                                    <% }); %>
                                        <% } %>
                                            <% if (data.contacts && data.contacts.length) { %>
                                                <div class="text-muted text-uppercase mb-2 mt-3"
                                                    style="font-size:.7rem;letter-spacing:.05em">Контакти</div>
                                                <% data.contacts.forEach(function(c) { %>
                                                    <div
                                                        class="d-flex align-items-center justify-content-between py-1 border-bottom small">
                                                        <div>
                                                            <a href="/contacts/<%= c.id_contact %>"
                                                                class="text-decoration-none fw-semibold text-dark">
                                                                <%= c.contact_name %>
                                                            </a>
                                                            <% if (c.role_name) { %><span
                                                                    class="badge bg-light text-secondary border rounded-0 ms-1"
                                                                    style="font-size:.7rem">
                                                                    <%= c.role_name %>
                                                                </span>
                                                                <% } %>
                                                                    <% if (c.is_primary) { %><span
                                                                            class="badge bg-primary rounded-0 ms-1"
                                                                            style="font-size:.7rem">Основний</span>
                                                                        <% } %>
                                                        </div>
                                                        <button class="btn btn-link btn-sm p-0 text-danger"><i
                                                                class="fa-solid fa-xmark fa-xs"></i></button>
                                                    </div>
                                                    <% }); %>
                                                        <% } %>
                                                            <% if ((!data.companies || !data.companies.length) &&
                                                                (!data.contacts || !data.contacts.length)) { %>
                                                                <span class="text-muted small">Учасників немає</span>
                                                                <% } %>
                        </div>
                    </div>
                </div>

                <!-- Опис і нотатки -->
                <div class="col-12 col-md-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div class="card-header text-bg-primary rounded-0">
                            <i class="fa-solid fa-note-sticky me-1"></i>Опис та нотатки
                        </div>
                        <div class="card-body">
                            <% if (data.deal.description) { %>
                                <div class="small text-muted text-uppercase mb-1" style="font-size:.7rem">Опис</div>
                                <div class="small mb-3">
                                    <%= data.deal.description %>
                                </div>
                                <% } %>
                                    <% if (data.deal.notes) { %>
                                        <div class="small text-muted text-uppercase mb-1" style="font-size:.7rem">
                                            Нотатки</div>
                                        <div class="small text-muted">
                                            <%= data.deal.notes %>
                                        </div>
                                        <% } %>
                                            <% if (!data.deal.description && !data.deal.notes) { %>
                                                <span class="text-muted small">Немає опису</span>
                                                <% } %>
                        </div>
                    </div>
                </div>

                <!-- Кастомні поля -->
                <div class="col-12 col-md-4">
                    <div class="card border-primary rounded-0 h-100">
                        <div class="card-header text-bg-primary rounded-0">
                            <i class="fa-solid fa-sliders me-1"></i>Додаткові поля
                        </div>
                        <div class="card-body p-0">
                            <% if (data.customFields && data.customFields.length) { %>
                                <table class="table table-sm table-borderless mb-0 small">
                                    <tbody>
                                        <% data.customFields.forEach(function(f) { %>
                                            <tr class="border-bottom">
                                                <td class="text-muted ps-3" style="width:50%">
                                                    <%= f.label %>
                                                </td>
                                                <td class="pe-3 text-end">
                                                    <% if (f.field_type==='checkbox' ) { %>
                                                        <i
                                                            class="fa-solid <%= f.value ? 'fa-check text-success' : 'fa-xmark text-danger' %>"></i>
                                                        <% } else if (f.field_type==='date' ) { %>
                                                            <%= f.value ? new Date(f.value).toLocaleDateString('uk-UA')
                                                                : '—' %>
                                                                <% } else { %>
                                                                    <%= f.value || '—' %>
                                                                        <% } %>
                                                </td>
                                            </tr>
                                            <% }); %>
                                    </tbody>
                                </table>
                                <% } else { %>
                                    <div class="p-3 text-muted small">Немає додаткових полів</div>
                                    <% } %>
                        </div>
                    </div>
                </div>

            </div>

            <!-- ================================================== -->
            <!-- РЯД 4: ОСТАННЯ АКТИВНІСТЬ -->
            <!-- ================================================== -->
            <% if (data.lastActivity) { %>
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <div class="card border-primary rounded-0">
                            <div class="card-header text-bg-primary rounded-0">
                                <i class="fa-solid fa-bolt me-1"></i>Остання активність
                            </div>
                            <div class="card-body small">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <span class="badge rounded-0"
                                        style="background:<%= data.lastActivity.type_color %>;color:#fff">
                                        <i class="<%= data.lastActivity.type_icon %> me-1"></i>
                                        <%= data.lastActivity.type_name %>
                                    </span>
                                    <span class="text-muted">
                                        <%= new Date(data.lastActivity.date_plan).toLocaleDateString('uk-UA') %>
                                    </span>
                                    <span class="fw-semibold">
                                        <%= data.lastActivity.subject || '—' %>
                                    </span>
                                </div>
                                <% if (data.lastActivity.result) { %>
                                    <div class="text-muted">
                                        <%= data.lastActivity.result %>
                                    </div>
                                    <% } %>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>

                    <!-- ================================================== -->
                    <!-- РЯД: КАЛЕНДАР УГОДИ -->
                    <!-- ================================================== -->
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <div class="card border-primary rounded-0">
                                <div
                                    class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
                                    <span><i class="fa-solid fa-calendar-days me-1"></i>Календар угоди</span>
                                    <button class="btn btn-light btn-sm rounded-0" id="btnAddCalendarEvent">
                                        <i class="fa-solid fa-plus me-1"></i>Додати подію
                                    </button>
                                </div>
                                <div class="card-body p-2">
                                    <div id="dealCalendar"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ================================================== -->
                    <!-- ТАБИ -->
                    <!-- ================================================== -->
                    <div class="card border-primary rounded-0 mb-4">

                        <div class="card-header text-bg-primary rounded-0 p-0">
                            <ul class="nav nav-tabs border-0" id="dealTabs">
                                <li class="nav-item">
                                    <button class="nav-link active rounded-0 border-0 text-white" data-bs-toggle="tab"
                                        data-bs-target="#pane-items">
                                        <i class="fa-solid fa-list me-1"></i>Позиції
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link rounded-0 border-0 text-white" data-bs-toggle="tab"
                                        data-bs-target="#pane-documents">
                                        <i class="fa-solid fa-file-lines me-1"></i>Документи
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link rounded-0 border-0 text-white" data-bs-toggle="tab"
                                        data-bs-target="#pane-activities">
                                        <i class="fa-solid fa-timeline me-1"></i>Активності
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link rounded-0 border-0 text-white" data-bs-toggle="tab"
                                        data-bs-target="#pane-tasks">
                                        <i class="fa-solid fa-check-square me-1"></i>Завдання
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link rounded-0 border-0 text-white" data-bs-toggle="tab"
                                        data-bs-target="#pane-files">
                                        <i class="fa-solid fa-paperclip me-1"></i>Файли
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link rounded-0 border-0 text-white" data-bs-toggle="tab"
                                        data-bs-target="#pane-custom-fields">
                                        <i class="fa-solid fa-sliders me-1"></i>Додаткові поля
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link rounded-0 border-0 text-white" data-bs-toggle="tab"
                                        data-bs-target="#pane-history">
                                        <i class="fa-solid fa-clock-rotate-left me-1"></i>Історія
                                    </button>
                                </li>


                                <li class="nav-item">
                                    <button class="nav-link rounded-0 border-0 text-white" data-bs-toggle="tab"
                                        data-bs-target="#pane-calendar">
                                        <i class="fa-solid fa-calendar-days me-1"></i>Календар
                                    </button>
                                </li>
                            </ul>
                        </div>

                        <div class="tab-content">

                            <!-- ТАБ: ПОЗИЦІЇ -->
                            <div class="tab-pane fade show active" id="pane-items">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <button class="btn btn-primary btn-sm rounded-0" id="btnAddItem">
                                        <i class="fa-solid fa-plus me-1"></i>Додати позицію
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <div id="items-table" class="tabulator-table"></div>
                                </div>
                            </div>

                            <!-- ТАБ: ДОКУМЕНТИ -->
                            <div class="tab-pane fade" id="pane-documents">
                                <div class="d-flex justify-content-end gap-2 mb-3 flex-wrap">
                                    <button class="btn btn-outline-primary btn-sm rounded-0" id="btnAddQuote"><i
                                            class="fa-solid fa-plus me-1"></i>КП</button>
                                    <button class="btn btn-outline-success btn-sm rounded-0" id="btnAddContract"><i
                                            class="fa-solid fa-plus me-1"></i>Договір</button>
                                    <button class="btn btn-outline-warning btn-sm rounded-0" id="btnAddInvoice"><i
                                            class="fa-solid fa-plus me-1"></i>Рахунок</button>
                                    <button class="btn btn-outline-info btn-sm rounded-0" id="btnAddAct"><i
                                            class="fa-solid fa-plus me-1"></i>Акт</button>
                                </div>
                                <h6 class="mb-2"><i class="fa-solid fa-file-invoice text-primary me-2"></i>Комерційні
                                    пропозиції</h6>
                                <div id="quotes-table" class="mb-4"></div>
                                <h6 class="mb-2"><i class="fa-solid fa-file-signature text-success me-2"></i>Договори
                                </h6>
                                <div id="contracts-table" class="mb-4"></div>
                                <h6 class="mb-2"><i
                                        class="fa-solid fa-file-invoice-dollar text-warning me-2"></i>Рахунки</h6>
                                <div id="invoices-table" class="mb-4"></div>
                                <h6 class="mb-2"><i class="fa-solid fa-file-circle-check text-info me-2"></i>Акти
                                    виконаних робіт</h6>
                                <div id="acts-table" class="mb-4"></div>
                            </div>

                            <!-- ТАБ: АКТИВНОСТІ -->
                            <div class="tab-pane fade" id="pane-activities">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">Активності</h6>
                                    <button class="btn btn-primary btn-sm rounded-0" id="btnAddActivity">
                                        <i class="fa-solid fa-plus me-1"></i>Додати
                                    </button>
                                </div>
                                <div id="activities-table"></div>
                            </div>

                            <!-- ТАБ: ЗАВДАННЯ -->
                            <div class="tab-pane fade" id="pane-tasks">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">Завдання</h6>
                                    <button class="btn btn-primary btn-sm rounded-0" id="btnAddTask">
                                        <i class="fa-solid fa-plus me-1"></i>Нове завдання
                                    </button>
                                </div>
                                <div id="tasks-table"></div>
                            </div>

                            <!-- ТАБ: ФАЙЛИ -->
                            <div class="tab-pane fade" id="pane-files">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">Файли та документи</h6>
                                    <button class="btn btn-primary btn-sm rounded-0">
                                        <i class="fa-solid fa-upload me-1"></i>Завантажити
                                    </button>
                                </div>
                                <div id="files-table"></div>
                            </div>

                            <!-- ТАБ: ДОДАТКОВІ ПОЛЯ -->
                            <div class="tab-pane fade" id="pane-custom-fields">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">Додаткові поля</h6>
                                    <button class="btn btn-primary btn-sm rounded-0" id="btnAddCustomField">
                                        <i class="fa-solid fa-plus me-1"></i>Додати поле
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <div id="custom-fields-table" class="tabulator-table"></div>
                                </div>
                            </div>

                            <!-- ТАБ: ІСТОРІЯ -->
                            <div class="tab-pane fade p-3" id="pane-history">
                                <div class="table-responsive">
                                    <div id="history-table" class="tabulator-table"></div>
                                </div>
                            </div>
                            <!-- ================================================== -->
                            <!-- ТАБ-ПАНЕЛЬ "КАЛЕНДАР" -->
                            <!-- ================================================== -->
                            <div class="tab-pane fade" id="pane-calendar">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0">Усі події угоди</h6>
                                    <button class="btn btn-primary btn-sm rounded-0" id="btnAddCalendarEventFromTab">
                                        <i class="fa-solid fa-plus me-1"></i>Додати подію
                                    </button>
                                </div>
                                <div class="table-responsive">
                                    <div id="calendar-events-table" class="tabulator-table"></div>
                                </div>
                            </div>

                        </div>
                    </div>

        </div>
        <!-- ================================================== -->
        <!-- MODAL: ПОЗИЦІЯ УГОДИ (додати / редагувати)       -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalItem" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-primary rounded-0">
                        <h5 class="modal-title" id="modalItemTitle">Позиція угоди</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="item_id">

                        <div class="row g-3">
                            <!-- Тип позиції -->
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold">Тип позиції</label>
                                <select class="form-select form-select-sm rounded-0" id="item_type">
                                    <option value="product">Товар</option>
                                    <option value="service">Послуга</option>
                                    <option value="work">Робота / Підряд</option>
                                    <option value="subscription">Підписка</option>
                                    <option value="license">Ліцензія</option>
                                    <option value="rental">Оренда</option>
                                    <option value="training">Навчання</option>
                                    <option value="custom" selected>Довільна</option>
                                </select>
                            </div>
                            <!-- Назва -->
                            <div class="col-12 col-md-8">
                                <label class="form-label small fw-semibold">Назва <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="item_name"
                                    placeholder="Назва позиції">
                            </div>
                            <!-- Опис -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Опис</label>
                                <textarea class="form-control form-control-sm rounded-0" id="item_description" rows="2"
                                    placeholder="Опис позиції"></textarea>
                            </div>
                            <!-- Артикул -->
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold">Артикул (SKU)</label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="item_sku"
                                    placeholder="SKU-001">
                            </div>
                            <!-- Одиниця виміру -->
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold">Одиниця виміру</label>
                                <select class="form-select form-select-sm rounded-0" id="item_id_unit">
                                    <option value="">— не вказано —</option>
                                    <% data.units && data.units.forEach(function(u) { %>
                                        <option value="<%= u.id %>">
                                            <%= u.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>
                            <!-- ПДВ -->
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold">Ставка ПДВ</label>
                                <select class="form-select form-select-sm rounded-0" id="item_id_tax">
                                    <option value="">— без ПДВ —</option>
                                    <% data.taxes && data.taxes.forEach(function(t) { %>
                                        <option value="<%= t.id %>" data-rate="<%= t.rate %>">
                                            <%= t.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>
                            <!-- Кількість -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Кількість <span
                                        class="text-danger">*</span></label>
                                <input type="number" class="form-control form-control-sm rounded-0" id="item_qty"
                                    value="1" min="0.001" step="any">
                            </div>
                            <!-- Ціна -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Ціна за одиницю <span
                                        class="text-danger">*</span></label>
                                <input type="number" class="form-control form-control-sm rounded-0" id="item_price"
                                    value="0" min="0" step="any">
                            </div>
                            <!-- Собівартість -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Собівартість за од.</label>
                                <input type="number" class="form-control form-control-sm rounded-0" id="item_cost_price"
                                    value="0" min="0" step="any">
                            </div>
                            <!-- Знижка -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Знижка</label>
                                <div class="input-group input-group-sm">
                                    <input type="number" class="form-control rounded-0" id="item_discount" value="0"
                                        min="0" step="any">
                                    <select class="form-select rounded-0" id="item_discount_type"
                                        style="max-width:65px">
                                        <option value="0">%</option>
                                        <option value="1">₴</option>
                                    </select>
                                </div>
                            </div>
                            <!-- ПДВ включено -->
                            <div class="col-6 col-md-3 d-flex align-items-end">
                                <div class="form-check mb-1">
                                    <input class="form-check-input rounded-0" type="checkbox" id="item_tax_included">
                                    <label class="form-check-label small" for="item_tax_included">ПДВ включено в
                                        ціну</label>
                                </div>
                            </div>

                            <!-- Підсумок (авто) -->
                            <div class="col-12">
                                <div class="card border-0 rounded-0 bg-light">
                                    <div class="card-body py-2 small">
                                        <div class="row g-2 text-center">
                                            <div class="col-4">
                                                <div class="text-muted">Сума без ПДВ</div>
                                                <div class="fw-semibold" id="item_calc_amount">0.00 ₴</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="text-muted">ПДВ</div>
                                                <div class="fw-semibold" id="item_calc_vat">0.00 ₴</div>
                                            </div>
                                            <div class="col-4">
                                                <div class="text-muted">Разом</div>
                                                <div class="fw-bold text-primary" id="item_calc_total">0.00 ₴</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Дати (для підписок, оренди, навчання) -->
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Дата початку</label>
                                <input type="date" class="form-control form-control-sm rounded-0" id="item_date_from">
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold">Дата закінчення</label>
                                <input type="date" class="form-control form-control-sm rounded-0" id="item_date_to">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-0" id="btnSaveItem">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Зберегти
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- ================================================== -->
        <!-- MODAL: АКТИВНІСТЬ (додати / редагувати)           -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalActivity" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-primary rounded-0">
                        <h5 class="modal-title" id="modalActivityTitle">Активність</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="activity_id">

                        <div class="row g-3">
                            <!-- Тип -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Тип активності <span
                                        class="text-danger">*</span></label>
                                <select class="form-select form-select-sm rounded-0" id="activity_type">
                                    <% data.activityTypes && data.activityTypes.forEach(function(t) { %>
                                        <option value="<%= t.id %>">
                                            <%= t.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>
                            <!-- Результат -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Результат</label>
                                <select class="form-select form-select-sm rounded-0" id="activity_outcome">
                                    <option value="">— не вказано —</option>
                                    <% data.activityOutcomes && data.activityOutcomes.forEach(function(o) { %>
                                        <option value="<%= o.id %>" data-type="<%= o.id_activity_type || '' %>">
                                            <%= o.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>
                            <!-- Тема -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Тема <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="activity_subject"
                                    placeholder="Тема активності">
                            </div>
                            <!-- Опис -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Опис</label>
                                <textarea class="form-control form-control-sm rounded-0" id="activity_description"
                                    rows="2" placeholder="Деталі..."></textarea>
                            </div>
                            <!-- Результат текст -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Підсумок / Результат</label>
                                <textarea class="form-control form-control-sm rounded-0" id="activity_result" rows="2"
                                    placeholder="Що вийшло, домовленості..."></textarea>
                            </div>
                            <!-- Наступний крок -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Наступний крок</label>
                                <input type="text" class="form-control form-control-sm rounded-0"
                                    id="activity_next_step" placeholder="Що зробити далі...">
                            </div>
                            <!-- Дата / Час -->
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold">Дата і час <span
                                        class="text-danger">*</span></label>
                                <input type="datetime-local" class="form-control form-control-sm rounded-0"
                                    id="activity_date_plan">
                            </div>
                            <!-- Тривалість -->
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold">Тривалість (хв)</label>
                                <input type="number" class="form-control form-control-sm rounded-0"
                                    id="activity_duration" min="0" placeholder="30">
                            </div>
                            <!-- Статус -->
                            <div class="col-12 col-md-4">
                                <label class="form-label small fw-semibold">Статус</label>
                                <select class="form-select form-select-sm rounded-0" id="activity_status">
                                    <option value="planned">Заплановано</option>
                                    <option value="in_progress">В процесі</option>
                                    <option value="done">Виконано</option>
                                    <option value="canceled">Скасовано</option>
                                </select>
                            </div>
                            <!-- Місце -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Місце проведення</label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="activity_location"
                                    placeholder="Офіс, адреса...">
                            </div>
                            <!-- Посилання (Zoom/Meet) -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Посилання (Zoom / Meet)</label>
                                <input type="url" class="form-control form-control-sm rounded-0"
                                    id="activity_location_url" placeholder="https://...">
                            </div>
                            <!-- Пріоритет / Нагадування -->
                            <div class="col-6 col-md-4">
                                <label class="form-label small fw-semibold">Пріоритет</label>
                                <select class="form-select form-select-sm rounded-0" id="activity_priority">
                                    <option value="1">Низький</option>
                                    <option value="2" selected>Середній</option>
                                    <option value="3">Високий</option>
                                    <option value="4">Критичний</option>
                                </select>
                            </div>
                            <div class="col-6 col-md-4 d-flex align-items-end">
                                <div class="form-check mb-1">
                                    <input class="form-check-input rounded-0" type="checkbox" id="activity_reminder">
                                    <label class="form-check-label small" for="activity_reminder">Нагадати</label>
                                </div>
                            </div>
                            <div class="col-12 col-md-4" id="activity_reminder_block" style="display:none">
                                <label class="form-label small fw-semibold">За скільки хвилин</label>
                                <input type="number" class="form-control form-control-sm rounded-0"
                                    id="activity_reminder_minutes" value="30" min="5">
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-0" id="btnSaveActivity">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Зберегти
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- ================================================== -->
        <!-- MODAL: ЗАВДАННЯ (додати / редагувати)             -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalTask" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-primary rounded-0">
                        <h5 class="modal-title" id="modalTaskTitle">Завдання</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="task_id">

                        <div class="row g-3">
                            <!-- Назва -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Назва завдання <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="task_title"
                                    placeholder="Що треба зробити...">
                            </div>
                            <!-- Опис -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Опис</label>
                                <textarea class="form-control form-control-sm rounded-0" id="task_description" rows="3"
                                    placeholder="Детальний опис завдання..."></textarea>
                            </div>
                            <!-- Виконавець -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Виконавець</label>
                                <select class="form-select form-select-sm rounded-0" id="task_id_user">
                                    <option value="">— поточний менеджер —</option>
                                    <% data.users && data.users.forEach(function(u) { %>
                                        <option value="<%= u.id %>">
                                            <%= u.last_name %>
                                                <%= u.first_name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>
                            <!-- Статус -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Статус</label>
                                <select class="form-select form-select-sm rounded-0" id="task_status">
                                    <option value="new" selected>Нове</option>
                                    <option value="in_progress">В роботі</option>
                                    <option value="on_hold">Відкладено</option>
                                    <option value="done">Виконано</option>
                                    <option value="canceled">Скасовано</option>
                                </select>
                            </div>
                            <!-- Дата початку -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Дата початку</label>
                                <input type="datetime-local" class="form-control form-control-sm rounded-0"
                                    id="task_date_start">
                            </div>
                            <!-- Дедлайн -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Дедлайн</label>
                                <input type="datetime-local" class="form-control form-control-sm rounded-0"
                                    id="task_date_due">
                            </div>
                            <!-- Пріоритет -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Пріоритет</label>
                                <select class="form-select form-select-sm rounded-0" id="task_priority">
                                    <option value="1">Низький</option>
                                    <option value="2" selected>Середній</option>
                                    <option value="3">Високий</option>
                                    <option value="4">Критичний</option>
                                </select>
                            </div>
                            <!-- Оцінка часу -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Оцінка (хв)</label>
                                <input type="number" class="form-control form-control-sm rounded-0" id="task_estimated"
                                    min="0" placeholder="60">
                            </div>
                            <!-- Прогрес -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Прогрес: <span
                                        id="task_progress_val">0</span>%</label>
                                <input type="range" class="form-range" id="task_progress" min="0" max="100" step="5"
                                    value="0"
                                    oninput="document.getElementById('task_progress_val').textContent = this.value">
                            </div>
                            <!-- Приватне -->
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input rounded-0" type="checkbox" id="task_is_private">
                                    <label class="form-check-label small" for="task_is_private">Приватне (видно тільки
                                        мені)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-0" id="btnSaveTask">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Зберегти
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- ================================================== -->
        <!-- ПІДТВЕРДЖЕННЯ ВИДАЛЕННЯ                           -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalConfirmDelete" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-danger rounded-0">
                        <h5 class="modal-title">Підтвердження</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0" id="modalConfirmText">Видалити запис?</p>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-danger btn-sm rounded-0" id="btnConfirmDelete">
                            <i class="fa-solid fa-trash me-1"></i>Видалити
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- СТЕППЕР СТАДІЙ -->
        <div class="overflow-auto">
            <div class="d-flex gap-1 flex-nowrap pb-1">
                <% data.stages.forEach(function(stage) { %>
                    <button class="btn btn-sm flex-shrink-0 rounded-0
                <%
                    if (stage.id == data.deal.id_stage) {
                        if (stage.stage_type === 'won')      { %>btn-success<%
                        } else if (stage.stage_type === 'lost')     { %>btn-danger<%
                        } else if (stage.stage_type === 'canceled') { %>btn-secondary<%
                        } else { %>btn-primary<% }
                    } else {
                        if (stage.stage_type === 'won')      { %>btn-outline-success<%
                        } else if (stage.stage_type === 'lost')     { %>btn-outline-danger<%
                        } else if (stage.stage_type === 'canceled') { %>btn-outline-secondary<%
                        } else { %>btn-outline-primary<% }
                    }
                %>" style="min-width:110px;font-size:0.75rem" data-stage-id="<%= stage.id %>"
                        data-stage-type="<%= stage.stage_type %>" data-stage-name="<%= stage.name %>"
                        <%=stage.id==data.deal.id_stage ? 'disabled' : '' %>>
                        <% if (stage.stage_type==='won' ) { %><i class="fa-solid fa-trophy me-1"></i>
                            <% } else if (stage.stage_type==='lost' ) { %><i class="fa-solid fa-xmark me-1"></i>
                                <% } else if (stage.stage_type==='canceled' ) { %><i class="fa-solid fa-ban me-1"></i>
                                    <% } else if (stage.id==data.deal.id_stage) { %><i
                                            class="fa-solid fa-circle-dot me-1"></i>
                                        <% } %>
                                            <%= stage.name %>
                    </button>
                    <% }); %>
            </div>
        </div>


        <!-- ================================================== -->
        <!-- MODAL: ЗМІНА СТАДІЇ (open)                        -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalStageChange" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-primary rounded-0">
                        <h5 class="modal-title">Змінити стадію</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0 small">Перевести угоду на стадію <strong id="stageChangeName"></strong>?</p>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-0" id="btnConfirmStageChange">
                            <i class="fa-solid fa-check me-1"></i>Підтвердити
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- ================================================== -->
        <!-- MODAL: УГОДА ВИГРАНА (won)                        -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalStageWon" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-success rounded-0">
                        <h5 class="modal-title"><i class="fa-solid fa-trophy me-2"></i>Угода виграна!</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Фактична дата закриття</label>
                            <input type="date" class="form-control form-control-sm rounded-0" id="won_date_close">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Коментар</label>
                            <textarea class="form-control form-control-sm rounded-0" id="won_note" rows="2"
                                placeholder="Що допомогло виграти угоду..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-success btn-sm rounded-0" id="btnConfirmWon">
                            <i class="fa-solid fa-trophy me-1"></i>Підтвердити
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- ================================================== -->
        <!-- MODAL: УГОДА ПРОГРАНА (lost)                      -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalStageLost" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-danger rounded-0">
                        <h5 class="modal-title"><i class="fa-solid fa-xmark me-2"></i>Угода програна</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Причина програшу <span
                                    class="text-danger">*</span></label>
                            <select class="form-select form-select-sm rounded-0" id="lost_reason">
                                <option value="">— оберіть причину —</option>
                                <% data.lostReasons && data.lostReasons.forEach(function(r) { %>
                                    <option value="<%= r.id %>">
                                        <%= r.name %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Конкурент</label>
                            <input type="text" class="form-control form-control-sm rounded-0" id="lost_competitor"
                                placeholder="Хто виграв угоду..." value="<%= data.deal.competitor_name || '' %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Коментар</label>
                            <textarea class="form-control form-control-sm rounded-0" id="lost_note" rows="2"
                                placeholder="Деталі..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-danger btn-sm rounded-0" id="btnConfirmLost">
                            <i class="fa-solid fa-xmark me-1"></i>Підтвердити
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- ================================================== -->
        <!-- MODAL: РЕДАГУВАННЯ ЗНАЧЕННЯ КАСТОМНОГО ПОЛЯ      -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalCustomField" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-primary rounded-0">
                        <h5 class="modal-title" id="modalCFTitle">Редагувати поле</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="cf_id_field">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold" id="cf_label">Значення</label>
                            <div class="form-text text-muted mb-2" id="cf_hint"></div>
                            <div id="cf_input_wrap"></div>
                        </div>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-0" id="btnSaveCF">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Зберегти
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================================================== -->
        <!-- MODAL: ДОДАТИ / РЕДАГУВАТИ КАСТОМНЕ ПОЛЕ          -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalAddCustomField" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-primary rounded-0">
                        <h5 class="modal-title" id="modalAddCFTitle">Додати поле</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="nf_id">
                        <div class="row g-3">

                            <!-- Тип поля -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Тип поля <span
                                        class="text-danger">*</span></label>
                                <select class="form-select form-select-sm rounded-0" id="nf_type">
                                    <option value="">— оберіть тип —</option>
                                    <optgroup label="Текст">
                                        <option value="text">Текст</option>
                                        <option value="textarea">Текстова область</option>
                                        <option value="editor">Текстовий редактор</option>
                                    </optgroup>
                                    <optgroup label="Числа">
                                        <option value="number">Число</option>
                                        <option value="decimal">Десяткове число</option>
                                    </optgroup>
                                    <optgroup label="Контакти">
                                        <option value="email">Email</option>
                                        <option value="phone">Телефон</option>
                                        <option value="url">URL</option>
                                    </optgroup>
                                    <optgroup label="Дата">
                                        <option value="date">Дата</option>
                                        <option value="datetime">Дата і час</option>
                                    </optgroup>
                                    <optgroup label="Вибір">
                                        <option value="checkbox">Прапорець (checkbox)</option>
                                        <option value="radio">Перемикач (radio)</option>
                                        <option value="select">Список (одиночний)</option>
                                        <option value="multiselect">Список (множинний)</option>
                                        <option value="tags">Теги</option>
                                    </optgroup>
                                    <optgroup label="Інше">
                                        <option value="auto">Авто-мітка</option>
                                    </optgroup>
                                </select>
                            </div>

                            <!-- Ключ поля -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Ключ поля</label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="nf_key"
                                    placeholder="my_field_key">
                                <div class="form-text">Латиниця, цифри, підкреслення. Якщо не вказано — генерується
                                    автоматично.</div>
                            </div>

                            <!-- Назва -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Назва <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="nf_label"
                                    placeholder="Назва поля">
                            </div>

                            <!-- Підказка -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Підказка</label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="nf_hint"
                                    placeholder="Пояснення для користувача">
                            </div>

                            <!-- Іконка -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Іконка (FA клас)</label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text rounded-0" id="nf_icon_preview"><i
                                            class="fa-solid fa-circle-question"></i></span>
                                    <input type="text" class="form-control rounded-0" id="nf_icon"
                                        placeholder="fa-solid fa-star">
                                </div>
                            </div>

                            <!-- Воронка -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Воронка</label>
                                <select class="form-select form-select-sm rounded-0" id="nf_pipeline">
                                    <option value="">— всі воронки —</option>
                                    <% data.pipelines && data.pipelines.forEach(function(pip) { %>
                                        <option value="<%= pip.id %>">
                                            <%= pip.name %>
                                        </option>
                                        <% }); %>
                                </select>
                            </div>

                            <!-- Значення за замовчуванням -->
                            <div class="col-12 col-md-6" id="nf_default_wrap">
                                <label class="form-label small fw-semibold">Значення за замовчуванням</label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="nf_default"
                                    placeholder="За замовчуванням">
                            </div>

                            <!-- Порядок сортування -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Порядок сортування</label>
                                <input type="number" class="form-control form-control-sm rounded-0" id="nf_sort"
                                    value="0" min="0">
                            </div>

                            <!-- Налаштування -->
                            <div class="col-12">
                                <div class="d-flex gap-4 flex-wrap">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="nf_required">
                                        <label class="form-check-label small" for="nf_required">Обов'язкове</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="nf_unique">
                                        <label class="form-check-label small" for="nf_unique">Унікальне</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="nf_show_list">
                                        <label class="form-check-label small" for="nf_show_list">В списку угод</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="nf_show_kanban">
                                        <label class="form-check-label small" for="nf_show_kanban">В канбані</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Варіанти для select/radio/multiselect -->
                            <div class="col-12" id="nf_options_wrap" style="display:none">
                                <label class="form-label small fw-semibold">Варіанти вибору</label>
                                <div id="nf_options_list" class="mb-2"></div>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-0"
                                    id="btnAddOption">
                                    <i class="fa-solid fa-plus me-1"></i>Додати варіант
                                </button>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-0" id="btnSaveNewField">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Зберегти
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- ================================================== -->
        <!-- MODAL: ПОДІЯ КАЛЕНДАРЯ (додати / редагувати)        -->
        <!-- Вставити поряд з modalActivity / modalTask          -->
        <!-- ================================================== -->
        <div class="modal fade" id="modalCalendarEvent" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content rounded-0">
                    <div class="modal-header text-bg-primary rounded-0">
                        <h5 class="modal-title" id="modalCalendarEventTitle">Подія календаря</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="ce_id">

                        <div class="row g-3">

                            <!-- Тип події -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Тип події</label>
                                <select class="form-select form-select-sm rounded-0" id="ce_event_type">
                                    <option value="">— не вказано —</option>
                                </select>
                            </div>

                            <!-- Пріоритет -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Пріоритет</label>
                                <select class="form-select form-select-sm rounded-0" id="ce_priority">
                                    <option value="1">Низький</option>
                                    <option value="2" selected>Середній</option>
                                    <option value="3">Високий</option>
                                    <option value="4">Критичний</option>
                                </select>
                            </div>

                            <!-- Назва -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Назва <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="ce_title"
                                    placeholder="Назва події">
                            </div>

                            <!-- Опис -->
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Детальний опис</label>
                                <textarea class="form-control form-control-sm rounded-0" id="ce_description" rows="3"
                                    placeholder="Деталі події..."></textarea>
                            </div>

                            <!-- Увесь день -->
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="ce_all_day">
                                    <label class="form-check-label small fw-semibold" for="ce_all_day">Увесь
                                        день</label>
                                </div>
                            </div>

                            <!-- Дата/час початку -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Дата початку <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="ce_date_start"
                                    placeholder="дд.мм.рррр">
                            </div>
                            <div class="col-6 col-md-3" id="ce_time_start_block">
                                <label class="form-label small fw-semibold">Час початку <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="ce_time_start"
                                    placeholder="гг:хх">
                            </div>

                            <!-- Дата/час кінця -->
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-semibold">Дата кінця <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="ce_date_end"
                                    placeholder="дд.мм.рррр">
                            </div>
                            <div class="col-6 col-md-3" id="ce_time_end_block">
                                <label class="form-label small fw-semibold">Час кінця <span
                                        class="text-danger">*</span></label>
                                <input type="text" class="form-control form-control-sm rounded-0" id="ce_time_end"
                                    placeholder="гг:хх">
                            </div>

                            <!-- Видимість -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Хто бачить подію</label>
                                <select class="form-select form-select-sm rounded-0" id="ce_visibility_type">
                                    <option value="all" selected>Усі менеджери угоди</option>
                                    <option value="private">Тільки я</option>
                                    <option value="custom">Вибрані менеджери</option>
                                </select>
                            </div>

                            <!-- Статус -->
                            <div class="col-12 col-md-6">
                                <label class="form-label small fw-semibold">Статус</label>
                                <select class="form-select form-select-sm rounded-0" id="ce_status">
                                    <option value="planned" selected>Заплановано</option>
                                    <option value="done">Виконано</option>
                                    <option value="canceled">Скасовано</option>
                                </select>
                            </div>

                            <!-- Мульти-select учасників (показується тільки для custom) -->
                            <div class="col-12" id="ce_custom_users_block" style="display:none;">
                                <label class="form-label small fw-semibold">Учасники</label>
                                <select class="form-select form-select-sm rounded-0" id="ce_custom_users" multiple
                                    size="5">
                                    <% data.users && data.users.forEach(function(u) { %>
                                        <option value="<%= u.id %>">
                                            <%= u.last_name %>
                                                <%= u.first_name %>
                                        </option>
                                        <% }); %>
                                </select>
                                <div class="form-text small">Затисніть Ctrl (Cmd на Mac), щоб обрати декілька</div>
                            </div>

                            <!-- Нагадування -->
                            <div class="col-12 col-md-6">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" id="ce_reminder">
                                    <label class="form-check-label small fw-semibold" for="ce_reminder">Нагадати</label>
                                </div>
                            </div>
                            <div class="col-12 col-md-6" id="ce_reminder_minutes_block" style="display:none;">
                                <label class="form-label small fw-semibold">За скільки хвилин</label>
                                <select class="form-select form-select-sm rounded-0" id="ce_reminder_minutes">
                                    <option value="10">10 хвилин</option>
                                    <option value="30" selected>30 хвилин</option>
                                    <option value="60">1 годину</option>
                                    <option value="1440">1 день</option>
                                </select>
                            </div>

                        </div>
                    </div>
                    <div class="modal-footer rounded-0">
                        <button type="button" class="btn btn-secondary btn-sm rounded-0"
                            data-bs-dismiss="modal">Скасувати</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-0" id="btnSaveCalendarEvent">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Зберегти
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <%- include('../../partials/footer'); %>
            <%- include('../../partials/script'); %>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/l10n/uk.js"></script>
                <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
                <script>
                    const DEAL_ID = <%= data.deal.id %>;


                    // Клік на кнопку стадії
                    $(document).on('click', '.stage-btn', function () {
                        var stageId = $(this).data('stage-id');
                        var stageType = $(this).data('stage-type');
                        var stageName = $(this).data('stage-name');
                        _pendingStageId = stageId;

                        if (stageType === 'won') {
                            // Встановлюємо сьогоднішню дату за замовчуванням
                            $('#won_date_close').val(new Date().toISOString().substring(0, 10));
                            $('#won_note').val('');
                            $('#modalStageWon').modal('show');

                        } else if (stageType === 'lost') {
                            $('#lost_reason').val('');
                            $('#lost_note').val('');
                            $('#modalStageLost').modal('show');

                        } else {
                            // Звичайна стадія — простий confirm modal
                            $('#stageChangeName').text(stageName);
                            $('#modalStageChange').modal('show');
                        }
                    });

                    // Підтвердження — звичайна стадія
                    $('#btnConfirmStageChange').on('click', function () {
                        $.post('/api/deals/' + DEAL_ID + '/stage', { id_stage: _pendingStageId })
                            .done(function () { location.reload(); })
                            .fail(function () { alert('Помилка зміни стадії'); });
                    });

                    // Підтвердження — виграно
                    $('#btnConfirmWon').on('click', function () {
                        $.post('/api/deals/' + DEAL_ID + '/stage', {
                            id_stage: _pendingStageId,
                            date_close_fact: $('#won_date_close').val(),
                            note: $('#won_note').val()
                        })
                            .done(function () { location.reload(); })
                            .fail(function () { alert('Помилка зміни стадії'); });
                    });

                    // Підтвердження — програно
                    $('#btnConfirmLost').on('click', function () {
                        if (!$('#lost_reason').val()) {
                            alert('Вкажіть причину програшу');
                            return;
                        }
                        $.post('/api/deals/' + DEAL_ID + '/stage', {
                            id_stage: _pendingStageId,
                            id_lost_reason: $('#lost_reason').val(),
                            competitor_name: $('#lost_competitor').val(),
                            note: $('#lost_note').val()
                        })
                            .done(function () { location.reload(); })
                            .fail(function () { alert('Помилка зміни стадії'); });
                    });

                    // ============================================================
                    // ПОЗИЦІЇ — авто-розрахунок суми в модалці
                    // ============================================================
                    $('#item_qty, #item_price, #item_discount, #item_discount_type, #item_id_tax, #item_tax_included').on('change input', function () {
                        var qty = parseFloat($('#item_qty').val()) || 0;
                        var price = parseFloat($('#item_price').val()) || 0;
                        var discount = parseFloat($('#item_discount').val()) || 0;
                        var discount_type = parseInt($('#item_discount_type').val()) || 0;
                        var tax_included = $('#item_tax_included').is(':checked');
                        var tax_rate = parseFloat($('#item_id_tax option:selected').data('rate')) || 0;

                        var discount_amount = discount_type === 1 ? discount : price * qty * discount / 100;
                        var amount = price * qty - discount_amount;
                        var tax_amount = tax_included
                            ? amount - amount / (1 + tax_rate / 100)
                            : amount * tax_rate / 100;
                        var amount_total = tax_included ? amount : amount + tax_amount;

                        $('#item_calc_amount').text(amount.toLocaleString('uk-UA', { minimumFractionDigits: 2 }) + ' ₴');
                        $('#item_calc_vat').text(tax_amount.toLocaleString('uk-UA', { minimumFractionDigits: 2 }) + ' ₴');
                        $('#item_calc_total').text(amount_total.toLocaleString('uk-UA', { minimumFractionDigits: 2 }) + ' ₴');
                    });

                    // ============================================================
                    // ПОЗИЦІЇ — відкриття модалки "Додати"
                    // ============================================================
                    $('#btnAddItem').on('click', function () {
                        $('#modalItemTitle').text('Додати позицію');
                        $('#item_id').val('');
                        $('#item_type').val('custom');
                        $('#item_name').val('');
                        $('#item_description').val('');
                        $('#item_sku').val('');
                        $('#item_id_unit').val('');
                        $('#item_id_tax').val('');
                        $('#item_qty').val(1);
                        $('#item_price').val(0);
                        $('#item_cost_price').val(0);
                        $('#item_discount').val(0);
                        $('#item_discount_type').val(0);
                        $('#item_tax_included').prop('checked', false);
                        $('#item_date_from').val('');
                        $('#item_date_to').val('');
                        $('#item_calc_amount').text('0.00 ₴');
                        $('#item_calc_vat').text('0.00 ₴');
                        $('#item_calc_total').text('0.00 ₴');
                        $('#modalItem').modal('show');
                    });

                    // ============================================================
                    // ПОЗИЦІЇ — відкриття модалки "Редагувати"
                    // Виклик з Tabulator: onclick="itemEdit(rowData)"
                    // ============================================================
                    window.itemEdit = function (d) {
                        $('#modalItemTitle').text('Редагувати позицію');
                        $('#item_id').val(d.id);
                        $('#item_type').val(d.item_type || 'custom');
                        $('#item_name').val(d.name || '');
                        $('#item_description').val(d.description || '');
                        $('#item_sku').val(d.sku || '');
                        $('#item_id_unit').val(d.id_unit || '');
                        $('#item_id_tax').val(d.id_tax || '');
                        $('#item_qty').val(d.qty || 1);
                        $('#item_price').val(d.price || 0);
                        $('#item_cost_price').val(d.cost_price || 0);
                        $('#item_discount').val(d.discount || 0);
                        $('#item_discount_type').val(d.discount_type || 0);
                        $('#item_tax_included').prop('checked', d.tax_included == 1);
                        $('#item_date_from').val(d.date_from ? d.date_from.substring(0, 10) : '');
                        $('#item_date_to').val(d.date_to ? d.date_to.substring(0, 10) : '');
                        $('#item_id_tax, #item_qty, #item_price').trigger('change');
                        $('#modalItem').modal('show');
                    };

                    // ============================================================
                    // ПОЗИЦІЇ — збереження
                    // ============================================================
                    $('#btnSaveItem').on('click', function () {
                        var name = $.trim($('#item_name').val());
                        if (!name) { alert('Вкажіть назву позиції'); return; }

                        var id = $('#item_id').val();
                        var url = id
                            ? '/api/deals/' + DEAL_ID + '/items/' + id + '/edit'
                            : '/api/deals/' + DEAL_ID + '/items/add';

                        $.post(url, {
                            item_type: $('#item_type').val(),
                            id_unit: $('#item_id_unit').val(),
                            id_tax: $('#item_id_tax').val(),
                            name: name,
                            description: $('#item_description').val(),
                            sku: $('#item_sku').val(),
                            qty: $('#item_qty').val(),
                            price: $('#item_price').val(),
                            cost_price: $('#item_cost_price').val(),
                            price_currency: 'UAH',
                            discount: $('#item_discount').val(),
                            discount_type: $('#item_discount_type').val(),
                            tax_rate: $('#item_id_tax option:selected').data('rate') || 0,
                            tax_included: $('#item_tax_included').is(':checked') ? 1 : 0,
                            date_from: $('#item_date_from').val(),
                            date_to: $('#item_date_to').val(),
                        })
                            .done(function () {
                                $('#modalItem').modal('hide');
                                itemsTable.replaceData();
                            })
                            .fail(function () { alert('Помилка збереження'); });
                    });

                    // ============================================================
                    // ПОЗИЦІЇ — видалення
                    // ============================================================
                    window.itemDelete = function (id) {
                        $('#modalConfirmText').text('Видалити позицію угоди?');
                        $('#modalConfirmDelete').modal('show');

                        $('#btnConfirmDelete').off('click').on('click', function () {
                            $.post('/api/deals/' + DEAL_ID + '/items/' + id + '/delete')
                                .done(function () {
                                    $('#modalConfirmDelete').modal('hide');
                                    itemsTable.replaceData();
                                })
                                .fail(function () { alert('Помилка видалення'); });
                        });
                    };


                    // ============================================================
                    // АКТИВНОСТІ — нагадування toggle
                    // ============================================================
                    $('#activity_reminder').on('change', function () {
                        $('#activity_reminder_block').toggle(this.checked);
                    });

                    // ============================================================
                    // АКТИВНОСТІ — відкриття модалки "Додати"
                    // ============================================================
                    $('#btnAddActivity').on('click', function () {
                        $('#modalActivityTitle').text('Додати активність');
                        $('#activity_id').val('');
                        $('#activity_type').val($('#activity_type option:first').val());
                        $('#activity_outcome').val('');
                        $('#activity_subject').val('');
                        $('#activity_description').val('');
                        $('#activity_result').val('');
                        $('#activity_next_step').val('');
                        $('#activity_date_plan').val('');
                        $('#activity_duration').val('');
                        $('#activity_status').val('planned');
                        $('#activity_location').val('');
                        $('#activity_location_url').val('');
                        $('#activity_priority').val(2);
                        $('#activity_reminder').prop('checked', false);
                        $('#activity_reminder_minutes').val(30);
                        $('#activity_reminder_block').hide();
                        $('#modalActivity').modal('show');
                    });

                    // ============================================================
                    // АКТИВНОСТІ — відкриття модалки "Редагувати"
                    // ============================================================
                    window.activityEdit = function (d) {
                        $('#modalActivityTitle').text('Редагувати активність');
                        $('#activity_id').val(d.id);
                        $('#activity_type').val(d.id_activity_type || '');
                        $('#activity_outcome').val(d.id_outcome || '');
                        $('#activity_subject').val(d.subject || '');
                        $('#activity_description').val(d.description || '');
                        $('#activity_result').val(d.result || '');
                        $('#activity_next_step').val(d.next_step || '');
                        $('#activity_date_plan').val(d.date_plan ? d.date_plan.substring(0, 16) : '');
                        $('#activity_duration').val(d.duration_minutes || '');
                        $('#activity_status').val(d.status || 'planned');
                        $('#activity_location').val(d.location || '');
                        $('#activity_location_url').val(d.location_url || '');
                        $('#activity_priority').val(d.priority || 2);
                        $('#activity_reminder').prop('checked', d.reminder == 1);
                        $('#activity_reminder_minutes').val(d.reminder_minutes || 30);
                        $('#activity_reminder_block').toggle(d.reminder == 1);
                        $('#modalActivity').modal('show');
                    };

                    // ============================================================
                    // АКТИВНОСТІ — збереження
                    // ============================================================
                    $('#btnSaveActivity').on('click', function () {
                        var subject = $.trim($('#activity_subject').val());
                        var date_plan = $('#activity_date_plan').val();
                        if (!subject) { alert('Вкажіть тему активності'); return; }
                        if (!date_plan) { alert('Вкажіть дату активності'); return; }

                        var id = $('#activity_id').val();
                        var url = id
                            ? '/api/deals/' + DEAL_ID + '/activities/' + id + '/edit'
                            : '/api/deals/' + DEAL_ID + '/activities/add';

                        $.post(url, {
                            id_activity_type: $('#activity_type').val(),
                            id_outcome: $('#activity_outcome').val(),
                            subject: subject,
                            description: $('#activity_description').val(),
                            result: $('#activity_result').val(),
                            next_step: $('#activity_next_step').val(),
                            date_plan: date_plan,
                            duration_minutes: $('#activity_duration').val(),
                            status: $('#activity_status').val(),
                            location: $('#activity_location').val(),
                            location_url: $('#activity_location_url').val(),
                            priority: $('#activity_priority').val(),
                            reminder: $('#activity_reminder').is(':checked') ? 1 : 0,
                            reminder_minutes: $('#activity_reminder_minutes').val(),
                        })
                            .done(function () {
                                $('#modalActivity').modal('hide');
                                activitiesTable.replaceData();
                            })
                            .fail(function () { alert('Помилка збереження'); });
                    });

                    // ============================================================
                    // АКТИВНОСТІ — видалення
                    // ============================================================
                    window.activityDelete = function (id) {
                        $('#modalConfirmText').text('Видалити активність?');
                        $('#modalConfirmDelete').modal('show');

                        $('#btnConfirmDelete').off('click').on('click', function () {
                            $.post('/api/deals/' + DEAL_ID + '/activities/' + id + '/delete')
                                .done(function () {
                                    $('#modalConfirmDelete').modal('hide');
                                    activitiesTable.replaceData();
                                })
                                .fail(function () { alert('Помилка видалення'); });
                        });
                    };


                    // ============================================================
                    // ЗАВДАННЯ — відкриття модалки "Додати"
                    // ============================================================
                    $('#btnAddTask').on('click', function () {
                        $('#modalTaskTitle').text('Нове завдання');
                        $('#task_id').val('');
                        $('#task_title').val('');
                        $('#task_description').val('');
                        $('#task_id_user').val('');
                        $('#task_status').val('new');
                        $('#task_date_start').val('');
                        $('#task_date_due').val('');
                        $('#task_priority').val(2);
                        $('#task_estimated').val('');
                        $('#task_progress').val(0);
