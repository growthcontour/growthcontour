		<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
		<script src="/assets/js/notyf/notyf.min.js"></script>
				<script>
			(function () {
				const CLIENT_ID = <%= c.id %>;
				const API = "/api/clients/" + CLIENT_ID + "/notes/";
				const text = document.getElementById("nt-text");
				const sug = document.getElementById("nt-suggest");
				const list = document.getElementById("nt-list");
				const moreBox = document.getElementById("nt-more-box");
				let NEXT = null;
				let MENTIONS = {}; // id → імʼя, обрані через @
				let EDIT_MENTIONS = {};
				let sugTimer = null;
				let sugTarget = null;

				const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
				const fail = (m) => (window.Notyf ? new Notyf().error(m) : alert(m));

				async function post(url, data) {
					const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data || {}) });
					const j = await r.json().catch(() => ({}));
					if (!r.ok || j.ok === false) throw new Error(j.error || "<%= i18n.__('clients.card.server_error') %>");
					return j;
				}

				// Текст: екранування, переноси, виділення @згадок
				function fmt(body) {
					return esc(body)
						.replace(/(^|\s)(@[^\s@,.;:!?]+(?: [^\s@,.;:!?]+)?)/g, '$1<span class="text-primary fw-semibold">$2</span>')
						.replace(/\n/g, "<br>");
				}

				function item(n) {
					const when = new Date(n.date_add).toLocaleString([], { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" });
					return (
						'<div class="border-start border-3 ps-2 mb-3 ' + (n.is_pinned ? "border-warning" : "border-primary") + '" data-note="' + n.id + '">' +
						'<div class="d-flex justify-content-between align-items-start gap-2">' +
						'<div class="small text-muted">' + (n.is_pinned ? '<i class="fa-solid fa-thumbtack text-warning me-1"></i>' : "") + "<b>" + esc(n.author) + "</b> · " + esc(when) + (n.edited ? " · <%= i18n.__('clients.card.notes.edited') %>" : "") + "</div>" +
						'<div class="btn-group btn-group-sm flex-shrink-0">' +
						'<button class="btn btn-link btn-sm p-0 px-1 text-muted" data-nt="pin" data-v="' + (n.is_pinned ? 0 : 1) + '" title="' + (n.is_pinned ? "<%= i18n.__('clients.card.notes.unpin') %>" : "<%= i18n.__('clients.card.notes.pin') %>") + '"><i class="fa-solid fa-thumbtack"></i></button>' +
						(n.is_mine ? '<button class="btn btn-link btn-sm p-0 px-1 text-muted" data-nt="edit" title="<%= i18n.__('clients.card.edit_note') %>"><i class="fa-solid fa-pen"></i></button>' : "") +
						'<button class="btn btn-link btn-sm p-0 px-1 text-muted" data-nt="del" title="<%= i18n.__('clients.card.delete') %>"><i class="fa-solid fa-trash"></i></button>' +
						"</div></div>" +
						'<div class="nt-body">' + fmt(n.body) + "</div>" +
						"</div>"
					);
				}

				let CACHE = {};
				async function load(reset) {
					try {
						const d = await post(API, { before_id: reset ? null : NEXT, limit: 20 });
						[...d.pinned, ...d.rows].forEach((n) => (CACHE[n.id] = n));
						const html = (reset ? d.pinned : []).concat(d.rows).map(item).join("");
						if (reset) list.innerHTML = html || '<div class="text-muted small text-center"><%= i18n.__('clients.card.notes.empty') %></div>';
						else list.insertAdjacentHTML("beforeend", html);
						NEXT = d.next_before_id;
						moreBox.classList.toggle("d-none", !d.has_more);
					} catch (e) {
						list.innerHTML = '<div class="text-danger small">' + esc(e.message) + "</div>";
					}
				}

				// ─── @згадки: пошук колеги за текстом після @ ───
				function mentionQuery(el) {
					const upto = el.value.slice(0, el.selectionStart);
					const m = upto.match(/(^|\s)@([^\s@]{1,30}(?: [^\s@]{0,30})?)$/);
					return m ? m[2] : null;
				}
				function onType(el, store) {
					clearTimeout(sugTimer);
					const q = mentionQuery(el);
					if (!q || q.length < 2) return sug.classList.add("d-none");
					sugTimer = setTimeout(async () => {
						try {
							const r = await fetch("/api/calendar/users/search", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: new URLSearchParams({ q }) });
							const users = await r.json();
							if (!Array.isArray(users) || !users.length) return sug.classList.add("d-none");
							sugTarget = { el, store };
							sug.innerHTML = users.slice(0, 8).map((u) => '<button type="button" class="list-group-item list-group-item-action small py-1" data-uid="' + u.id + '" data-name="' + esc(u.user_name) + '">' + esc(u.user_name) + "</button>").join("");
							el.parentNode.appendChild(sug);
							sug.style.top = el.offsetHeight + "px";
							sug.classList.remove("d-none");
						} catch (e) {
							sug.classList.add("d-none");
						}
					}, 250);
				}
				sug.addEventListener("mousedown", (ev) => {
					const b = ev.target.closest("[data-uid]");
					if (!b || !sugTarget) return;
					ev.preventDefault();
					const el = sugTarget.el;
					const pos = el.selectionStart;
					const before = el.value.slice(0, pos).replace(/@([^\s@]{1,30}(?: [^\s@]{0,30})?)$/, "@" + b.dataset.name + " ");
					el.value = before + el.value.slice(pos);
					el.selectionStart = el.selectionEnd = before.length;
					sugTarget.store[b.dataset.uid] = b.dataset.name;
					sug.classList.add("d-none");
					el.focus();
				});
				text.addEventListener("input", () => onType(text, MENTIONS));
				document.addEventListener("click", (ev) => {
					if (!ev.target.closest("#nt-suggest")) sug.classList.add("d-none");
				});

				const mentionIds = (body, store) => Object.keys(store).filter((id) => body.includes("@" + store[id])).map(Number);

				document.getElementById("nt-add").addEventListener("click", async function () {
					const body = text.value.trim();
					if (!body) return;
					this.disabled = true;
					try {
						await post(API + "add/", { body, mentions: mentionIds(body, MENTIONS) });
						text.value = "";
						MENTIONS = {};
						load(true);
					} catch (e) {
						fail(e.message);
					} finally {
						this.disabled = false;
					}
				});
				text.addEventListener("keydown", (ev) => {
					if (ev.key === "Enter" && (ev.ctrlKey || ev.metaKey)) document.getElementById("nt-add").click();
				});

				document.getElementById("nt-more").addEventListener("click", () => load(false));

				list.addEventListener("click", async (ev) => {
					const b = ev.target.closest("[data-nt]");
					if (!b) return;
					const box = b.closest("[data-note]");
					const id = Number(box.dataset.note);
					const act = b.dataset.nt;
					try {
						if (act === "pin") {
							await post(API + id + "/pin/", { pinned: b.dataset.v === "1" });
							return load(true);
						}
						if (act === "del") {
							if (!confirm("<%= i18n.__('clients.card.notes.confirm_delete') %>")) return;
							await post(API + id + "/delete/");
							return load(true);
						}
						if (act === "edit") {
							const n = CACHE[id];
							EDIT_MENTIONS = {};
							const bodyEl = box.querySelector(".nt-body");
							bodyEl.innerHTML =
								'<div class="position-relative"><textarea class="form-control form-control-sm rounded-0 mb-1" rows="3">' + esc(n.body) + "</textarea></div>" +
								'<div class="d-flex gap-1 justify-content-end"><button class="btn btn-sm btn-secondary rounded-0" data-nt="cancel"><%= i18n.__('clients.card.cancel') %></button><button class="btn btn-sm btn-primary rounded-0" data-nt="save"><%= i18n.__('clients.card.save') %></button></div>';
							const ta = bodyEl.querySelector("textarea");
							ta.addEventListener("input", () => onType(ta, EDIT_MENTIONS));
							ta.focus();
							return;
						}
						if (act === "cancel") return load(true);
						if (act === "save") {
							const body = box.querySelector("textarea").value.trim();
							await post(API + id + "/edit/", { body, mentions: mentionIds(body, EDIT_MENTIONS) });
							return load(true);
						}
					} catch (e) {
						fail(e.message);
					}
				});

				load(true);
			})();
		</script>
		<script>
			(function () {
				const CLIENT_ID = <%= c.id %>;
				const card = document.getElementById("cf-card");
				const body = document.getElementById("cf-body");
				const form = document.getElementById("cf-form");
				let FIELDS = [];

				const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
				const fail = (m) => (window.Notyf ? new Notyf().error(m) : alert(m));

				async function post(url, data) {
					const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data || {}) });
					const j = await r.json().catch(() => ({}));
					if (!r.ok || j.ok === false) throw new Error(j.error || "<%= i18n.__('clients.card.server_error') %>");
					return j;
				}

				function show(f) {
					if (f.text === null || f.text === undefined) return '<span class="text-muted">—</span>';
					if (f.type === "url") return '<a href="' + esc(f.text) + '" target="_blank" rel="noopener">' + esc(f.text) + "</a>";
					if (f.type === "email") return '<a href="mailto:' + esc(f.text) + '">' + esc(f.text) + "</a>";
					if (f.type === "phone") return '<a href="tel:' + esc(f.text) + '">' + esc(f.text) + "</a>";
					if (f.type === "textarea") return '<span style="white-space:pre-line">' + esc(f.text) + "</span>";
					return esc(f.text);
				}

				function render() {
					card.classList.toggle("d-none", !FIELDS.length);
					body.innerHTML = '<dl class="row small mb-0">' + FIELDS.map((f) => '<dt class="col-6">' + esc(f.name) + '</dt><dd class="col-6">' + show(f) + "</dd>").join("") + "</dl>";
				}

				function input(f) {
					const id = "cf-" + f.id;
					const req = f.required ? " *" : "";
					const ph = esc(f.placeholder);
					const opts = (sel) => f.options.filter((o) => o.active || sel(o.id)).map((o) => '<option value="' + o.id + '"' + (sel(o.id) ? " selected" : "") + ">" + esc(o.name) + "</option>").join("");
					let el;
					switch (f.type) {
						case "textarea":
							el = '<textarea class="form-control rounded-0" id="' + id + '" rows="3" placeholder="' + ph + '">' + esc(f.value) + "</textarea>";
							break;
						case "number":
							el = '<input type="number" step="any" class="form-control rounded-0" id="' + id + '" placeholder="' + ph + '" value="' + esc(f.value) + '" />';
							break;
						case "date":
							el = '<input type="date" class="form-control rounded-0" id="' + id + '" value="' + esc(f.value) + '" />';
							break;
						case "boolean":
							el = '<select class="form-select rounded-0" id="' + id + '"><option value="">—</option><option value="1"' + (f.value === true ? " selected" : "") + '><%= i18n.__('clients.card.custom_fields.yes') %></option><option value="0"' + (f.value === false ? " selected" : "") + "><%= i18n.__('clients.card.custom_fields.no') %></option></select>";
							break;
						case "select":
							el = '<select class="form-select rounded-0" id="' + id + '"><option value="">—</option>' + opts((oid) => oid === f.value) + "</select>";
							break;
						case "multiselect":
							el = '<select class="form-select rounded-0" id="' + id + '" multiple size="' + Math.min(6, Math.max(3, f.options.length)) + '">' + opts((oid) => (f.value || []).includes(oid)) + "</select>";
							break;
						default:
							el = '<input type="' + (f.type === "email" ? "email" : f.type === "url" ? "url" : f.type === "phone" ? "tel" : "text") + '" class="form-control rounded-0" id="' + id + '" placeholder="' + ph + '" value="' + esc(f.value) + '" />';
					}
					return '<div class="' + (f.type === "textarea" || f.type === "multiselect" ? "col-12" : "col-md-6") + '"><label class="form-label" for="' + id + '">' + esc(f.name) + req + "</label>" + el + "</div>";
				}

				async function load() {
					try {
						FIELDS = (await post("/api/clients/" + CLIENT_ID + "/fields/")).fields || [];
						render();
					} catch (e) {
						card.classList.remove("d-none");
						body.innerHTML = '<div class="text-danger small">' + esc(e.message) + "</div>";
					}
				}

				document.getElementById("cf-edit").addEventListener("click", () => {
					form.innerHTML = FIELDS.map(input).join("");
					bootstrap.Modal.getOrCreateInstance(document.getElementById("cf-modal")).show();
				});

				document.getElementById("cf-save").addEventListener("click", async function () {
					const values = {};
					FIELDS.forEach((f) => {
						const el = document.getElementById("cf-" + f.id);
						values[f.id] = f.type === "multiselect" ? [...el.selectedOptions].map((o) => Number(o.value)) : el.value;
					});
					this.disabled = true;
					try {
						await post("/api/clients/" + CLIENT_ID + "/fields/save/", { values });
						bootstrap.Modal.getOrCreateInstance(document.getElementById("cf-modal")).hide();
						load();
					} catch (e) {
						fail(e.message);
					} finally {
						this.disabled = false;
					}
				});

				load();
			})();
		</script>
		<script>
			(function () {
				const CLIENT_ID = <%= c.id %>;
				const MANAGER_ID = <%= c.id_manager || 0 %>;
				const body = document.getElementById("cal-body");
				const toggle = document.getElementById("cal-done-toggle");
				let SCOPE = "upcoming";
				let TYPES_LOADED = false;

				const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
				const pad = (n) => String(n).padStart(2, "0");
				const local = (d) => d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate()) + "T" + pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":00";

				async function post(url, data) {
					const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data || {}) });
					const j = await r.json().catch(() => ({}));
					if (!r.ok) throw new Error(j.error || "<%= i18n.__('clients.card.server_error') %>");
					return j;
				}

				function item(e) {
					const start = new Date(e.date_start);
					const overdue = e.status === 1 && start < new Date();
					const when = e.all_day ? start.toLocaleDateString() : start.toLocaleString([], { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" });
					const st = e.status === 2 ? '<span class="badge text-bg-success rounded-0"><%= i18n.__('clients.card.calendar.status_done') %></span>' : e.status === 3 ? '<span class="badge text-bg-secondary rounded-0"><%= i18n.__('clients.card.merges.reverted') %></span>' : overdue ? '<span class="badge text-bg-danger rounded-0"><%= i18n.__('clients.card.calendar.status_overdue') %></span>' : "";
					const btns =
						e.status === 1
							? '<button class="btn btn-sm btn-outline-success rounded-0" data-cal-status="2" data-id="' + e.id + '" title="<%= i18n.__('clients.card.calendar.mark_done') %>"><i class="fa-solid fa-check"></i></button>' +
							  '<button class="btn btn-sm btn-outline-secondary rounded-0" data-cal-status="3" data-id="' + e.id + '" title="<%= i18n.__('clients.card.cancel') %>"><i class="fa-solid fa-xmark"></i></button>'
							: '<button class="btn btn-sm btn-outline-primary rounded-0" data-cal-status="1" data-id="' + e.id + '" title="<%= i18n.__('clients.card.calendar.restore') %>"><i class="fa-solid fa-rotate-left"></i></button>';
					return (
						'<div class="tl-item"><div class="tl-icon" style="background:' + esc(e.type_color || "#6c757d") + '"><i class="' + esc(e.type_icon || "fa-solid fa-calendar") + '"></i></div><div class="tl-body">' +
						'<div class="d-flex justify-content-between gap-2"><div><a href="/?event=' + e.id + '" class="fw-semibold">' + esc(e.title) + "</a> " + st + "</div>" +
						(e.is_mine ? '<div class="btn-group align-self-start">' + btns + "</div>" : "") + "</div>" +
						(e.description ? '<div class="tl-text">' + esc(e.description) + "</div>" : "") +
						'<div class="tl-sub' + (overdue ? " text-danger" : "") + '">' + esc(when) + (e.type_name ? " · " + esc(e.type_name) : "") + (e.creator_name ? " · " + esc(e.creator_name) : "") + "</div></div></div>"
					);
				}

				async function load() {
					try {
						const d = await post("/api/calendar/links/list", { type: "client", id: CLIENT_ID, scope: SCOPE, limit: 50 });
						body.innerHTML = d.rows.length ? d.rows.map(item).join("") : '<div class="text-center text-muted py-2">' + (SCOPE === "done" ? "<%= i18n.__('clients.card.calendar.empty_done') %>" : "<%= i18n.__('clients.card.calendar.empty') %>") + "</div>";
					} catch (e) {
						body.innerHTML = '<div class="text-danger">' + esc(e.message) + "</div>";
					}
				}

				toggle.addEventListener("click", function () {
					SCOPE = SCOPE === "upcoming" ? "done" : "upcoming";
					toggle.textContent = SCOPE === "done" ? "<%= i18n.__('clients.card.calendar.planned') %>" : "<%= i18n.__('clients.card.calendar.done') %>";
					load();
				});

				body.addEventListener("click", async function (ev) {
					const b = ev.target.closest("[data-cal-status]");
					if (!b) return;
					b.disabled = true;
					try {
						await post("/api/calendar/events/" + b.dataset.id + "/status", { status: parseInt(b.dataset.calStatus, 10) });
						load();
					} catch (e) {
						b.disabled = false;
						new Notyf().error(e.message);
					}
				});

				const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById("modal-cal"));

				document.getElementById("cal-add").addEventListener("click", async function () {
					const d = new Date(Date.now() + 3600000);
					d.setMinutes(0, 0, 0);
					document.getElementById("cal-title").value = "";
					document.getElementById("cal-desc").value = "";
					document.getElementById("cal-date").value = d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
					document.getElementById("cal-time").value = pad(d.getHours()) + ":00";
					document.getElementById("cal-manager").closest(".form-check").classList.toggle("d-none", !MANAGER_ID);
					if (!TYPES_LOADED) {
						try {
							const types = await post("/api/calendar/event-types");
							document.getElementById("cal-type").insertAdjacentHTML("beforeend", types.filter((t) => !t.is_absence).map((t) => '<option value="' + t.id + '">' + esc(t.name || t.code) + "</option>").join(""));
							TYPES_LOADED = true;
						} catch (e) {}
					}
					modal.show();
					setTimeout(() => document.getElementById("cal-title").focus(), 300);
				});

				document.getElementById("cal-save").addEventListener("click", async function () {
					const btn = this;
					const title = document.getElementById("cal-title").value.trim();
					const date = document.getElementById("cal-date").value;
					const time = document.getElementById("cal-time").value || "09:00";
					if (!title || !date) return new Notyf().error("<%= i18n.__('clients.card.calendar.need_title_date') %>");

					const start = new Date(date + "T" + time + ":00");
					const end = new Date(start.getTime() + parseInt(document.getElementById("cal-dur").value, 10) * 60000);
					const remind = document.getElementById("cal-remind").value;
					const type = document.getElementById("cal-type").value;

					btn.disabled = true;
					try {
						await post("/api/calendar/events/add", {
							title,
							description: document.getElementById("cal-desc").value.trim() || null,
							date_start: local(start),
							date_end: local(end),
							all_day: 0,
							tz_offset: -new Date().getTimezoneOffset(),
							priority: 2,
							status: 1,
							visibility: 1,
							notify_scope: 2,
							is_busy: 1,
							id_event_type: type ? parseInt(type, 10) : null,
							reminder_minutes: remind === "" ? null : parseInt(remind, 10),
							participant_ids: MANAGER_ID && document.getElementById("cal-manager").checked ? [MANAGER_ID] : [],
							links: [{ type: "client", id: CLIENT_ID }],
						});
						modal.hide();
						SCOPE = "upcoming";
						toggle.textContent = "<%= i18n.__('clients.card.calendar.done') %>";
						load();
					} catch (e) {
						new Notyf().error(e.message);
					} finally {
						btn.disabled = false;
					}
				});

				load();
			})();
		</script>

		<script>
			(function () {
				const CLIENT_ID = <%= c.id %>;
				const body = document.getElementById("tl-body");
				let ITEMS = [];
				let FILTER = "all";

				const CH_ICON = { telegram: ["fa-brands fa-telegram", "#229ED9"], instagram: ["fa-brands fa-instagram", "#E1306C"], webchat: ["fa-solid fa-comments", "#16a085"] };
				const ROLE = { buyer: "<%= i18n.__('clients.card.timeline.role.buyer') %>", recipient: "<%= i18n.__('clients.card.timeline.role.recipient') %>", company: "<%= i18n.__('clients.card.timeline.role.company') %>" };
				const CONV_STATUS = { open: "<%= i18n.__('clients.card.timeline.conv.open') %>", pending: "<%= i18n.__('clients.card.timeline.conv.pending') %>", resolved: "<%= i18n.__('clients.card.timeline.conv.resolved') %>", archived: "<%= i18n.__('clients.card.timeline.conv.archived') %>" };

				function esc(s) {
					return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
				}
				function col(v, def) {
					return v ? (v[0] === "#" ? v : "#" + v) : def;
				}
				function badge(text, ct, cb, icon) {
					if (!text) return "";
					return '<span class="badge rounded-0 me-1" style="color:' + col(ct, "#fff") + ";background:" + col(cb, "#6c757d") + '">' + (icon ? '<i class="' + esc(icon) + ' me-1"></i>' : "") + esc(text) + "</span>";
				}

				function renderItem(x) {
					if (x.type === "order") {
						return (
							'<div class="tl-item"><div class="tl-icon" style="background:#8e44ad"><i class="fa-solid fa-cart-shopping"></i></div><div class="tl-body">' +
							'<div class="d-flex justify-content-between gap-2"><div><a href="/orders/' + x.id + '/" class="fw-semibold"><%= i18n.__('clients.card.timeline.orders') %> ' + esc(x.title) + "</a> " +
							badge(x.status.name, x.status.color_text, x.status.color_background, x.status.icon) + "</div>" +
							'<span class="badge text-bg-primary rounded-0 align-self-start">' + esc(x.amount) + " " + esc(x.currency || "") + "</span></div>" +
							'<div class="tl-sub">' + esc(x.dt_text) + " · " + esc(ROLE[x.role] || x.role) + (x.source ? " · " + esc(x.source) : "") + "</div></div></div>"
						);
					}
					if (x.type === "lead") {
						return (
							'<div class="tl-item"><div class="tl-icon" style="background:#f39c12"><i class="fa-solid fa-bullseye"></i></div><div class="tl-body">' +
							'<div class="d-flex justify-content-between gap-2"><div><a href="/leads/' + x.id + '/" class="fw-semibold">' + esc(x.title || "<%= i18n.__('clients.card.timeline.lead') %> #" + x.id) + "</a> " +
							badge(x.status.name, x.status.color_text, x.status.color_background) +
							(x.stage ? '<span class="badge rounded-0 me-1" style="color:#fff;background:' + col(x.stage.color, "#6c757d") + '">' + esc(x.stage.name) + "</span>" : "") +
							(x.converted ? '<span class="badge text-bg-success rounded-0"><%= i18n.__('clients.card.timeline.converted') %></span>' : "") + "</div>" +
							(x.amount ? '<span class="badge text-bg-light border rounded-0 align-self-start">' + esc(x.amount) + "</span>" : "") + "</div>" +
							'<div class="tl-sub">' + esc(x.dt_text) + "</div></div></div>"
						);
					}
					const ic = CH_ICON[x.channel_type] || ["fa-solid fa-comment", "#6c757d"];
					return (
						'<div class="tl-item"><div class="tl-icon" style="background:' + ic[1] + '"><i class="' + ic[0] + '"></i></div><div class="tl-body">' +
						'<div><a href="/contact-center/chat/' + esc(x.url_token) + '/" class="fw-semibold"><%= i18n.__('clients.card.timeline.dialog') %> · ' + esc(x.title) + "</a> " +
						'<span class="badge text-bg-light border rounded-0">' + esc(CONV_STATUS[x.conv_status] || x.conv_status) + "</span></div>" +
						(x.last_text ? '<div class="tl-text">' + (x.last_dir === "out" ? '<i class="fa-solid fa-reply me-1 text-muted"></i>' : "") + esc(x.last_text) + "</div>" : "") +
						'<div class="tl-sub">' + esc(x.dt_text) + " · <%= i18n.__('clients.card.timeline.messages') %> " + (x.messages_count || 0) + "</div></div></div>"
					);
				}

				function render() {
					if (FILTER === "changes") return;
					const list = FILTER === "all" ? ITEMS : ITEMS.filter((x) => x.type === FILTER);
					body.innerHTML = list.length ? list.map(renderItem).join("") : '<div class="text-center text-muted py-4"><%= i18n.__('clients.card.timeline.empty') %></div>';
				}

				document.querySelectorAll("#tl-tabs [data-filter]").forEach(function (btn) {
					btn.addEventListener("click", function () {
						document.querySelectorAll("#tl-tabs .nav-link").forEach((b) => b.classList.remove("active"));
						btn.classList.add("active");
						FILTER = btn.getAttribute("data-filter");
						if (FILTER === "changes") loadChanges(true);
						else render();
					});
				});

								// ─── Вкладка «Зміни» ───────────────────────────
				const H_SOURCE = { manual: ["<%= i18n.__('clients.card.history.source.manual') %>", "fa-solid fa-user-pen", "#0d6efd"], order: ["<%= i18n.__('clients.card.timeline.orders') %>", "fa-solid fa-cart-shopping", "#8e44ad"], "contact-center": ["<%= i18n.__('clients.card.history.source.contact_center') %>", "fa-solid fa-headset", "#16a085"], chat: ["<%= i18n.__('clients.card.history.source.chat') %>", "fa-solid fa-comments", "#16a085"], lead: ["<%= i18n.__('clients.card.timeline.lead') %>", "fa-solid fa-bullseye", "#f39c12"], import: ["<%= i18n.__('clients.card.history.source.import') %>", "fa-solid fa-file-import", "#6c757d"], merge: ["<%= i18n.__('clients.card.history.source.merge') %>", "fa-solid fa-code-merge", "#d35400"], api: ["API", "fa-solid fa-plug", "#6c757d"], site_sync: ["<%= i18n.__('clients.card.history.source.site_sync') %>", "fa-solid fa-rotate", "#2980b9"], system: ["<%= i18n.__('clients.card.history.source.system') %>", "fa-solid fa-gear", "#7f8c8d"] };
				const H_ENTITY = { client: "<%= i18n.__('clients.card.history.entity.client') %>", person: "<%= i18n.__('clients.card.history.entity.person') %>", organization: "<%= i18n.__('clients.card.kind.organization') %>", contact: "<%= i18n.__('clients.card.contact_form.title') %>", address: "<%= i18n.__('clients.card.address_form.title') %>", identifier: "<%= i18n.__('clients.card.identifier_form.title') %>", relationship: "<%= i18n.__('clients.card.history.entity.relationship') %>", commercial: "<%= i18n.__('clients.card.commercial.title') %>", tag: "<%= i18n.__('clients.card.history.entity.tag') %>", role: "<%= i18n.__('clients.card.history.entity.role') %>", external_id: "<%= i18n.__('clients.card.history.entity.external_id') %>", order: "<%= i18n.__('clients.card.timeline.orders') %>", lead: "<%= i18n.__('clients.card.timeline.lead') %>", chat_contact: "<%= i18n.__('clients.card.history.entity.chat_contact') %>", duplicate: "<%= i18n.__('clients.card.history.entity.duplicate') %>", links: "<%= i18n.__('clients.card.history.entity.links') %>", event: "<%= i18n.__('clients.card.history.entity.event') %>", field: "<%= i18n.__('clients.card.history.entity.field') %>", note: "<%= i18n.__('clients.card.profile.note') %>" };
				const H_ACTION = { created: "<%= i18n.__('clients.card.history.action.created') %>", updated: "<%= i18n.__('clients.card.notes.edited') %>", added: "<%= i18n.__('clients.card.history.action.added') %>", removed: "<%= i18n.__('clients.card.history.action.removed') %>", linked: "<%= i18n.__('clients.card.history.action.linked') %>", unlinked: "<%= i18n.__('clients.card.history.action.unlinked') %>", merged: "<%= i18n.__('clients.card.history.action.merged') %>", merge_reverted: "<%= i18n.__('clients.card.history.action.merge_reverted') %>", dismissed: "<%= i18n.__('clients.card.history.action.dismissed') %>" };
				const H = { rows: [], next: null, more: false, source: "", entity: "", busy: false };

				function hRef(x) {
					const r = x.source_ref;
					if (!r) return "";
					if ((x.source === "order" || x.source === "contact-center") && /^\d+$/.test(r)) return ' · <a href="/orders/' + r + '/"><%= i18n.__('clients.card.history.order_ref') %> #' + esc(r) + "</a>";
					if (x.source === "lead" && /^\d+$/.test(r)) return ' · <a href="/leads/' + r + '/"><%= i18n.__('clients.card.history.lead_ref') %> #' + esc(r) + "</a>";
					if (x.source === "merge") return " · <%= i18n.__('clients.card.history.action.merged') %> #" + esc(r);
					return " · " + esc(r);
				}
				function hLine(x) {
					const act = H_ACTION[x.action] || x.action;
					const what = H_ENTITY[x.entity] || x.entity;
					let link = "";
					if (x.entity === "order" && x.id_entity) link = ' <a href="/orders/' + x.id_entity + '/">' + esc(x.new_text || x.old_text || "#" + x.id_entity) + "</a>";
					else if (x.entity === "event" && x.id_entity && x.action !== "updated") link = ' <a href="/?event=' + x.id_entity + '">' + esc(x.new_text || x.old_text || "#" + x.id_entity) + "</a>";
					else if (x.entity === "lead" && x.id_entity) link = ' <a href="/leads/' + x.id_entity + '/">' + esc(x.new_text || x.old_text || "#" + x.id_entity) + "</a>";
					else if ((x.action === "merged" || x.action === "merge_reverted") && (x.value_new || x.value_old)) {
						const other = x.value_new || x.value_old;
						link = ' <a href="/clients/' + esc(other) + '/">#' + esc(other) + (x.old_text && x.action === "merged" ? " " + esc(x.old_text) : "") + "</a>";
					}
					const field = x.field_text ? ' <span class="text-muted">' + esc(x.field_text) + "</span>" : "";
					let val = "";
					if (!link) {
						if (x.action === "updated") val = ': <s class="text-muted">' + esc(x.old_text ?? "—") + '</s> <i class="fa-solid fa-arrow-right-long mx-1 text-muted"></i> <b>' + esc(x.new_text ?? "—") + "</b>";
						else if (x.new_text != null || x.old_text != null) val = ": <b>" + esc(x.new_text ?? x.old_text) + "</b>";
					}
					return '<div class="small">' + esc(what) + " " + esc(act) + field + val + link + "</div>";
				}
				function renderChanges() {
					const groups = [];
					for (const x of H.rows) {
						const g = groups[groups.length - 1];
						if (g && g.batch === x.batch) g.items.push(x);
						else groups.push({ batch: x.batch, items: [x] });
					}
					const src = Object.entries(H_SOURCE).map(([k, v]) => '<option value="' + k + '"' + (H.source === k ? " selected" : "") + ">" + v[0] + "</option>").join("");
					const ent = Object.entries(H_ENTITY).map(([k, v]) => '<option value="' + k + '"' + (H.entity === k ? " selected" : "") + ">" + v + "</option>").join("");
					let html =
						'<div class="d-flex gap-2 mb-3"><select class="form-select form-select-sm rounded-0" id="h-source"><option value=""><%= i18n.__('clients.card.history.all_sources') %></option>' + src + "</select>" +
						'<select class="form-select form-select-sm rounded-0" id="h-entity"><option value=""><%= i18n.__('clients.card.history.all_entities') %></option>' + ent + "</select></div>";
					if (!groups.length) html += '<div class="text-center text-muted py-4"><%= i18n.__('clients.card.history.empty') %></div>';
					for (const g of groups) {
						const f = g.items[0];
						const s = H_SOURCE[f.source] || [f.source, "fa-solid fa-circle", "#6c757d"];
						html +=
							'<div class="tl-item"><div class="tl-icon" style="background:' + s[2] + '"><i class="' + s[1] + '"></i></div><div class="tl-body">' +
							g.items.map(hLine).join("") +
							'<div class="tl-sub">' + esc(new Date(f.date_add).toLocaleString()) + " · " + esc(f.user_name || (f.id_user ? "#" + f.id_user : s[0])) + (f.user_name || f.id_user ? " · " + esc(s[0]) : "") + hRef(f) + (f.ip ? ' · <span class="text-muted">' + esc(f.ip) + "</span>" : "") + "</div></div></div>";
					}
					if (H.more) html += '<div class="text-center"><button class="btn btn-sm btn-outline-primary rounded-0" id="h-more"><%= i18n.__('clients.card.show_more') %></button></div>';
					body.innerHTML = html;
					document.getElementById("h-source").addEventListener("change", (e) => { H.source = e.target.value; loadChanges(true); });
					document.getElementById("h-entity").addEventListener("change", (e) => { H.entity = e.target.value; loadChanges(true); });
					const more = document.getElementById("h-more");
					if (more) more.addEventListener("click", () => loadChanges(false));
				}
				function loadChanges(reset) {
					if (H.busy) return;
					H.busy = true;
					if (reset) { H.rows = []; H.next = null; }
					fetch("/api/clients/" + CLIENT_ID + "/history/", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ before_id: H.next, source: H.source, entity: H.entity, limit: 100 }) })
						.then((r) => r.json())
						.then(function (d) {
							H.rows = H.rows.concat(d.rows || []);
							H.next = d.next_before_id;
							H.more = !!d.has_more;
							if (FILTER === "changes") renderChanges();
						})
						.catch(function () { body.innerHTML = '<div class="text-danger py-3"><%= i18n.__('clients.card.history.load_error') %></div>'; })
						.finally(() => (H.busy = false));
				}

				fetch("/api/clients/" + CLIENT_ID + "/timeline/", { method: "POST" })
					.then((r) => r.json())
					.then(function (d) {
						ITEMS = d.items || [];
						["order", "lead", "chat"].forEach((k) => (document.getElementById("cnt-" + k).textContent = (d.counts && d.counts[k]) || 0));
						render();
					})
					.catch(function () {
						body.innerHTML = '<div class="text-danger py-3"><%= i18n.__('clients.card.timeline.load_error') %></div>';
					});
			})();
		</script>
				<script>
			(function () {
				const CID = <%= c.id %>;
				const FORM = <%- JSON.stringify(d.form).replace(/</g, '\\u003c') %>;
				const notyf = new Notyf({
					position: { x: "right", y: "top" },
					duration: 5000,
					types: [
						{ type: "success", dismissible: true, icon: false },
						{ type: "error", background: "indianred", dismissible: true, icon: false },
						{ type: "warning", background: "#e67e22", dismissible: true, icon: false },
					],
				});
				const $ = (id) => document.getElementById(id);
				const modalProfile = new bootstrap.Modal($("modal-profile"));
				const modalContact = new bootstrap.Modal($("modal-contact"));

				async function post(url, body) {
					const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) });
					const j = await r.json().catch(() => ({}));
					if (!r.ok || j.ok === false) throw new Error(j.error || "<%= i18n.__('clients.card.error') %>");
					return j;
				}
				const val = (id) => ($(id) ? $(id).value.trim() : undefined);
				const set = (id, v) => {
					if ($(id)) $(id).value = v == null ? "" : v;
				};
				function warnDuplicates(r) {
					if (r && r.duplicates && r.duplicates.length) {
						notyf.open({ type: "warning", message: "<%= i18n.__('clients.card.contact_form.duplicate_in') %> " + r.duplicates.map((x) => x.display_name || "#" + x.id_client).join(", ") + ". <%= i18n.__('clients.card.duplicate_added') %>" });
					}
				}
				const reloadSoon = (ms) => setTimeout(() => location.reload(), ms || 600);

				// Часові пояси з браузера (усі IANA-зони)
				try {
					const tzs = Intl.supportedValuesOf ? Intl.supportedValuesOf("timeZone") : [];
					$("tz-list").innerHTML = tzs.map((z) => '<option value="' + z + '">').join("");
				} catch (e) {}

				// ── Профіль ──
				function openProfile() {
					const p = FORM.person || {};
					["last_name", "first_name", "middle_name", "gender", "birth_date", "job_title", "trade_name"].forEach((k) => set("pf-" + k, p[k]));
					const o = FORM.organization || {};
					["legal_name", "short_name", "industry", "website", "employees_count", "registration_date"].forEach((k) => set("of-" + k, o[k]));
					["id_legal_type", "id_lifecycle", "status", "id_manager", "country", "timezone", "id_lang", "note"].forEach((k) => set("f-" + k, FORM[k]));
					document.querySelectorAll("#f-tags input").forEach((cb) => (cb.checked = (FORM.tags || []).includes(Number(cb.value))));
					modalProfile.show();
				}

				async function saveProfile(btn) {
					btn.disabled = true;
					try {
						const body = {
							id_legal_type: val("f-id_legal_type"),
							id_lifecycle: val("f-id_lifecycle"),
							status: val("f-status"),
							id_manager: val("f-id_manager"),
							country: (val("f-country") || "").toUpperCase(),
							timezone: val("f-timezone"),
							id_lang: val("f-id_lang"),
							note: val("f-note"),
						};
						if (FORM.kind === "person") {
							body.person = {};
							["last_name", "first_name", "middle_name", "gender", "birth_date", "job_title", "trade_name"].forEach((k) => (body.person[k] = val("pf-" + k)));
						} else if (FORM.kind === "organization") {
							body.organization = {};
							["legal_name", "short_name", "industry", "website", "employees_count", "registration_date"].forEach((k) => (body.organization[k] = val("of-" + k)));
						}
						await post("/api/clients/" + CID + "/profile/", body);
						const tags = [...document.querySelectorAll("#f-tags input:checked")].map((cb) => Number(cb.value));
						await post("/api/clients/" + CID + "/tags/", { tags });
						notyf.success("<%= i18n.__('clients.card.saved') %>");
						modalProfile.hide();
						reloadSoon();
					} catch (e) {
						notyf.error(e.message);
					} finally {
						btn.disabled = false;
					}
				}

				// ── Контакти ──
				function openContact(li) {
					set("ct-id", li ? li.dataset.cp : "");
					$("ct-title").textContent = li ? "<%= i18n.__('clients.card.contact_form.edit_title') %>" : "<%= i18n.__('clients.card.contact_form.new_title') %>";
					$("ct-type").disabled = !!li; // тип контакту після створення не змінюється
					if (li) set("ct-type", li.dataset.type);
					set("ct-value", li ? li.dataset.value : "");
					set("ct-label", li ? li.dataset.label : "personal");
					$("ct-consent").checked = li ? li.dataset.consent === "1" : false;
					$("ct-primary").checked = false;
					$("ct-primary-wrap").style.display = li ? "none" : "";
					modalContact.show();
					setTimeout(() => $("ct-value").focus(), 300);
				}

				async function saveContact(btn) {
					btn.disabled = true;
					try {
						const idCp = val("ct-id");
						const body = { value: val("ct-value"), label: val("ct-label"), marketing_consent: $("ct-consent").checked ? 1 : 0 };
						let r;
						if (idCp) {
							r = await post("/api/clients/" + CID + "/contacts/" + idCp + "/update/", body);
						} else {
							body.id_contact_type = val("ct-type");
							body.is_primary = $("ct-primary").checked ? 1 : 0;
							r = await post("/api/clients/" + CID + "/contacts/add/", body);
						}
						if (r.valid === false) notyf.open({ type: "warning", message: "<%= i18n.__('clients.card.contact_form.invalid_saved') %>" });
						warnDuplicates(r);
						notyf.success("<%= i18n.__('clients.card.saved') %>");
						modalContact.hide();
						reloadSoon(r.duplicates && r.duplicates.length ? 2500 : 600);
					} catch (e) {
						notyf.error(e.message);
					} finally {
						btn.disabled = false;
					}
				}

				// ── Делегування кліків ──
				document.addEventListener("click", async function (e) {
					const el = e.target.closest("[data-cl]");
					if (!el) return;
					const li = el.closest("[data-cp]");
					switch (el.dataset.cl) {
						case "edit-profile":
							return openProfile();
						case "save-profile":
							return saveProfile(el);
						case "add-contact":
							return openContact(null);
						case "edit-contact":
							return openContact(li);
						case "save-contact":
							return saveContact(el);
						case "primary-contact":
							try {
								await post("/api/clients/" + CID + "/contacts/" + li.dataset.cp + "/primary/");
								reloadSoon(200);
							} catch (err) {
								notyf.error(err.message);
							}
							return;
						case "delete-contact":
							if (!confirm("<%= i18n.__('clients.card.contact_form.confirm_delete') %> " + li.dataset.value + "?")) return;
							try {
								await post("/api/clients/" + CID + "/contacts/" + li.dataset.cp + "/delete/");
								reloadSoon(200);
							} catch (err) {
								notyf.error(err.message);
							}
							return;
					}
				});

				$("ct-value").addEventListener("keydown", (e) => {
					if (e.key === "Enter") document.querySelector('[data-cl="save-contact"]').click();
				});
			})();
		</script>
		<script>
			(function () {
				const CID = <%= c.id %>;
				const EDIT = <%- JSON.stringify({ addresses: d.addresses, identifiers: d.identifiers, relationships: d.relationships, commercial: d.commercial }).replace(/</g, '\\u003c') %>;
				const notyf = new Notyf({
					position: { x: "right", y: "top" },
					duration: 5000,
					types: [
						{ type: "success", dismissible: true, icon: false },
						{ type: "error", background: "indianred", dismissible: true, icon: false },
						{ type: "warning", background: "#e67e22", dismissible: true, icon: false },
					],
				});
				const $ = (id) => document.getElementById(id);
				const M = (id) => bootstrap.Modal.getOrCreateInstance($(id));
				const val = (id) => ($(id) ? $(id).value.trim() : "");
				const set = (id, v) => {
					if ($(id)) $(id).value = v == null ? "" : v;
				};
				const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
				const reloadSoon = (ms) => setTimeout(() => location.reload(), ms || 600);
				const byId = (list, id) => (list || []).find((x) => String(x.id) === String(id));

				async function post(url, body) {
					const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) });
					const j = await r.json().catch(() => ({}));
					if (!r.ok || j.ok === false) throw new Error(j.error || "<%= i18n.__('clients.card.error') %>");
					return j;
				}
				async function run(fn, btn) {
					if (btn) btn.disabled = true;
					try {
						const r = await fn();
						if (r && r.duplicates && r.duplicates.length) {
							notyf.open({ type: "warning", message: "<%= i18n.__('clients.card.identifier_form.duplicate_in') %> " + r.duplicates.map((x) => x.display_name || "#" + x.id_client).join(", ") + ". <%= i18n.__('clients.card.duplicate_added') %>" });
							reloadSoon(2500);
						} else {
							notyf.success("<%= i18n.__('clients.card.saved') %>");
							reloadSoon();
						}
						return r;
					} catch (e) {
						notyf.error(e.message);
					} finally {
						if (btn) btn.disabled = false;
					}
				}

				// ── Адреси ──
				const AD_FIELDS = ["id_address_type", "country", "region", "postcode", "city", "street", "building", "apartment", "address_line", "carrier_code", "carrier_point_name", "carrier_point_ref", "recipient_name", "recipient_phone", "comment"];
				function openAddress(id) {
					const a = id ? byId(EDIT.addresses, id) : {};
					set("ad-id", id || "");
					$("ad-title").textContent = id ? "<%= i18n.__('clients.card.address_form.edit_title') %>" : "<%= i18n.__('clients.card.address_form.new_title') %>";
					AD_FIELDS.forEach((k) => set("ad-" + k, a[k]));
					if (!id) set("ad-id_address_type", $("ad-id_address_type").options[0] && $("ad-id_address_type").options[0].value);
					$("ad-is_default").checked = !!a.is_default;
					M("modal-address").show();
				}
				function saveAddress(btn) {
					const id = val("ad-id");
					const body = { is_default: $("ad-is_default").checked ? 1 : 0 };
					AD_FIELDS.forEach((k) => (body[k] = val("ad-" + k)));
					body.country = body.country.toUpperCase();
					return run(() => post("/api/clients/" + CID + "/addresses/" + (id ? id + "/update/" : "add/"), body), btn);
				}

				// ── Реквізити ──
				function openIdentifier(id) {
					const x = id ? byId(EDIT.identifiers, id) : null;
					set("id-id", id || "");
					$("id-title").textContent = id ? "<%= i18n.__('clients.card.identifier_form.edit_title') %>" : "<%= i18n.__('clients.card.identifier_form.new_title') %>";
					$("id-type").disabled = !!id;
					if (x) set("id-type", x.id_identifier_type);
					set("id-value", x ? x.value : "");
					set("id-country", x ? x.country : ($("id-type").selectedOptions[0] || {}).dataset?.country || "");
					$("id-verified").checked = x ? !!x.is_verified : false;
					M("modal-identifier").show();
				}
				$("id-type").addEventListener("change", function () {
					const c = this.selectedOptions[0] && this.selectedOptions[0].dataset.country;
					if (c) set("id-country", c);
				});
				function saveIdentifier(btn) {
					const id = val("id-id");
					const body = { id_identifier_type: val("id-type"), value: val("id-value"), country: val("id-country").toUpperCase(), is_verified: $("id-verified").checked ? 1 : 0 };
					return run(() => post("/api/clients/" + CID + "/identifiers/" + (id ? id + "/update/" : "add/"), body), btn);
				}

				// ── Зв'язки ──
				const KIND_ICON = { person: "fa-solid fa-user", organization: "fa-solid fa-building", group: "fa-solid fa-users" };
				function openRelationship(id) {
					const r = id ? byId(EDIT.relationships, id) : null;
					set("rl-id", id || "");
					$("rl-title").textContent = id ? "<%= i18n.__('clients.card.relationship_form.edit_title') %>" : "<%= i18n.__('clients.card.relationship_form.new_title') %>";
					$("rl-new-block").style.display = id ? "none" : "";
					$("rl-to-wrap").style.display = id ? "" : "none";
					set("rl-other", "");
					set("rl-search", "");
					$("rl-results").innerHTML = "";
					$("rl-picked").innerHTML = id ? "" : '<span class="text-muted"><%= i18n.__('clients.card.relationship_form.not_picked') %></span>';
					set("rl-title-input", r ? r.title : "");
					set("rl-from", r ? r.valid_from : "");
					set("rl-to", r ? r.valid_to : "");
					set("rl-note", r ? r.note : "");
					$("rl-primary").checked = r ? !!r.is_primary : false;
					M("modal-relationship").show();
				}
				let rlTimer = null;
				$("rl-search").addEventListener("input", function () {
					clearTimeout(rlTimer);
					const q = this.value.trim();
					if (q.length < 2) {
						$("rl-results").innerHTML = "";
						return;
					}
					rlTimer = setTimeout(async () => {
						try {
							const rows = (await post("/api/clients/search/", { q })).filter((x) => x.id !== CID);
							$("rl-results").innerHTML = rows.length
								? rows.map((x) => '<button type="button" class="list-group-item list-group-item-action small py-1 px-2 w-100 text-start border-0 border-bottom" data-pick="' + x.id + '" data-name="' + esc(x.display_name) + '"><i class="' + (KIND_ICON[x.kind] || KIND_ICON.person) + ' text-muted me-1"></i>' + esc(x.display_name || "#" + x.id) + ' <span class="text-muted">' + esc(x.phone || x.email || "") + "</span></button>").join("")
								: '<div class="small text-muted p-2"><%= i18n.__('clients.card.relationship_form.not_found') %></div>';
						} catch (e) {
							$("rl-results").innerHTML = '<div class="small text-danger p-2">' + esc(e.message) + "</div>";
						}
					}, 300);
				});
				$("rl-results").addEventListener("click", function (e) {
					const b = e.target.closest("[data-pick]");
					if (!b) return;
					set("rl-other", b.dataset.pick);
					$("rl-picked").innerHTML = '<i class="fa-solid fa-check text-success me-1"></i>' + esc(b.dataset.name);
					$("rl-results").innerHTML = "";
					set("rl-search", "");
				});
				function saveRelationship(btn) {
					const id = val("rl-id");
					const common = { title: val("rl-title-input"), valid_from: val("rl-from"), note: val("rl-note"), is_primary: $("rl-primary").checked ? 1 : 0 };
					if (id) return run(() => post("/api/clients/" + CID + "/relationships/" + id + "/update/", { ...common, valid_to: val("rl-to") }), btn);
					if (!val("rl-other")) {
						notyf.error("<%= i18n.__('clients.card.relationship_form.pick_client') %>");
						return;
					}
					return run(() => post("/api/clients/" + CID + "/relationships/add/", { ...common, rel: val("rl-rel"), id_other: val("rl-other") }), btn);
				}

				// ── Комерційні умови ──
				const CM_FIELDS = ["price_group", "discount_percent", "credit_limit", "payment_terms_days", "currency", "default_payment_method"];
				function openCommercial() {
					const m = EDIT.commercial || {};
					CM_FIELDS.forEach((k) => set("cm-" + k, m[k]));
					$("cm-vat_payer").checked = !!m.vat_payer;
					M("modal-commercial").show();
				}
				function saveCommercial(btn) {
					const body = { vat_payer: $("cm-vat_payer").checked ? 1 : 0 };
					CM_FIELDS.forEach((k) => (body[k] = val("cm-" + k)));
					return run(() => post("/api/clients/" + CID + "/commercial/", body), btn);
				}

				// ── Делегування ──
				document.addEventListener("click", function (e) {
					const el = e.target.closest("[data-cl2]");
					if (!el) return;
					const addr = el.closest("[data-addr]"),
						ident = el.closest("[data-ident]"),
						rel = el.closest("[data-rel]");
					const confirmRun = (msg, url) => confirm(msg) && run(() => post(url));
					switch (el.dataset.cl2) {
						case "add-address": return openAddress(null);
						case "edit-address": return openAddress(addr.dataset.addr);
						case "save-address": return saveAddress(el);
						case "default-address": return run(() => post("/api/clients/" + CID + "/addresses/" + addr.dataset.addr + "/default/"));
						case "delete-address": return confirmRun("<%= i18n.__('clients.card.address_form.confirm_delete') %>", "/api/clients/" + CID + "/addresses/" + addr.dataset.addr + "/delete/");
						case "add-identifier": return openIdentifier(null);
						case "edit-identifier": return openIdentifier(ident.dataset.ident);
						case "save-identifier": return saveIdentifier(el);
						case "delete-identifier": return confirmRun("<%= i18n.__('clients.card.identifier_form.confirm_delete') %>", "/api/clients/" + CID + "/identifiers/" + ident.dataset.ident + "/delete/");
						case "add-relationship": return openRelationship(null);
						case "edit-relationship": return openRelationship(rel.dataset.rel);
						case "save-relationship": return saveRelationship(el);
						case "end-relationship": return confirmRun("<%= i18n.__('clients.card.relationship_form.confirm_end') %>", "/api/clients/" + CID + "/relationships/" + rel.dataset.rel + "/end/");
						case "delete-relationship": return confirmRun("<%= i18n.__('clients.card.relationship_form.confirm_delete') %>", "/api/clients/" + CID + "/relationships/" + rel.dataset.rel + "/delete/");
						case "edit-commercial": return openCommercial();
						case "save-commercial": return saveCommercial(el);
					}
				});
			})();
		</script>
		<script>
			document.addEventListener("click", async function (e) {
				const b = e.target.closest("[data-revert-merge]");
				if (!b) return;
				if (!confirm("<%= i18n.__('clients.card.confirm_revert_merge') %>")) return;
				b.disabled = true;
				try {
					const r = await fetch("/api/clients/merges/" + b.dataset.revertMerge + "/revert/", { method: "POST" });
					const j = await r.json();
					if (!r.ok || j.ok === false) throw new Error(j.error || "<%= i18n.__('clients.card.error') %>");
					location.href = location.pathname;
				} catch (err) {
					alert(err.message);
					b.disabled = false;
				}
			});
		</script>
	</body>
</html>