<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('clients.card.title') %> #<%= data.client.id %></title>
		<%- include('../../partials/head'); %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
		<style>
			.section-title {
				font-size: 11px;
				font-weight: 700;
				text-transform: uppercase;
				color: #6c757d;
				letter-spacing: 0.5px;
				margin-bottom: 4px;
			}
			.cl-list li {
				padding: 6px 0;
				border-bottom: 1px dashed #e9ecef;
			}
			.cl-list li:last-child {
				border-bottom: none;
			}
			.cl-ico {
				width: 26px;
				height: 26px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				color: #fff;
				font-size: 12px;
				flex: none;
			}
			.stat-box {
				border: 1px solid #dee2e6;
				padding: 12px;
				height: 100%;
			}
			.stat-box .v {
				font-size: 20px;
				font-weight: 700;
			}
			.tl-item {
				display: flex;
				gap: 12px;
				padding: 10px 0;
				border-bottom: 1px solid #f1f3f5;
			}
			.tl-item:last-child {
				border-bottom: none;
			}
			.tl-icon {
				width: 34px;
				height: 34px;
				display: flex;
				align-items: center;
				justify-content: center;
				color: #fff;
				flex: none;
			}
			.tl-body {
				flex: 1;
				min-width: 0;
			}
			.tl-sub {
				font-size: 12px;
				color: #6c757d;
			}
			.tl-text {
				font-size: 13px;
				color: #495057;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
		</style>
	</head>

	<body class="d-flex flex-column h-100">
		<%- include('../../partials/header'); %>
		<%
			const d = data;
			const c = d.client;
			const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (x) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[x]);
			const col = (v, def) => (v ? (v[0] === "#" ? v : "#" + v) : def);
			const badge = (text, ct, cb, icon) =>
				'<span class="badge rounded-0 me-1" style="color:' + col(ct, "#fff") + ";background:" + col(cb, "#6c757d") + '">' + (icon ? '<i class="' + esc(icon) + ' me-1"></i>' : "") + esc(text || "—") + "</span>";
			const KIND = { person: "fa-solid fa-user", organization: "fa-solid fa-building", group: "fa-solid fa-users" };
			const STATUS = { active: "success", blocked: "danger", archived: "secondary" };
			const fmtDate = (v) => {
				if (!v) return "";
				const x = new Date(v);
				return String(x.getDate()).padStart(2, "0") + "." + String(x.getMonth() + 1).padStart(2, "0") + "." + x.getFullYear();
			};
			const money = (v) => Number(v || 0).toFixed(2) + " " + d.base_currency;
			const st = d.stats || {};
		%>

		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= c.display_name || i18n.__('clients.card.no_name') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('clients.card.breadcrumb.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/clients/"><%= i18n.__('clients.card.breadcrumb.clients') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									#<%= c.id %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto d-flex gap-2">
						<% if (can('clients.list', 'delete')) { %>
						<button type="button" class="btn btn-outline-danger rounded-0" id="cl-delete" title="<%= i18n.__('clients.card.delete_to_trash') %>"><i class="fa-solid fa-trash"></i></button>
						<script>
							document.getElementById("cl-delete").addEventListener("click", async function () {
								if (!confirm("<%= i18n.__('clients.card.confirm_delete_client') %>")) return;
								this.disabled = true;
								const r = await fetch("/api/clients/<%= c.id %>/delete/", { method: "POST" });
								const j = await r.json().catch(() => ({}));
								if (r.ok && j.ok !== false) location.href = "/clients/";
								else {
									alert(j.error || "<%= i18n.__('clients.card.delete_error') %>");
									this.disabled = false;
								}
							});
						</script>
						<% } %>
						<a href="/clients/" class="btn btn-primary rounded-0"><i class="fa-solid fa-angle-left"></i></a>
					</div>
				</div>
			</div>
		</div>

		<div class="container-fluid mt-3">
			<%- include('../../partials/risk', { riskUrl: '/api/clients/' + d.client.id + '/risk/' }) %>
			<% if (d.merged_from) { %>
			<div class="alert alert-info rounded-0"><i class="fa-solid fa-code-merge me-1"></i> <%= i18n.__('clients.card.merged_from', { id: d.merged_from }) %></div>
			<% } %>
			<% if (d.just_merged) { %>
			<div class="alert alert-success rounded-0 d-flex justify-content-between align-items-center">
				<span><i class="fa-solid fa-circle-check me-1"></i> <%= i18n.__('clients.card.merged_ok') %></span>
				<button type="button" class="btn btn-sm btn-outline-danger rounded-0" data-revert-merge="<%= d.just_merged %>"><i class="fa-solid fa-rotate-left me-1"></i><%= i18n.__('clients.card.revert_merge') %></button>
			</div>
			<% } %>

			<% if (d.duplicates.length) { %>
			<div class="alert alert-warning rounded-0">
				<i class="fa-solid fa-triangle-exclamation me-1"></i> <strong><%= i18n.__('clients.card.possible_duplicates') %></strong>
				<% d.duplicates.forEach(function (x) { %>
				<a href="/clients/<%= x.other_id %>/" class="ms-2"><%= x.other_name || ('#' + x.other_id) %></a>
				<span class="badge text-bg-warning rounded-0"><%= x.score %>%</span>
				<a href="/clients/merge/?a=<%= c.id %>&b=<%= x.other_id %>" class="btn btn-sm btn-outline-dark rounded-0 py-0 ms-1"><i class="fa-solid fa-code-compare me-1"></i><%= i18n.__('clients.card.compare') %></a>
				<% }) %>
			</div>
			<% } %>

			<div class="row">
				<!-- ═══ ЛІВА КОЛОНКА ═══ -->
				<div class="col-lg-4">
					<!-- Профіль -->
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('clients.card.profile.title') %></span>
							<button type="button" class="btn btn-sm btn-light rounded-0" data-cl="edit-profile"><i class="fa-solid fa-pen"></i></button>
						</div>
						<div class="card-body">
							<div class="d-flex align-items-center gap-2 mb-2">
								<span class="cl-ico" style="width: 42px; height: 42px; font-size: 18px; background: <%= col(d.lifecycle && d.lifecycle.color_background, '#6c757d') %>"><i class="<%= KIND[c.kind] || KIND.person %>"></i></span>
								<div>
									<h5 class="mb-0"><%= c.display_name || i18n.__('clients.card.no_name') %></h5>
									<div class="tl-sub"><%= i18n.__('clients.card.kind.' + (KIND[c.kind] ? c.kind : 'person')) %> · #<%= c.id %></div>
								</div>
							</div>

							<div class="mb-2">
								<% if (d.lifecycle) { %><%- badge(d.lifecycle.name, d.lifecycle.color_text, d.lifecycle.color_background, d.lifecycle.icon) %><% } %>
								<% if (d.legal_type) { %><%- badge(d.legal_type.short_name || d.legal_type.name, d.legal_type.color_text, d.legal_type.color_background, d.legal_type.icon) %><% } %>
								<% if (c.status !== 'active') { %><span class="badge rounded-0 text-bg-<%= STATUS[c.status] || STATUS.active %>"><%= i18n.__('clients.card.status.' + (STATUS[c.status] ? c.status : 'active')) %></span><% } %>
								<% d.roles.forEach(function (r) { %><%- badge(r.name, r.color_text, r.color_background, r.icon) %><% }) %>
							</div>
							<% if (d.tags.length) { %>
							<div class="mb-2"><% d.tags.forEach(function (t) { %><%- badge(t.name, t.color_text, t.color_background, t.icon) %><% }) %></div>
							<% } %>

							<dl class="row small mb-0">
								<% if (d.person) { const p = d.person; %>
									<% if (p.last_name || p.first_name || p.middle_name) { %><dt class="col-5"><%= i18n.__('clients.card.profile.full_name') %></dt><dd class="col-7"><%= [p.last_name, p.first_name, p.middle_name].filter(Boolean).join(" ") %></dd><% } %>
									<% if (p.trade_name) { %><dt class="col-5"><%= i18n.__('clients.card.profile.trade_name') %></dt><dd class="col-7"><%= p.trade_name %></dd><% } %>
									<% if (p.job_title) { %><dt class="col-5"><%= i18n.__('clients.card.profile.job_title') %></dt><dd class="col-7"><%= p.job_title %></dd><% } %>
									<% if (['male', 'female', 'other'].includes(p.gender)) { %><dt class="col-5"><%= i18n.__('clients.card.profile.gender') %></dt><dd class="col-7"><%= i18n.__('clients.card.gender.' + p.gender) %></dd><% } %>
									<% if (p.birth_date) { %><dt class="col-5"><%= i18n.__('clients.card.profile.birth_date') %></dt><dd class="col-7"><%= fmtDate(p.birth_date) %></dd><% } %>
								<% } %>
								<% if (d.organization) { const o = d.organization; %>
									<% if (o.legal_name) { %><dt class="col-5"><%= i18n.__('clients.card.profile.legal_name_short') %></dt><dd class="col-7"><%= o.legal_name %></dd><% } %>
									<% if (o.industry) { %><dt class="col-5"><%= i18n.__('clients.card.profile.industry') %></dt><dd class="col-7"><%= o.industry %></dd><% } %>
									<% if (o.employees_count) { %><dt class="col-5"><%= i18n.__('clients.card.profile.employees') %></dt><dd class="col-7"><%= o.employees_count %></dd><% } %>
									<% if (o.website) { %><dt class="col-5"><%= i18n.__('clients.card.profile.website') %></dt><dd class="col-7"><a href="<%= /^https?:/i.test(o.website) ? o.website : 'https://' + o.website %>" target="_blank" rel="noopener"><%= o.website %></a></dd><% } %>
								<% } %>
								<% if (c.country) { %><dt class="col-5"><%= i18n.__('clients.card.profile.country') %></dt><dd class="col-7"><%= c.country %></dd><% } %>
								<% if (c.timezone) { %><dt class="col-5"><%= i18n.__('clients.card.profile.timezone') %></dt><dd class="col-7"><%= c.timezone %></dd><% } %>
								<% if (c.lang_name) { %><dt class="col-5"><%= i18n.__('clients.card.profile.language') %></dt><dd class="col-7"><%= c.lang_name %></dd><% } %>
								<dt class="col-5"><%= i18n.__('clients.card.profile.manager') %></dt><dd class="col-7"><%= c.manager_name || "—" %></dd>
								<dt class="col-5"><%= i18n.__('clients.card.profile.source') %></dt><dd class="col-7"><%= c.source %></dd>
								<% if (c.date_first_contact_text) { %><dt class="col-5"><%= i18n.__('clients.card.profile.first_contact') %></dt><dd class="col-7"><%= c.date_first_contact_text %></dd><% } %>
								<dt class="col-5"><%= i18n.__('clients.card.profile.last_activity') %></dt><dd class="col-7"><%= c.date_last_activity_text || "—" %></dd>
							</dl>

							<% if (c.note) { %>
							<hr class="my-2" />
							<div class="section-title"><%= i18n.__('clients.card.profile.note') %></div>
							<div class="small" style="white-space: pre-wrap"><%= c.note %></div>
							<% } %>
						</div>
					</div>

					<!-- Контакти -->
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('clients.card.contacts.title') %></span>
							<button type="button" class="btn btn-sm btn-light rounded-0" data-cl="add-contact"><i class="fa-solid fa-plus"></i></button>
						</div>
						<div class="card-body py-2">
							<% if (!d.contacts.length) { %><div class="text-muted small py-2"><%= i18n.__('clients.card.contacts.empty') %></div><% } %>
							<ul class="list-unstyled cl-list mb-0">
								<% d.contacts.forEach(function (x) { %>
								<li class="d-flex align-items-center gap-2" data-cp="<%= x.id %>" data-type="<%= x.id_contact_type %>" data-value="<%= x.value %>" data-label="<%= x.label %>" data-consent="<%= x.marketing_consent ? 1 : 0 %>">
									<span class="cl-ico" style="background: <%= col(x.type.color_background, '#6c757d') %>"><i class="<%= x.type.icon || 'fa-solid fa-address-book' %>"></i></span>
									<div class="flex-grow-1" style="min-width: 0">
										<% if (x.url) { %><a href="<%= x.url %>" target="_blank" rel="noopener"><%= x.value_normalized %></a><% } else { %><%= x.value_normalized %><% } %>
										<% if (x.is_primary) { %><i class="fa-solid fa-star text-warning ms-1" title="<%= i18n.__('clients.card.contacts.primary') %>"></i><% } %>
										<% if (!x.is_valid) { %><i class="fa-solid fa-circle-exclamation text-danger ms-1" title="<%= i18n.__('clients.card.contacts.invalid') %>"></i><% } %>
										<% if (x.marketing_consent) { %><i class="fa-solid fa-bullhorn text-success ms-1" title="<%= i18n.__('clients.card.contacts.consent') %>"></i><% } %>
										<div class="tl-sub"><%= x.type.name || x.type.code %> · <%= ['personal', 'work', 'other'].includes(x.label) ? i18n.__('clients.card.label.' + x.label) : x.label %><% if (x.country) { %> · <%= x.country %><% } %></div>
									</div>
									<div class="btn-group btn-group-sm">
										<% if (!x.is_primary) { %><button type="button" class="btn btn-link text-warning p-1" data-cl="primary-contact" title="<%= i18n.__('clients.card.contacts.make_primary') %>"><i class="fa-regular fa-star"></i></button><% } %>
										<button type="button" class="btn btn-link text-primary p-1" data-cl="edit-contact" title="<%= i18n.__('clients.card.edit') %>"><i class="fa-solid fa-pen"></i></button>
										<button type="button" class="btn btn-link text-danger p-1" data-cl="delete-contact" title="<%= i18n.__('clients.card.delete') %>"><i class="fa-regular fa-trash-can"></i></button>
									</div>
								</li>
								<% }) %>
							</ul>
						</div>
					</div>

										<!-- Адреси -->
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('clients.card.addresses.title') %></span>
							<button type="button" class="btn btn-sm btn-light rounded-0" data-cl2="add-address"><i class="fa-solid fa-plus"></i></button>
						</div>
						<div class="card-body py-2">
							<% if (!d.addresses.length) { %><div class="text-muted small py-2"><%= i18n.__('clients.card.addresses.empty') %></div><% } %>
							<ul class="list-unstyled cl-list mb-0">
								<% d.addresses.forEach(function (a) {
									const street = [a.street, a.building].filter(Boolean).join(", ") + (a.apartment ? ", " + i18n.__('clients.card.addresses.apartment_short') + " " + a.apartment : "");
									const line = [a.postcode, a.country, a.region, a.city, street, a.address_line].filter(Boolean).join(", ");
								%>
								<li class="d-flex gap-2" data-addr="<%= a.id %>">
									<div class="flex-grow-1" style="min-width: 0">
										<div class="small fw-semibold"><i class="<%= a.type.icon || 'fa-solid fa-location-dot' %> me-1 text-muted"></i><%= a.type.name || a.type.code %><% if (a.is_default) { %> <span class="badge text-bg-light border rounded-0"><%= i18n.__('clients.card.addresses.default_badge') %></span><% } %></div>
										<% if (line) { %><div class="small"><%= line %></div><% } %>
										<% if (a.carrier_point_name || a.carrier_point_ref) { %><div class="small"><i class="fa-solid fa-box me-1 text-muted"></i><%= a.carrier_code ? a.carrier_code + ': ' : '' %><%= a.carrier_point_name || a.carrier_point_ref %></div><% } %>
										<% if (a.recipient_name || a.recipient_phone) { %><div class="tl-sub"><%= i18n.__('clients.card.addresses.recipient_label') %> <%= [a.recipient_name, a.recipient_phone].filter(Boolean).join(", ") %></div><% } %>
										<% if (a.comment) { %><div class="tl-sub fst-italic"><%= a.comment %></div><% } %>
									</div>
									<div class="btn-group btn-group-sm align-self-start">
										<% if (!a.is_default) { %><button type="button" class="btn btn-link text-warning p-1" data-cl2="default-address" title="<%= i18n.__('clients.card.addresses.make_default') %>"><i class="fa-regular fa-star"></i></button><% } %>
										<button type="button" class="btn btn-link text-primary p-1" data-cl2="edit-address" title="<%= i18n.__('clients.card.edit') %>"><i class="fa-solid fa-pen"></i></button>
										<button type="button" class="btn btn-link text-danger p-1" data-cl2="delete-address" title="<%= i18n.__('clients.card.delete') %>"><i class="fa-regular fa-trash-can"></i></button>
									</div>
								</li>
								<% }) %>
							</ul>
						</div>
					</div>

					<!-- Реквізити -->
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('clients.card.identifiers.title') %></span>
							<button type="button" class="btn btn-sm btn-light rounded-0" data-cl2="add-identifier"><i class="fa-solid fa-plus"></i></button>
						</div>
						<div class="card-body py-2">
							<% if (!d.identifiers.length) { %><div class="text-muted small py-2"><%= i18n.__('clients.card.identifiers.empty') %></div><% } %>
							<ul class="list-unstyled cl-list mb-0">
								<% d.identifiers.forEach(function (x) { %>
								<li class="d-flex align-items-center gap-2" data-ident="<%= x.id %>">
									<div class="flex-grow-1">
										<div class="tl-sub"><%= x.type.name || x.type.code %><% if (x.country) { %> · <%= x.country %><% } %></div>
										<code><%= x.value %></code><% if (x.is_verified) { %> <i class="fa-solid fa-circle-check text-success" title="<%= i18n.__('clients.card.identifiers.verified') %>"></i><% } %>
									</div>
									<div class="btn-group btn-group-sm">
										<button type="button" class="btn btn-link text-primary p-1" data-cl2="edit-identifier" title="<%= i18n.__('clients.card.edit') %>"><i class="fa-solid fa-pen"></i></button>
										<button type="button" class="btn btn-link text-danger p-1" data-cl2="delete-identifier" title="<%= i18n.__('clients.card.delete') %>"><i class="fa-regular fa-trash-can"></i></button>
									</div>
								</li>
								<% }) %>
							</ul>
						</div>
					</div>

					<!-- Зв'язки -->
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('clients.card.relationships.title') %></span>
							<button type="button" class="btn btn-sm btn-light rounded-0" data-cl2="add-relationship"><i class="fa-solid fa-plus"></i></button>
						</div>
						<div class="card-body py-2">
							<% if (!d.relationships.length) { %><div class="text-muted small py-2"><%= i18n.__('clients.card.relationships.empty') %></div><% } %>
							<ul class="list-unstyled cl-list mb-0">
								<% d.relationships.forEach(function (r) { %>
								<li class="d-flex gap-2 <%= r.active ? '' : 'opacity-50' %>" data-rel="<%= r.id %>">
									<div class="flex-grow-1" style="min-width: 0">
										<div class="tl-sub"><%= r.label %><% if (r.title) { %> · <%= r.title %><% } %><% if (!r.active) { %> · <%= i18n.__('clients.card.relationships.until') %> <%= r.valid_to %><% } %></div>
										<i class="<%= KIND[r.other_kind] || KIND.person %> text-muted me-1"></i><a href="/clients/<%= r.other_id %>/"><%= r.other_name || ('#' + r.other_id) %></a>
										<% if (r.is_primary) { %><i class="fa-solid fa-star text-warning ms-1" title="<%= i18n.__('clients.card.relationships.primary') %>"></i><% } %>
										<% if (r.note) { %><div class="tl-sub fst-italic"><%= r.note %></div><% } %>
									</div>
									<div class="btn-group btn-group-sm align-self-start">
										<button type="button" class="btn btn-link text-primary p-1" data-cl2="edit-relationship" title="<%= i18n.__('clients.card.edit') %>"><i class="fa-solid fa-pen"></i></button>
										<% if (r.active) { %><button type="button" class="btn btn-link text-secondary p-1" data-cl2="end-relationship" title="<%= i18n.__('clients.card.relationships.end') %>"><i class="fa-solid fa-flag-checkered"></i></button><% } %>
										<button type="button" class="btn btn-link text-danger p-1" data-cl2="delete-relationship" title="<%= i18n.__('clients.card.delete') %>"><i class="fa-regular fa-trash-can"></i></button>
									</div>
								</li>
								<% }) %>
							</ul>
						</div>
					</div>

					<!-- Комерційні умови -->
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('clients.card.commercial.title') %></span>
							<button type="button" class="btn btn-sm btn-light rounded-0" data-cl2="edit-commercial"><i class="fa-solid fa-pen"></i></button>
						</div>
						<div class="card-body py-2">
							<% if (d.commercial) { const m = d.commercial; %>
							<dl class="row small mb-0">
								<% if (m.price_group) { %><dt class="col-6"><%= i18n.__('clients.card.commercial.price_group') %></dt><dd class="col-6"><%= m.price_group %></dd><% } %>
								<% if (Number(m.discount_percent)) { %><dt class="col-6"><%= i18n.__('clients.card.commercial.discount') %></dt><dd class="col-6"><%= Number(m.discount_percent) %>%</dd><% } %>
								<% if (m.credit_limit != null) { %><dt class="col-6"><%= i18n.__('clients.card.commercial.credit_limit') %></dt><dd class="col-6"><%= Number(m.credit_limit).toFixed(2) %> <%= m.currency || d.base_currency %></dd><% } %>
								<% if (m.payment_terms_days) { %><dt class="col-6"><%= i18n.__('clients.card.commercial.payment_terms') %></dt><dd class="col-6"><%= m.payment_terms_days %> <%= i18n.__('clients.card.commercial.days_short') %></dd><% } %>
								<% if (m.currency) { %><dt class="col-6"><%= i18n.__('clients.card.commercial.currency') %></dt><dd class="col-6"><%= m.currency %></dd><% } %>
								<% if (m.default_payment_method) { %><dt class="col-6"><%= i18n.__('clients.card.commercial.payment_method') %></dt><dd class="col-6"><%= m.default_payment_method %></dd><% } %>
								<dt class="col-6"><%= i18n.__('clients.card.commercial.vat_payer') %></dt><dd class="col-6"><%= m.vat_payer ? i18n.__('clients.card.yes') : i18n.__('clients.card.no') %></dd>
							</dl>
							<% } else { %>
							<div class="text-muted small py-2"><%= i18n.__('clients.card.commercial.not_set') %></div>
							<% } %>
						</div>
					</div>
					<!-- Власні поля -->
					<div class="card border-primary rounded-0 mb-3 d-none" id="cf-card">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('clients.card.custom_fields.title') %></span>
							<button type="button" class="btn btn-sm btn-light rounded-0" id="cf-edit"><i class="fa-solid fa-pen"></i></button>
						</div>
						<div class="card-body py-2" id="cf-body"></div>
					</div>
					<!-- Історія злиттів -->
					<% if (d.merges.length) { %>
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0"><%= i18n.__('clients.card.merges.title') %></div>
						<div class="card-body py-2">
							<ul class="list-unstyled cl-list mb-0">
								<% d.merges.forEach(function (m) { %>
								<li class="d-flex justify-content-between align-items-center gap-2 <%= m.reverted_at ? 'opacity-50' : '' %>">
									<div class="small">
										<i class="fa-solid fa-code-merge text-muted me-1"></i><%= m.loser_name || ('#' + m.id_client_loser) %> <span class="text-muted">#<%= m.id_client_loser %></span>
										<div class="tl-sub"><%= m.date_add %><% if (m.user_name) { %> · <%= m.user_name %><% } %><% if (m.reverted_at) { %> · <%= i18n.__('clients.card.merges.reverted') %> <%= m.reverted_at %><% } %></div>
									</div>
									<% if (!m.reverted_at) { %><button type="button" class="btn btn-sm btn-link text-danger p-1" data-revert-merge="<%= m.id %>" title="<%= i18n.__('clients.card.revert_merge') %>"><i class="fa-solid fa-rotate-left"></i></button><% } %>
								</li>
								<% }) %>
							</ul>
						</div>
					</div>
					<% } %>

					<!-- Зовнішні ідентифікатори -->
					<% if (d.externals.length) { %>
					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0" role="button" data-bs-toggle="collapse" data-bs-target="#cl-ext"><%= i18n.__('clients.card.externals.title') %> <i class="fa-solid fa-chevron-down float-end mt-1"></i></div>
						<div class="collapse" id="cl-ext">
							<div class="card-body py-2">
								<dl class="row small mb-0">
									<% d.externals.forEach(function (e) { %>
									<dt class="col-5"><%= e.integration_name || e.system %></dt>
									<dd class="col-7 text-break"><code><%= e.external_id %></code></dd>
									<% }) %>
								</dl>
							</div>
						</div>
					</div>
					<% } %>
				</div>

				<!-- ═══ ПРАВА КОЛОНКА ═══ -->
				<div class="col-lg-8">
					<div class="row g-2 mb-3">
						<div class="col-6 col-md-3">
							<div class="stat-box">
								<div class="section-title"><%= i18n.__('clients.card.stats.orders') %></div>
								<div class="v"><%= st.orders_valid_count || 0 %><% if ((st.orders_count || 0) !== (st.orders_valid_count || 0)) { %><small class="text-muted fs-6"> / <%= st.orders_count %></small><% } %></div>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="stat-box">
								<div class="section-title"><%= i18n.__('clients.card.stats.revenue') %></div>
								<div class="v"><%= money(st.revenue_base) %></div>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="stat-box">
								<div class="section-title"><%= i18n.__('clients.card.stats.avg_order') %></div>
								<div class="v"><%= money(st.avg_order_base) %></div>
							</div>
						</div>
						<div class="col-6 col-md-3">
							<div class="stat-box">
								<div class="section-title"><%= i18n.__('clients.card.stats.leads') %></div>
								<div class="v"><%= st.leads_count || 0 %></div>
							</div>
						</div>
						<% if (d.rfm) { %>
						<div class="col-12">
							<div class="stat-box d-flex justify-content-between align-items-center">
								<div>
									<div class="section-title"><%= i18n.__('clients.card.stats.rfm') %></div>
									<span class="badge rounded-0 fs-6" style="background:<%= d.rfm.color %>"><i class="<%= d.rfm.icon %> me-1"></i><%= i18n.__('clients.rfm.' + d.rfm.code) %></span>
								</div>
								<div class="text-end small text-muted" title="<%= i18n.__('clients.card.stats.rfm_hint') %>">R <b><%= st.rfm_r %></b> · F <b><%= st.rfm_f %></b> · M <b><%= st.rfm_m %></b></div>
							</div>
						</div>
						<% } %>
					</div>

					<div class="card border-primary rounded-0 mb-3" id="cal-card">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><i class="fa-solid fa-calendar-check me-2"></i><%= i18n.__('clients.card.calendar.title') %></span>
							<div class="d-flex gap-1">
								<button type="button" class="btn btn-sm btn-light rounded-0" id="cal-done-toggle"><%= i18n.__('clients.card.calendar.done') %></button>
								<button type="button" class="btn btn-sm btn-light rounded-0" id="cal-add"><i class="fa-solid fa-plus me-1"></i><%= i18n.__('clients.card.calendar.add') %></button>
							</div>
						</div>
						<div class="card-body" id="cal-body">
							<div class="text-center text-muted py-2"><span class="spinner-border spinner-border-sm"></span></div>
						</div>
					</div>

					<!-- Нотатки -->
					<div class="card border-primary rounded-0 mb-3" id="notes">
						<div class="card-header text-bg-primary rounded-0"><i class="fa-solid fa-note-sticky me-2"></i><%= i18n.__('clients.card.notes.title') %></div>
						<div class="card-body">
							<div class="position-relative mb-2">
								<textarea class="form-control rounded-0" id="nt-text" rows="2" maxlength="10000" placeholder="<%= i18n.__('clients.card.notes.placeholder') %>"></textarea>
								<div class="list-group position-absolute shadow-sm d-none" id="nt-suggest" style="z-index: 1080; min-width: 240px; max-height: 200px; overflow-y: auto"></div>
							</div>
							<div class="d-flex justify-content-end mb-3">
								<button type="button" class="btn btn-sm btn-primary rounded-0" id="nt-add"><i class="fa-solid fa-paper-plane me-1"></i><%= i18n.__('clients.card.notes.add') %></button>
							</div>
							<div id="nt-list"><div class="text-center text-muted small"><span class="spinner-border spinner-border-sm"></span></div></div>
							<div class="text-center d-none" id="nt-more-box"><button type="button" class="btn btn-sm btn-outline-primary rounded-0" id="nt-more"><%= i18n.__('clients.card.show_more') %></button></div>
						</div>
					</div>

					<div class="card border-primary rounded-0 mb-3">
						<div class="card-header text-bg-primary rounded-0 p-0">
							<ul class="nav nav-tabs card-header-tabs m-0" id="tl-tabs">
								<li class="nav-item"><button class="nav-link active rounded-0" data-filter="all"><%= i18n.__('clients.card.timeline.all') %></button></li>
								<li class="nav-item"><button class="nav-link rounded-0" data-filter="order"><%= i18n.__('clients.card.timeline.orders') %> <span class="badge text-bg-light rounded-0" id="cnt-order">0</span></button></li>
								<li class="nav-item"><button class="nav-link rounded-0" data-filter="lead"><%= i18n.__('clients.card.timeline.leads') %> <span class="badge text-bg-light rounded-0" id="cnt-lead">0</span></button></li>
								<li class="nav-item"><button class="nav-link rounded-0" data-filter="changes"><i class="fa-solid fa-clock-rotate-left me-1"></i><%= i18n.__('clients.card.timeline.changes') %></button></li>
							</ul>
						</div>
						<div class="card-body" id="tl-body">
							<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span><%= i18n.__('clients.card.timeline.loading') %></div>
						</div>
					</div>
				</div>
			</div>
		</div>

				<!-- Модалка: запланувати -->
		<div class="modal fade" id="modal-cal" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content rounded-0">
					<div class="modal-header text-bg-primary rounded-0">
						<h5 class="modal-title"><i class="fa-solid fa-calendar-plus me-2"></i><%= i18n.__('clients.card.calendar.add') %></h5>
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<div class="mb-2">
							<label class="form-label"><%= i18n.__('clients.card.calendar.what') %></label>
							<input type="text" class="form-control rounded-0" id="cal-title" maxlength="255" placeholder="<%= i18n.__('clients.card.calendar.what_ph') %>" />
						</div>
						<div class="mb-2">
							<label class="form-label"><%= i18n.__('clients.card.type') %></label>
							<select class="form-select rounded-0" id="cal-type"><option value="">—</option></select>
						</div>
						<div class="row g-2 mb-2">
							<div class="col-6">
								<label class="form-label"><%= i18n.__('clients.card.calendar.date') %></label>
								<input type="date" class="form-control rounded-0" id="cal-date" />
							</div>
							<div class="col-3">
								<label class="form-label"><%= i18n.__('clients.card.calendar.time') %></label>
								<input type="time" class="form-control rounded-0" id="cal-time" />
							</div>
							<div class="col-3">
								<label class="form-label"><%= i18n.__('clients.card.calendar.minutes') %></label>
								<select class="form-select rounded-0" id="cal-dur">
									<option value="15">15</option>
									<option value="30" selected>30</option>
									<option value="60">60</option>
									<option value="120">120</option>
								</select>
							</div>
						</div>
						<div class="mb-2">
							<label class="form-label"><%= i18n.__('clients.card.calendar.remind') %></label>
							<select class="form-select rounded-0" id="cal-remind">
								<option value=""><%= i18n.__('clients.card.calendar.remind_at_start') %></option>
								<option value="15" selected><%= i18n.__('clients.card.calendar.remind_15m') %></option>
								<option value="60"><%= i18n.__('clients.card.calendar.remind_1h') %></option>
								<option value="1440"><%= i18n.__('clients.card.calendar.remind_1d') %></option>
							</select>
						</div>
						<div class="mb-2">
							<label class="form-label"><%= i18n.__('clients.card.calendar.description') %></label>
							<textarea class="form-control rounded-0" id="cal-desc" rows="2"></textarea>
						</div>
						<div class="form-check">
							<input class="form-check-input" type="checkbox" id="cal-manager" checked />
							<label class="form-check-label" for="cal-manager"><%= i18n.__('clients.card.calendar.add_manager') %></label>
						</div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('clients.card.cancel') %></button>
						<button type="button" class="btn btn-primary rounded-0" id="cal-save"><%= i18n.__('clients.card.save') %></button>
					</div>
				</div>
			</div>
		</div>

				<!-- Модалка: власні поля -->
		<div class="modal fade" id="cf-modal" tabindex="-1">
			<div class="modal-dialog modal-lg">
				<div class="modal-content rounded-0">
					<div class="modal-header text-bg-primary rounded-0">
						<h5 class="modal-title"><%= i18n.__('clients.card.custom_fields.title') %></h5>
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body"><div class="row g-2" id="cf-form"></div></div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('clients.card.cancel') %></button>
						<button type="button" class="btn btn-primary rounded-0" id="cf-save"><%= i18n.__('clients.card.save') %></button>
					</div>
				</div>
			</div>
		</div>

				<!-- Модалка: профіль -->
		<div class="modal fade" id="modal-profile" tabindex="-1">
			<div class="modal-dialog modal-lg">
				<div class="modal-content rounded-0">
					<div class="modal-header text-bg-primary rounded-0">
						<h5 class="modal-title"><%= i18n.__('clients.card.profile_form.title') %></h5>
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<% if (c.kind === 'person') { %>
						<div class="row g-2 mb-2">
							<div class="col-md-4"><label class="section-title"><%= i18n.__('clients.card.profile_form.last_name') %></label><input class="form-control form-control-sm rounded-0" id="pf-last_name" /></div>
							<div class="col-md-4"><label class="section-title"><%= i18n.__('clients.card.profile_form.first_name') %></label><input class="form-control form-control-sm rounded-0" id="pf-first_name" /></div>
							<div class="col-md-4"><label class="section-title"><%= i18n.__('clients.card.profile_form.middle_name') %></label><input class="form-control form-control-sm rounded-0" id="pf-middle_name" /></div>
							<div class="col-md-4">
								<label class="section-title"><%= i18n.__('clients.card.profile.gender') %></label>
								<select class="form-select form-select-sm rounded-0" id="pf-gender">
									<option value="unknown">—</option><option value="male"><%= i18n.__('clients.card.gender.male') %></option><option value="female"><%= i18n.__('clients.card.gender.female') %></option><option value="other"><%= i18n.__('clients.card.gender.other') %></option>
								</select>
							</div>
							<div class="col-md-4"><label class="section-title"><%= i18n.__('clients.card.profile.birth_date') %></label><input type="date" class="form-control form-control-sm rounded-0" id="pf-birth_date" /></div>
							<div class="col-md-4"><label class="section-title"><%= i18n.__('clients.card.profile.job_title') %></label><input class="form-control form-control-sm rounded-0" id="pf-job_title" /></div>
							<div class="col-md-12"><label class="section-title"><%= i18n.__('clients.card.profile_form.trade_name') %></label><input class="form-control form-control-sm rounded-0" id="pf-trade_name" /></div>
						</div>
						<% } else if (c.kind === 'organization') { %>
						<div class="row g-2 mb-2">
							<div class="col-md-8"><label class="section-title"><%= i18n.__('clients.card.profile_form.legal_name') %></label><input class="form-control form-control-sm rounded-0" id="of-legal_name" /></div>
							<div class="col-md-4"><label class="section-title"><%= i18n.__('clients.card.profile_form.short_name') %></label><input class="form-control form-control-sm rounded-0" id="of-short_name" /></div>
							<div class="col-md-4"><label class="section-title"><%= i18n.__('clients.card.profile.industry') %></label><input class="form-control form-control-sm rounded-0" id="of-industry" /></div>
							<div class="col-md-4"><label class="section-title"><%= i18n.__('clients.card.profile.website') %></label><input class="form-control form-control-sm rounded-0" id="of-website" /></div>
							<div class="col-md-2"><label class="section-title"><%= i18n.__('clients.card.profile.employees') %></label><input type="number" min="0" class="form-control form-control-sm rounded-0" id="of-employees_count" /></div>
							<div class="col-md-2"><label class="section-title"><%= i18n.__('clients.card.profile_form.registration_date') %></label><input type="date" class="form-control form-control-sm rounded-0" id="of-registration_date" /></div>
						</div>
						<% } %>

						<div class="row g-2 mb-2">
							<div class="col-md-4">
								<label class="section-title"><%= i18n.__('clients.card.profile_form.legal_type') %></label>
								<select class="form-select form-select-sm rounded-0" id="f-id_legal_type">
									<option value="">—</option>
									<% d.options.legal_types.forEach(function (x) { %><option value="<%= x.id %>"><%= x.short_name ? x.short_name + ' — ' + x.name : x.name %></option><% }) %>
								</select>
							</div>
							<div class="col-md-4">
								<label class="section-title"><%= i18n.__('clients.card.profile_form.lifecycle') %></label>
								<select class="form-select form-select-sm rounded-0" id="f-id_lifecycle">
									<option value="">—</option>
									<% d.options.lifecycle.forEach(function (x) { %><option value="<%= x.id %>"><%= x.name %></option><% }) %>
								</select>
							</div>
							<div class="col-md-4">
								<label class="section-title"><%= i18n.__('clients.card.profile_form.status') %></label>
								<select class="form-select form-select-sm rounded-0" id="f-status">
									<option value="active"><%= i18n.__('clients.card.status.active') %></option><option value="blocked"><%= i18n.__('clients.card.status.blocked') %></option><option value="archived"><%= i18n.__('clients.card.status.archived') %></option>
								</select>
							</div>
							<div class="col-md-4">
								<label class="section-title"><%= i18n.__('clients.card.profile.manager') %></label>
								<select class="form-select form-select-sm rounded-0" id="f-id_manager">
									<option value="">—</option>
									<% d.options.managers.forEach(function (x) { %><option value="<%= x.id %>"><%= x.name || ('#' + x.id) %></option><% }) %>
								</select>
							</div>
							<div class="col-md-2">
								<label class="section-title"><%= i18n.__('clients.card.profile.country') %></label>
								<input class="form-control form-control-sm rounded-0 text-uppercase" id="f-country" maxlength="2" placeholder="US" />
							</div>
							<div class="col-md-3">
								<label class="section-title"><%= i18n.__('clients.card.profile.timezone') %></label>
								<input class="form-control form-control-sm rounded-0" id="f-timezone" list="tz-list" placeholder="Europe/Kyiv" />
								<datalist id="tz-list"></datalist>
							</div>
							<div class="col-md-3">
								<label class="section-title"><%= i18n.__('clients.card.profile.language') %></label>
								<select class="form-select form-select-sm rounded-0" id="f-id_lang">
									<option value="">—</option>
									<% d.options.languages.forEach(function (x) { %><option value="<%= x.id %>"><%= x.name %></option><% }) %>
								</select>
							</div>
						</div>

						<label class="section-title"><%= i18n.__('clients.card.profile_form.tags') %></label>
						<div class="d-flex flex-wrap gap-2 mb-2" id="f-tags">
							<% if (!d.options.tags.length) { %><span class="text-muted small"><%= i18n.__('clients.card.profile_form.no_tags') %></span><% } %>
							<% d.options.tags.forEach(function (x) { %>
							<label class="d-inline-flex align-items-center gap-1 small">
								<input type="checkbox" class="form-check-input" value="<%= x.id %>" /> <%- badge(x.name, x.color_text, x.color_background, x.icon) %>
							</label>
							<% }) %>
						</div>

						<label class="section-title"><%= i18n.__('clients.card.profile.note') %></label>
						<textarea class="form-control form-control-sm rounded-0" id="f-note" rows="3"></textarea>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('clients.card.cancel') %></button>
						<button type="button" class="btn btn-primary rounded-0" data-cl="save-profile"><%= i18n.__('clients.card.save') %></button>
					</div>
				</div>
			</div>
		</div>

		<!-- Модалка: контакт -->
		<div class="modal fade" id="modal-contact" tabindex="-1">
			<div class="modal-dialog">
