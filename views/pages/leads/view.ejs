<script src="/assets/js/notyf/notyf.min.js"></script>
<script src="/assets/js/tabulator/tabulator.min.js"></script>
<script>
(function () {
"use strict";
const LEAD_ID = <%= Number(lead.id) %>;
const CAN_EDIT = <%= canEdit ? 'true' : 'false' %>;
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
const MONEY = new Intl.NumberFormat("uk-UA", { minimumFractionDigits: 0, maximumFractionDigits: 2 });
const notyf = new Notyf({
    position: { x: "right", y: "top" },
    duration: 4000,
    types: [
        { type: "success", dismissible: true, icon: false },
        { type: "error", background: "indianred", dismissible: true, icon: false },
    ],
});
const root = $("lead-form");
const ctl = (f) => root.querySelector('[data-f="' + f + '"]');

// ============================================================
// ЗНАЧЕННЯ ФОРМИ: усі поля ліда в одному об'єкті (контакти — як contact_info, теги — масив id)
// ============================================================
function collect() {
    const v = {};
    root.querySelectorAll("[data-f]").forEach((el) => {
        const f = el.dataset.f;
        if (f === "tags") v.tags = [...el.querySelectorAll(".tag-check:checked")].map((x) => Number(x.value)).sort((a, b) => a - b);
        else if (f.startsWith("contact.")) (v.contact_info = v.contact_info || {})[f.slice(8)] = el.value.trim();
        else v[f] = el.value.trim();
    });
    return v;
}
const same = (a, b) => JSON.stringify(a ?? "") === JSON.stringify(b ?? "");
let saved = collect(); // стан, збережений на сервері

// ============================================================
// ПЕРЕГЛЯД: текст і бейджі з тих самих полів форми
// ============================================================
function badge(opt) {
    const icon = opt.dataset.icon ? '<i class="' + esc(opt.dataset.icon) + ' me-1"></i>' : "";
    return '<span class="badge rounded-0" style="color:' + esc(opt.dataset.fg) + ";background:" + esc(opt.dataset.bg) + '">' + icon + esc(opt.textContent.trim()) + "</span>";
}
function renderView() {
    root.querySelectorAll("[data-show]").forEach((box) => {
        const f = box.dataset.show;
        const el = ctl(f);
        let html = "";
        if (f === "tags") {
            html = [...el.querySelectorAll(".tag-check:checked")].map((x) => '<span class="badge rounded-0" style="background:' + esc(x.dataset.bg) + '">' + esc(x.nextElementSibling.textContent.trim()) + "</span>").join("");
        } else if (el.tagName === "SELECT") {
            const opt = el.selectedOptions[0];
            if (opt && opt.value) html = opt.dataset.bg ? badge(opt) : esc(opt.textContent.trim());
        } else {
            const v = el.value.trim();
            const kind = box.dataset.kind;
            if (v === "") html = "";
            else if (kind === "money") html = esc(MONEY.format(Number(v) || 0));
            else if (kind === "date") html = esc(new Date(v + "T00:00:00").toLocaleDateString("uk-UA"));
            else if (kind === "tel") html = '<a href="tel:' + esc(v.replace(/[^\d+]/g, "")) + '">' + esc(v) + "</a>";
            else if (kind === "email") html = '<a href="mailto:' + esc(v) + '">' + esc(v) + "</a>";
            else if (kind === "url") html = '<a href="' + esc(/^https?:\/\//i.test(v) ? v : "https://" + v) + '" target="_blank" rel="noopener noreferrer">' + esc(v) + "</a>";
            else html = esc(v);
        }
        box.innerHTML = html || '<span class="text-muted">—</span>';
    });
    // Етап воронки
    const st = ctl("id_stage").value;
    document.querySelectorAll(".pipeline-step").forEach((b) => b.classList.toggle("active", b.dataset.stage === st));
    // Смужки балів
    ["score_fit", "score_activity"].forEach((f) => {
        const bar = document.querySelector('[data-bar="' + f + '"]');
        if (bar) bar.style.width = Math.min(100, Math.max(0, Number(ctl(f).value) || 0)) + "%";
    });
    // Блок програшу: статус «програно» або причину вже вказано
    const opt = ctl("id_status").selectedOptions[0];
    // Етап «програно» теж відкриває блок причини (вона обов'язкова — правила етапів)
    const stEl = document.querySelector('#pipeline-steps [data-stage="' + ctl("id_stage").value + '"]');
    const lost = (opt && opt.dataset.system === "lost") || (stEl && stEl.dataset.system === "lost") || ctl("id_loss_reason").value || ctl("loss_note").value.trim();
    $("loss-section").classList.toggle("d-none", !lost);
}

// ============================================================
// РЕЖИМ РЕДАГУВАННЯ: «Редагувати» → форма; «Зберегти» — одним запитом; «Скасувати» — повернути як було
// ============================================================
let editing = false;
function dirtyFields() {
    const cur = collect();
    return Object.keys(cur).filter((k) => !same(cur[k], saved[k]));
}
function markDirty() {
    const cur = collect();
    root.querySelectorAll("[data-f]").forEach((el) => {
        const f = el.dataset.f;
        const changed = f.startsWith("contact.") ? !same((cur.contact_info || {})[f.slice(8)], (saved.contact_info || {})[f.slice(8)]) : !same(cur[f], saved[f]);
        if (f === "id_stage") $("pipeline-steps").classList.toggle("is-dirty", changed);
        else el.classList.toggle("is-dirty", changed);
    });
    const n = dirtyFields().length;
    if ($("dirty-info")) $("dirty-info").textContent = n ? "<%= i18n.__('leads.view.changed_n') %>".replace("{{n}}", n) : "<%= i18n.__('leads.view.no_changes') %>";
    if ($("btn-save")) $("btn-save").disabled = !n;
    renderView();
}
function setEditing(on) {
    editing = on;
    document.body.classList.toggle("lead-editing", on);
    root.querySelectorAll(".is-invalid").forEach((el) => el.classList.remove("is-invalid"));
    markDirty();
    if (on) {
        const t = ctl("title");
        t.focus();
    }
}
// Повернути форму до збереженого стану
function restore() {
    root.querySelectorAll("[data-f]").forEach((el) => {
        const f = el.dataset.f;
        if (f === "tags") el.querySelectorAll(".tag-check").forEach((x) => (x.checked = (saved.tags || []).includes(Number(x.value))));
        else if (f.startsWith("contact.")) el.value = (saved.contact_info || {})[f.slice(8)] || "";
        else el.value = saved[f] ?? "";
    });
}

if (CAN_EDIT) {
    $("btn-edit").addEventListener("click", () => setEditing(true));
    root.addEventListener("input", () => editing && markDirty());
    root.addEventListener("change", () => editing && markDirty());
    // Етап — клік по кроку воронки (лише в режимі редагування)
    $("pipeline-steps").addEventListener("click", (e) => {
        const b = e.target.closest(".pipeline-step");
        if (!b || !editing) return;
        ctl("id_stage").value = b.dataset.stage;
        markDirty();
    });

    const cancelModal = bootstrap.Modal.getOrCreateInstance($("m-cancel"));
    $("btn-cancel").addEventListener("click", () => (dirtyFields().length ? cancelModal.show() : setEditing(false)));
    $("m-cancel-ok").addEventListener("click", () => {
        restore();
        cancelModal.hide();
        setEditing(false);
    });

    // Збереження
    const conflictModal = bootstrap.Modal.getOrCreateInstance($("m-conflict"));
    let busy = false;
    async function save(force) {
        const fields = dirtyFields();
        if (!fields.length || busy) return;
        busy = true;
        $("btn-save").disabled = true;
        const cur = collect();
        const body = { date_edit: $("lead-date-edit").value, force: !!force, changes: {} };
        fields.forEach((f) => (f === "tags" ? (body.tags = cur.tags) : (body.changes[f] = cur[f])));
        root.querySelectorAll(".is-invalid").forEach((el) => el.classList.remove("is-invalid"));
        try {
            const r = await fetch("/api/leads/" + LEAD_ID + "/save/", { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(body) });
            const d = await r.json().catch(() => ({}));
            if (r.status === 409 && d.conflict) {
                $("m-conflict-text").textContent = "<%= i18n.__('leads.view.conflict_text') %>".replace("{{who}}", d.who || "—").replace("{{at}}", d.at ? new Date(String(d.at).replace(" ", "T")).toLocaleString("uk-UA") : "");
                conflictModal.show();
                return;
            }
            if (!r.ok) {
                // Помилки по полях — біля полів
                Object.entries(d.errors || {}).forEach(([f, msg]) => {
                    const els = f === "contact_info" ? [...root.querySelectorAll('[data-f^="contact."]')] : [ctl(f)];
                    els.filter(Boolean).forEach((el) => {
                        el.classList.add("is-invalid");
                        const fb = el.parentElement.querySelector(".invalid-feedback");
                        if (fb) fb.textContent = msg;
                    });
                });
                notyf.error(d.message || "<%= i18n.__('leads.server.server') %>");
                return;
            }
            $("lead-date-edit").value = d.date_edit;
            if ($("lead-date-edit-text")) $("lead-date-edit-text").textContent = new Date(String(d.date_edit).replace(" ", "T")).toLocaleString("uk-UA");
            // Бали могли перерахуватись правилами скорингу — показуємо серверні значення
            ["score_fit", "score_activity"].forEach((f) => { if (d[f] !== undefined && ctl(f)) ctl(f).value = d[f]; });
            saved = collect();
            if (d.score !== undefined) {
                const cls = { A: "text-bg-success", B: "text-bg-primary", C: "text-bg-warning" }[d.grade] || "text-bg-secondary";
                $("score-badge").className = "badge rounded-0 " + cls;
                $("score-badge").innerHTML = Number(d.score) + " / <strong>" + esc(d.grade) + "</strong>";
            }
            if (d.client && fields.includes("contact_info")) renderClient(d.client);
            setEditing(false);
            notyf.success(d.changed && d.changed.length ? "<%= i18n.__('leads.view.saved') %>" : "<%= i18n.__('leads.view.no_changes') %>");
            if (historyTable) historyTable.setData();
            // Спрацювали автоматизації етапу / статусу — лід міг змінитись на сервері: показуємо актуальний стан
            if (d.automated) {
                notyf.success("<%= i18n.__('leads.auto.n.fired') %>");
                setTimeout(() => location.reload(), 1200);
            }
        } catch (e) {
            notyf.error("<%= i18n.__('leads.server.server') %>");
        } finally {
            busy = false;
            if (editing) $("btn-save").disabled = !dirtyFields().length;
        }
    }
    $("btn-save").addEventListener("click", () => save(false));
    $("m-conflict-force").addEventListener("click", () => {
        conflictModal.hide();
        save(true);
    });
    $("m-conflict-reload").addEventListener("click", () => {
        window.removeEventListener("beforeunload", guard);
        location.reload();
    });
    // Ctrl+S — зберегти; Esc — скасувати
    document.addEventListener("keydown", (e) => {
        if (!editing) return;
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "s") {
            e.preventDefault();
            save(false);
        }
    });
    // Незбережені зміни не губляться випадково: браузер питає перед виходом
    function guard(e) {
        if (editing && dirtyFields().length) {
            e.preventDefault();
            e.returnValue = "";
        }
    }
    window.addEventListener("beforeunload", guard);
}

// Картка клієнта після зміни контактів (лід перепривʼязується до клієнта на сервері)
function renderClient(c) {
    const box = $("client-card-body");
