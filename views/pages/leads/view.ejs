                    <button type="button" class="nav-link rounded-0" data-bs-toggle="tab"
                            data-bs-target="#tab-conversion" data-action="load-conversions">
                        <i class="fa-solid fa-arrow-right-arrow-left me-1"></i> <%= i18n.__('leads.view.t.konversiia') %>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link rounded-0" data-bs-toggle="tab"
                            data-bs-target="#tab-utm">
                        <i class="fa-solid fa-chart-line me-1"></i> UTM
                    </button>
