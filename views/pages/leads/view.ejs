const fmtSize = (n) => (n >= 1048576 ? (n / 1048576).toFixed(1) + " MB" : Math.max(1, Math.round((n || 0) / 1024)) + " KB");

async function api(url, body) {
    const opt = { method: "POST", credentials: "same-origin", headers: { Accept: "application/json" } };
    if (body instanceof FormData) opt.body = body;
    else if (body) { opt.headers["Content-Type"] = "application/json"; opt.body = JSON.stringify(body); }
    const r = await fetch(url, opt);
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.message || j.error || W.err);
    return j;
}
const refreshHistory = () => { try { historyTable.setData(); } catch (e) { /* таблиця ще не готова */ } };

// Підтвердження дії через модалку (без confirm())
let confirmFn = null;
const confirmModal = $("m-confirm") ? bootstrap.Modal.getOrCreateInstance($("m-confirm")) : null;
function ask(title, text, fn) {
    $("m-confirm-title").textContent = title;
    $("m-confirm-text").textContent = text;
    confirmFn = fn;
    confirmModal.show();
}
if ($("m-confirm-ok")) $("m-confirm-ok").addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    if (!confirmFn) return;
    btn.disabled = true;
    try { await confirmFn(); confirmModal.hide(); }
    catch (err) { notyf.error(err.message); }
    finally { btn.disabled = false; }
});

/* ── Активності ── */
let activitiesLoaded = false;
let lastActivities = [];
// Відкритий лід (не конвертований, не виграний / програний) — має мати запланований наступний крок
const LEAD_OPEN = <%= (!lead.is_converted && lead.status_system_type !== 'won' && lead.status_system_type !== 'lost') ? 'true' : 'false' %>;
/** Після виконаної дії: якщо в ліда не лишилось запланованих — запропонувати наступний крок */
async function promptNext() {
    await loadActivities(true);
    if (!CAN_EDIT || !LEAD_OPEN || lastActivities.some((a) => a.status === "planned")) return;
    ask("<%= i18n.__('leads.work.next_title') %>", "<%= i18n.__('leads.work.next_text') %>", async () => {
        setTimeout(() => openActivity({ status: "planned", type: "call" }), 350);
    });
}
async function loadActivities(force) {
    if (activitiesLoaded && !force) return;
    activitiesLoaded = true;
    try {
        const rows = await api("/api/leads/" + LEAD_ID + "/activities/");
        lastActivities = rows;
        const noNext = LEAD_OPEN && !rows.some((a) => a.status === "planned");
        $("activities-list").innerHTML = (noNext ? '<div class="alert alert-warning rounded-0 py-2 small"><i class="fa-solid fa-triangle-exclamation me-1"></i><%= i18n.__('leads.work.no_next') %></div>' : "") + (!rows.length
            ? '<p class="text-muted"><%= i18n.__('leads.view.t.aktyvnostei_nemaie') %></p>'
            : rows.map((a) => {
                const late = a.status === "planned" && a.scheduled_at && new Date(String(a.scheduled_at).replace(" ", "T")) < new Date();
                const acts = !CAN_EDIT ? "" :
                    '<div class="btn-group btn-group-sm">' +
                    (a.status === "planned"
                        ? '<button type="button" class="btn btn-outline-success rounded-0" data-action="act-status" data-id="' + a.id + '" data-status="done" title="<%= i18n.__('leads.work.mark_done') %>"><i class="fa-solid fa-check"></i></button>' +
                          '<button type="button" class="btn btn-outline-secondary rounded-0" data-action="act-status" data-id="' + a.id + '" data-status="cancelled" title="<%= i18n.__('leads.work.mark_cancel') %>"><i class="fa-solid fa-ban"></i></button>'
                        : '<button type="button" class="btn btn-outline-secondary rounded-0" data-action="act-status" data-id="' + a.id + '" data-status="planned" title="<%= i18n.__('leads.work.mark_planned') %>"><i class="fa-solid fa-rotate-left"></i></button>') +
                    '<button type="button" class="btn btn-outline-danger rounded-0" data-action="act-delete" data-id="' + a.id + '" title="<%= i18n.__('leads.work.delete') %>"><i class="fa-solid fa-trash"></i></button></div>';
                return '<div class="d-flex gap-3 mb-3 border-bottom pb-3"><div style="width:32px;text-align:center"><i class="' + (TYPE_ICON[a.type] || TYPE_ICON.other) + ' text-primary"></i></div>' +
                    '<div class="flex-grow-1"><div class="d-flex justify-content-between align-items-start gap-2"><div><strong>' + esc(a.subject || W.type[a.type] || a.type) + '</strong> ' +
                    '<span class="badge rounded-0 ' + (late ? "text-bg-danger" : STATUS_BADGE[a.status] || "text-bg-secondary") + '">' + esc(late ? "<%= i18n.__('leads.work.overdue') %>" : W.status[a.status] || a.status) + "</span></div>" + acts + "</div>" +
                    '<small class="text-muted">' + esc(W.type[a.type] || a.type) + " · " + esc(a.manager_name || "—") + " · " +
                    esc(fmtDate(a.status === "planned" ? a.scheduled_at : a.done_at || a.date_add)) +
                    (a.duration_sec ? " · " + Math.round(a.duration_sec / 60) + " <%= i18n.__('leads.work.min') %>" : "") + "</small>" +
                    (a.body ? '<div class="mt-1 small" style="white-space:pre-wrap">' + esc(a.body) + "</div>" : "") + "</div></div>";
            }).join(""));
    } catch (err) {
        activitiesLoaded = false;
        notyf.error(err.message);
    }
}
const actModal = $("m-act") ? bootstrap.Modal.getOrCreateInstance($("m-act")) : null;
function actSync() {
    const planned = $("act-status").value === "planned";
    $("act-when-box").classList.toggle("d-none", !planned);
}
if ($("act-status")) $("act-status").addEventListener("change", actSync);
function openActivity(preset) {
    preset = preset || {};
    $("act-type").value = preset.type || "call";
    $("act-status").value = preset.status || "done";
    $("act-direction").value = "outbound";
    $("act-subject").value = "";
    $("act-body").value = "";
    $("act-duration").value = "";
    const d = new Date(Date.now() + 3600e3);
    d.setMinutes(0, 0, 0);
    $("act-when").value = new Date(d.getTime() - d.getTimezoneOffset() * 60e3).toISOString().slice(0, 16);
    actSync();
    actModal.show();
}
if ($("act-save")) $("act-save").addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    btn.disabled = true;
    try {
        await api("/api/leads/" + LEAD_ID + "/activities/add/", {
            type: $("act-type").value, status: $("act-status").value, direction: $("act-direction").value,
            subject: $("act-subject").value, body: $("act-body").value,
            scheduled_at: $("act-status").value === "planned" ? $("act-when").value : "",
            duration_min: $("act-duration").value,
        });
        const wasDone = $("act-status").value === "done";
        actModal.hide();
        notyf.success("<%= i18n.__('leads.work.n.act_added') %>");
        refreshHistory();
        if (wasDone) setTimeout(promptNext, 400);
        else loadActivities(true);
    } catch (err) {
        notyf.error(err.message);
    } finally {
        btn.disabled = false;
    }
});

/* ── Файли ── */
const MAX_FILE = <%= Number(typeof maxFileSize !== "undefined" ? maxFileSize : 0) || 0 %>;
let filesLoaded = false;
async function loadFiles(force) {
    if (filesLoaded && !force) return;
    filesLoaded = true;
    try {
        const rows = await api("/api/leads/" + LEAD_ID + "/files/");
        $("files-list").innerHTML = !rows.length
            ? '<p class="text-muted"><%= i18n.__('leads.view.t.failiv_nemaie') %></p>'
            : '<table class="table table-sm table-bordered align-middle mb-0"><tbody>' + rows.map((f) => {
                const url = "/leads/" + LEAD_ID + "/files/" + f.id + "/";
                return "<tr><td>" + '<i class="fa-solid ' + (/^image\//.test(f.mime) ? "fa-file-image" : f.mime === "application/pdf" ? "fa-file-pdf" : "fa-file") + ' me-2 text-muted"></i>' +
                    '<a href="' + url + '" target="_blank" rel="noopener">' + esc(f.name) + "</a></td>" +
                    '<td style="width:130px">' + esc(W.cat[f.category] || f.category || "") + "</td>" +
                    '<td style="width:90px" class="text-end">' + fmtSize(f.size) + "</td>" +
                    '<td style="width:180px" class="small text-muted">' + esc(f.manager_name || "—") + "<br>" + esc(fmtDate(f.date_add)) + "</td>" +
                    '<td style="width:90px" class="text-end"><div class="btn-group btn-group-sm">' +
                    '<a class="btn btn-outline-primary rounded-0" href="' + url + '?download=1" title="<%= i18n.__('leads.work.download') %>"><i class="fa-solid fa-download"></i></a>' +
                    (CAN_EDIT ? '<button type="button" class="btn btn-outline-danger rounded-0" data-action="file-delete" data-id="' + f.id + '" data-name="' + esc(f.name) + '" title="<%= i18n.__('leads.work.delete') %>"><i class="fa-solid fa-trash"></i></button>' : "") +
                    "</div></td></tr>";
            }).join("") + "</tbody></table>";
    } catch (err) {
        filesLoaded = false;
        notyf.error(err.message);
    }
}
if ($("file-input")) $("file-input").addEventListener("change", async (e) => {
    const file = e.target.files[0];
    e.target.value = "";
    if (!file) return;
    if (MAX_FILE && file.size > MAX_FILE) return notyf.error("<%= i18n.__('leads.work.e.file_size') %>");
    const fd = new FormData();
    fd.append("category", $("file-category").value);
    fd.append("file", file);
    const btn = document.querySelector('[data-action="file-pick"]');
    btn.disabled = true;
    try {
        await api("/api/leads/" + LEAD_ID + "/files/upload/", fd);
        notyf.success("<%= i18n.__('leads.work.n.file_added') %>");
        loadFiles(true);
        refreshHistory();
    } catch (err) {
        notyf.error(err.message);
    } finally {
        btn.disabled = false;
    }
});

/* ── Конвертація ── */
let conversionsLoaded = false;
async function loadConversions(force) {
    if (conversionsLoaded && !force) return;
    conversionsLoaded = true;
    try {
        const rows = await api("/api/leads/" + LEAD_ID + "/conversions/");
        const href = { order: "/orders/", client: "/clients/", deal: "/deals/" };
        $("conversions-list").innerHTML = !rows.length ? "" :
            '<table class="table table-sm table-bordered align-middle mb-0"><thead><tr><th><%= i18n.__('leads.work.f.to') %></th><th><%= i18n.__('leads.work.f.object') %></th><th><%= i18n.__('leads.work.f.manager') %></th><th><%= i18n.__('leads.work.f.date') %></th></tr></thead><tbody>' +
            rows.map((c) => "<tr><td>" + esc(W.to[c.converted_to] || c.converted_to) + "</td>" +
                "<td>" + (href[c.converted_to] ? '<a href="' + href[c.converted_to] + Number(c.converted_id) + '/">' + esc(c.label || "#" + c.converted_id) + "</a>" : esc(c.label || c.converted_id)) + "</td>" +
                "<td>" + esc(c.manager_name || "—") + "</td><td>" + esc(fmtDate(c.date_add)) + "</td></tr>").join("") + "</tbody></table>";
    } catch (err) {
        conversionsLoaded = false;
        notyf.error(err.message);
    }
}
async function convert(target, body) {
    const j = await api("/api/leads/" + LEAD_ID + "/convert/" + target + "/", body);
    notyf.success("<%= i18n.__('leads.work.n.converted') %>");
    // Статус і етап ліда змінились на сервері — оновлюємо сторінку, щоб не зберегти застарілі значення
    setTimeout(() => (location.href = j.url || location.href), 900);
}

const LEAD_DEFAULT = <%- JSON.stringify({ title: String(lead.title || ''), value: Number(lead.value || 0), products: (function (p) { if (typeof p === 'string') { try { p = JSON.parse(p); } catch (e) { p = null; } } return Array.isArray(p) ? p.slice(0, 200) : []; })(lead.products) }).replace(/</g, '\\u003c') %>;
const orderModal = $("m-order") ? bootstrap.Modal.getOrCreateInstance($("m-order")) : null;
function orderRow(it) {
    const tr = document.createElement("tr");
    tr.innerHTML =
        '<td><input type="text" class="form-control form-control-sm rounded-0" data-k="name" maxlength="255"></td>' +
        '<td><input type="text" class="form-control form-control-sm rounded-0" data-k="sku" maxlength="120"></td>' +
        '<td><input type="number" class="form-control form-control-sm rounded-0" data-k="quantity" min="1" step="1"></td>' +
        '<td><input type="number" class="form-control form-control-sm rounded-0" data-k="price" min="0" step="0.01"></td>' +
        '<td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm rounded-0" data-action="ord-del"><i class="fa-solid fa-xmark"></i></button></td>';
    tr.querySelector('[data-k="name"]').value = it.name || "";
    tr.querySelector('[data-k="sku"]').value = it.sku || "";
    tr.querySelector('[data-k="quantity"]').value = it.quantity || 1;
    tr.querySelector('[data-k="price"]').value = it.price ?? "";
    $("ord-items").appendChild(tr);
}
function orderItems() {
    return [...$("ord-items").querySelectorAll("tr")].map((tr) => {
        const v = (k) => tr.querySelector('[data-k="' + k + '"]').value.trim();
        return { name: v("name"), sku: v("sku"), quantity: v("quantity"), price: v("price") };
    });
}
function orderTotal() {
    const t = orderItems().reduce((s, i) => s + (Number(i.quantity) || 0) * (Number(String(i.price).replace(",", ".")) || 0), 0);
    $("ord-total").textContent = MONEY.format(t);
}
async function openOrder() {
    let sources;
    try { sources = await api("/api/leads/" + LEAD_ID + "/convert/sources/"); }
    catch (err) { return notyf.error(err.message); }
    if (!sources.length) return notyf.error("<%= i18n.__('leads.work.e.no_sources') %>");
    $("ord-source").innerHTML = sources.map((s) => '<option value="' + Number(s.id) + '">' + esc(s.name) + "</option>").join("");
    $("ord-items").innerHTML = "";
    const prods = LEAD_DEFAULT.products.filter((p) => p && (p.name || p.title));
    if (prods.length) prods.forEach((p) => orderRow({ name: p.name || p.title, sku: p.sku || p.model || "", quantity: p.quantity || p.qty || 1, price: p.price ?? "" }));
    else orderRow({ name: LEAD_DEFAULT.title, quantity: 1, price: LEAD_DEFAULT.value || "" });
    $("ord-note").value = "";
    orderTotal();
    orderModal.show();
}
if ($("m-order")) {
    $("ord-add").addEventListener("click", () => { orderRow({ quantity: 1 }); orderTotal(); });
    $("ord-items").addEventListener("input", orderTotal);
    $("ord-save").addEventListener("click", async (e) => {
        const btn = e.currentTarget;
        btn.disabled = true;
        try {
            await convert("order", { id_integration: $("ord-source").value, items: orderItems(), note: $("ord-note").value });
            orderModal.hide();
        } catch (err) {
            notyf.error(err.message);
            btn.disabled = false;
        }
    });
}

document.addEventListener("click", (e) => {
    const el = e.target.closest("[data-action]");
    if (!el) return;
    const a = el.dataset.action;
    if (a === "load-activities") loadActivities();
    else if (a === "load-files") loadFiles();
    else if (a === "load-conversions") loadConversions();
    else if (a === "act-new") openActivity();
    else if (a === "act-status") {
        el.disabled = true;
        api("/api/leads/" + LEAD_ID + "/activities/" + el.dataset.id + "/status/", { status: el.dataset.status })
            .then(() => {
                notyf.success("<%= i18n.__('leads.work.n.act_updated') %>");
                if (el.dataset.status === "done" || el.dataset.status === "cancelled") promptNext();
                else loadActivities(true);
            })
            .catch((err) => { el.disabled = false; notyf.error(err.message); });
    } else if (a === "act-delete") {
        ask("<%= i18n.__('leads.work.act_delete_title') %>", "<%= i18n.__('leads.work.act_delete_text') %>", async () => {
            await api("/api/leads/" + LEAD_ID + "/activities/" + el.dataset.id + "/delete/");
            notyf.success("<%= i18n.__('leads.work.n.deleted') %>");
            loadActivities(true);
        });
    } else if (a === "file-pick") $("file-input").click();
    else if (a === "file-delete") {
        ask("<%= i18n.__('leads.work.file_delete_title') %>", el.dataset.name, async () => {
            await api("/api/leads/" + LEAD_ID + "/files/" + el.dataset.id + "/delete/");
            notyf.success("<%= i18n.__('leads.work.n.deleted') %>");
            loadFiles(true);
            refreshHistory();
        });
    } else if (a === "ord-del") {
        el.closest("tr").remove();
        orderTotal();
    } else if (a === "convert-lead") {
        if (document.body.classList.contains("lead-editing")) return notyf.error("<%= i18n.__('leads.work.e.editing') %>");
        const t = el.dataset.target;
        if (t === "order") openOrder();
        else ask(W.to[t], t === "client" ? "<%= i18n.__('leads.work.confirm_client') %>" : "<%= i18n.__('leads.work.confirm_deal') %>", () => convert(t));
    }
});

// ============================================================
// SLA: залишок часу на першу відповідь (секунди від сервера, без залежності від поясу браузера)
// ============================================================
const dur = (sec) => {
    sec = Math.abs(Math.round(sec));
    const d = Math.floor(sec / 86400), h = Math.floor((sec % 86400) / 3600), m = Math.floor((sec % 3600) / 60);
    return (d ? d + " <%= i18n.__('leads.sla.d') %> " : "") + (d || h ? h + " <%= i18n.__('leads.sla.h') %> " : "") + m + " <%= i18n.__('leads.sla.m') %>";
};
if ($("sla-took")) $("sla-took").textContent = "<%= i18n.__('leads.sla.took') %> " + dur(Number($("sla-took").dataset.sec));
if ($("sla-left")) {
    const el = $("sla-left");
    const end = Date.now() + Number(el.dataset.left) * 1000;
    const draw = () => {
        const left = (end - Date.now()) / 1000;
        el.className = "badge rounded-0 ms-1 " + (left < 0 ? "text-bg-danger" : left < 3600 ? "text-bg-warning" : "text-bg-success");
        el.textContent = left < 0 ? "<%= i18n.__('leads.sla.late_by') %> " + dur(left) : "<%= i18n.__('leads.sla.left') %> " + dur(left);
    };
    draw();
    setInterval(draw, 30000);
}

// ============================================================
// ДУБЛІКАТИ: ліди з тим самим телефоном / email, «не дубль», злиття
// ============================================================
const DUP_BY = { phone: "<%= i18n.__('leads.dupes.by_phone') %>", email: "<%= i18n.__('leads.dupes.by_email') %>" };
async function loadDupes() {
    try {
        const d = await api("/api/leads/" + LEAD_ID + "/duplicates/");
        const rows = d.rows || [];
        $("dupes-card").classList.toggle("d-none", !rows.length);
        if (!rows.length) return;
        $("dupes-count").textContent = rows.length;
        if ($("dupes-dismiss")) $("dupes-dismiss").classList.toggle("d-none", !<%= lead.is_duplicate ? 'true' : 'false' %>);
        $("dupes-list").innerHTML = rows.map((r) => {
            const ci = r.contact_info || {};
            return '<div class="list-group-item rounded-0"><div class="d-flex justify-content-between gap-2">' +
                '<div class="small"><a class="fw-semibold" href="/leads/' + Number(r.id) + '/">#' + Number(r.id) + " " + esc(r.title || "") + "</a>" +
                (Number(d.of) === Number(r.id) ? ' <span class="badge rounded-0 text-bg-warning"><%= i18n.__('leads.dupes.original') %></span>' : "") +
                '<div class="text-muted">' + esc([ci.name, ci.phone, ci.email].filter(Boolean).join(" · ")) + "</div>" +
                '<div class="text-muted">' + esc(DUP_BY[r.by] || "") + " · " + esc(String(r.date_add || "").slice(0, 16)) + " · " + esc(r.status_name || "—") + " · " + esc(r.manager_name || "—") + "</div></div>" +
                (CAN_EDIT ? '<div><button type="button" class="btn btn-sm btn-outline-warning rounded-0 text-nowrap" data-action="merge-open" data-id="' + Number(r.id) + '"><i class="fa-solid fa-code-merge me-1"></i><%= i18n.__('leads.dupes.merge') %></button></div>' : "") +
                "</div></div>";
        }).join("");
    } catch (err) {
        /* картка дублів необов'язкова — сторінка працює без неї */
    }
}
loadDupes();
if ($("dupes-dismiss")) $("dupes-dismiss").addEventListener("click", () => {
    ask("<%= i18n.__('leads.dupes.dismiss') %>", "<%= i18n.__('leads.dupes.dismiss_hint') %>", async () => {
        await api("/api/leads/" + LEAD_ID + "/duplicates/dismiss/");
        notyf.success("<%= i18n.__('leads.dupes.n.dismissed') %>");
        setTimeout(() => location.reload(), 700);
    });
});

const MG_LABEL = {
    title: "<%= i18n.__('leads.view.f.title') %>", value: "<%= i18n.__('leads.view.f.value') %>", note: "<%= i18n.__('leads.view.f.note') %>",
    id_status: "<%= i18n.__('leads.view.f.id_status') %>", id_manager: "<%= i18n.__('leads.view.f.id_manager') %>", id_source: "<%= i18n.__('leads.view.f.id_source') %>",
    expected_close_date: "<%= i18n.__('leads.view.f.expected_close_date') %>",
    "contact.name": "<%= i18n.__('leads.dupes.f.name') %>", "contact.phone": "<%= i18n.__('leads.dupes.f.phone') %>", "contact.email": "Email",
    "contact.company": "<%= i18n.__('leads.dupes.f.company') %>", "contact.position": "<%= i18n.__('leads.dupes.f.position') %>",
};
const mergeModal = $("m-merge") ? bootstrap.Modal.getOrCreateInstance($("m-merge")) : null;
let mergeOther = 0;
function mgShow(lead, f) {
    if (f.startsWith("contact.")) return (lead.contact_info || {})[f.slice(8)] || "";
    if (f === "value") return Number(lead.value) ? MONEY.format(Number(lead.value)) : "";
    if (lead[f + "_name"] !== undefined) return lead[f + "_name"] || (lead[f] ? "#" + lead[f] : "");
    return lead[f] == null ? "" : String(lead[f]);
}
async function openMerge(idOther) {
    if (document.body.classList.contains("lead-editing")) return notyf.error("<%= i18n.__('leads.work.e.editing') %>");
    let d;
    try { d = await api("/api/leads/" + LEAD_ID + "/merge/preview/", { other: idOther }); }
    catch (err) { return notyf.error(err.message); }
    mergeOther = idOther;
    $("mg-main-h").innerHTML = "<%= i18n.__('leads.dupes.main') %> · #" + Number(d.main.id);
    $("mg-other-h").innerHTML = "<%= i18n.__('leads.dupes.other') %> · #" + Number(d.other.id);
    const rows = d.fields.map((f) => {
        const a = mgShow(d.main, f), b = mgShow(d.other, f);
        if (a === b || !b) return "";
        const name = "mg-" + f.replace(".", "-");
        // Порожнє в основному заповнюється з другого (контакти — завжди), інакше за замовчуванням лишається основне
        const takeOther = !a;
        const cell = (side, v, checked) => '<td><label class="d-flex gap-2"><input class="form-check-input mt-1" type="radio" name="' + name + '" data-f="' + f + '" value="' + side + '"' + (checked ? " checked" : "") + '><span style="white-space:pre-wrap">' + (v ? esc(v) : '<span class="text-muted">—</span>') + "</span></label></td>";
        return "<tr><th class=\"small\">" + esc(MG_LABEL[f] || f) + "</th>" + cell("main", a, !takeOther) + cell("other", b, takeOther) + "</tr>" +
            (f === "note" && a ? '<tr><th></th><td colspan="2"><label class="d-flex gap-2 small"><input class="form-check-input" type="radio" name="' + name + '" data-f="note" value="both"><span><%= i18n.__('leads.dupes.note_both') %></span></label></td></tr>' : "");
    }).join("");
    $("mg-rows").innerHTML = rows || '<tr><td colspan="3" class="text-muted small"><%= i18n.__('leads.dupes.same') %></td></tr>';
    $("mg-moves").innerHTML = '<i class="fa-solid fa-circle-info me-1 text-primary"></i>' + esc("<%= i18n.__('leads.dupes.moves') %>".replace("{{a}}", d.other.n_activities).replace("{{f}}", d.other.n_files).replace("{{id}}", d.other.id));
    mergeModal.show();
}
if ($("mg-ok")) $("mg-ok").addEventListener("click", async (e) => {
    const btn = e.currentTarget;
    const pick = {};
    $("mg-rows").querySelectorAll("input[type=radio]:checked").forEach((r) => (pick[r.dataset.f] = r.value));
    btn.disabled = true;
    try {
        await api("/api/leads/" + LEAD_ID + "/merge/", { other: mergeOther, pick, date_edit: $("lead-date-edit").value });
        notyf.success("<%= i18n.__('leads.dupes.n.merged') %>");
        setTimeout(() => location.reload(), 800);
    } catch (err) {
        notyf.error(err.message);
        btn.disabled = false;
    }
});
document.addEventListener("click", (e) => {
    const el = e.target.closest('[data-action="merge-open"]');
    if (el) openMerge(Number(el.dataset.id));
});

// ============================================================
// СКОРИНГ: з чого склались бали (правила скорингу)
// ============================================================
async function scoreWhy() {
    let d;
    try { d = await api("/api/leads/" + LEAD_ID + "/score/"); }
    catch (err) { return notyf.error(err.message); }
    const part = (type, label, total) => {
        const rows = d.items.filter((i) => i.type === type);
        const body = !d.auto[type]
            ? '<p class="small text-muted mb-0"><%= i18n.__('leads.scoring.manual_part') %></p>'
            : rows.length
                ? '<table class="table table-sm mb-0"><tbody>' + rows.map((i) => "<tr><td>" + esc(i.name) + (i.hits ? ' <small class="text-muted">×' + Number(i.hits) + "</small>" : "") + '</td><td class="text-end ' + (i.delta < 0 ? "text-danger" : "text-success") + '">' + (i.delta > 0 ? "+" : "") + Number(i.delta) + "</td></tr>").join("") + "</tbody></table>"
                : '<p class="small text-muted mb-0"><%= i18n.__('leads.scoring.no_hits') %></p>';
        return '<div class="mb-3"><div class="d-flex justify-content-between fw-semibold"><span>' + esc(label) + "</span><span>" + Number(total) + "</span></div>" + body + "</div>";
    };
    $("m-score-body").innerHTML = part("fit", "Fit Score", d.fit) + part("activity", "Activity Score", d.activity) +
        '<div class="small text-muted"><%= i18n.__('leads.scoring.grades') %></div>';
    bootstrap.Modal.getOrCreateInstance($("m-score")).show();
}
document.addEventListener("click", (e) => {
    if (e.target.closest('[data-action="score-why"]')) scoreWhy();
});

// ============================================================
// ЗБАГАЧЕННЯ: пропозиції з телефону, домену email і сайту компанії
// ============================================================
const ENRICH_FIELD = { website: "<%= i18n.__('leads.view.f.website') %>", "contact.phone": "<%= i18n.__('leads.rules.f.contact.phone') %>", "contact.company": "<%= i18n.__('leads.rules.f.contact.company') %>" };
const ENRICH_SRC = { e164: "<%= i18n.__('leads.enrich.src.e164') %>", email: "<%= i18n.__('leads.enrich.src.email') %>", site: "<%= i18n.__('leads.enrich.src.site') %>" };
let enrichData = null;
async function openEnrich(btn) {
    if (document.body.classList.contains("lead-editing")) return notyf.error("<%= i18n.__('leads.work.e.editing') %>");
    btn.disabled = true;
    try { enrichData = await api("/api/leads/" + LEAD_ID + "/enrich/"); }
    catch (err) { btn.disabled = false; return notyf.error(err.message); }
    btn.disabled = false;
    const d = enrichData;
    const s = (d.info && d.info.site) || null;
    let html = d.suggestions.length
        ? '<div class="section-title"><%= i18n.__('leads.enrich.suggestions') %></div><table class="table table-sm table-bordered align-middle"><tbody>' +
          d.suggestions.map((x, i) => '<tr><td style="width:36px" class="text-center"><input class="form-check-input" type="checkbox" data-sg="' + i + '" checked></td><td class="small fw-semibold">' + esc(ENRICH_FIELD[x.field] || x.field) + '</td><td class="small">' + (x.current ? '<span class="text-muted text-decoration-line-through me-1">' + esc(x.current) + "</span>" : "") + esc(x.value) + '<div class="text-muted">' + esc(ENRICH_SRC[x.source] || x.source) + "</div></td></tr>").join("") +
          "</tbody></table>"
        : '<p class="text-muted small"><%= i18n.__('leads.enrich.nothing') %></p>';
    const facts = [];
    if (d.info && d.info.country) facts.push("<%= i18n.__('leads.enrich.country') %>: <strong>" + esc(d.info.country) + "</strong> (" + esc(d.info.phone_code) + ")");
    if (d.email_type) facts.push("<%= i18n.__('leads.enrich.email') %>: " + (d.email_type === "corporate" ? "<%= i18n.__('leads.enrich.corporate') %>" : "<%= i18n.__('leads.enrich.free') %>"));
    if (s && s.error) facts.push("<%= i18n.__('leads.enrich.site_error') %> (" + esc(s.error) + ")");
    if (s && !s.error) {
        if (s.title) facts.push("<%= i18n.__('leads.enrich.site_title') %>: " + esc(s.title));
        if (s.description) facts.push("<%= i18n.__('leads.enrich.site_desc') %>: " + esc(s.description));
        const soc = Object.entries(s.social || {}).map(([k, u]) => '<a href="' + esc(u) + '" target="_blank" rel="noopener noreferrer">' + esc(k) + "</a>");
        if (soc.length) facts.push("<%= i18n.__('leads.enrich.social') %>: " + soc.join(", "));
        if ((s.emails || []).length) facts.push("Email: " + s.emails.map(esc).join(", "));
        if ((s.phones || []).length) facts.push("<%= i18n.__('leads.enrich.phones') %>: " + s.phones.map(esc).join(", "));
    }
    if (facts.length) html += '<div class="section-title mt-3"><%= i18n.__('leads.enrich.found') %></div><ul class="small mb-0">' + facts.map((f) => "<li>" + f + "</li>").join("") + "</ul>";
    $("m-enrich-body").innerHTML = html;
    $("enrich-apply").classList.toggle("d-none", !d.suggestions.length);
    bootstrap.Modal.getOrCreateInstance($("m-enrich")).show();
}
if ($("enrich-apply")) $("enrich-apply").addEventListener("click", async (e) => {
    const picked = [...$("m-enrich-body").querySelectorAll("[data-sg]:checked")].map((c) => enrichData.suggestions[Number(c.dataset.sg)]);
    if (!picked.length) return bootstrap.Modal.getOrCreateInstance($("m-enrich")).hide();
    // Застосування — звичайним збереженням ліда (історія, вебхуки, захист від одночасних змін)
    const changes = {};
    const contact = {};
    root.querySelectorAll('[data-f^="contact."]').forEach((el) => (contact[el.dataset.f.slice(8)] = el.value.trim()));
    let contactTouched = false;
    picked.forEach((x) => {
        if (x.field.startsWith("contact.")) { contact[x.field.slice(8)] = x.value; contactTouched = true; }
        else changes[x.field] = x.value;
    });
    if (contactTouched) changes.contact_info = Object.fromEntries(Object.entries(contact).filter(([, v]) => v));
    const btn = e.currentTarget;
    btn.disabled = true;
    try {
        await api("/api/leads/" + LEAD_ID + "/save/", { date_edit: $("lead-date-edit").value, changes });
        notyf.success("<%= i18n.__('leads.view.saved') %>");
        setTimeout(() => location.reload(), 700);
    } catch (err) {
        notyf.error(err.message);
        btn.disabled = false;
    }
});
document.addEventListener("click", (e) => {
    const b = e.target.closest('[data-action="enrich"]');
    if (b) openEnrich(b);
});

renderView();
})();
</script>
</body>
</html>