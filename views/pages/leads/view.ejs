// ============================================================
const DICT = {};
root.querySelectorAll("select[data-f]").forEach((sel) => {
    DICT[sel.dataset.f] = {};
    [...sel.options].forEach((o) => o.value && (DICT[sel.dataset.f][o.value] = o.textContent.trim()));
});
DICT.tags = {};
root.querySelectorAll(".tag-check").forEach((x) => (DICT.tags[x.value] = x.nextElementSibling.textContent.trim()));
DICT.id_stage = {};
document.querySelectorAll(".pipeline-step").forEach((b) => (DICT.id_stage[b.dataset.stage] = b.childNodes.length ? b.textContent.replace(/\s+\d+%\s*$/, "").trim() : ""));

function histValue(h, v, nameField) {
    if (v === null || v === undefined || v === "") return "—";
    if (nameField && h[nameField]) return h[nameField];
    if (h.field_name === "tags") return String(v).split(",").filter(Boolean).map((id) => DICT.tags[id] || "#" + id).join(", ") || "—";
    if (DICT[h.field_name]) return DICT[h.field_name][v] || "#" + v;
    if (h.field_name === "contact_info") {
        try {
            return Object.values(JSON.parse(v)).filter(Boolean).join(", ") || "—";
        } catch (e) {
            return v;
        }
    }
    return v;
}
function renderDiff(h) {
    if (["utm", "fingerprint", "custom_fields"].includes(h.field_name)) return '<span class="text-muted fst-italic small"><%= i18n.__('leads.view.t.onovleno') %></span>';
    const o = histValue(h, h.value_old, h.field_name === "id_status" ? "status_old_name" : h.field_name === "id_stage" ? "stage_old_name" : null);
    const n = histValue(h, h.value_new, h.field_name === "id_status" ? "status_new_name" : h.field_name === "id_stage" ? "stage_new_name" : null);
    return '<span class="text-muted text-decoration-line-through me-1">' + esc(o) + '</span><i class="fa-solid fa-arrow-right mx-1 text-muted" style="font-size:10px"></i><span class="text-success fw-semibold">' + esc(n) + "</span>";
}
