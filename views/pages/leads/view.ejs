const ACTION_LABELS = { field_change: "<%= i18n.__('leads.history.actions.field_change') %>", status_change: "<%= i18n.__('leads.history.actions.status_change') %>", stage_change: "<%= i18n.__('leads.history.actions.stage_change') %>", pipeline_change: "<%= i18n.__('leads.history.actions.pipeline_change') %>", assigned: "<%= i18n.__('leads.history.actions.assigned') %>", unassigned: "<%= i18n.__('leads.history.actions.unassigned') %>", score_change: "<%= i18n.__('leads.history.actions.score_change') %>", converted: "<%= i18n.__('leads.history.actions.converted') %>", comment: "<%= i18n.__('leads.history.actions.comment') %>", comment_pin: "<%= i18n.__('leads.history.actions.comment_pin') %>", file_attached: "<%= i18n.__('leads.history.actions.file_attached') %>", file_deleted: "<%= i18n.__('leads.history.actions.file_deleted') %>", task_created: "<%= i18n.__('leads.history.actions.task_created') %>", email_sent: "<%= i18n.__('leads.history.actions.email_sent') %>", call_logged: "<%= i18n.__('leads.history.actions.call_logged') %>", meeting_logged: "<%= i18n.__('leads.history.actions.meeting_logged') %>", sla_breach: "<%= i18n.__('leads.history.actions.sla_breach') %>", automation_fired: "<%= i18n.__('leads.history.actions.automation_fired') %>", duplicate_marked: "<%= i18n.__('leads.history.actions.duplicate_marked') %>", duplicate_dismissed: "<%= i18n.__('leads.history.actions.duplicate_dismissed') %>", merged: "<%= i18n.__('leads.history.actions.merged') %>", auto_assigned: "<%= i18n.__('leads.history.actions.auto_assigned') %>", imported: "<%= i18n.__('leads.history.actions.imported') %>", sla_warning: "<%= i18n.__('leads.history.actions.sla_warning') %>", deleted: "<%= i18n.__('leads.history.actions.deleted') %>", restored: "<%= i18n.__('leads.history.actions.restored') %>" };
