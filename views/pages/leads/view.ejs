<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
<head>
    <title><%= i18n.__('leads.view.title') %> #<%= lead.id %></title>
    <%- include('../../partials/head'); %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
    <link href="/assets/css/tabulator/tabulator.min.css" rel="stylesheet" />
    <link href="/assets/css/tabulator/tabulator_bootstrap5.min.css" rel="stylesheet" />
    <style>
        /* Перегляд / редагування: у перегляді полів форми не видно — випадково змінити нічого не можна */
        body:not(.lead-editing) .edit-only { display: none !important; }
        body.lead-editing .view-only { display: none !important; }
        .field-view { min-height: 24px; white-space: pre-wrap; word-break: break-word; }
        /* Змінене, ще не збережене поле */
        .is-dirty { border-color: #ffc107 !important; box-shadow: 0 0 0 .15rem rgba(255, 193, 7, .35) !important; }
        /* Панель збереження: закріплена знизу, поки лід редагується */
        #edit-bar { position: sticky; bottom: 0; z-index: 1020; }
        .pipeline-steps { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 16px; }
        .pipeline-step {
            padding: 5px 14px;
            border-radius: 0;
            font-size: 12px;
            border: 2px solid transparent;
            opacity: .55;
            transition: opacity .15s;
            cursor: default;
        }
        .pipeline-step.active { opacity: 1; border-color: rgba(0,0,0,.25); }
        body.lead-editing .pipeline-step { cursor: pointer; }
        body.lead-editing .pipeline-step:hover { opacity: .85; }
        .score-bar { height: 6px; border-radius: 3px; background: #e9ecef; }
        .score-bar-fill { height: 100%; border-radius: 3px; transition: width .3s; }
        .tab-content { min-height: 300px; }
        .section-title { font-size: 11px; font-weight: 700; text-transform: uppercase;
                         color: #6c757d; letter-spacing: .5px; margin-bottom: 8px; }
        #history-table .tabulator-col, #history-table .tabulator-cell { border-right: 1px solid #dee2e6; border-bottom: 1px solid #dee2e6; }
        #history-table .tabulator-col:last-child, #history-table .tabulator-cell:last-child { border-right: none; }
    </style>
</head>
<body class="d-flex flex-column h-100">
<%- include('../../partials/header'); %>
<%
    // Іконка Font Awesome: у старих записах лише назва («fa-star») — додаємо стиль fa-solid
    function fa(cls) {
        var c = String(cls || '').trim();
        if (!/^[a-z0-9 -]+$/i.test(c)) return '';
        return /(^|\s)(fa-(solid|regular|brands|light|thin|duotone)|fas|far|fab|fal)(\s|$)/.test(c) ? c : 'fa-solid ' + c;
    }
    function hex(c, def) { return /^#[0-9a-f]{3,8}$/i.test(String(c || '')) ? c : def; }
    var ci = lead.contact_info || {};
    var tagIds = tags.map(function (t) { return Number(t.id); });
    var closeDate = lead.expected_close_date ? String(lead.expected_close_date).slice(0, 10) : '';
%>
    <!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
    <div class="breadcrumbs pt-3 pb-3">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col">
            <span><%= '#' + lead.id + ' ' + (lead.title || '') %></span>
            <div>
              <ul class="list-inline mb-0">
                <li class="list-inline-item">
                  <a href="/">
                    <i class="fas fa-home"></i>
                    <span><%= i18n.__('leads.view.breadcrumb.home') %></span>
                  </a>
                </li>
                <li class="list-inline-item">
                  <i class="fas fa-chevron-right"></i>
                  <a href="/leads/"><%= i18n.__('leads.view.breadcrumb.leads') %></a>
                </li>
                <li class="list-inline-item">
                  <i class="fas fa-chevron-right"></i>
                  <%= '#' + lead.id + ' ' + (lead.title || '') %>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-auto">
            <a href="/leads/" class="btn btn-primary rounded-0">
              <i class="fa-solid fa-angle-left"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

<div class="container-fluid py-3" id="lead-form">
    <input type="hidden" id="lead-date-edit" value="<%= lead.date_edit %>" />

    <!-- Етапи воронки: змінюються лише в режимі редагування -->
    <div class="pipeline-steps" id="pipeline-steps">
        <input type="hidden" data-f="id_stage" value="<%= lead.id_stage || '' %>" />
        <% stages.forEach(function(st) { %>
        <button type="button" class="pipeline-step <%= lead.id_stage == st.id ? 'active' : '' %>" style="background:<%= hex(st.color, '#6c757d') %>;color:#fff" data-stage="<%= st.id %>" data-system="<%= st.system_type %>">
            <% if (fa(st.icon)) { %><i class="<%= fa(st.icon) %> me-1"></i><% } %><%= st.name %>
            <small class="ms-1 opacity-75"><%= st.probability %>%</small>
        </button>
        <% }); %>
    </div>

    <div class="row g-3">
        <!-- ЛІВА КОЛОНКА -->
        <div class="col-12 col-xl-8">
            <!-- Заголовок і основне -->
            <div class="card rounded-0 border-primary mb-3">
                <div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center gap-2">
                    <div class="flex-grow-1">
                        <span class="view-only fw-bold fs-5 field-view" data-show="title"></span>
                        <input type="text" maxlength="500" class="form-control rounded-0 edit-only" data-f="title" value="<%= lead.title %>" placeholder="<%= i18n.__('leads.view.f.title') %>" />
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-shrink-0">
                        <% if (lead.is_converted) { %>
                        <span class="badge bg-success rounded-0"><i class="fa-solid fa-circle-check me-1"></i><%= i18n.__('leads.view.t.konvertovano') %></span>
                        <% } %>
                        <% if (lead.is_duplicate) { %>
                        <span class="badge bg-warning text-dark rounded-0"><i class="fa-solid fa-copy me-1"></i><%= i18n.__('leads.view.t.dublikat') %></span>
                        <% } %>
                        <% if (canEdit) { %>
                        <button type="button" class="btn btn-sm btn-light rounded-0 view-only" id="btn-edit"><i class="fa-solid fa-pen me-1"></i><%= i18n.__('leads.view.edit') %></button>
                        <button type="button" class="btn btn-sm btn-light rounded-0 view-only" data-action="enrich" title="<%= i18n.__('leads.enrich.hint') %>"><i class="fa-solid fa-wand-magic-sparkles me-1"></i><%= i18n.__('leads.enrich.button') %></button>
                        <% } %>
                        <% if (canDelete) { %>
                        <button type="button" class="btn btn-sm btn-outline-light rounded-0 view-only" id="btn-delete" title="<%= i18n.__('leads.view.t.vydalyty_v_koshyk') %>"><i class="fa-solid fa-trash"></i></button>
                        <% } %>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('leads.view.t.status') %></div>
                            <div class="view-only field-view" data-show="id_status"></div>
                            <select class="form-select form-select-sm rounded-0 edit-only" data-f="id_status">
                                <% statuses.forEach(function(s) { %>
                                <option value="<%= s.id %>" data-fg="<%= hex(s.color_text, '#ffffff') %>" data-bg="<%= hex(s.color_background, '#6c757d') %>" data-icon="<%= fa(s.icon) %>" data-system="<%= s.system_type %>" <%= lead.id_status == s.id ? 'selected' : '' %>><%= s.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('leads.view.t.priorytet') %></div>
                            <div class="view-only field-view" data-show="id_priority"></div>
                            <select class="form-select form-select-sm rounded-0 edit-only" data-f="id_priority">
                                <option value="">—</option>
                                <% priorities.forEach(function(p) { %>
                                <option value="<%= p.id %>" data-fg="<%= hex(p.color_text, '#ffffff') %>" data-bg="<%= hex(p.color_background, '#6c757d') %>" data-icon="<%= fa(p.icon) %>" <%= lead.id_priority == p.id ? 'selected' : '' %>><%= p.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('leads.view.t.temperatura') %></div>
                            <div class="view-only field-view" data-show="id_temperature"></div>
                            <select class="form-select form-select-sm rounded-0 edit-only" data-f="id_temperature">
                                <option value="">—</option>
                                <% temperatures.forEach(function(t) { %>
                                <option value="<%= t.id %>" data-fg="<%= hex(t.color_text, '#000000') %>" data-bg="<%= hex(t.color_background, '#e9ecef') %>" data-icon="<%= fa(t.icon) %>" <%= lead.id_temperature == t.id ? 'selected' : '' %>><%= t.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('leads.view.t.kvalifikatsiia') %></div>
                            <div class="view-only field-view" data-show="id_qualification"></div>
                            <select class="form-select form-select-sm rounded-0 edit-only" data-f="id_qualification">
                                <option value="">—</option>
                                <% qualifications.forEach(function(q) { %>
                                <option value="<%= q.id %>" data-fg="<%= hex(q.color_text, '#ffffff') %>" data-bg="<%= hex(q.color_background, '#6c757d') %>" data-icon="<%= fa(q.icon) %>" <%= lead.id_qualification == q.id ? 'selected' : '' %>><%= q.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('leads.view.t.suma') %></div>
                            <div class="view-only field-view" data-show="value" data-kind="money"></div>
                            <input type="number" min="0" step="0.01" class="form-control form-control-sm rounded-0 edit-only" data-f="value" value="<%= Number(lead.value || 0) %>" />
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('leads.view.t.data_zakryttia') %></div>
                            <div class="view-only field-view" data-show="expected_close_date" data-kind="date"></div>
                            <input type="date" class="form-control form-control-sm rounded-0 edit-only" data-f="expected_close_date" value="<%= closeDate %>" />
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('leads.view.t.dzherelo') %></div>
                            <div class="view-only field-view" data-show="id_source"></div>
                            <select class="form-select form-select-sm rounded-0 edit-only" data-f="id_source">
                                <option value="">—</option>
                                <% sources.forEach(function(src) { %>
                                <option value="<%= src.id %>" <%= lead.id_source == src.id ? 'selected' : '' %>><%= src.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('leads.view.f.id_manager') %></div>
                            <div class="view-only field-view" data-show="id_manager"></div>
                            <select class="form-select form-select-sm rounded-0 edit-only" data-f="id_manager">
                                <option value="">—</option>
                                <% managers.forEach(function(m) { %>
                                <option value="<%= m.id %>" <%= lead.id_manager == m.id ? 'selected' : '' %>><%= m.name || ('#' + m.id) %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="section-title"><%= i18n.__('leads.view.t.sait') %></div>
                            <div class="view-only field-view" data-show="website" data-kind="url"></div>
                            <input type="text" maxlength="255" class="form-control form-control-sm rounded-0 edit-only" data-f="website" value="<%= lead.website %>" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Нотатка -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('leads.view.t.notatka') %></div>
                <div class="card-body">
                    <div class="view-only field-view" data-show="note"></div>
                    <textarea class="form-control rounded-0 edit-only" rows="4" data-f="note"><%= lead.note %></textarea>
                </div>
            </div>

            <!-- Контактна інформація -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('leads.view.t.kontaktna_informatsiia') %></div>
                <div class="card-body">
                    <div class="row g-2">
                        <% [
                            { key: 'name', label: i18n.__('leads.view.t.imia'), type: 'text' },
                            { key: 'phone', label: i18n.__('leads.view.t.telefon'), type: 'tel' },
                            { key: 'email', label: 'Email', type: 'email' },
                            { key: 'company', label: i18n.__('leads.view.t.kompaniia'), type: 'text' },
                            { key: 'position', label: i18n.__('leads.view.t.posada'), type: 'text' }
                        ].forEach(function(f) { %>
                        <div class="col-12 col-md-6">
                            <div class="section-title"><%= f.label %></div>
                            <div class="view-only field-view" data-show="contact.<%= f.key %>" data-kind="<%= f.key === 'phone' ? 'tel' : f.key === 'email' ? 'email' : '' %>"></div>
                            <input type="<%= f.type %>" maxlength="255" class="form-control form-control-sm rounded-0 edit-only" data-f="contact.<%= f.key %>" value="<%= ci[f.key] || '' %>" />
                            <div class="invalid-feedback"></div>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>

            <!-- Score -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2 d-flex justify-content-between align-items-center">
                    <span>Score</span>
                    <span class="badge rounded-0 <%= lead.grade=='A'?'text-bg-success':lead.grade=='B'?'text-bg-primary':lead.grade=='C'?'text-bg-warning':'text-bg-secondary' %>" id="score-badge"><%= lead.score %> / <strong><%= lead.grade %></strong></span>
                    <button type="button" class="btn btn-sm btn-link p-0 ms-1" data-action="score-why" title="<%= i18n.__('leads.scoring.why') %>"><i class="fa-solid fa-circle-question"></i></button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="section-title">Fit Score<% if (scoreAuto.fit) { %> <span class="badge rounded-0 text-bg-light border"><%= i18n.__('leads.scoring.auto') %></span><% } %></div>
                            <div class="view-only field-view" data-show="score_fit"></div>
                            <input type="number" min="0" max="100" step="1" class="form-control form-control-sm rounded-0 edit-only<%= scoreAuto.fit ? ' bg-light' : '' %>" data-f="score_fit" value="<%= lead.score_fit %>"<%= scoreAuto.fit ? ' readonly' : '' %> />
                            <div class="score-bar mt-1"><div class="score-bar-fill bg-primary" data-bar="score_fit" style="width:<%= Math.min(lead.score_fit, 100) %>%"></div></div>
                        </div>
                        <div class="col-6">
                            <div class="section-title">Activity Score<% if (scoreAuto.activity) { %> <span class="badge rounded-0 text-bg-light border"><%= i18n.__('leads.scoring.auto') %></span><% } %></div>
                            <div class="view-only field-view" data-show="score_activity"></div>
                            <input type="number" min="0" max="100" step="1" class="form-control form-control-sm rounded-0 edit-only<%= scoreAuto.activity ? ' bg-light' : '' %>" data-f="score_activity" value="<%= lead.score_activity %>"<%= scoreAuto.activity ? ' readonly' : '' %> />
                            <div class="score-bar mt-1"><div class="score-bar-fill bg-info" data-bar="score_activity" style="width:<%= Math.min(lead.score_activity, 100) %>%"></div></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Програш: видно, коли статус «програно» або причину вже вказано -->
            <div class="card rounded-0 mb-3 d-none" id="loss-section">
                <div class="card-header fw-semibold py-2 text-danger"><%= i18n.__('leads.view.t.prychyna_prohrashu') %></div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-12 col-md-6">
                            <div class="section-title"><%= i18n.__('leads.view.t.prychyna') %></div>
                            <div class="view-only field-view" data-show="id_loss_reason"></div>
                            <select class="form-select form-select-sm rounded-0 edit-only" data-f="id_loss_reason">
                                <option value="">—</option>
                                <% loss_reasons.forEach(function(r) { %>
                                <option value="<%= r.id %>" <%= lead.id_loss_reason == r.id ? 'selected' : '' %>><%= r.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="section-title"><%= i18n.__('leads.view.t.komentar') %></div>
                            <div class="view-only field-view" data-show="loss_note"></div>
                            <textarea class="form-control form-control-sm rounded-0 edit-only" rows="2" data-f="loss_note"><%= lead.loss_note || '' %></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Теги -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('leads.view.t.tehy') %></div>
                <div class="card-body">
                    <div class="view-only d-flex flex-wrap gap-2" data-show="tags"></div>
                    <div class="edit-only d-flex flex-wrap gap-3" data-f="tags">
                        <% all_tags.forEach(function(t) { %>
                        <div class="form-check">
                            <input class="form-check-input tag-check" type="checkbox" id="tag-<%= t.id %>" value="<%= t.id %>" data-bg="<%= hex(t.color, '#6c757d') %>" <%= tagIds.indexOf(Number(t.id)) >= 0 ? 'checked' : '' %> />
                            <label class="form-check-label" for="tag-<%= t.id %>"><span class="badge rounded-0" style="background:<%= hex(t.color, '#6c757d') %>"><%= t.name %></span></label>
                        </div>
                        <% }); %>
                        <% if (!all_tags.length) { %><span class="text-muted small">—</span><% } %>
                    </div>
                </div>
            </div>

        </div>

        <!-- ПРАВА КОЛОНКА -->
        <div class="col-12 col-xl-4">
            <%- include('../../partials/risk', { riskUrl: '/api/leads/' + lead.id + '/risk/' }) %>

            <!-- Можливі дублі: ліди з тим самим телефоном або email -->
            <div class="card rounded-0 mb-3 border-warning d-none" id="dupes-card">
                <div class="card-header fw-semibold py-2 bg-warning-subtle d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-copy me-1"></i><%= i18n.__('leads.dupes.title') %> <span class="badge rounded-0 text-bg-warning" id="dupes-count"></span></span>
                    <% if (canEdit) { %>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-0 d-none" id="dupes-dismiss" title="<%= i18n.__('leads.dupes.dismiss_hint') %>"><%= i18n.__('leads.dupes.dismiss') %></button>
                    <% } %>
                </div>
                <div class="list-group list-group-flush" id="dupes-list"></div>
            </div>

            <!-- Клієнт -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('leads.view.t.kliient') %></div>
                <div class="card-body" id="client-card-body">
                    <% if (lead.id_client) { %>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa-solid fa-user text-muted me-1"></i>
                            <a href="/clients/<%= lead.id_client %>/" class="fw-semibold"><%= lead.client_name || ('#' + lead.id_client) %></a>
                        </div>
                        <a href="/clients/<%= lead.id_client %>/" class="btn btn-sm btn-outline-primary rounded-0" title="<%= i18n.__('leads.view.t.kartka_kliienta') %>"><i class="fa-solid fa-up-right-from-square"></i></a>
                    </div>
                    <% } else { %>
                    <span class="text-muted small"><%= i18n.__('leads.view.t.ne_pryviazano_vkazhit_telefon_email') %></span>
                    <% } %>
                    <% if (lead.id_client_org) { %>
                    <div class="mt-2">
                        <i class="fa-solid fa-building text-muted me-1"></i>
                        <a href="/clients/<%= lead.id_client_org %>/"><%= lead.client_org_name || ('#' + lead.id_client_org) %></a>
                    </div>
                    <% } %>
                </div>
            </div>

                        <!-- Заплановано -->
            <%- include('../../partials/calendar/links', {
                calType: 'lead',
                calId: lead.id,
                calManager: lead.id_manager || 0,
                calExtra: [lead.id_client ? { type: 'client', id: lead.id_client } : null, lead.id_client_org ? { type: 'client', id: lead.id_client_org } : null].filter(Boolean)
            }) %>

            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2">SLA</div>
                <div class="card-body">
                    <div class="mb-2">
                        <div class="section-title"><%= i18n.__('leads.view.t.dedlain_vidpovidi') %></div>
                        <% if (lead.response_deadline) { %>
                            <span><%= String(lead.response_deadline).slice(0, 16) %></span>
                            <% if (!lead.first_response_at && !lead.is_converted && lead.sla_left !== null) { %>
                            <span class="badge rounded-0 ms-1" id="sla-left" data-left="<%= Number(lead.sla_left) %>"></span>
                            <% } %>
                        <% } else { %><span class="text-muted"><%= i18n.__('leads.sla.none') %></span><% } %>
                    </div>
                    <div>
                        <div class="section-title"><%= i18n.__('leads.view.t.persha_vidpovid') %></div>
                        <% if (lead.first_response_at) { %>
                            <span><%= String(lead.first_response_at).slice(0, 16) %></span>
                            <% if (lead.response_sec !== null && lead.response_sec >= 0) { %>
                            <span class="badge rounded-0 ms-1 <%= lead.response_deadline && String(lead.first_response_at) > String(lead.response_deadline) ? 'text-bg-danger' : 'text-bg-success' %>" id="sla-took" data-sec="<%= Number(lead.response_sec) %>"></span>
                            <% } %>
                        <% } else { %><span class="text-muted">—</span><% } %>
                    </div>
                    <div class="small text-muted mt-2"><%= i18n.__('leads.sla.hint') %></div>
                </div>
            </div>

