        : '<span class="text-muted small"><%= i18n.__('leads.view.t.ne_pryviazano_vkazhit_telefon_email') %></span>';
    if (c.id_org) html += '<div class="mt-2"><i class="fa-solid fa-building text-muted me-1"></i><a href="/clients/' + Number(c.id_org) + '/">' + esc(c.org_name || "#" + c.id_org) + "</a></div>";
