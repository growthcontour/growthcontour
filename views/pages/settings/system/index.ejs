						{ title: L.first_seen, field: "first_seen", width: 150, headerSort: false, formatter: (c) => `<span class="small">${esc(dt(c.getValue()))}</span>` },
						{ title: L.state, field: "status", width: 110, headerSort: false, formatter: (c) => `<span class="badge rounded-0 text-bg-${{ open: "danger", resolved: "success", ignored: "secondary" }[c.getValue()]}">${esc(L.es[c.getValue()])}</span>` },
					],
