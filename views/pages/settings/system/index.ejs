				document.querySelector('[data-bs-target="#t-perf"]').addEventListener("shown.bs.tab", perf);

				/* ─── Черги ─── */
				const qTable = new Tabulator("#q-table", {
					layout: "fitColumns",
					ajaxURL: "/api/settings/system/queue/",
					ajaxRequestFunc: (url, cfg, p) => post(url, { key: $("q-key").value, status: $("q-status").value, page: p.page, size: p.size }),
					pagination: true,
					paginationMode: "remote",
					paginationSize: 50,
					selectable: EDIT,
					placeholder: L.empty,
					columns: [
						...(EDIT ? [{ formatter: "rowSelection", titleFormatter: "rowSelection", hozAlign: "center", headerSort: false, width: 40, cellClick: (e, c) => c.getRow().toggleSelect() }] : []),
						{ title: "ID", field: "id", width: 80, headerSort: false },
						{ title: L.ref, field: "ref", width: 160, headerSort: false, formatter: (c) => ($("q-key").value === "messages" && c.getValue() ? `<a href="/orders/${Number(c.getValue())}/" target="_blank">#${Number(c.getValue())}</a>` : esc(c.getValue() ?? "—")) },
						{ title: L.attempts, field: "attempts", width: 90, headerSort: false },
						{ title: L.error, field: "last_error", headerSort: false, formatter: (c) => `<span class="small text-danger">${esc(c.getValue() || "")}</span>`, cellClick: (e, c) => c.getValue() && detail(L.error, pre(c.getValue()), c.getValue()) },
						{ title: L.date, field: "date", width: 170, headerSort: false, formatter: (c) => esc(dt(c.getValue())) },
					],
				});
				qTable.on("rowSelectionChanged", (d) => $("q-retry-sel") && ($("q-retry-sel").disabled = !d.length));
				["q-key", "q-status"].forEach((id) => $(id).addEventListener("change", () => qTable.setData()));
				async function retry(ids) {
					if (!confirm(ids ? fill(L.confirm_retry_sel, { n: ids.length }) : L.confirm_retry_all)) return;
					try {
						const r = await post("/api/settings/system/queue/retry/", { key: $("q-key").value, ids: ids || [] });
						notyf.success(fill(L.retried, { n: r.retried }));
						qTable.setData();
						overview();
					} catch (e) {
						notyf.error(e.message);
					}
				}
				if (EDIT) {
					$("q-retry-sel").addEventListener("click", () => retry(qTable.getSelectedData().map((d) => d.id)));
					$("q-retry-all").addEventListener("click", () => retry(null));
				}

				/* ─── Оновлення ─── */
				const activeTab = () => (document.querySelector("#tabs .nav-link.active") || {}).dataset?.bsTarget;
				$("refresh").addEventListener("click", () => {
					overview();
					const t = activeTab();
					if (t === "#t-errors") reloadErrors();
					if (t === "#t-perf") perf();
					if (t === "#t-logs") reloadLogs();
				});
				setInterval(() => {
					if (!$("auto").checked || document.visibilityState !== "visible") return;
					overview();
					if (activeTab() === "#t-errors") reloadErrors();
					if (activeTab() === "#t-perf") perf();
				}, 30000);
				overview();
			})();
		</script>
	</body>
</html>
