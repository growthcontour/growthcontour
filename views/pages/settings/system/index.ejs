				document.querySelector('[data-bs-target="#t-errors"]').addEventListener("shown.bs.tab", reloadErrors);

				/* ─── Журнали ─── */
				function fillFiles(keep) {
					const cat = $("l-cat").value;
					const sel = $("l-file");
					const cur = sel.value;
					const list = files.filter((f) => f.category === cat);
					sel.innerHTML = list.map((f) => `<option value="${esc(f.key)}">${esc(cat === "legacy" ? L.legacy[f.day] || f.day : f.day)} · ${bytes(f.size)}</option>`).join("") || `<option value="">—</option>`;
					if (keep && cur && list.some((f) => f.key === cur)) sel.value = cur;
					$("l-download").href = sel.value ? "/api/settings/system/logs/download/?file=" + encodeURIComponent(sel.value) : "#";
				}
				const timeOf = (id) => {
					const f = files.find((x) => x.key === $("l-file").value);
					const v = $(id).value;
					return v && f && /^\d{4}-\d{2}-\d{2}$/.test(f.day) ? new Date(f.day + "T" + v + ":00").toISOString() : "";
				};
				const lTable = new Tabulator("#l-table", {
					layout: "fitColumns",
					ajaxURL: "/api/settings/system/logs/",
					ajaxRequestFunc: (url, cfg, p) =>
						$("l-file").value
							? post(url, { file: $("l-file").value, level: $("l-level").value, module: $("l-module").value, q: $("l-q").value.trim(), from: timeOf("l-from"), to: timeOf("l-to"), page: p.page, size: p.size }).then((r) => {
									$("l-info").textContent = fill(L.found, { n: num(r.total) }) + (Object.keys(r.counts.levels).length ? " · " + Object.entries(r.counts.levels).map(([k, v]) => k + ": " + v).join(", ") : "") + (r.truncated ? " · " + L.truncated : "");
									const sel = $("l-module");
									const cur = sel.value;
									const mods = Object.keys(r.counts.modules).sort();
									sel.innerHTML = `<option value="">${esc(L.all)}</option>` + mods.map((m) => `<option value="${esc(m)}">${esc(m)} (${r.counts.modules[m]})</option>`).join("");
									if (cur && !mods.includes(cur)) sel.insertAdjacentHTML("beforeend", `<option value="${esc(cur)}">${esc(cur)}</option>`);
									sel.value = cur;
									return r;
							  })
							: Promise.resolve({ last_page: 1, data: [] }),
					pagination: true,
					paginationMode: "remote",
					paginationSize: 100,
					paginationSizeSelector: [50, 100, 200, 500],
					placeholder: L.empty,
					columns: [
						{ title: L.time, field: "time", width: 165, headerSort: false, formatter: (c) => `<span class="small">${esc(dt(c.getValue()))}</span>` },
						{ title: L.level, field: "level", width: 80, headerSort: false, formatter: (c) => `<span class="badge rounded-0 lv text-bg-${LV[c.getValue()] || "secondary"}">${esc(c.getValue())}</span>` },
						{ title: L.module, field: "module", width: 120, headerSort: false, formatter: (c) => `<span class="small">${esc(c.getValue())}</span>` },
						{
