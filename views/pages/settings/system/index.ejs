						{ title: L.level, field: "level", width: 80, headerSort: false, formatter: (c) => `<span class="badge rounded-0 lv text-bg-${LV[c.getValue()] || "danger"}">${esc(c.getValue())}</span>` },
						{ title: L.module, field: "module", width: 130, headerSort: false, formatter: (c) => `<span class="small">${esc(c.getValue())}</span>` },
						{
