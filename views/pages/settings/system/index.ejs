					showTab("queues");
					qTable.setData();
				});

				/* ─── Помилки ─── */
				let eStatus = "open";
				const eTable = new Tabulator("#e-table", {
					layout: "fitColumns",
					ajaxURL: "/api/settings/system/errors/",
					ajaxRequestFunc: (url, cfg, p) =>
						post(url, { status: eStatus, module: $("e-module").value, q: $("e-q").value.trim(), sort: $("e-sort").value, page: p.page, size: p.size }).then((r) => {
							$("e-missing").classList.toggle("d-none", !r.missing);
