				eTable.on("rowClick", async (e, row) => {
					if (e.target.closest(".tabulator-row-handle, input[type=checkbox]")) return;
					try {
						const { row: d } = await post("/api/settings/system/errors/" + Number(row.getData().id) + "/");
						const c = d.context || {};
						const html =
							kv(L.module, esc(d.module)) + kv(L.count, num(d.count)) + kv(L.first_seen, esc(dt(d.first_seen))) + kv(L.last_seen, esc(dt(d.last_seen))) +
							(d.frame ? kv(L.frame, `<code>${esc(d.frame)}</code>`) : "") +
							(c.url ? kv(L.url, `<code>${esc((c.method || "") + " " + c.url)}</code>`) : "") +
							(c.user_id ? kv(L.user, "#" + Number(c.user_id)) : "") +
							(c.req_id ? kv("Request ID", `<code>${esc(c.req_id)}</code>`) : "") +
							(d.status !== "open" ? kv(L.state, esc(L.es[d.status]) + (d.resolved_name ? " · " + esc(d.resolved_name) : "") + (d.resolved_at ? " · " + esc(dt(d.resolved_at)) : "")) : "") +
							`<div class="fw-semibold small mt-3 mb-1">${esc(L.stack)}</div>` + pre(d.stack || d.message) +
							`<div class="fw-semibold small mt-2 mb-1">${esc(L.context)}</div>` + pre(c);
						detail(d.message, html, (d.stack || d.message) + "\n\n" + JSON.stringify(c, null, 2), c.req_id);
					} catch (err) {
						notyf.error(err.message);
					}
				});
				const reloadErrors = () => eTable.setData();
				$("e-status").addEventListener("click", (e) => {
					const b = e.target.closest("[data-status]");
					if (!b) return;
					document.querySelectorAll("#e-status .btn").forEach((x) => x.classList.toggle("active", x === b));
					eStatus = b.dataset.status;
					reloadErrors();
				});
				["e-module", "e-sort"].forEach((id) => $(id).addEventListener("change", reloadErrors));
				let eT = null;
				$("e-q").addEventListener("input", () => { clearTimeout(eT); eT = setTimeout(reloadErrors, 400); });
				if (EDIT) {
					const setBtns = document.querySelectorAll("[data-set]");
