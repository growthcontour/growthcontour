						{ title: L.avg, field: "avg", width: 90, hozAlign: "right", formatter: (c) => c.getValue() + " ms" },
						{ title: L.max, field: "max", width: 90, hozAlign: "right", formatter: (c) => c.getValue() + " ms" },
