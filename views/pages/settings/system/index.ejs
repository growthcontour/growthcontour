					});
					$("e-delete").addEventListener("click", async () => {
						const ids = eTable.getSelectedData().map((d) => d.id);
						if (!ids.length || !confirm("<%= i18n.__('system.delete_q') %>".replace("%n", ids.length))) return;
						try {
							const r = await post("/api/settings/system/errors-delete/", { ids });
							notyf.success("<%= i18n.__('system.purged') %>".replace("%n", r.deleted));
							reloadErrors();
						} catch (e) {
							notyf.error(e.message);
						}
					});
					setBtns.forEach((b) =>
						b.addEventListener("click", async () => {
							const ids = eTable.getSelectedData().map((d) => d.id);
							try {
								const r = await post("/api/settings/system/errors-set/", { ids, status: b.dataset.set });
								notyf.success(fill(L.changed, { n: r.changed }));
								reloadErrors();
							} catch (e) {
								notyf.error(e.message);
							}
						})
					);
					$("e-purge").addEventListener("click", async () => {
						if (!confirm(L.purge_q)) return;
						try {
							const r = await post("/api/settings/system/errors-purge/", { days: 30 });
