					],
				});
				pSql.on("rowClick", (e, row) => detail("SQL", pre(row.getData().sql), row.getData().sql));
				async function perf() {
					try {
						const r = await post("/api/settings/system/performance/");
						$("p-info").textContent = fill(L.perf_since, { t: dt(r.started_at) }) + " · event loop p99 " + r.loop.p99 + " ms";
						pRoutes.setData(r.routes);
						pSql.setData(r.sql);
