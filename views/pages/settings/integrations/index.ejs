<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
<head>
	<title><%= i18n.__('orders.integrations.title') %></title>
	<%- include('../../../partials/head'); %>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	<link href="/assets/css/tabulator/tabulator.min.css" rel="stylesheet" />
	<link href="/assets/css/tabulator/tabulator_bootstrap5.min.css" rel="stylesheet" />
	<style>
		#integrations-table .tabulator-col, #integrations-table .tabulator-cell { border-right: 1px solid #dee2e6; border-bottom: 1px solid #dee2e6; }
		#integrations-table .tabulator-col:last-child, #integrations-table .tabulator-cell:last-child { border-right: none; }
		.src-badge { display: inline-block; padding: 2px 8px; font-size: 12px; }
		.form-label.req::after { content: " *"; color: #dc3545; }
		.mono { font-family: monospace; }
	</style>
</head>
<body class="d-flex flex-column h-100">
	<%- include('../../../partials/header'); %>

	<div class="breadcrumbs pt-3 pb-3">
		<div class="container-fluid">
			<div class="row align-items-center">
				<div class="col">
					<span><%= i18n.__('orders.integrations.title') %></span>
					<div>
						<ul class="list-inline mb-0">
							<li class="list-inline-item"><a href="/"><i class="fas fa-home"></i> <span><%= i18n.__('orders.integrations.breadcrumb.home') %></span></a></li>
							<li class="list-inline-item"><i class="fas fa-chevron-right"></i> <%= i18n.__('header.nav.settings') %></li>
							<li class="list-inline-item"><i class="fas fa-chevron-right"></i> <%= i18n.__('orders.integrations.title') %></li>
						</ul>
					</div>
				</div>
				<div class="col-auto">
					<a href="/" class="btn btn-primary rounded-0"><i class="fa-solid fa-angle-left"></i></a>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-3">
		<div class="row">
			<div class="col-12 mb-3">
				<a href="/settings/integrations/new/" class="btn btn-primary rounded-0 mb-3"><i class="fa-solid fa-plus me-1"></i><%= i18n.__('orders.integrations.add_button') %></a>
				<div class="card border-primary rounded-0">
					<div class="card-header text-bg-primary rounded-0"><%= i18n.__('orders.integrations.title') %></div>
					<div id="integrations-table"></div>
				</div>
			</div>
		</div>
	</div>

	<!-- Не прийняті сайтом -->
	<div class="modal fade" id="modalSyncErrors" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-xl modal-dialog-scrollable">
			<div class="modal-content rounded-0">
				<div class="modal-header">
					<h1 class="modal-title fs-5"><%= i18n.__('orders.integrations.errors.title') %> — <span id="err_int_name"></span></h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body">
					<div class="form-text mb-2"><%= i18n.__('orders.integrations.errors.hint') %></div>
					<div id="err_list"></div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.integrations.delete_modal.close') %></button>
					<button type="button" class="btn btn-primary rounded-0" id="btn_err_retry_all"><i class="fa-solid fa-rotate"></i> <%= i18n.__('orders.integrations.errors.retry_all') %></button>
				</div>
			</div>
		</div>
	</div>

	<%- include('../../../partials/footer'); %> <%- include('../../../partials/script'); %>
	<script src="/assets/js/notyf/notyf.min.js"></script>
	<script src="/assets/js/tabulator/tabulator.min.js"></script>
	<script>
		const PLATFORMS = <%- JSON.stringify(platforms).replace(/</g, '\\u003c') %>;
		const T = {
			add: "<%= i18n.__('orders.integrations.modal.title_add') %>",
			edit: "<%= i18n.__('orders.integrations.modal.title_edit') %>",
			saved: "<%= i18n.__('orders.integrations.modal.saved') %>",
			empty: "<%= i18n.__('orders.integrations.table.empty') %>",
			active: "<%= i18n.__('orders.integrations.status_opt.active') %>",
			disabled: "<%= i18n.__('orders.integrations.status_opt.disabled') %>",
		};

		const notyf = new Notyf({
			position: { x: "right", y: "top" },
			duration: 4000,
			types: [
				{ type: "success", dismissible: true, icon: false },
				{ type: "error", background: "indianred", dismissible: true, icon: false },
			],
		});
		const byId = (id) => document.getElementById(id);
		const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
		const modal = (id) => bootstrap.Modal.getOrCreateInstance(byId(id));

		async function api(url, body) {
			const res = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) });
			const data = await res.json().catch(() => ({}));
			if (!res.ok) throw Object.assign(new Error(data.message || "Error"), { status: res.status, data });
			return data;
		}

		function busy(btn, on) {
			if (on) { btn.dataset.html = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>'; }
			else { btn.disabled = false; btn.innerHTML = btn.dataset.html || btn.innerHTML; }
		}

		// ─── Таблиця ───
		const ok = '<i class="fa-solid fa-check text-success"></i>';
		const no = '<i class="fa-solid fa-xmark text-muted"></i>';
		var table = new Tabulator("#integrations-table", {
			layout: "fitColumns",
			ajaxURL: "/api/settings/integrations/list/",
			ajaxConfig: "POST",
			pagination: true,
			paginationSize: 20,
			placeholder: T.empty,
			columns: [
				{ title: "ID", field: "id", headerSort: false, width: 70 },
				{ title: "<%= i18n.__('orders.integrations.columns.name') %>", field: "name", headerSort: false, widthGrow: 3, formatter: (cell) => {
					const d = cell.getRow().getData();
					const pl = PLATFORMS[d.platform];
					const plat = (pl ? pl.label : d.platform || "—") + (d.platform_version ? " " + d.platform_version : "");
					return '<span class="src-badge" style="background:' + esc(d.color_background || "#607d8b") + ";color:" + esc(d.color_text || "#fff") + '">' + esc(d.name) + "</span>" +
						'<small class="text-muted d-block">' + esc(plat) + (d.base_url ? " · " + esc(d.base_url) : "") + "</small>";
				}},
				{ title: "Зв'язок", field: "callback_url", headerSort: false, widthGrow: 2, formatter: (cell) => {
					const d = cell.getRow().getData();
					const pl = PLATFORMS[d.platform];
					if (!pl || !pl.fields.callback_url) return '<small class="text-muted">—</small>';
					return "<small>Endpoint: " + (d.callback_url ? ok : no) + " &nbsp; Ключ: " + (d.has_outbound_token ? ok : no) + "</small>";
				}},
				{ title: "<%= i18n.__('orders.integrations.columns.sync') %>", field: "sync_orders_out", headerSort: false, widthGrow: 2, formatter: (cell) => {
					const d = cell.getRow().getData();
					return "<small><%= i18n.__('orders.integrations.columns.orders_out') %>: " + (Number(d.sync_orders_out) ? ok : no) +
						" &nbsp; <%= i18n.__('orders.integrations.columns.status_out') %>: " + (Number(d.sync_status_out) ? ok : no) + "</small>";
				}},
				{ title: "<%= i18n.__('orders.integrations.columns.assortment') %>", field: "assortment_count", headerSort: false, width: 130, formatter: (cell) => {
					const v = cell.getValue();
					return v === undefined || v === null ? '<small class="text-muted">—</small>' : Number(v).toLocaleString() + ' <small class="text-muted">/ ' + Number(cell.getRow().getData().assortment_total || 0).toLocaleString() + "</small>";
				}},
				{ title: "<%= i18n.__('orders.integrations.columns.health') %>", field: "health_state", headerSort: false, width: 170, formatter: (cell) => {
					const d = cell.getRow().getData();
					if (!d.health_state && !d.sync_errors && d.assortment_count === undefined) return '<small class="text-muted">—</small>';
					const st = d.health_state || "unknown";
					const cls = st === "ok" ? "text-bg-success" : st === "unknown" ? "text-bg-secondary" : "text-bg-danger";
					const tip = [d.health_message, d.health_version ? HEALTH.module + " " + d.health_version : "", d.health_at || ""].filter(Boolean).join("\n");
					const recon = d.recon_at
						? '<div class="small text-muted" title="' + esc(HEALTH.recon_tip + " " + d.recon_at) + '">' +
						  (Number(d.recon_missing) ? '<span class="text-danger">−' + Number(d.recon_missing) + "</span> " : "") +
						  (Number(d.recon_extra) ? '<span class="text-warning">+' + Number(d.recon_extra) + "</span> " : "") +
						  (Number(d.recon_modified) ? '<span class="text-info">✎' + Number(d.recon_modified) + "</span> " : "") +
						  (Number(d.recon_unlinked) ? '<span class="text-secondary">?' + Number(d.recon_unlinked) + "</span>" : "") +
						  (!Number(d.recon_missing) && !Number(d.recon_extra) && !Number(d.recon_modified) ? HEALTH.recon_ok : "") +
						  "</div>"
						: "";
					// Зайві на сайті або зупинене прибирання: спершу запропонувати безпечне — відв'язати, а не вимикати
					const unlink = Number(d.recon_extra) || Number(d.prune_blocked)
						? '<div><button type="button" class="btn btn-sm btn-outline-warning rounded-0 py-0 mt-1 js-unlink-extra" data-id="' + d.id + '">' + esc(HEALTH.unlink_extra) + "</button></div>"
						: "";
					const prune = Number(d.prune_blocked)
						? '<div><button type="button" class="btn btn-sm btn-outline-danger rounded-0 py-0 mt-1 js-prune-confirm" data-id="' + d.id + '" data-n="' + Number(d.prune_blocked) + '">' + esc(HEALTH.prune_confirm.replace("%n", d.prune_blocked)) + "</button></div>"
						: "";
					return '<span class="badge rounded-0 ' + cls + '" title="' + esc(tip) + '">' + esc(HEALTH[st] || st) + "</span>" +
						' <button type="button" class="btn btn-sm btn-link p-0 js-health-check" data-id="' + d.id + '" title="' + HEALTH.check + '"><i class="fa-solid fa-rotate"></i></button>' + recon + unlink + prune;
				}},
				{ title: "<%= i18n.__('orders.integrations.columns.sync_errors') %>", field: "sync_errors", headerSort: false, width: 120, hozAlign: "center", formatter: (cell) => {
					const n = Number(cell.getValue() || 0);
					return n
						? '<button type="button" class="btn btn-sm btn-outline-danger rounded-0 py-0 js-sync-errors" data-id="' + cell.getRow().getData().id + '">' + n.toLocaleString() + "</button>"
						: '<small class="text-muted">0</small>';
				}},
				{ title: "<%= i18n.__('orders.integrations.columns.last_sync') %>", field: "last_sync", headerSort: false, width: 170, formatter: (cell) => {
					const v = cell.getValue();
					if (!v) return '<small class="text-muted">—</small>';
					const when = esc(new Date(v.at).toLocaleString());
					return v.errors || (v.message && v.message !== "cancelled")
						? '<span class="text-danger" title="' + esc(v.message || "") + '"><i class="fa-solid fa-triangle-exclamation"></i> ' + when + "</span>"
						: '<span class="text-success"><i class="fa-solid fa-check"></i></span> <small>' + when + "</small>";
				}},
				{ title: "<%= i18n.__('orders.integrations.columns.tokens') %>", field: "tokens_count", headerSort: false, width: 90 },
				{ title: "<%= i18n.__('orders.integrations.columns.status') %>", field: "status", headerSort: false, width: 110, formatter: (cell) => {
					const s = cell.getValue();
					return '<span class="badge rounded-0 ' + (s === "active" ? "text-bg-success" : "text-bg-secondary") + '">' + (T[s] || esc(s)) + "</span>";
				}},
				{ title: "<%= i18n.__('orders.integrations.columns.date_add') %>", field: "date_add", headerSort: false, widthGrow: 1 },
				{ title: "", field: "id", headerSort: false, width: 70, hozAlign: "center", formatter: (cell) =>
					'<a href="/settings/integrations/' + cell.getValue() + '/" class="btn btn-sm btn-outline-primary rounded-0" title="<%= i18n.__('orders.integrations.actions.open') %>"><i class="fa-regular fa-pen-to-square"></i></a>' },
			],
		});

		// Лічильники «Товарів на сайті» — окремим запитом, щоб не гальмувати список
		table.on("dataLoaded", async (rows) => {
			if (!rows || !rows.length) return;
			try {
				const r = await api("/api/settings/integrations/assortment/counts/");
				const upd = rows
					.filter((x) => r.counts[x.id] !== undefined || (r.sync && r.sync[x.id]))
					.map((x) => ({ id: x.id, assortment_count: r.counts[x.id], assortment_total: r.total, last_sync: (r.sync || {})[x.id] || null, sync_errors: (r.errors || {})[x.id] || 0 }));
				if (upd.length) table.updateData(upd);
			} catch (e) {}
		});

		// ─── Стан сайту: перевірити зараз ───
		const HEALTH = <%- JSON.stringify(i18n.__('orders.integrations.health')) %>;
		// Захист від масового зникнення: підтвердити прибирання
		document.addEventListener("click", async (e) => {
			const btn = e.target.closest(".js-prune-confirm");
			if (!btn) return;
			if (!confirm(HEALTH.prune_confirm_q.replace("%n", btn.dataset.n))) return;
			btn.disabled = true;
			try {
				await api("/api/settings/integrations/prune/confirm/", { id: Number(btn.dataset.id) });
				notyf.success(HEALTH.prune_confirmed);
				table.updateData([{ id: Number(btn.dataset.id), prune_blocked: 0 }]);
			} catch (err) {
				notyf.error(err.message);
				btn.disabled = false;
			}
		});
		// Відв'язати зайві: товари на сайті лишаються як є, обмін їх більше не чіпає
		document.addEventListener("click", async (e) => {
			const btn = e.target.closest(".js-unlink-extra");
			if (!btn) return;
			if (!confirm(HEALTH.unlink_extra_q)) return;
			btn.disabled = true;
			try {
				const r = await api("/api/settings/integrations/unlink-extra/", { id: Number(btn.dataset.id) });
				notyf.success(HEALTH.unlink_extra_done.replace("%n", r.unlinked).replace("%t", r.linked));
				table.updateData([{ id: Number(btn.dataset.id), recon_extra: 0, prune_blocked: 0 }]);
			} catch (err) {
				notyf.error(err.message);
				btn.disabled = false;
			}
		});
		document.addEventListener("click", async (e) => {
			const btn = e.target.closest(".js-health-check");
			if (!btn) return;
			btn.disabled = true;
			try {
				const r = await api("/api/settings/integrations/health/check/", { id: Number(btn.dataset.id) });
				table.updateData([{ id: Number(btn.dataset.id), health_state: r.state, health_message: r.message, health_version: r.version, health_at: new Date().toLocaleString() }]);
				(r.state === "ok" ? notyf.success : notyf.error).call(notyf, HEALTH.checked + ": " + (HEALTH[r.state] || r.state) + (r.message ? " — " + r.message : ""));
			} catch (err) {
				notyf.error(err.message);
			} finally {
				btn.disabled = false;
			}
		});

		// ─── Не прийняті сайтом: список, повтор одного / усіх ───
		const ERR = {
			empty: "<%= i18n.__('orders.integrations.errors.empty') %>",
			product: "<%= i18n.__('orders.integrations.errors.product') %>",
			message: "<%= i18n.__('orders.integrations.errors.message') %>",
			attempts: "<%= i18n.__('orders.integrations.errors.attempts') %>",
			next: "<%= i18n.__('orders.integrations.errors.next') %>",
			exhausted: "<%= i18n.__('orders.integrations.errors.exhausted') %>",
			retry: "<%= i18n.__('orders.integrations.errors.retry') %>",
			started: "<%= i18n.__('orders.integrations.errors.started') %>",
			busy: "<%= i18n.__('orders.integrations.errors.busy') %>",
		};
		let errIntegration = null;
		async function loadErrors() {
			const box = byId("err_list");
			box.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
			try {
				const r = await api("/api/settings/integrations/assortment/errors/", { id_integration: errIntegration });
				if (!r.rows.length) return (box.innerHTML = '<div class="text-muted">' + ERR.empty + "</div>");
				box.innerHTML =
					'<table class="table table-sm table-bordered align-middle small mb-0"><thead><tr><th>' + ERR.product + "</th><th>" + ERR.message + '</th><th style="width:90px">' + ERR.attempts + '</th><th style="width:150px">' + ERR.next + '</th><th style="width:110px"></th></tr></thead><tbody>' +
					r.rows
						.map(
							(x) =>
								'<tr><td><a href="/catalog/products/' + x.id + '/" target="_blank">' + esc(x.name) + "</a>" + (x.sku ? ' <small class="text-muted">' + esc(x.sku) + "</small>" : "") + "</td>" +
								'<td class="text-danger text-break">' + esc(x.message) + "</td>" +
								"<td>" + x.attempts + " / " + r.max + "</td>" +
								"<td>" + (x.exhausted ? '<span class="text-danger">' + ERR.exhausted + "</span>" : x.retry_at ? esc(new Date(x.retry_at).toLocaleString()) : "—") + "</td>" +
								'<td><button type="button" class="btn btn-sm btn-outline-primary rounded-0 py-0 js-err-retry" data-id="' + x.id + '">' + ERR.retry + "</button></td></tr>"
						)
						.join("") +
					"</tbody></table>";
			} catch (e) {
				box.innerHTML = '<div class="text-danger">' + esc(e.message || "Error") + "</div>";
			}
		}
		async function retry(ids) {
			try {
				const r = await api("/api/settings/integrations/assortment/retry/", { id_integration: errIntegration, ids });
				notyf.success(r.status === "busy" ? ERR.busy : ERR.started);
				await loadErrors();
			} catch (e) {
				notyf.error(e.message);
			}
		}
		document.addEventListener("click", (e) => {
			const open = e.target.closest(".js-sync-errors");
			if (open) {
				errIntegration = Number(open.dataset.id);
				const row = table.getRow(errIntegration);
				byId("err_int_name").textContent = row ? row.getData().name : "#" + errIntegration;
				modal("modalSyncErrors").show();
				loadErrors();
				return;
			}
			const one = e.target.closest(".js-err-retry");
			if (one) retry([Number(one.dataset.id)]);
		});
		byId("btn_err_retry_all").addEventListener("click", () => retry([]));
	</script>
</body>
</html>