							<button type="button" class="btn btn-sm btn-outline-secondary rounded-0 cm-map-only" id="cm_auto"><i class="fa-solid fa-wand-magic-sparkles"></i> <%= i18n.__('orders.integrations.categories.auto') %></button>
							<div class="form-check form-check-inline mb-0 ms-2 cm-map-only">
								<input type="checkbox" class="form-check-input rounded-0" id="cm_only_unmapped" />
								<label class="form-check-label small" for="cm_only_unmapped"><%= i18n.__('orders.integrations.categories.only_unmapped') %></label>
							</div>
							<input type="search" class="form-control form-control-sm rounded-0" style="max-width:220px" id="cm_search" placeholder="<%= i18n.__('orders.integrations.categories.search') %>" />
							<small class="text-muted ms-auto cm-map-only" id="cm_tree_at"></small>
						</div>
						<div class="small mb-2" id="cm_stats"></div>
						<table class="table table-sm table-bordered align-middle small mb-0">
							<thead><tr><th style="width:35%"><%= i18n.__('orders.integrations.categories.col_system') %></th><th class="cm-col-site"><%= i18n.__('orders.integrations.categories.col_site') %></th><th class="cm-col-place"><%= i18n.__('orders.integrations.categories.col_place') %></th></tr></thead>
							<tbody id="cm_rows"></tbody>
