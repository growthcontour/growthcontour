								<option value="skip"><%= i18n.__('orders.integrations.categories.unmapped_skip') %></option>
								<option value="default"><%= i18n.__('orders.integrations.categories.unmapped_default') %></option>
							</select>
						</div>
						<div class="col-md-4 cm-site-only">
							<label class="form-label small mb-1"><%= i18n.__('orders.integrations.categories.default') %></label>
