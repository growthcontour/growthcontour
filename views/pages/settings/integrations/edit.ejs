						<input type="search" class="form-control form-control-sm rounded-0 mb-1" id="cm_picker_q" placeholder="<%= i18n.__('orders.integrations.categories.search') %>" />
						<select class="form-select form-select-sm rounded-0" size="10" id="cm_picker_list"></select>
					</div>
