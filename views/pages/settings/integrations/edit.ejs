							<small class="text-muted d-block mb-1"><%= i18n.__('orders.integrations.categories.rules_hint') %></small>
							<div class="table-responsive">
								<table class="table table-sm table-bordered align-middle small mb-1">
									<thead><tr>
										<th><%= i18n.__('orders.integrations.categories.r_brands') %></th>
										<th><%= i18n.__('orders.integrations.categories.r_categories') %></th>
										<th><%= i18n.__('orders.integrations.categories.r_values') %></th>
										<th style="width:90px"><%= i18n.__('orders.integrations.categories.r_price_from') %></th>
										<th style="width:90px"><%= i18n.__('orders.integrations.categories.r_price_to') %></th>
										<th style="width:110px"><%= i18n.__('orders.integrations.categories.r_stock') %></th>
										<th style="width:120px"><%= i18n.__('orders.integrations.categories.r_action') %></th>
										<th><%= i18n.__('orders.integrations.categories.r_site') %></th>
