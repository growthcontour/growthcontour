<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
<head>
	<title><%= id ? i18n.__('orders.integrations.modal.title_edit') : i18n.__('orders.integrations.modal.title_add') %> — <%= i18n.__('orders.integrations.title') %></title>
	<%- include('../../../partials/head'); %>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/themes/monolith.min.css" />
	<style>
		#integrations-table .tabulator-col, #integrations-table .tabulator-cell { border-right: 1px solid #dee2e6; border-bottom: 1px solid #dee2e6; }
		#integrations-table .tabulator-col:last-child, #integrations-table .tabulator-cell:last-child { border-right: none; }
		.src-badge { display: inline-block; padding: 2px 8px; font-size: 12px; }
		.pickr .pcr-button { border: 1px solid #eee; border-radius: 0; }
		.form-label.req::after { content: " *"; color: #dc3545; }
		.mono { font-family: monospace; }
		.save-bar { position: sticky; bottom: 0; z-index: 10; background: var(--bs-body-bg); border-top: 1px solid var(--bs-border-color); }
	</style>
</head>
<body class="d-flex flex-column h-100">
	<%- include('../../../partials/header'); %>

	<!-- Breadcrumb -->
	<div class="breadcrumbs pt-3 pb-3">
		<div class="container-fluid">
			<div class="row align-items-center">
				<div class="col">
					<span id="page_title"><%= id ? i18n.__('orders.integrations.modal.title_edit') : i18n.__('orders.integrations.modal.title_add') %></span>
					<div>
						<ul class="list-inline mb-0">
							<li class="list-inline-item"><a href="/"><i class="fas fa-home"></i> <span><%= i18n.__('orders.integrations.breadcrumb.home') %></span></a></li>
							<li class="list-inline-item"><i class="fas fa-chevron-right"></i> <%= i18n.__('header.nav.settings') %></li>
							<li class="list-inline-item"><i class="fas fa-chevron-right"></i> <a href="/settings/integrations/"><%= i18n.__('orders.integrations.title') %></a></li>
							<li class="list-inline-item"><i class="fas fa-chevron-right"></i> <span id="crumb_name"><%= id ? '#' + id : i18n.__('orders.integrations.modal.title_add') %></span></li>
						</ul>
					</div>
				</div>
				<div class="col-auto">
					<a href="/settings/integrations/" class="btn btn-primary rounded-0"><i class="fa-solid fa-angle-left"></i></a>
				</div>
			</div>
		</div>
	</div>
	<!-- END Breadcrumb -->

	<main class="flex-shrink-0">
		<div class="container-fluid mt-3">
			<!-- ═══ Загальне ═══ -->
			<div class="card border-primary rounded-0 mb-3">
				<div class="card-header text-bg-primary rounded-0 d-flex align-items-center justify-content-between">
					<span><%= i18n.__('orders.integrations.cards.general') %><span class="d-none" id="int_modal_title"></span></span>
					<span class="badge text-bg-light rounded-0 d-none" id="int_id_wrap">#<span id="int_id_label"></span></span>
				</div>
				<div class="card-body">
			<input type="hidden" id="int_id" />
			<div class="mb-3">
				<label class="form-label req" for="int_name"><%= i18n.__('orders.integrations.fields.name') %></label>
				<input type="text" class="form-control rounded-0" id="int_name" maxlength="255" />
			</div>

			<div class="mb-3">
				<label class="form-label" for="int_order_prefix"><%= i18n.__('orders.integrations.fields.order_prefix') %></label>
				<input type="text" class="form-control rounded-0" id="int_order_prefix" maxlength="16" placeholder="ORD-" style="max-width:200px" />
				<div class="form-text"><%= i18n.__('orders.integrations.fields.order_prefix_help') %></div>
			</div>

			<div class="row">
				<div class="col-12 col-md-5 mb-3">
					<label class="form-label req" for="int_platform"><%= i18n.__('orders.integrations.fields.platform') %></label>
					<select class="form-select rounded-0" id="int_platform"></select>
				</div>
				<div class="col-6 col-md-3 mb-3 d-none" data-field="version">
					<label class="form-label" for="int_platform_version">Версія</label>
					<select class="form-select rounded-0" id="int_platform_version"></select>
				</div>
				<div class="col-6 col-md-4 mb-3">
					<label class="form-label" for="int_status"><%= i18n.__('orders.integrations.fields.status') %></label>
					<select class="form-select rounded-0" id="int_status">
						<option value="active"><%= i18n.__('orders.integrations.status_opt.active') %></option>
						<option value="disabled"><%= i18n.__('orders.integrations.status_opt.disabled') %></option>
					</select>
				</div>
			</div>

			<div class="mb-3 d-none" data-field="default_status">
				<label class="form-label" for="int_default_status">Стартовий статус замовлення</label>
				<select class="form-select rounded-0" id="int_default_status"><option value="">— оберіть статус —</option></select>
				<small class="text-muted">Усі замовлення від цієї інтеграції створюються з цим статусом.</small>
			</div>

			<div class="row">
				<div class="col-6 col-md-4 mb-3">
					<label class="form-label"><%= i18n.__('orders.integrations.fields.color_background') %></label>
					<div class="pickr-color" data-target="int_color_background"></div>
					<input type="hidden" id="int_color_background" value="#607d8b" />
				</div>
				<div class="col-6 col-md-4 mb-3">
					<label class="form-label"><%= i18n.__('orders.integrations.fields.color_text') %></label>
					<div class="pickr-color" data-target="int_color_text"></div>
					<input type="hidden" id="int_color_text" value="#ffffff" />
				</div>
				<div class="col-12 col-md-4 mb-3">
					<label class="form-label"><%= i18n.__('orders.integrations.fields.preview') %></label>
					<div><span class="src-badge" id="int_preview">example</span></div>
				</div>
			</div>

			<div class="mb-3">
				<label class="form-label" for="int_note"><%= i18n.__('orders.integrations.fields.note') %></label>
				<input type="text" class="form-control rounded-0" id="int_note" maxlength="999" />
			</div>
		
				</div>
			</div>

			<!-- ═══ Підключення до сайту ═══ -->
			<div class="card border-primary rounded-0 mb-3" data-card>
				<div class="card-header text-bg-primary rounded-0"><%= i18n.__('orders.integrations.cards.connection') %></div>
				<div class="card-body">
			<div class="mb-3 d-none" data-field="base_url">
				<label class="form-label" for="int_base_url">Адреса сайту</label>
				<input type="url" class="form-control rounded-0" id="int_base_url" placeholder="https://shop.com" maxlength="255" />
			</div>

			<div class="mb-3 d-none" data-field="callback_url">
				<label class="form-label" for="int_callback_url">API endpoint модуля</label>
				<div class="input-group">
					<input type="url" class="form-control rounded-0 mono" id="int_callback_url" maxlength="512" />
					<button type="button" class="btn btn-outline-secondary rounded-0" id="btn_fill_callback" title="Заповнити з адреси сайту"><i class="fa-solid fa-wand-magic-sparkles"></i></button>
				</div>
				<small class="text-muted" id="int_callback_hint"></small>
			</div>

			<div class="mb-3 d-none" data-field="outbound_token">
				<label class="form-label" for="int_outbound_token">Ключ доступу CRM → сайт</label>
				<div class="input-group">
					<input type="text" class="form-control rounded-0 mono" id="int_outbound_token" maxlength="255" autocomplete="off" />
					<button type="button" class="btn btn-outline-secondary rounded-0" id="btn_gen_token" title="Згенерувати"><i class="fa-solid fa-rotate"></i></button>
					<button type="button" class="btn btn-outline-secondary rounded-0" id="btn_copy_token" title="Копіювати"><i class="fa-regular fa-copy"></i></button>
				</div>
				<small class="text-muted">Вставте цей ключ у налаштування модуля на сайті. Після зміни ключа оновіть його і там.</small>
			</div>

				</div>
			</div>

			<!-- ═══ Обмін замовленнями ═══ -->
			<div class="card border-primary rounded-0 mb-3" data-card>
				<div class="card-header text-bg-primary rounded-0"><%= i18n.__('orders.integrations.cards.orders') %></div>
				<div class="card-body">
			<div class="row d-none" data-cap="orders">
				<div class="col-12 col-md-6 mb-3">
					<div class="form-check">
						<input type="checkbox" class="form-check-input rounded-0" id="int_sync_orders_out" value="1" />
						<label class="form-check-label" for="int_sync_orders_out"><%= i18n.__('orders.integrations.fields.sync_orders_out') %></label>
					</div>
				</div>
				<div class="col-12 col-md-6 mb-3">
					<div class="form-check">
						<input type="checkbox" class="form-check-input rounded-0" id="int_sync_status_out" value="1" />
						<label class="form-check-label" for="int_sync_status_out"><%= i18n.__('orders.integrations.fields.sync_status_out') %></label>
					</div>
				</div>
			</div>

				</div>
			</div>

			<!-- ═══ Каталог: ціни, контент, залишки ═══ -->
			<div class="card border-primary rounded-0 mb-3" data-card>
				<div class="card-header text-bg-primary rounded-0"><%= i18n.__('orders.integrations.cards.catalog') %></div>
				<div class="card-body">
			<div class="mb-3 d-none" data-cap="catalog">
				<label class="form-label" for="int_assortment_mode"><%= i18n.__('orders.integrations.fields.assortment_mode') %></label>
				<select class="form-select rounded-0" id="int_assortment_mode">
					<option value="all"><%= i18n.__('orders.integrations.fields.assortment_all') %></option>
					<option value="selected"><%= i18n.__('orders.integrations.fields.assortment_selected') %></option>
				</select>
				<small class="text-muted"><%= i18n.__('orders.integrations.fields.assortment_hint') %></small>
			</div>

			<div class="mb-3 d-none" data-cap="catalog">
				<label class="form-label"><%= i18n.__('orders.integrations.fields.price_rule') %></label>
				<div class="row g-2">
					<div class="col-6 col-md-3">
						<select class="form-select rounded-0" id="int_pr_source" title="<%= i18n.__('orders.integrations.fields.pr_source') %>">
							<option value="price"><%= i18n.__('orders.integrations.fields.pr_source_price') %></option>
							<option value="wholesale_price"><%= i18n.__('orders.integrations.fields.pr_source_wholesale') %></option>
							<option value="compare_at_price"><%= i18n.__('orders.integrations.fields.pr_source_compare') %></option>
						</select>
					</div>
					<div class="col-6 col-md-3">
						<div class="input-group">
							<input type="number" step="0.01" min="-99" max="1000" class="form-control rounded-0" id="int_pr_percent" placeholder="0" title="<%= i18n.__('orders.integrations.fields.pr_percent') %>" />
							<span class="input-group-text rounded-0">%</span>
						</div>
					</div>
					<div class="col-6 col-md-3">
						<select class="form-select rounded-0" id="int_pr_round" title="<%= i18n.__('orders.integrations.fields.pr_round') %>">
							<option value="none"><%= i18n.__('orders.integrations.fields.pr_round_none') %></option>
							<option value="int"><%= i18n.__('orders.integrations.fields.pr_round_int') %></option>
							<option value="9"><%= i18n.__('orders.integrations.fields.pr_round_9') %></option>
							<option value="99"><%= i18n.__('orders.integrations.fields.pr_round_99') %></option>
							<option value="10"><%= i18n.__('orders.integrations.fields.pr_round_10') %></option>
						</select>
					</div>
					<div class="col-6 col-md-3">
						<div class="input-group">
							<input type="number" step="0.01" min="0" class="form-control rounded-0" id="int_pr_min_margin" placeholder="<%= i18n.__('orders.integrations.fields.pr_min_margin') %>" title="<%= i18n.__('orders.integrations.fields.pr_min_margin') %>" />
							<span class="input-group-text rounded-0">%</span>
						</div>
					</div>
					<div class="col-6 col-md-3">
						<input type="text" maxlength="3" class="form-control rounded-0 text-uppercase" id="int_pr_currency" placeholder="<%= i18n.__('orders.integrations.fields.pr_currency') %>" title="<%= i18n.__('orders.integrations.fields.pr_currency') %>" />
					</div>
					<div class="col-6 col-md-3">
						<div class="input-group">
							<span class="input-group-text rounded-0">×</span>
							<input type="number" step="0.000001" min="0" class="form-control rounded-0" id="int_pr_rate" placeholder="<%= i18n.__('orders.integrations.fields.pr_rate') %>" title="<%= i18n.__('orders.integrations.fields.pr_rate') %>" />
						</div>
					</div>
				</div>
				<small class="text-muted"><%= i18n.__('orders.integrations.fields.price_rule_hint') %></small>

				<label class="form-label mt-2"><%= i18n.__('orders.integrations.fields.pr_rules') %></label>
				<table class="table table-sm table-bordered align-middle small mb-1">
					<thead><tr><th><%= i18n.__('orders.integrations.fields.pr_r_brands') %></th><th><%= i18n.__('orders.integrations.fields.pr_r_categories') %></th><th style="width:110px"><%= i18n.__('orders.integrations.fields.pr_r_from') %></th><th style="width:110px"><%= i18n.__('orders.integrations.fields.pr_r_to') %></th><th style="width:100px">%</th><th style="width:40px"></th></tr></thead>
					<tbody id="int_pr_rules"></tbody>
				</table>
				<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="int_pr_rule_add"><i class="fa-solid fa-plus"></i> <%= i18n.__('orders.integrations.fields.pr_r_add') %></button>
				<div><small class="text-muted"><%= i18n.__('orders.integrations.fields.pr_rules_hint') %></small></div>
			</div>

			<div class="mb-3 d-none" data-cap="catalog">
				<label class="form-label"><%= i18n.__('orders.integrations.fields.content_rule') %></label>
				<ul class="nav nav-tabs small" role="tablist">
					<li class="nav-item"><button class="nav-link rounded-0 active py-1" type="button" data-bs-toggle="tab" data-bs-target="#int_ct_all"><%= i18n.__('orders.integrations.fields.ct_all_langs') %></button></li>
					<% contentLanguages.forEach((l) => { %>
					<li class="nav-item"><button class="nav-link rounded-0 py-1" type="button" data-bs-toggle="tab" data-bs-target="#int_ct_<%= l.iso %>"><%= String(l.iso).toUpperCase() %></button></li>
					<% }) %>
				</ul>
				<div class="tab-content border border-top-0 p-2" id="int_content">
					<% [{ code: '*', iso: 'all' }].concat(contentLanguages).forEach((l, i) => { %>
					<div class="tab-pane fade<%= i === 0 ? ' show active' : '' %>" id="int_ct_<%= l.iso %>" data-code="<%= l.code %>">
						<input type="text" class="form-control form-control-sm rounded-0 mb-1" data-ct="name" maxlength="255" placeholder="<%= i18n.__('orders.integrations.fields.ct_name') %>" />
						<textarea class="form-control form-control-sm rounded-0 mb-1" data-ct="description_before" rows="2" placeholder="<%= i18n.__('orders.integrations.fields.ct_before') %>"></textarea>
						<textarea class="form-control form-control-sm rounded-0" data-ct="description_after" rows="2" placeholder="<%= i18n.__('orders.integrations.fields.ct_after') %>"></textarea>
					</div>
					<% }) %>
				</div>
				<small class="text-muted"><%= i18n.__('orders.integrations.fields.content_rule_hint') %></small>
				<div class="input-group input-group-sm mt-2" style="max-width:520px">
					<span class="input-group-text rounded-0"><%= i18n.__('orders.integrations.fields.manual_edits') %></span>
					<select class="form-select rounded-0" id="int_manual_edits">
						<option value="highlight"><%= i18n.__('orders.integrations.fields.manual_highlight') %></option>
						<option value="overwrite"><%= i18n.__('orders.integrations.fields.manual_overwrite') %></option>
					</select>
				</div>
			</div>

			<div class="mb-3 d-none" data-cap="catalog">
				<label class="form-label"><%= i18n.__('orders.integrations.fields.stock_rule') %></label>
				<div class="row g-2 align-items-start">
					<div class="col-md-8">
						<div class="d-flex flex-wrap gap-3" id="int_stock_wh">
							<% warehouses.forEach((w) => { %>
							<div class="form-check">
								<input type="checkbox" class="form-check-input rounded-0" id="int_wh_<%= w.id %>" value="<%= w.id %>" />
								<label class="form-check-label" for="int_wh_<%= w.id %>"><%= w.code %><%= w.name ? ' — ' + w.name : '' %></label>
							</div>
							<% }) %>
						</div>
					</div>
					<div class="col-md-4">
						<div class="input-group">
							<span class="input-group-text rounded-0"><%= i18n.__('orders.integrations.fields.stock_buffer') %></span>
							<input type="number" min="0" step="1" class="form-control rounded-0" id="int_stock_buffer" placeholder="0" />
						</div>
					</div>
				</div>
				<small class="text-muted"><%= i18n.__('orders.integrations.fields.stock_rule_hint') %></small>
			</div>

			<div class="mb-3 d-none" data-cap="catalog">
				<label class="form-label"><%= i18n.__('orders.integrations.fields.required_fields') %></label>
				<div class="d-flex flex-wrap gap-3" id="int_required">
					<% requiredCodes.forEach((c) => { %>
					<div class="form-check">
						<input type="checkbox" class="form-check-input rounded-0" id="int_req_<%= c %>" value="<%= c %>" />
						<label class="form-check-label" for="int_req_<%= c %>"><%= i18n.__('catalog.quality.rule.' + c) %></label>
					</div>
					<% }) %>
				</div>
				<small class="text-muted"><%= i18n.__('orders.integrations.fields.required_fields_hint') %></small>
			</div>

			<div class="mb-3 d-none" data-cap="catalog">
				<label class="form-label" for="int_alert_emails"><%= i18n.__('orders.integrations.fields.alert_emails') %></label>
				<input type="text" class="form-control rounded-0" id="int_alert_emails" maxlength="500" placeholder="owner@example.com, manager@example.com" />
				<small class="text-muted"><%= i18n.__('orders.integrations.fields.alert_emails_hint') %></small>
			</div>

				</div>
			</div>

			<!-- ═══ Сповіщення ═══ -->
			<!-- ─── Сповіщення про замовлення сайту ─── -->
			<div class="card border-primary rounded-0 mb-3">
				<div class="card-header text-bg-primary rounded-0"><i class="fa-solid fa-bell me-1"></i><%= i18n.__('orders.integrations.notify.title') %></div>
				<div class="card-body">
					<div class="form-text mt-0 mb-2"><%= i18n.__('orders.integrations.notify.hint') %></div>
					<div class="row g-3">
						<div class="col-md-6">
							<label class="form-label small mb-1"><%= i18n.__('orders.integrations.notify.users') %></label>
							<div class="position-relative">
								<input type="text" class="form-control form-control-sm rounded-0" id="nt_user_search" autocomplete="off" placeholder="<%= i18n.__('orders.integrations.notify.users_ph') %>" />
								<div class="list-group position-absolute w-100 shadow-sm d-none" id="nt_user_results" style="z-index:1080;max-height:200px;overflow:auto"></div>
							</div>
							<div class="d-flex flex-wrap gap-1 mt-1" id="nt_users"></div>
						</div>
						<div class="col-md-6">
							<label class="form-label small mb-1"><%= i18n.__('orders.integrations.notify.groups') %></label>
							<select class="form-select form-select-sm rounded-0" id="nt_group_select"><option value=""><%= i18n.__('orders.integrations.notify.groups_ph') %></option></select>
							<div class="d-flex flex-wrap gap-1 mt-1" id="nt_groups"></div>
						</div>
						<div class="col-12">
							<div class="form-check"><input class="form-check-input" type="checkbox" id="nt_manager" /><label class="form-check-label" for="nt_manager"><%= i18n.__('orders.integrations.notify.manager') %></label></div>
							<div class="form-check"><input class="form-check-input" type="checkbox" id="nt_push" /><label class="form-check-label" for="nt_push"><%= i18n.__('orders.integrations.notify.push') %></label></div>
						</div>
						<div class="col-12">
							<label class="form-label small mb-1"><%= i18n.__('orders.integrations.notify.events') %></label>
							<div class="row g-1" id="nt_events">
								<% ['new', 'status', 'unassigned', 'paid', 'ttn', 'delivered', 'returned', 'refund', 'rma'].forEach(function (k) { %>
								<div class="col-md-6"><div class="form-check"><input class="form-check-input" type="checkbox" data-ev="<%= k %>" id="nt_ev_<%= k %>" /><label class="form-check-label" for="nt_ev_<%= k %>"><%= i18n.__('orders.integrations.notify.ev_' + k) %></label></div></div>
								<% }); %>
							</div>
						</div>
						<div class="col-md-6" id="nt_statuses_wrap">
							<label class="form-label small mb-1"><%= i18n.__('orders.integrations.notify.statuses') %></label>
							<div class="border p-2" id="nt_statuses" style="max-height:150px;overflow:auto"></div>
							<div class="form-text"><%= i18n.__('orders.integrations.notify.statuses_hint') %></div>
						</div>
						<div class="col-md-6">
							<label class="form-label small mb-1" for="nt_unassigned_min"><%= i18n.__('orders.integrations.notify.unassigned_min') %></label>
							<input type="number" min="5" max="1440" class="form-control form-control-sm rounded-0" id="nt_unassigned_min" value="15" style="max-width:120px" />
							<label class="form-label small mb-1 mt-2" for="nt_min_total"><%= i18n.__('orders.integrations.notify.min_total') %></label>
							<input type="number" min="0" step="0.01" class="form-control form-control-sm rounded-0" id="nt_min_total" style="max-width:160px" />
							<label class="form-label small mb-1 mt-2" for="nt_payment"><%= i18n.__('orders.integrations.notify.payment') %></label>
							<input type="text" maxlength="200" class="form-control form-control-sm rounded-0" id="nt_payment" placeholder="<%= i18n.__('orders.integrations.notify.payment_ph') %>" />
							<div class="form-check mt-2"><input class="form-check-input" type="checkbox" id="nt_first" /><label class="form-check-label" for="nt_first"><%= i18n.__('orders.integrations.notify.first_order') %></label></div>
						</div>
						<div class="col-12"><hr class="my-1" /></div>
						<div class="col-12">
							<div class="form-check"><input class="form-check-input" type="checkbox" id="nt_tg_enabled" /><label class="form-check-label fw-semibold" for="nt_tg_enabled"><i class="fa-brands fa-telegram me-1"></i><%= i18n.__('orders.integrations.notify.tg') %></label></div>
						</div>
						<div class="col-md-5"><label class="form-label small mb-1" for="nt_tg_token"><%= i18n.__('orders.integrations.notify.tg_token') %></label><input type="password" class="form-control form-control-sm rounded-0" id="nt_tg_token" autocomplete="new-password" placeholder="123456789:AA..." /><div class="form-text" id="nt_tg_token_hint"></div></div>
						<div class="col-md-4"><label class="form-label small mb-1" for="nt_tg_chat"><%= i18n.__('orders.integrations.notify.tg_chat') %></label><input type="text" class="form-control form-control-sm rounded-0" id="nt_tg_chat" placeholder="-1001234567890" /></div>
						<div class="col-md-3"><label class="form-label small mb-1" for="nt_tg_thread"><%= i18n.__('orders.integrations.notify.tg_thread') %></label><input type="number" min="1" class="form-control form-control-sm rounded-0" id="nt_tg_thread" /></div>
						<div class="col-12"><button type="button" class="btn btn-sm btn-outline-primary rounded-0" id="nt_tg_test"><i class="fa-brands fa-telegram"></i> <%= i18n.__('orders.integrations.notify.tg_test') %></button></div>
					</div>
				</div>
			</div>

			<div class="save-bar py-2 mb-3 d-flex gap-2">
				<button type="button" class="btn btn-primary rounded-0" id="btn_save_integration"><%= i18n.__('orders.integrations.modal.save') %></button>
				<a href="/settings/integrations/" class="btn btn-secondary rounded-0"><%= i18n.__('orders.integrations.modal.close') %></a>
				<% if (id) { %>
				<button type="button" class="btn btn-outline-primary rounded-0 d-none" id="btn_categories"><i class="fa-solid fa-sitemap me-1"></i><%= i18n.__('orders.integrations.categories.title') %></button>
				<button type="button" class="btn btn-outline-danger rounded-0 ms-auto" id="btn_delete_integration"><i class="fa-regular fa-trash-can me-1"></i><%= i18n.__('orders.integrations.delete_modal.delete') %></button>
				<% } %>
			</div>
		</div>
	</main>

