<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Bootstrap demo</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/css/bootstrap.min.css" rel="stylesheet" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
		<link href="/assets/css/login/style.css" rel="stylesheet" />
		<style>
			a {
				text-decoration: none;
			}

			.form-control:focus {
				box-shadow: none;
			}
		</style>
	</head>

	<body class="d-flex flex-column h-100 bg-body-tertiary">
		<div class="d-flex align-items-center justify-content-center vh-100">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-lg-5">
						<div class="form w-100" style="background: #fff; padding: 10px 15px">
							<div class="row mb-3">
								<div class="col-12">
									<p class="text-primary" style="font-size: 26px; font-weight: bold">Growth contour</p>
								</div>
							</div>
							<form id="reset_password_form">
								<div class="mb-3">
									<label for="email" class="form-label"> Email </label>
									<input id="email" name="email" type="text" class="form-control rounded-0" />
								</div>
								<button type="submit" class="btn btn-primary rounded-0 w-100"><%= i18n.__('reset_password.reset_password') %></button>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<footer>
			<div class="container-fluid bg-body-tertiary pt-3 pb-3">
				<div class="row">
					<div class="col-12 text-center">
						<p class="m-0">Growth contour <%= new Date().getFullYear()%></p>
					</div>
				</div>
			</div>
		</footer>
		<script src="https://unpkg.com/@popperjs/core@2"></script>
		<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.min.js"></script>
		<script src="/assets/js/notyf/notyf.min.js"></script>
		<script>
			const notyf = new Notyf({
				position: {
					x: "right",
					y: "top",
				},
				types: [
					{
						type: "success",
						dismissible: true,
						icon: false,
					},
					{
						type: "error",
						background: "indianred",
						dismissible: true,
						icon: false,
					},
				],
			});
		</script>
		<!-- i18n -->
		<script>
			$(document).ready(function () {
				$("#lang li a").on("click", function () {
					var a = {
						lang: $(this).attr("data-lang"),
					};
					console.log(a),
						$.ajax({
							type: "POST",
							url: "/lang",
							data: a,
							dataType: "json",
							success: function (a) {
								location.reload();
							},
							error: function (a) {},
						});
				});
			});
		</script>
		<!-- END i18n -->
		<script>
			$(document).ready(function () {
				$("form").submit(function (event) {
					$("#reset_password_form #email").removeClass("is-invalid");
					var data = {
						email: $("input[name=email]").val(),
						password: $("input[name=password]").val(),
					};

					$.ajax({
						type: "POST",
						url: "/api/administrator/reset-password/",
						data: data,
						dataType: "json",
						encode: true,
						success: function (data) {
							notyf.success("<%= i18n.__('reset_password.success.success') %>");
							$("input[name=email]").val("");
						},
						error: function (XHR) {
							const data = XHR.responseJSON || {}; // Парсимо JSON-відповідь
							if (data.status == "error") {
								notyf.error("<%= i18n.__('reset_password.error.please_fill_out_this_field') %>");
							}
							$.each(data.errors, function (index, item) {
								if (item.error == "email") {
									$('#reset_password_form input[name="email"]').addClass("is-invalid");
									$("#validation_reset_password_form_email").detach();
									$('#reset_password_form input[name="email"]').after('<div id="validation_reset_password_form_email" class="invalid-feedback"><%= i18n.__("reset_password.error.please_fill_out_this_field") %></div>');
								}
							});
						},
					});
					return false;
				});
			});
		</script>
	</body>
</html>
