<!DOCTYPE html>
<html lang="<%= i18n.__('lang_iso') %>">
<head>
	<%- include('../../partials/head'); %>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" />
	<style>
		.tabulator { font-size: 0.9rem; }
		.mailing-sub { font-size: 0.8rem; color: #6c757d; }
	</style>
	<title><%= i18n.__('mailing.ui.automations.title') %></title>
</head>
<body>
	<%- include('../../partials/header'); %>
	<% const canAdd = can('mailing.campaigns', 'edit'); %>
	<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
	<div class="breadcrumbs pt-3 pb-3">
		<div class="container-fluid">
			<div class="row align-items-center">
				<div class="col">
					<span><%= i18n.__('mailing.ui.contacts.title') %></span>
					<div>
						<ul class="list-inline mb-0">
							<li class="list-inline-item">
								<a href="/">
									<i class="fas fa-home"></i>
									<span><%= i18n.__('header.nav.home') %></span>
								</a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<a href="/mailing/"><%= i18n.__('header.nav.mailing') %></a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<%= i18n.__('mailing.ui.contacts.title') %>
							</li>
						</ul>
					</div>
				</div>
				<div class="col-auto">
					<a href="/mailing/" class="btn btn-primary rounded-0">
						<i class="fa-solid fa-angle-left"></i>
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-3 mb-4">
		<div class="card border-primary rounded-0">
			<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
				<span><%= i18n.__('mailing.ui.automations.title') %> <span class="badge text-bg-light rounded-0" id="total">0</span></span>
				<% if (canAdd) { %><button class="btn btn-light btn-sm rounded-0" id="btn-add"><i class="fa-solid fa-plus"></i> <%= i18n.__('mailing.ui.automations.add') %></button><% } %>
			</div>
			<div class="card-body">
				<div class="row g-2 mb-3">
					<div class="col-12 col-md-4"><input type="search" class="form-control rounded-0" id="f-search" placeholder="<%= i18n.__('mailing.ui.search') %>" maxlength="100" /></div>
					<div class="col-12 col-md-3">
						<select class="form-select rounded-0" id="f-status">
							<option value=""><%= i18n.__('mailing.ui.all') %></option>
							<% ['draft','active','paused'].forEach(function (s) { %><option value="<%= s %>"><%= i18n.__('mailing.ui.automations.status.' + s) %></option><% }) %>
						</select>
					</div>
				</div>
				<div id="auto-table"></div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="modal-add" tabindex="-1">
		<div class="modal-dialog">
			<form class="modal-content rounded-0" id="form-add">
				<div class="modal-header"><h5 class="modal-title"><%= i18n.__('mailing.ui.automations.add') %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
				<div class="modal-body row g-3">
					<div class="col-12"><label class="form-label"><%= i18n.__('mailing.ui.automations.name') %> *</label><input class="form-control rounded-0" name="name" maxlength="255" required /></div>
					<div class="col-12">
						<label class="form-label"><%= i18n.__('mailing.ui.automations.trigger') %></label>
						<select class="form-select rounded-0" name="trigger_type">
							<% ['list_subscribe','date_field','inactive','manual'].forEach(function (t) { %><option value="<%= t %>"><%= i18n.__('mailing.ui.automations.trigger_type.' + t) %></option><% }) %>
						</select>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('mailing.ui.cancel') %></button>
					<button type="submit" class="btn btn-primary rounded-0"><%= i18n.__('mailing.ui.automations.create') %></button>
				</div>
			</form>
		</div>
	</div>

	<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
	<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
	<script>
		var TR_STATUS = { draft: "<%= i18n.__('mailing.ui.automations.status.draft') %>", active: "<%= i18n.__('mailing.ui.automations.status.active') %>", paused: "<%= i18n.__('mailing.ui.automations.status.paused') %>" };
		var TR_TRIGGER = { list_subscribe: "<%= i18n.__('mailing.ui.automations.trigger_type.list_subscribe') %>", date_field: "<%= i18n.__('mailing.ui.automations.trigger_type.date_field') %>", inactive: "<%= i18n.__('mailing.ui.automations.trigger_type.inactive') %>", manual: "<%= i18n.__('mailing.ui.automations.trigger_type.manual') %>" };
		var notyf = new Notyf({
			position: { x: "right", y: "top" },
			duration: 4000,
			types: [
				{ type: "success", dismissible: true, icon: false },
				{ type: "error", background: "indianred", dismissible: true, icon: false },
			],
		});

		// Екранування для форматерів Tabulator
		function esc(v) {
			return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
				return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
			});
		}

		// Дата UTC з БД → локальний час браузера
		function fmtDate(v) {
			if (!v) return "";
			var d = new Date(String(v).replace(" ", "T") + "Z");
			if (isNaN(d)) return esc(v);
			var p = function (n) {
				return String(n).padStart(2, "0");
			};
			return p(d.getHours()) + ":" + p(d.getMinutes()) + " " + p(d.getDate()) + "." + p(d.getMonth() + 1) + "." + d.getFullYear();
		}

		// POST JSON → Promise(data). Помилка: notyf + reject(data)
		function api(url, payload) {
			return fetch(url, {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify(payload || {}),
			})
				.then(function (r) {
					return r
						.json()
						.catch(function () {
							return { ok: false, message: "<%= i18n.__('mailing.errors.server_error') %>" };
						})
						.then(function (d) {
							if (!r.ok || d.ok === false) return Promise.reject(d);
							return d;
						});
				})
				.catch(function (d) {
					if (d && d.message) notyf.error(d.message);
					else notyf.error("<%= i18n.__('mailing.errors.server_error') %>");
					return Promise.reject(d || {});
				});
		}

		// Помилки полів: {errors:[{field,message}]} → .is-invalid + .invalid-feedback (текст, не HTML)
		function clearErrors($form) {
			$form.find(".is-invalid").removeClass("is-invalid");
			$form.find(".invalid-feedback.js-err").remove();
		}

		function showErrors($form, d) {
			clearErrors($form);
			(d && d.errors ? d.errors : []).forEach(function (e) {
				var $el = $form.find('[name="' + String(e.field).replace(/"/g, "") + '"]').first();
				if (!$el.length) return;
				$el.addClass("is-invalid");
				$('<div class="invalid-feedback js-err"></div>').text(e.message).insertAfter($el);
			});
		}

		// Значення форми → об'єкт: data-type="int|bool|json" керує типом
		function formData($form) {
			var out = {};
			$form.find("[name]").each(function () {
				var $el = $(this);
				var name = $el.attr("name");
				var type = $el.data("type");
				if ($el.is(":disabled") && !$el.data("send-disabled")) return;
				var val;
				if ($el.is(":checkbox")) val = $el.is(":checked");
				else val = $el.val();
				if (type === "int") val = val === "" || val === null ? null : parseInt(val, 10);
				if (type === "nullable") val = val === "" ? null : val;
				out[name] = val;
			});
			return out;
		}

		// Спільні налаштування Tabulator (серверна пагінація/сортування)
		function gridOptions(url, extra) {
			return Object.assign(
				{
					layout: "fitColumns",
					ajaxURL: url,
					ajaxConfig: "POST",
					ajaxContentType: "json",
					pagination: true,
					paginationMode: "remote",
					sortMode: "remote",
					paginationSize: 20,
					paginationSizeSelector: [20, 50, 100],
					placeholder: "<%= i18n.__('mailing.ui.empty') %>",
					movableColumns: true,
				},
				extra || {}
			);
		}

		function badge(text, cls) {
			return '<span class="badge rounded-0 ' + (cls || "text-bg-secondary") + '">' + esc(text) + "</span>";
		}

		var STATUS_CLS = {
			active: "text-bg-success",
			subscribed: "text-bg-success",
			unsubscribed: "text-bg-secondary",
			pending: "text-bg-warning",
			bounced: "text-bg-danger",
			complained: "text-bg-danger",
			cleaned: "text-bg-dark",
			draft: "text-bg-secondary",
			scheduled: "text-bg-info",
			preparing: "text-bg-info",
			sending: "text-bg-primary",
			paused: "text-bg-warning",
			sent: "text-bg-success",
			cancelled: "text-bg-dark",
			failed: "text-bg-danger",
			uploaded: "text-bg-secondary",
			queued: "text-bg-info",
			processing: "text-bg-primary",
			done: "text-bg-success",
		};
	</script>
	<script>
		var AUTO_CLS = { draft: "text-bg-secondary", active: "text-bg-success", paused: "text-bg-warning" };

		var table = new Tabulator(
			"#auto-table",
			gridOptions("/api/mailing/automations/list", {
				ajaxParams: function () { return { search: $("#f-search").val(), status: $("#f-status").val() }; },
				sortMode: "local",
				ajaxResponse: function (u, p, res) {
					$("#total").text(res.last_row);
					return res;
				},
				columns: [
					{ title: "ID", field: "id", width: 70 },
					{
						title: "<%= i18n.__('mailing.ui.automations.name') %>",
						field: "name",
						formatter: function (c) {
							var d = c.getRow().getData();
							return '<a href="/mailing/automations/' + parseInt(d.id, 10) + '/">' + esc(d.name) + '</a><div class="mailing-sub">' + esc(TR_TRIGGER[d.trigger_type] || d.trigger_type) + "</div>";
						},
					},
					{ title: "<%= i18n.__('mailing.ui.status') %>", field: "status", width: 140, formatter: function (c) { return badge(TR_STATUS[c.getValue()] || c.getValue(), AUTO_CLS[c.getValue()]); } },
					{ title: "<%= i18n.__('mailing.ui.automations.steps') %>", field: "cnt_steps", hozAlign: "right", width: 100 },
					{ title: "<%= i18n.__('mailing.ui.automations.entered') %>", field: "cnt_entered", hozAlign: "right", width: 120 },
					{ title: "<%= i18n.__('mailing.ui.automations.in_progress') %>", field: "cnt_active", hozAlign: "right", width: 120 },
					{ title: "<%= i18n.__('mailing.ui.automations.sent') %>", field: "cnt_sent", hozAlign: "right", width: 120 },
					{ title: "<%= i18n.__('mailing.ui.automations.activated') %>", field: "date_activated", formatter: function (c) { return fmtDate(c.getValue()); } },
				],
			})
		);
		var timer;
		$("#f-search").on("input", function () {
			clearTimeout(timer);
			timer = setTimeout(function () { table.setData(); }, 400);
		});
		$("#f-status").on("change", function () { table.setData(); });

		var $fa = $("#form-add");
		var modal = new bootstrap.Modal("#modal-add");
		$("#btn-add").on("click", function () {
			clearErrors($fa);
			$fa[0].reset();
			modal.show();
		});
		$fa.on("submit", function (e) {
			e.preventDefault();
			var d = formData($fa);
			d.track_opens = true;
			d.track_clicks = true;
			api("/api/mailing/automations/save", d)
				.then(function (r) { window.location.href = "/mailing/automations/" + parseInt(r.id, 10) + "/"; })
				.catch(function (err) { showErrors($fa, err); });
		});
	</script>
</body>
</html>
