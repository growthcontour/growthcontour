<!DOCTYPE html>
<html lang="<%= i18n.__('lang_iso') %>">
<head>
	<%- include('../../partials/head'); %>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" />
	<style>
		.tabulator { font-size: 0.9rem; }
		.mailing-sub { font-size: 0.8rem; color: #6c757d; }
	</style>
	<title><%= i18n.__('mailing.ui.templates.title') %></title>
</head>
<body>
	<%- include('../../partials/header'); %>
	<% const canEdit = can('mailing.templates', 'edit'); const canDel = can('mailing.templates', 'delete'); %>

	<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
	<div class="breadcrumbs pt-3 pb-3">
		<div class="container-fluid">
			<div class="row align-items-center">
				<div class="col">
					<span><%= i18n.__('mailing.ui.templates.title') %></span>
					<div>
						<ul class="list-inline mb-0">
							<li class="list-inline-item">
								<a href="/">
									<i class="fas fa-home"></i>
									<span><%= i18n.__('header.nav.home') %></span>
								</a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<a href="/mailing/"><%= i18n.__('header.nav.mailing') %></a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<%= i18n.__('mailing.ui.templates.title') %>
							</li>
						</ul>
					</div>
				</div>
				<div class="col-auto">
					<a href="/mailing/" class="btn btn-primary rounded-0">
						<i class="fa-solid fa-angle-left"></i>
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-3 mb-4">
		<div class="card border-primary rounded-0">
			<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
				<span><%= i18n.__('mailing.ui.templates.title') %></span>
				<% if (canEdit) { %><button class="btn btn-light btn-sm rounded-0" id="btn-add"><i class="fa-solid fa-plus"></i> <%= i18n.__('mailing.ui.templates.add') %></button><% } %>
			</div>
			<div class="card-body">
				<div class="row g-2 mb-3"><div class="col-12 col-md-4"><input type="search" class="form-control rounded-0" id="f-search" placeholder="<%= i18n.__('mailing.ui.search') %>" maxlength="100" /></div></div>
				<div id="tpl-table"></div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="modal-tpl" tabindex="-1">
		<div class="modal-dialog">
			<form class="modal-content rounded-0" id="form-tpl">
				<div class="modal-header"><h5 class="modal-title"><%= i18n.__('mailing.ui.templates.modal_title') %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
				<div class="modal-body">
					<input type="hidden" name="id" data-type="int" />
					<label class="form-label"><%= i18n.__('mailing.ui.templates.name') %> *</label>
					<input class="form-control rounded-0" name="name" maxlength="255" required />
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('mailing.ui.cancel') %></button>
					<button type="submit" class="btn btn-primary rounded-0"><%= i18n.__('mailing.ui.save') %></button>
				</div>
			</form>
		</div>
	</div>

	<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
	<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
	<script>

		var notyf = new Notyf({
			position: { x: "right", y: "top" },
			duration: 4000,
			types: [
				{ type: "success", dismissible: true, icon: false },
				{ type: "error", background: "indianred", dismissible: true, icon: false },
			],
		});

		// Екранування для форматерів Tabulator
		function esc(v) {
			return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
				return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
			});
		}

		// Дата UTC з БД → локальний час браузера
		function fmtDate(v) {
			if (!v) return "";
			var d = new Date(String(v).replace(" ", "T") + "Z");
			if (isNaN(d)) return esc(v);
			var p = function (n) {
				return String(n).padStart(2, "0");
			};
			return p(d.getHours()) + ":" + p(d.getMinutes()) + " " + p(d.getDate()) + "." + p(d.getMonth() + 1) + "." + d.getFullYear();
		}

		// POST JSON → Promise(data). Помилка: notyf + reject(data)
		function api(url, payload) {
			return fetch(url, {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify(payload || {}),
			})
				.then(function (r) {
					return r
						.json()
						.catch(function () {
							return { ok: false, message: "<%= i18n.__('mailing.errors.server_error') %>" };
						})
						.then(function (d) {
							if (!r.ok || d.ok === false) return Promise.reject(d);
							return d;
						});
				})
				.catch(function (d) {
					if (d && d.message) notyf.error(d.message);
					else notyf.error("<%= i18n.__('mailing.errors.server_error') %>");
					return Promise.reject(d || {});
				});
		}

		// Помилки полів: {errors:[{field,message}]} → .is-invalid + .invalid-feedback (текст, не HTML)
		function clearErrors($form) {
			$form.find(".is-invalid").removeClass("is-invalid");
			$form.find(".invalid-feedback.js-err").remove();
		}

		function showErrors($form, d) {
			clearErrors($form);
			(d && d.errors ? d.errors : []).forEach(function (e) {
				var $el = $form.find('[name="' + String(e.field).replace(/"/g, "") + '"]').first();
				if (!$el.length) return;
				$el.addClass("is-invalid");
				$('<div class="invalid-feedback js-err"></div>').text(e.message).insertAfter($el);
			});
		}

		// Значення форми → об'єкт: data-type="int|bool|json" керує типом
		function formData($form) {
			var out = {};
			$form.find("[name]").each(function () {
				var $el = $(this);
				var name = $el.attr("name");
				var type = $el.data("type");
				if ($el.is(":disabled") && !$el.data("send-disabled")) return;
				var val;
				if ($el.is(":checkbox")) val = $el.is(":checked");
				else val = $el.val();
				if (type === "int") val = val === "" || val === null ? null : parseInt(val, 10);
				if (type === "nullable") val = val === "" ? null : val;
				out[name] = val;
			});
			return out;
		}

		// Спільні налаштування Tabulator (серверна пагінація/сортування)
		function gridOptions(url, extra) {
			return Object.assign(
				{
					layout: "fitColumns",
					ajaxURL: url,
					ajaxConfig: "POST",
					ajaxContentType: "json",
					pagination: true,
					paginationMode: "remote",
					sortMode: "remote",
					paginationSize: 20,
					paginationSizeSelector: [20, 50, 100],
					placeholder: "<%= i18n.__('mailing.ui.empty') %>",
					movableColumns: true,
				},
				extra || {}
			);
		}

		function badge(text, cls) {
			return '<span class="badge rounded-0 ' + (cls || "text-bg-secondary") + '">' + esc(text) + "</span>";
		}

		var STATUS_CLS = {
			active: "text-bg-success",
			subscribed: "text-bg-success",
			unsubscribed: "text-bg-secondary",
			pending: "text-bg-warning",
			bounced: "text-bg-danger",
			complained: "text-bg-danger",
			cleaned: "text-bg-dark",
			draft: "text-bg-secondary",
			scheduled: "text-bg-info",
			preparing: "text-bg-info",
			sending: "text-bg-primary",
			paused: "text-bg-warning",
			sent: "text-bg-success",
			cancelled: "text-bg-dark",
			failed: "text-bg-danger",
			uploaded: "text-bg-secondary",
			queued: "text-bg-info",
			processing: "text-bg-primary",
			done: "text-bg-success",
		};
	</script>
	<script>
		var CAN = { edit: <%- JSON.stringify(canEdit).replace(/</g, '\\u003c') %>, del: <%- JSON.stringify(canDel).replace(/</g, '\\u003c') %> };
		var LANGS = <%- JSON.stringify(languages.map(function (l) { return { id: l.id, name: l.name }; })).replace(/</g, '\\u003c') %>;

		var table = new Tabulator(
			"#tpl-table",
			gridOptions("/api/mailing/templates/list", {
				ajaxParams: function () { return { search: $("#f-search").val() }; },
				sortMode: "local",
				columns: [
					{ title: "ID", field: "id", width: 70 },
					{ title: "<%= i18n.__('mailing.ui.templates.name') %>", field: "name", formatter: function (c) { var d = c.getRow().getData(); return '<a href="/mailing/templates/' + parseInt(d.id, 10) + '/">' + esc(d.name) + "</a>"; } },
					{
						title: "<%= i18n.__('mailing.ui.templates.langs') %>",
						field: "langs",
						headerSort: false,
						formatter: function (c) {
							var ids = String(c.getValue() || "").split(",").filter(Boolean).map(Number);
							return LANGS.filter(function (l) { return ids.indexOf(l.id) >= 0; }).map(function (l) { return badge(l.name, "text-bg-light border"); }).join(" ");
						},
					},
					{ title: "<%= i18n.__('mailing.ui.templates.edited') %>", field: "date_edit", formatter: function (c) { var d = c.getRow().getData(); return fmtDate(d.date_edit || d.date_add); } },
					{
						title: "",
						field: "id",
						headerSort: false,
						width: 150,
						hozAlign: "right",
						formatter: function () {
							return (CAN.edit ? '<button class="btn btn-sm btn-outline-secondary rounded-0 js-rename"><i class="fa-solid fa-pen"></i></button> <button class="btn btn-sm btn-outline-secondary rounded-0 js-copy"><i class="fa-solid fa-copy"></i></button> ' : "") + (CAN.del ? '<button class="btn btn-sm btn-outline-danger rounded-0 js-del"><i class="fa-solid fa-trash"></i></button>' : "");
						},
						cellClick: function (e, cell) {
							var d = cell.getRow().getData();
							if (e.target.closest(".js-rename")) openTpl(d);
							if (e.target.closest(".js-copy")) api("/api/mailing/templates/" + d.id + "/copy").then(function () { notyf.success("<%= i18n.__('mailing.ui.saved') %>"); table.replaceData(); });
							if (e.target.closest(".js-del") && confirm("<%= i18n.__('mailing.ui.confirm_delete') %>")) api("/api/mailing/templates/" + d.id + "/delete").then(function () { notyf.success("<%= i18n.__('mailing.ui.deleted') %>"); table.replaceData(); });
						},
					},
				],
			})
		);
		var timer;
		$("#f-search").on("input", function () { clearTimeout(timer); timer = setTimeout(function () { table.setData(); }, 400); });

		var $ft = $("#form-tpl");
		var modal = new bootstrap.Modal("#modal-tpl");
		function openTpl(d) {
			clearErrors($ft);
			$ft[0].reset();
			$ft.find('[name="id"]').val(d ? d.id : "");
			$ft.find('[name="name"]').val(d ? d.name : "");
			modal.show();
		}
		$("#btn-add").on("click", function () { openTpl(null); });
		$ft.on("submit", function (e) {
			e.preventDefault();
			var d = formData($ft);
			api("/api/mailing/templates/save", d)
				.then(function (r) {
					modal.hide();
					if (!d.id) window.location.href = "/mailing/templates/" + parseInt(r.id, 10) + "/";
					else { notyf.success("<%= i18n.__('mailing.ui.saved') %>"); table.replaceData(); }
				})
				.catch(function (err) { showErrors($ft, err); });
		});
	</script>
</body>
</html>
