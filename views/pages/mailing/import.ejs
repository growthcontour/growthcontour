<!DOCTYPE html>
<html lang="<%= i18n.__('lang_iso') %>">
<head>
	<%- include('../../partials/head'); %>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" />
	<style>
		.tabulator { font-size: 0.9rem; }
		.mailing-sub { font-size: 0.8rem; color: #6c757d; }
	</style>
	<title><%= i18n.__('mailing.ui.import.title') %></title>
</head>
<body>
	<%- include('../../partials/header'); %>
	<% const canEdit = can('mailing.contacts', 'edit'); %>

	<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
	<div class="breadcrumbs pt-3 pb-3">
		<div class="container-fluid">
			<div class="row align-items-center">
				<div class="col">
					<span><%= i18n.__('mailing.ui.import.title') %></span>
					<div>
						<ul class="list-inline mb-0">
							<li class="list-inline-item">
								<a href="/">
									<i class="fas fa-home"></i>
									<span><%= i18n.__('header.nav.home') %></span>
								</a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<a href="/mailing/contacts/"><%= i18n.__('mailing.ui.contacts.title') %></a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<%= i18n.__('mailing.ui.import.title') %>
							</li>
						</ul>
					</div>
				</div>
				<div class="col-auto">
					<a href="/mailing/contacts/" class="btn btn-primary rounded-0">
						<i class="fa-solid fa-angle-left"></i>
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-3 mb-4">
		<% if (canEdit) { %>
		<!-- КРОК 1: ФАЙЛ -->
		<div class="card border-primary rounded-0 mb-3" id="step-upload">
			<div class="card-header text-bg-primary rounded-0">1. <%= i18n.__('mailing.ui.import.step_file') %></div>
			<form class="card-body row g-2 align-items-end" id="form-upload">
				<div class="col-12 col-md-6">
					<input type="file" class="form-control rounded-0" name="file" accept=".xlsx,.csv,.txt" required />
					<div class="form-text"><%= i18n.__('mailing.ui.import.file_hint') %></div>
				</div>
				<div class="col-12 col-md-3"><button type="submit" class="btn btn-primary rounded-0"><i class="fa-solid fa-upload"></i> <%= i18n.__('mailing.ui.import.upload') %></button></div>
			</form>
		</div>

		<!-- КРОК 2: МАПІНГ І ОПЦІЇ -->
		<div class="card border-primary rounded-0 mb-3 d-none" id="step-map">
			<div class="card-header text-bg-primary rounded-0">2. <%= i18n.__('mailing.ui.import.step_map') %> <span class="ms-2 mailing-sub text-white" id="file-name"></span></div>
			<div class="card-body">
				<div class="table-responsive mb-3" style="max-height: 420px">
					<table class="table table-sm table-bordered align-top mb-0" id="map-table"><thead></thead><tbody></tbody></table>
				</div>
				<div class="form-check mb-3"><input class="form-check-input" type="checkbox" id="o-header" /><label class="form-check-label" for="o-header"><%= i18n.__('mailing.ui.import.has_header') %></label></div>

				<form class="row g-3" id="form-start">
					<div class="col-12 col-lg-6">
						<label class="form-label"><%= i18n.__('mailing.ui.import.lists') %> *</label>
						<div id="o-lists" class="d-flex flex-wrap gap-3 border p-2"></div>
						<input type="hidden" name="lists" />
					</div>
					<div class="col-12 col-lg-6">
						<label class="form-label"><%= i18n.__('mailing.ui.import.consent_source') %> *</label>
						<input class="form-control rounded-0" name="consent_source" maxlength="255" required />
						<div class="form-text"><%= i18n.__('mailing.ui.import.consent_hint') %></div>
					</div>
					<div class="col-12 col-md-4">
						<label class="form-label"><%= i18n.__('mailing.ui.import.default_lang') %></label>
						<select class="form-select rounded-0" name="id_lang" data-type="int"><% languages.forEach(function (l) { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select>
					</div>
					<div class="col-12 col-md-8 d-flex flex-wrap gap-4 align-items-end">
						<div class="form-check"><input class="form-check-input" type="checkbox" name="update_existing" id="o-upd" /><label class="form-check-label" for="o-upd"><%= i18n.__('mailing.ui.import.update_existing') %></label></div>
						<div class="form-check"><input class="form-check-input" type="checkbox" name="check_mx" id="o-mx" checked /><label class="form-check-label" for="o-mx"><%= i18n.__('mailing.ui.import.check_mx') %></label></div>
						<div class="form-check"><input class="form-check-input" type="checkbox" name="skip_disposable" id="o-disp" checked /><label class="form-check-label" for="o-disp"><%= i18n.__('mailing.ui.import.skip_disposable') %></label></div>
						<div class="form-check"><input class="form-check-input" type="checkbox" name="skip_role" id="o-role" /><label class="form-check-label" for="o-role"><%= i18n.__('mailing.ui.import.skip_role') %></label></div>
					</div>
					<div class="col-12 d-flex gap-2">
						<button type="submit" class="btn btn-primary rounded-0"><i class="fa-solid fa-play"></i> <%= i18n.__('mailing.ui.import.start') %></button>
						<button type="button" class="btn btn-outline-secondary rounded-0" id="btn-discard"><%= i18n.__('mailing.ui.cancel') %></button>
					</div>
				</form>
			</div>
		</div>

		<!-- КРОК 3: ПРОГРЕС -->
		<div class="card border-primary rounded-0 mb-3 d-none" id="step-progress">
			<div class="card-header text-bg-primary rounded-0">3. <%= i18n.__('mailing.ui.import.step_progress') %></div>
			<div class="card-body">
				<div class="progress rounded-0 mb-2" style="height: 22px"><div class="progress-bar progress-bar-striped progress-bar-animated" id="p-bar" style="width: 100%"></div></div>
				<div id="p-info" class="mb-2"></div>
				<button class="btn btn-outline-danger btn-sm rounded-0" id="btn-cancel"><%= i18n.__('mailing.ui.import.cancel') %></button>
			</div>
		</div>
		<% } %>

		<div class="card rounded-0">
			<div class="card-header rounded-0"><%= i18n.__('mailing.ui.import.history') %></div>
			<div class="card-body"><div id="hist-table"></div></div>
		</div>
	</div>

	<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
	<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
	<script>
		var TR_ERRORS = { server_error: "<%= i18n.__('mailing.errors.server_error') %>", forbidden: "<%= i18n.__('mailing.errors.forbidden') %>", not_found: "<%= i18n.__('mailing.errors.not_found') %>", invalid_request: "<%= i18n.__('mailing.errors.invalid_request') %>", validation_error: "<%= i18n.__('mailing.errors.validation_error') %>", invalid_email: "<%= i18n.__('mailing.errors.invalid_email') %>", invalid_domain: "<%= i18n.__('mailing.errors.invalid_domain') %>", email_exists: "<%= i18n.__('mailing.errors.email_exists') %>", email_suppressed: "<%= i18n.__('mailing.errors.email_suppressed') %>", suppression_requires_consent: "<%= i18n.__('mailing.errors.suppression_requires_consent') %>", contact_not_found: "<%= i18n.__('mailing.errors.contact_not_found') %>", code_exists: "<%= i18n.__('mailing.errors.code_exists') %>", list_in_active_campaign: "<%= i18n.__('mailing.errors.list_in_active_campaign') %>", invalid_field_code: "<%= i18n.__('mailing.errors.invalid_field_code') %>", segment_bad_field: "<%= i18n.__('mailing.errors.segment_bad_field') %>", segment_bad_op: "<%= i18n.__('mailing.errors.segment_bad_op') %>", segment_bad_value: "<%= i18n.__('mailing.errors.segment_bad_value') %>", segment_too_deep: "<%= i18n.__('mailing.errors.segment_too_deep') %>", segment_too_many_rules: "<%= i18n.__('mailing.errors.segment_too_many_rules') %>", audience_no_lists: "<%= i18n.__('mailing.errors.audience_no_lists') %>", campaign_no_sender: "<%= i18n.__('mailing.errors.campaign_no_sender') %>", campaign_no_content: "<%= i18n.__('mailing.errors.campaign_no_content') %>", campaign_not_editable: "<%= i18n.__('mailing.errors.campaign_not_editable') %>", campaign_wrong_status: "<%= i18n.__('mailing.errors.campaign_wrong_status') %>", campaign_not_ready: "<%= i18n.__('mailing.errors.campaign_not_ready') %>", campaign_active: "<%= i18n.__('mailing.errors.campaign_active') %>", campaign_not_sent: "<%= i18n.__('mailing.errors.campaign_not_sent') %>", content_too_large: "<%= i18n.__('mailing.errors.content_too_large') %>", content_missing: "<%= i18n.__('mailing.errors.content_missing') %>", no_sender: "<%= i18n.__('mailing.errors.no_sender') %>", smtp_failed: "<%= i18n.__('mailing.errors.smtp_failed') %>", smtp_pass_required: "<%= i18n.__('mailing.errors.smtp_pass_required') %>", sender_in_active_campaign: "<%= i18n.__('mailing.errors.sender_in_active_campaign') %>", file_too_large: "<%= i18n.__('mailing.errors.file_too_large') %>", upload_failed: "<%= i18n.__('mailing.errors.upload_failed') %>", file_required: "<%= i18n.__('mailing.errors.file_required') %>", file_empty: "<%= i18n.__('mailing.errors.file_empty') %>", file_invalid: "<%= i18n.__('mailing.errors.file_invalid') %>", file_missing: "<%= i18n.__('mailing.errors.file_missing') %>", image_invalid: "<%= i18n.__('mailing.errors.image_invalid') %>", import_already_started: "<%= i18n.__('mailing.errors.import_already_started') %>", import_not_cancellable: "<%= i18n.__('mailing.errors.import_not_cancellable') %>", import_error: "<%= i18n.__('mailing.errors.import_error') %>" };
		var TR_IMPORT_STATUS = { uploaded: "<%= i18n.__('mailing.import.status.uploaded') %>", queued: "<%= i18n.__('mailing.import.status.queued') %>", processing: "<%= i18n.__('mailing.import.status.processing') %>", done: "<%= i18n.__('mailing.import.status.done') %>", failed: "<%= i18n.__('mailing.import.status.failed') %>", cancelled: "<%= i18n.__('mailing.import.status.cancelled') %>" };
		var TR_UI_IMPORT_TARGET = { email: "<%= i18n.__('mailing.ui.import.target.email') %>", first_name: "<%= i18n.__('mailing.ui.import.target.first_name') %>", last_name: "<%= i18n.__('mailing.ui.import.target.last_name') %>", lang: "<%= i18n.__('mailing.ui.import.target.lang') %>", timezone: "<%= i18n.__('mailing.ui.import.target.timezone') %>", country: "<%= i18n.__('mailing.ui.import.target.country') %>" };
		var notyf = new Notyf({
			position: { x: "right", y: "top" },
			duration: 4000,
			types: [
				{ type: "success", dismissible: true, icon: false },
				{ type: "error", background: "indianred", dismissible: true, icon: false },
			],
		});

		// Екранування для форматерів Tabulator
		function esc(v) {
			return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
				return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
			});
		}

		// Дата UTC з БД → локальний час браузера
		function fmtDate(v) {
			if (!v) return "";
			var d = new Date(String(v).replace(" ", "T") + "Z");
			if (isNaN(d)) return esc(v);
			var p = function (n) {
				return String(n).padStart(2, "0");
			};
			return p(d.getHours()) + ":" + p(d.getMinutes()) + " " + p(d.getDate()) + "." + p(d.getMonth() + 1) + "." + d.getFullYear();
		}

		// POST JSON → Promise(data). Помилка: notyf + reject(data)
		function api(url, payload) {
			return fetch(url, {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify(payload || {}),
			})
				.then(function (r) {
					return r
						.json()
						.catch(function () {
							return { ok: false, message: "<%= i18n.__('mailing.errors.server_error') %>" };
						})
						.then(function (d) {
							if (!r.ok || d.ok === false) return Promise.reject(d);
							return d;
						});
				})
				.catch(function (d) {
					if (d && d.message) notyf.error(d.message);
					else notyf.error("<%= i18n.__('mailing.errors.server_error') %>");
					return Promise.reject(d || {});
				});
		}

		// Помилки полів: {errors:[{field,message}]} → .is-invalid + .invalid-feedback (текст, не HTML)
		function clearErrors($form) {
			$form.find(".is-invalid").removeClass("is-invalid");
			$form.find(".invalid-feedback.js-err").remove();
		}

		function showErrors($form, d) {
			clearErrors($form);
			(d && d.errors ? d.errors : []).forEach(function (e) {
				var $el = $form.find('[name="' + String(e.field).replace(/"/g, "") + '"]').first();
				if (!$el.length) return;
				$el.addClass("is-invalid");
				$('<div class="invalid-feedback js-err"></div>').text(e.message).insertAfter($el);
			});
		}

		// Значення форми → об'єкт: data-type="int|bool|json" керує типом
		function formData($form) {
			var out = {};
			$form.find("[name]").each(function () {
				var $el = $(this);
				var name = $el.attr("name");
				var type = $el.data("type");
				if ($el.is(":disabled") && !$el.data("send-disabled")) return;
				var val;
				if ($el.is(":checkbox")) val = $el.is(":checked");
				else val = $el.val();
				if (type === "int") val = val === "" || val === null ? null : parseInt(val, 10);
				if (type === "nullable") val = val === "" ? null : val;
				out[name] = val;
			});
			return out;
		}

		// Спільні налаштування Tabulator (серверна пагінація/сортування)
		function gridOptions(url, extra) {
			return Object.assign(
				{
					layout: "fitColumns",
					ajaxURL: url,
					ajaxConfig: "POST",
					ajaxContentType: "json",
					pagination: true,
					paginationMode: "remote",
					sortMode: "remote",
					paginationSize: 20,
					paginationSizeSelector: [20, 50, 100],
					placeholder: "<%= i18n.__('mailing.ui.empty') %>",
					movableColumns: true,
				},
				extra || {}
			);
		}

		function badge(text, cls) {
			return '<span class="badge rounded-0 ' + (cls || "text-bg-secondary") + '">' + esc(text) + "</span>";
		}

		var STATUS_CLS = {
			active: "text-bg-success",
			subscribed: "text-bg-success",
			unsubscribed: "text-bg-secondary",
			pending: "text-bg-warning",
			bounced: "text-bg-danger",
			complained: "text-bg-danger",
			cleaned: "text-bg-dark",
			draft: "text-bg-secondary",
			scheduled: "text-bg-info",
			preparing: "text-bg-info",
			sending: "text-bg-primary",
			paused: "text-bg-warning",
			sent: "text-bg-success",
			cancelled: "text-bg-dark",
			failed: "text-bg-danger",
			uploaded: "text-bg-secondary",
			queued: "text-bg-info",
			processing: "text-bg-primary",
			done: "text-bg-success",
		};
	</script>
	<script>
		var CUR = null; // id поточного імпорту
		var FIELDS = [];
		var TARGETS = ["email", "first_name", "last_name", "lang", "timezone", "country"];

		var hist = new Tabulator(
			"#hist-table",
			gridOptions("/api/mailing/import/list", {
				sortMode: "local",
				columns: [
					{ title: "ID", field: "id", width: 70 },
					{ title: "<%= i18n.__('mailing.ui.import.file') %>", field: "file_name", formatter: function (c) { return esc(c.getValue()); } },
					{ title: "<%= i18n.__('mailing.ui.status') %>", field: "status", formatter: function (c) { var d = c.getRow().getData(); return badge(TR_IMPORT_STATUS[d.status], STATUS_CLS[d.status]) + (d.error_message ? '<div class="mailing-sub">' + esc(TR_ERRORS[d.error_message]) + "</div>" : ""); } },
					{ title: "<%= i18n.__('mailing.ui.import.created') %>", field: "cnt_created", hozAlign: "right" },
					{ title: "<%= i18n.__('mailing.ui.import.updated') %>", field: "cnt_updated", hozAlign: "right" },
					{ title: "<%= i18n.__('mailing.ui.import.skipped') %>", field: "cnt_skipped", hozAlign: "right" },
					{ title: "<%= i18n.__('mailing.ui.import.invalid') %>", field: "cnt_invalid", hozAlign: "right" },
					{ title: "<%= i18n.__('mailing.ui.import.suppressed') %>", field: "cnt_suppressed", hozAlign: "right" },
					{ title: "<%= i18n.__('mailing.ui.date') %>", field: "date_add", formatter: function (c) { return fmtDate(c.getValue()); } },
					{ title: "", field: "has_report", headerSort: false, formatter: function (c) { var d = c.getRow().getData(); return d.has_report ? '<a class="btn btn-sm btn-outline-secondary rounded-0" href="/mailing/import/' + parseInt(d.id, 10) + '/report/"><i class="fa-solid fa-download"></i> ' + esc("<%= i18n.__('mailing.ui.import.report') %>") + "</a>" : ""; } },
				],
			})
		);

		api("/api/mailing/lists/list").then(function (rows) {
			rows.filter(function (l) { return l.active; }).forEach(function (l) {
				var $c = $('<div class="form-check"></div>');
				$c.append($('<input class="form-check-input" type="checkbox">').attr("id", "ol" + l.id).val(l.id));
				$c.append($('<label class="form-check-label"></label>').attr("id", "").attr("for", "ol" + l.id).text(l.name));
				$("#o-lists").append($c);
			});
		});
		api("/api/mailing/fields/list").then(function (f) { FIELDS = f; });

		function targetSelect(col, guess) {
			var $s = $('<select class="form-select form-select-sm rounded-0 js-target"></select>').attr("data-col", col);
			$s.append($("<option>").val("skip").text("<%= i18n.__('mailing.ui.import.skip') %>"));
			TARGETS.forEach(function (tg) { $s.append($("<option>").val(tg).text(TR_UI_IMPORT_TARGET[tg])); });
			FIELDS.forEach(function (f) { $s.append($("<option>").val("field:" + f.code).text(f.name + " {{" + f.code + "}}")); });
			$s.append($("<option>").val("new").text("+ " + "<%= i18n.__('mailing.ui.import.new_field') %>"));
			$s.val(guess || "skip");
			return $s;
		}

		function newFieldInputs(col) {
			var $w = $('<div class="mt-1 d-none js-new"></div>').attr("data-col", col);
			$w.append($('<input class="form-control form-control-sm rounded-0 mb-1 js-new-code" maxlength="64" pattern="[a-z][a-z0-9_]*">').attr("placeholder", "<%= i18n.__('mailing.ui.fields.code') %>"));
			$w.append($('<input class="form-control form-control-sm rounded-0 js-new-name" maxlength="128">').attr("placeholder", "<%= i18n.__('mailing.ui.fields.name') %>"));
			return $w;
		}

		function renderPreview(p) {
			$("#file-name").text(p.file_name);
			$("#o-header").prop("checked", !!p.has_header);
			var $h = $("#map-table thead").empty();
			var $b = $("#map-table tbody").empty();
			var $tr = $("<tr></tr>");
			for (var c = 0; c < p.columns; c++) {
				var $th = $('<th style="min-width:180px"></th>');
				$th.append(targetSelect(c, c === p.email_column ? "email" : "skip"), newFieldInputs(c));
				$tr.append($th);
			}
			$h.append($tr);
			p.rows.forEach(function (row, i) {
				var $r = $("<tr></tr>").addClass(i === 0 ? "js-first" : "");
				for (var c = 0; c < p.columns; c++) $r.append($('<td class="small text-break"></td>').text(row[c] || ""));
				$b.append($r);
			});
			markHeader();
			$("#step-upload").addClass("d-none");
			$("#step-map").removeClass("d-none");
		}

		function markHeader() {
			$("#map-table tbody tr.js-first").toggleClass("table-secondary fw-semibold", $("#o-header").is(":checked"));
		}
		$("#o-header").on("change", markHeader);
		$("#map-table").on("change", ".js-target", function () {
			$('.js-new[data-col="' + $(this).data("col") + '"]').toggleClass("d-none", $(this).val() !== "new");
		});

		// ─── Завантаження ───
		$("#form-upload").on("submit", function (e) {
			e.preventDefault();
			var file = this.file.files[0];
			if (!file) return;
			if (file.size > 50 * 1024 * 1024) return notyf.error("<%= i18n.__('mailing.errors.file_too_large') %>");
			var fd = new FormData();
			fd.append("file", file);
			var $btn = $(this).find("button").prop("disabled", true);
			fetch("/api/mailing/import/upload", { method: "POST", body: fd, credentials: "same-origin", headers: { Accept: "application/json" } })
				.then(function (r) {
					return r.json().then(function (d) { return r.ok && d.ok !== false ? d : Promise.reject(d); });
				})
				.then(function (d) {
					CUR = d.id;
					return api("/api/mailing/import/" + CUR + "/preview");
				})
				.then(renderPreview)
				.catch(function (d) {
					notyf.error((d && d.message) || TR_ERRORS[((d && d.error) || "server_error")]);
				})
				.finally(function () { $btn.prop("disabled", false); });
		});

		$("#btn-discard").on("click", function () {
			if (CUR) api("/api/mailing/import/" + CUR + "/cancel").catch(function () {});
			resetFlow();
		});

		function resetFlow() {
			CUR = null;
			$("#form-upload")[0].reset();
			$("#step-map, #step-progress").addClass("d-none");
			$("#step-upload").removeClass("d-none");
			hist.setData();
		}

		// ─── Старт ───
		var $fs = $("#form-start");
		$fs.on("submit", function (e) {
			e.preventDefault();
			clearErrors($fs);
			var d = formData($fs);
			d.has_header = $("#o-header").is(":checked");
			d.lists = $("#o-lists input:checked").map(function () { return parseInt(this.value, 10); }).get();
			d.mapping = {};
			d.new_fields = {};
			$(".js-target").each(function () {
				var col = String($(this).data("col"));
				var v = $(this).val();
				if (v === "new") {
					var $n = $('.js-new[data-col="' + col + '"]');
					var code = $.trim($n.find(".js-new-code").val()).toLowerCase();
					d.new_fields[code] = { name: $.trim($n.find(".js-new-name").val()), type: "text" };
					d.mapping[col] = "field:" + code;
				} else d.mapping[col] = v;
			});
			api("/api/mailing/import/" + CUR + "/start", d)
				.then(function () {
					$("#step-map").addClass("d-none");
					$("#step-progress").removeClass("d-none");
					poll();
				})
				.catch(function (err) {
					showErrors($fs, err);
					(err.errors || []).forEach(function (x) {
						if (x.field === "lists") $("#o-lists").addClass("border-danger");
						if (String(x.field).indexOf("mapping") === 0) notyf.error(x.message);
					});
				});
		});

		// ─── Прогрес ───
		function poll() {
			if (!CUR) return;
			api("/api/mailing/import/" + CUR)
				.then(function (s) {
					$("#p-info").empty().append(
						$("<div>").text(TR_IMPORT_STATUS[s.status] + " · " + "<%= i18n.__('mailing.ui.import.rows') %>" + ": " + s.rows_processed),
						$("<div class='mailing-sub'>").text(
							"<%= i18n.__('mailing.ui.import.created') %>" + ": " + s.cnt_created + " · " + "<%= i18n.__('mailing.ui.import.updated') %>" + ": " + s.cnt_updated + " · " + "<%= i18n.__('mailing.ui.import.skipped') %>" + ": " + s.cnt_skipped + " · " + "<%= i18n.__('mailing.ui.import.invalid') %>" + ": " + s.cnt_invalid + " · " + "<%= i18n.__('mailing.ui.import.suppressed') %>" + ": " + s.cnt_suppressed
						)
					);
					if (["done", "failed", "cancelled"].indexOf(s.status) >= 0) {
						$("#p-bar").removeClass("progress-bar-animated").toggleClass("bg-success", s.status === "done").toggleClass("bg-danger", s.status !== "done");
						$("#btn-cancel").addClass("d-none");
						if (s.status === "done") notyf.success("<%= i18n.__('mailing.ui.import.finished') %>");
						if (s.has_report) $("#p-info").append($('<a class="btn btn-sm btn-outline-secondary rounded-0 mt-2">').attr("href", "/mailing/import/" + parseInt(s.id, 10) + "/report/").text("<%= i18n.__('mailing.ui.import.report') %>"));
						$("#p-info").append($('<button class="btn btn-sm btn-primary rounded-0 mt-2 ms-2">').text("<%= i18n.__('mailing.ui.import.new') %>").on("click", resetFlow));
						hist.setData();
						return;
					}
					setTimeout(poll, 2000);
				})
				.catch(function () { setTimeout(poll, 5000); });
		}

		$("#btn-cancel").on("click", function () {
			if (CUR && confirm("<%= i18n.__('mailing.ui.import.cancel_confirm') %>")) api("/api/mailing/import/" + CUR + "/cancel");
		});
	</script>
</body>
</html>
