	<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
	<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
	<script>
		var TR_SENDER_PROVIDER = { smtp: "<%= i18n.__('mailing.sender.provider.smtp') %>", gmail: "<%= i18n.__('mailing.sender.provider.gmail') %>" };
		var TR_UI_FIELDS_TYPES = { text: "<%= i18n.__('mailing.ui.fields.types.text') %>", number: "<%= i18n.__('mailing.ui.fields.types.number') %>", date: "<%= i18n.__('mailing.ui.fields.types.date') %>", bool: "<%= i18n.__('mailing.ui.fields.types.bool') %>" };
		var TR_UI_SUPP_REASON = { hard_bounce: "<%= i18n.__('mailing.ui.supp.reason.hard_bounce') %>", complaint: "<%= i18n.__('mailing.ui.supp.reason.complaint') %>", unsubscribe_all: "<%= i18n.__('mailing.ui.supp.reason.unsubscribe_all') %>", manual: "<%= i18n.__('mailing.ui.supp.reason.manual') %>", invalid: "<%= i18n.__('mailing.ui.supp.reason.invalid') %>" };
		var notyf = new Notyf({
			position: { x: "right", y: "top" },
			duration: 4000,
			types: [
				{ type: "success", dismissible: true, icon: false },
				{ type: "error", background: "indianred", dismissible: true, icon: false },
			],
		});

		// Екранування для форматерів Tabulator
		function esc(v) {
			return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
				return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
			});
		}

		// Дата UTC з БД → локальний час браузера
		function fmtDate(v) {
			if (!v) return "";
			var d = new Date(String(v).replace(" ", "T") + "Z");
			if (isNaN(d)) return esc(v);
			var p = function (n) {
				return String(n).padStart(2, "0");
			};
			return p(d.getHours()) + ":" + p(d.getMinutes()) + " " + p(d.getDate()) + "." + p(d.getMonth() + 1) + "." + d.getFullYear();
		}

		// POST JSON → Promise(data). Помилка: notyf + reject(data)
		function api(url, payload) {
			return fetch(url, {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify(payload || {}),
			})
				.then(function (r) {
					return r
						.json()
						.catch(function () {
							return { ok: false, message: "<%= i18n.__('mailing.errors.server_error') %>" };
						})
						.then(function (d) {
							if (!r.ok || d.ok === false) return Promise.reject(d);
							return d;
						});
				})
				.catch(function (d) {
					if (d && d.message) notyf.error(d.message);
					else notyf.error("<%= i18n.__('mailing.errors.server_error') %>");
					return Promise.reject(d || {});
				});
		}

		// Помилки полів: {errors:[{field,message}]} → .is-invalid + .invalid-feedback (текст, не HTML)
		function clearErrors($form) {
			$form.find(".is-invalid").removeClass("is-invalid");
			$form.find(".invalid-feedback.js-err").remove();
		}

		function showErrors($form, d) {
			clearErrors($form);
			(d && d.errors ? d.errors : []).forEach(function (e) {
				var $el = $form.find('[name="' + String(e.field).replace(/"/g, "") + '"]').first();
				if (!$el.length) return;
				$el.addClass("is-invalid");
				$('<div class="invalid-feedback js-err"></div>').text(e.message).insertAfter($el);
			});
		}

		// Значення форми → об'єкт: data-type="int|bool|json" керує типом
		function formData($form) {
			var out = {};
			$form.find("[name]").each(function () {
				var $el = $(this);
				var name = $el.attr("name");
				var type = $el.data("type");
				if ($el.is(":disabled") && !$el.data("send-disabled")) return;
				var val;
				if ($el.is(":checkbox")) val = $el.is(":checked");
				else val = $el.val();
				if (type === "int") val = val === "" || val === null ? null : parseInt(val, 10);
				if (type === "nullable") val = val === "" ? null : val;
				out[name] = val;
			});
			return out;
		}

		// Спільні налаштування Tabulator (серверна пагінація/сортування)
		function gridOptions(url, extra) {
			return Object.assign(
				{
					layout: "fitColumns",
					ajaxURL: url,
					ajaxConfig: "POST",
					ajaxContentType: "json",
					pagination: true,
					paginationMode: "remote",
					sortMode: "remote",
					paginationSize: 20,
					paginationSizeSelector: [20, 50, 100],
					placeholder: "<%= i18n.__('mailing.ui.empty') %>",
					movableColumns: true,
				},
				extra || {}
			);
		}

		function badge(text, cls) {
			return '<span class="badge rounded-0 ' + (cls || "text-bg-secondary") + '">' + esc(text) + "</span>";
		}

		var STATUS_CLS = {
			active: "text-bg-success",
			subscribed: "text-bg-success",
			unsubscribed: "text-bg-secondary",
			pending: "text-bg-warning",
			bounced: "text-bg-danger",
			complained: "text-bg-danger",
			cleaned: "text-bg-dark",
			draft: "text-bg-secondary",
			scheduled: "text-bg-info",
			preparing: "text-bg-info",
			sending: "text-bg-primary",
			paused: "text-bg-warning",
			sent: "text-bg-success",
			cancelled: "text-bg-dark",
			failed: "text-bg-danger",
			uploaded: "text-bg-secondary",
			queued: "text-bg-info",
			processing: "text-bg-primary",
			done: "text-bg-success",
		};
	</script>
	<script>
		var CAN = { edit: <%- JSON.stringify(canEdit).replace(/</g, '\\u003c') %>, contacts: <%- JSON.stringify(canContacts).replace(/</g, '\\u003c') %>, delContacts: <%- JSON.stringify(canDelContacts).replace(/</g, '\\u003c') %> };
		var LANGS = <%- JSON.stringify(languages.map(function (l) { return { id: l.id, name: l.name }; })).replace(/</g, '\\u003c') %>;
		var APP_BASE = <%- JSON.stringify((process.env.MAILING_PUBLIC_URL || process.env.APP_URL || '').replace(/\/+$/, '')).replace(/</g, '\\u003c') %>;

		// ═══ ВІДПРАВНИКИ ═══
		var sendersTable = new Tabulator("#senders-table", {
			layout: "fitColumns",
			ajaxURL: "/api/mailing/senders/list",
			ajaxConfig: "POST",
			ajaxContentType: "json",
			placeholder: "<%= i18n.__('mailing.ui.empty') %>",
			columns: [
				{ title: "ID", field: "id", width: 70 },
				{
					title: "<%= i18n.__('mailing.ui.senders.name') %>",
					field: "name",
					formatter: function (c) {
						var d = c.getRow().getData();
						return esc(d.name) + (d.is_default ? " " + badge("<%= i18n.__('mailing.ui.senders.default') %>", "text-bg-primary") : "") + '<div class="mailing-sub">' + esc(TR_SENDER_PROVIDER[(d.provider || "smtp")]) + "</div>";
					},
				},
				{
					title: "<%= i18n.__('mailing.ui.senders.from_email') %>",
					field: "from_email",
					formatter: function (c) {
						var d = c.getRow().getData();
						return esc(d.from_name) + '<div class="mailing-sub">' + esc(d.from_email) + "</div>";
					},
				},
				{
					title: "<%= i18n.__('mailing.ui.senders.limits') %>",
					field: "rate_per_minute",
					formatter: function (c) {
						var d = c.getRow().getData();
						return esc(d.rate_per_minute) + " / " + "<%= i18n.__('mailing.ui.senders.per_min') %>" + '<div class="mailing-sub">' + (d.daily_limit ? esc(d.daily_limit) + " / " + "<%= i18n.__('mailing.ui.senders.per_day') %>" : "∞") + "</div>";
					},
				},
				{
					title: "DNS",
					field: "dns_check",
					formatter: function (c) {
						var d = c.getValue();
						if (typeof d === "string") d = JSON.parse(d);
						if (!d) return '<span class="mailing-sub">—</span>';
						return ["spf", "dkim", "dmarc"]
							.map(function (k) {
								return badge(k.toUpperCase(), d[k] ? "text-bg-success" : "text-bg-danger");
							})
							.join(" ");
					},
				},
				{
					title: "<%= i18n.__('mailing.ui.status') %>",
					field: "active",
					width: 110,
					formatter: function (c) {
						return c.getValue() ? badge("<%= i18n.__('mailing.ui.active') %>", "text-bg-success") : badge("<%= i18n.__('mailing.ui.inactive') %>");
					},
				},
				{
					title: "",
					field: "id",
					headerSort: false,
					width: 150,
					hozAlign: "right",
					formatter: function () {
						return (
							'<button class="btn btn-sm btn-outline-primary rounded-0 js-test" title="' +
							esc("<%= i18n.__('mailing.ui.senders.test_title') %>") +
							'"><i class="fa-solid fa-paper-plane"></i></button> ' +
							(CAN.edit
								? '<button class="btn btn-sm btn-outline-secondary rounded-0 js-edit"><i class="fa-solid fa-pen"></i></button> <button class="btn btn-sm btn-outline-danger rounded-0 js-del"><i class="fa-solid fa-trash"></i></button>'
								: "")
						);
					},
					cellClick: function (e, cell) {
						var id = cell.getRow().getData().id;
						if (e.target.closest(".js-test")) openTest(id);
						if (e.target.closest(".js-edit")) openSender(id);
						if (e.target.closest(".js-del") && confirm("<%= i18n.__('mailing.ui.confirm_delete') %>")) {
							api("/api/mailing/senders/" + id + "/delete").then(function () {
								notyf.success("<%= i18n.__('mailing.ui.deleted') %>");
								sendersTable.replaceData();
							});
						}
					},
				},
			],
		});

		var $fs = $("#form-sender");
		var senderModal = new bootstrap.Modal("#modal-sender");

		function toggleProvider() {
			var gmail = $fs.find('[name="provider"]:checked').val() === "gmail";
			$fs.find(".gmail-only").toggleClass("d-none", !gmail);
			$fs.find(".smtp-only").toggleClass("d-none", gmail);
		}
		$fs.on("change", '[name="provider"]', function () {
			toggleProvider();
			// Безпечні ліміти Gmail за замовчуванням
			if ($(this).val() === "gmail") {
				$fs.find('[name="rate_per_minute"]').val(20);
				if (!parseInt($fs.find('[name="daily_limit"]').val(), 10)) $fs.find('[name="daily_limit"]').val(450);
			}
		});

		function openSender(id) {
			clearErrors($fs);
			$fs[0].reset();
			$fs.find('[name="id"]').val("");
			$fs.find(".pass-keep").addClass("d-none");
			toggleProvider();
			if (!id) return senderModal.show();
			api("/api/mailing/senders/" + id).then(function (s) {
				Object.keys(s).forEach(function (k) {
					var $el = $fs.find('[name="' + k + '"]');
					if (!$el.length || $el.is(":radio")) return;
					if ($el.is(":checkbox")) $el.prop("checked", !!s[k]);
					else $el.val(s[k] == null ? "" : k === "warmup_start" ? String(s[k]).slice(0, 10) : s[k]);
				});
				$fs.find('[name="provider"][value="' + (s.provider === "gmail" ? "gmail" : "smtp") + '"]').prop("checked", true);
				$fs.find(".pass-keep").removeClass("d-none");
				toggleProvider();
				senderModal.show();
			});
		}

		$("#btn-sender-add").on("click", function () {
			openSender(null);
		});

		$fs.on("submit", function (e) {
			e.preventDefault();
			var d = formData($fs);
			d.provider = $fs.find('[name="provider"]:checked').val();
			if (d.provider === "gmail") d.smtp_pass = d.gmail_pass;
			delete d.gmail_pass;
			["smtp_pass", "imap_pass"].forEach(function (k) {
				if (!d[k]) delete d[k]; // порожній пароль = не змінювати
			});
			["reply_to", "bounce_address", "company_address", "dkim_selector", "imap_host", "imap_user", "smtp_host", "smtp_user"].forEach(function (k) {
				if (d[k] === "") d[k] = null;
			});
			api("/api/mailing/senders/save", d)
				.then(function () {
					notyf.success("<%= i18n.__('mailing.ui.saved') %>");
					senderModal.hide();
					sendersTable.replaceData();
				})
				.catch(function (err) {
					if (d.provider === "gmail" && err.errors) err.errors.forEach(function (x) { if (x.field === "smtp_pass") x.field = "gmail_pass"; });
					showErrors($fs, err);
				});
		});

		var $ft = $("#form-test");
		var testModal = new bootstrap.Modal("#modal-test");
		function openTest(id) {
			$ft[0].reset();
			$ft.find('[name="id"]').val(id);
			$("#dns-result").addClass("d-none").empty();
			testModal.show();
		}
		$ft.on("submit", function (e) {
			e.preventDefault();
			var $btn = $ft.find('[type="submit"]').prop("disabled", true);
			api("/api/mailing/senders/" + parseInt($ft.find('[name="id"]').val(), 10) + "/test", { to: $ft.find('[name="to"]').val() || null })
				.then(function () {
					notyf.success("<%= i18n.__('mailing.ui.senders.test_ok') %>");
				})
				.catch(function (d) {
					if (d && d.detail) notyf.error(d.detail);
				})
				.finally(function () {
					$btn.prop("disabled", false);
				});
		});
		$("#btn-dns").on("click", function () {
			var id = parseInt($ft.find('[name="id"]').val(), 10);
			var $b = $(this).prop("disabled", true);
			api("/api/mailing/senders/" + id + "/dns")
				.then(function (r) {
					var $box = $("#dns-result").removeClass("d-none").empty();
					[
						["SPF", r.spf, r.spf_includes_smtp],
						["DKIM", r.dkim_selector, r.dkim],
						["DMARC", r.dmarc, !!r.dmarc],
						["MX", r.mx ? "OK" : "", r.mx],
					].forEach(function (row) {
						var $line = $('<div class="d-flex gap-2 align-items-start mb-1"></div>');
						$line.append($(badge(row[0], row[2] ? "text-bg-success" : "text-bg-danger")));
						$line.append($('<code class="small text-break"></code>').text(row[1] || "<%= i18n.__('mailing.ui.senders.not_found') %>"));
						$box.append($line);
					});
					sendersTable.replaceData();
				})
				.finally(function () {
					$b.prop("disabled", false);
				});
		});

		// ═══ СПИСКИ ═══
		var listsCache = [];
		var listsTable = new Tabulator("#lists-table", {
			layout: "fitColumns",
			ajaxURL: "/api/mailing/lists/list",
			ajaxConfig: "POST",
			ajaxContentType: "json",
			placeholder: "<%= i18n.__('mailing.ui.empty') %>",
			ajaxResponse: function (url, params, res) {
				listsCache = res;
				fillListSelects();
				return res;
			},
			columns: [
				{ title: "ID", field: "id", width: 70 },
				{
					title: "<%= i18n.__('mailing.ui.lists.name') %>",
					field: "name",
					formatter: function (c) {
						var d = c.getRow().getData();
						return esc(d.name) + '<div class="mailing-sub"><code>' + esc(d.code) + "</code></div>";
					},
				},
				{ title: "<%= i18n.__('mailing.ui.lists.subscribed') %>", field: "cnt_subscribed", hozAlign: "right" },
				{ title: "<%= i18n.__('mailing.ui.lists.pending') %>", field: "cnt_pending", hozAlign: "right" },
				{ title: "<%= i18n.__('mailing.ui.lists.unsubscribed') %>", field: "cnt_unsubscribed", hozAlign: "right" },
				{
					title: "",
					field: "is_public",
					formatter: function (c) {
						var d = c.getRow().getData();
						return (d.is_public ? badge("<%= i18n.__('mailing.ui.lists.public') %>", "text-bg-info") + " " : "") + (d.double_optin ? badge("Double opt-in", "text-bg-light border") + " " : "") + (d.active ? "" : badge("<%= i18n.__('mailing.ui.inactive') %>"));
					},
				},
				{
					title: "",
					field: "id",
					headerSort: false,
					width: 110,
					hozAlign: "right",
					formatter: function () {
						return (CAN.contacts ? '<button class="btn btn-sm btn-outline-secondary rounded-0 js-edit"><i class="fa-solid fa-pen"></i></button> ' : "") + (CAN.delContacts ? '<button class="btn btn-sm btn-outline-danger rounded-0 js-del"><i class="fa-solid fa-trash"></i></button>' : "");
					},
					cellClick: function (e, cell) {
						var id = cell.getRow().getData().id;
						if (e.target.closest(".js-edit")) openList(id);
						if (e.target.closest(".js-del") && confirm("<%= i18n.__('mailing.ui.confirm_delete') %>")) {
							api("/api/mailing/lists/" + id + "/delete").then(function () {
								notyf.success("<%= i18n.__('mailing.ui.deleted') %>");
								listsTable.replaceData();
							});
						}
					},
				},
			],
		});

		function fillListSelects() {
			var $s = $("#sync-list");
			var cur = $s.val();
			$s.empty().append($("<option>").val("").text("—"));
			listsCache.forEach(function (l) {
				$s.append($("<option>").val(l.id).text(l.name));
			});
			if (cur) $s.val(cur);
			// Приклад форми підписки на сайт (тільки текст — без вставки як HTML)
			var pub = listsCache.filter(function (l) { return l.is_public && l.active; })[0];
			var code = pub ? pub.code : "news";
			$("#form-snippet").text(
				'<form method="post" action="' + APP_BASE + '/api/mailing/subscribe">\n' +
				'  <input type="email" name="email" required>\n' +
				'  <input type="text" name="first_name">\n' +
				'  <input type="hidden" name="lists" value="' + code + '">\n' +
				'  <input type="hidden" name="lang" value="<%= i18n.__('lang_iso') %>">\n' +
				'  <input type="hidden" name="return_url" value="https://site.com/thanks">\n' +
				'  <div style="position:absolute;left:-9999px" aria-hidden="true"><input type="text" name="website" tabindex="-1" autocomplete="off"></div>\n' +
				'  <label><input type="checkbox" name="consent" value="1" required> …</label>\n' +
				"  <button>…</button>\n</form>"
			);
		}

		var $fl = $("#form-list");
		var listModal = new bootstrap.Modal("#modal-list");
		function openList(id) {
			clearErrors($fl);
			$fl[0].reset();
			$fl.find('[name="id"]').val("");
			$fl.find(".lang-name, .lang-desc").val("");
			if (!id) return listModal.show();
			api("/api/mailing/lists/" + id).then(function (l) {
				$fl.find('[name="id"]').val(l.id);
				$fl.find('[name="code"]').val(l.code);
				$fl.find('[name="sort_order"]').val(l.sort_order);
				$fl.find('[name="is_public"]').prop("checked", !!l.is_public);
				$fl.find('[name="double_optin"]').prop("checked", !!l.double_optin);
				$fl.find('[name="active"]').prop("checked", !!l.active);
				Object.keys(l.lang || {}).forEach(function (idl) {
					var $b = $fl.find('.lang-block[data-id-lang="' + parseInt(idl, 10) + '"]');
					$b.find(".lang-name").val(l.lang[idl].name || "");
					$b.find(".lang-desc").val(l.lang[idl].description || "");
				});
				listModal.show();
			});
		}
		$("#btn-list-add").on("click", function () {
			openList(null);
		});
		$fl.on("submit", function (e) {
			e.preventDefault();
			var d = formData($fl);
			d.lang = {};
			$fl.find(".lang-block").each(function () {
				var $b = $(this);
				var name = $.trim($b.find(".lang-name").val());
				if (name) d.lang[$b.data("id-lang")] = { name: name, description: $.trim($b.find(".lang-desc").val()) || null };
			});
			api("/api/mailing/lists/save", d)
				.then(function () {
					notyf.success("<%= i18n.__('mailing.ui.saved') %>");
					listModal.hide();
					listsTable.replaceData();
				})
				.catch(function (err) {
					showErrors($fl, err);
				});
		});

		// ═══ ПОЛЯ ═══
		var fieldsTable = new Tabulator("#fields-table", {
			layout: "fitColumns",
			ajaxURL: "/api/mailing/fields/list",
			ajaxConfig: "POST",
			ajaxContentType: "json",
			placeholder: "<%= i18n.__('mailing.ui.empty') %>",
			columns: [
				{ title: "<%= i18n.__('mailing.ui.fields.name') %>", field: "name" },
				{
					title: "<%= i18n.__('mailing.ui.fields.tag') %>",
					field: "code",
					formatter: function (c) {
						return "<code>{{" + esc(c.getValue()) + "}}</code>";
					},
				},
				{
					title: "<%= i18n.__('mailing.ui.fields.type') %>",
					field: "type",
					formatter: function (c) {
						return esc(TR_UI_FIELDS_TYPES[c.getValue()]);
					},
				},
				{
					title: "",
					field: "id",
					headerSort: false,
					width: 70,
					hozAlign: "right",
					formatter: function () {
						return CAN.delContacts ? '<button class="btn btn-sm btn-outline-danger rounded-0 js-del"><i class="fa-solid fa-trash"></i></button>' : "";
					},
					cellClick: function (e, cell) {
						if (e.target.closest(".js-del") && confirm("<%= i18n.__('mailing.ui.confirm_delete') %>")) {
							api("/api/mailing/fields/" + cell.getRow().getData().id + "/delete").then(function () {
								notyf.success("<%= i18n.__('mailing.ui.deleted') %>");
								fieldsTable.replaceData();
							});
						}
					},
				},
			],
		});
		var $ff = $("#form-field");
		var fieldModal = new bootstrap.Modal("#modal-field");
		$("#btn-field-add").on("click", function () {
			clearErrors($ff);
			$ff[0].reset();
			fieldModal.show();
		});
		$ff.on("submit", function (e) {
			e.preventDefault();
			api("/api/mailing/fields/save", formData($ff))
				.then(function () {
					notyf.success("<%= i18n.__('mailing.ui.saved') %>");
					fieldModal.hide();
					fieldsTable.replaceData();
				})
				.catch(function (err) {
					showErrors($ff, err);
				});
		});

		// ═══ СТОП-ЛИСТ ═══
		function suppFilters() {
			return { search: $("#supp-search").val(), status: $("#supp-reason").val() };
		}
		var suppTable = new Tabulator(
			"#supp-table",
			gridOptions("/api/mailing/suppressions/list", {
				ajaxParams: suppFilters,
				columns: [
					{ title: "<%= i18n.__('mailing.ui.supp.value') %>", field: "value", formatter: function (c) { var d = c.getRow().getData(); return esc(d.value) + (d.type === "domain" ? " " + badge("<%= i18n.__('mailing.ui.supp.domain') %>", "text-bg-light border") : ""); } },
					{ title: "<%= i18n.__('mailing.ui.supp.reason_title') %>", field: "reason", formatter: function (c) { return badge(TR_UI_SUPP_REASON[c.getValue()], c.getValue() === "manual" ? "text-bg-secondary" : "text-bg-danger"); } },
					{ title: "<%= i18n.__('mailing.ui.note') %>", field: "note", headerSort: false, formatter: function (c) { return esc(c.getValue()); } },
					{ title: "<%= i18n.__('mailing.ui.date') %>", field: "date_add", formatter: function (c) { return fmtDate(c.getValue()); } },
					{
						title: "",
						field: "id",
						headerSort: false,
						width: 70,
						hozAlign: "right",
						formatter: function (c) {
							var r = c.getRow().getData().reason;
							// Відписку і скаргу зняти не можна (лише сама людина підписується знову)
							return CAN.delContacts && r !== "unsubscribe_all" && r !== "complaint" ? '<button class="btn btn-sm btn-outline-secondary rounded-0 js-del" title="' + esc("<%= i18n.__('mailing.ui.supp.remove') %>") + '"><i class="fa-solid fa-rotate-left"></i></button>' : "";
						},
						cellClick: function (e, cell) {
							if (e.target.closest(".js-del") && confirm("<%= i18n.__('mailing.ui.supp.remove_confirm') %>")) {
								api("/api/mailing/suppressions/" + cell.getRow().getData().id + "/delete").then(function () {
									notyf.success("<%= i18n.__('mailing.ui.saved') %>");
									suppTable.replaceData();
								});
							}
						},
					},
				],
			})
		);
		var suppTimer;
		$("#supp-search").on("input", function () {
			clearTimeout(suppTimer);
			suppTimer = setTimeout(function () { suppTable.setData(); }, 400);
		});
		$("#supp-reason").on("change", function () { suppTable.setData(); });

		var $fsu = $("#form-supp");
		var suppModal = new bootstrap.Modal("#modal-supp");
		$("#btn-supp-add").on("click", function () {
			clearErrors($fsu);
			$fsu[0].reset();
			suppModal.show();
		});
		$fsu.on("submit", function (e) {
			e.preventDefault();
			var d = formData($fsu);
			if (!d.note) d.note = null;
			api("/api/mailing/suppressions/add", d)
				.then(function () {
					notyf.success("<%= i18n.__('mailing.ui.saved') %>");
					suppModal.hide();
					suppTable.replaceData();
				})
				.catch(function (err) {
					showErrors($fsu, err);
				});
		});

		// ═══ ЗАГАЛЬНІ ═══
		var $fg = $("#form-general");
		try {
			(Intl.supportedValuesOf ? Intl.supportedValuesOf("timeZone") : []).forEach(function (z) {
				$("#tz-list").append($("<option>").val(z));
			});
		} catch (e) {}
		api("/api/mailing/settings/").then(function (s) {
			$fg.find('[name="default_timezone"]').val(s.default_timezone);
			$fg.find('[name="default_id_lang"]').val(s.default_id_lang);
			$fg.find('[name="cap_count"]').val(s.frequency_cap.count);
			$fg.find('[name="cap_days"]').val(s.frequency_cap.days);
			$fg.find('[name="soft_bounce_limit"]').val(s.soft_bounce_limit);
			$fg.find('[name="double_optin_ttl_days"]').val(s.double_optin_ttl_days);
			$fg.find('[name="sunset_days"]').val(s.sunset_days);
			$fg.find('[name="sync_enabled"]').prop("checked", !!(s.clients_sync && s.clients_sync.enabled));
			$("#sync-list").data("pending", s.clients_sync && s.clients_sync.id_list);
			var wait = setInterval(function () {
				if (!listsCache.length && $("#sync-list option").length < 2) return;
				clearInterval(wait);
				if ($("#sync-list").data("pending")) $("#sync-list").val($("#sync-list").data("pending"));
			}, 200);
			setTimeout(function () { clearInterval(wait); }, 10000);
		});
		$fg.on("submit", function (e) {
			e.preventDefault();
			var f = formData($fg);
			var payload = {
				default_timezone: f.default_timezone,
				default_id_lang: f.default_id_lang,
				frequency_cap: { count: f.cap_count || 0, days: f.cap_days || 7 },
				soft_bounce_limit: f.soft_bounce_limit,
				double_optin_ttl_days: f.double_optin_ttl_days,
				sunset_days: f.sunset_days || 0,
				clients_sync: { enabled: f.sync_enabled, id_list: f.sync_id_list || null },
			};
			api("/api/mailing/settings/save", payload)
				.then(function () {
					notyf.success("<%= i18n.__('mailing.ui.saved') %>");
				})
				.catch(function (err) {
					showErrors($fg, err);
				});
		});
	</script>
</body>
</html>
