<!DOCTYPE html>
<html lang="<%= i18n.__('lang_iso') %>">
<head>
	<%- include('../../partials/head'); %>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" />
	<style>
		.tabulator { font-size: 0.9rem; }
		.mailing-sub { font-size: 0.8rem; color: #6c757d; }
	</style>
	<title><%= i18n.__('mailing.ui.settings.title') %></title>
</head>
<body>
	<%- include('../../partials/header'); %>
	<% const canEdit = can('mailing.settings', 'edit'); const canContacts = can('mailing.contacts', 'edit'); const canDelContacts = can('mailing.contacts', 'delete'); %>

	<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
	<div class="breadcrumbs pt-3 pb-3">
		<div class="container-fluid">
			<div class="row align-items-center">
				<div class="col">
					<span><%= i18n.__('mailing.ui.settings.title') %></span>
					<div>
						<ul class="list-inline mb-0">
							<li class="list-inline-item">
								<a href="/">
									<i class="fas fa-home"></i>
									<span><%= i18n.__('header.nav.home') %></span>
								</a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<a href="/mailing/"><%= i18n.__('header.nav.mailing') %></a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<%= i18n.__('mailing.ui.settings.title') %>
							</li>
						</ul>
					</div>
				</div>
				<div class="col-auto">
					<a href="/mailing/" class="btn btn-primary rounded-0">
						<i class="fa-solid fa-angle-left"></i>
					</a>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-3 mb-4">
		<ul class="nav nav-tabs" role="tablist">
			<li class="nav-item"><button class="nav-link active rounded-0" data-bs-toggle="tab" data-bs-target="#tab-senders" type="button"><%= i18n.__('mailing.ui.settings.tab_senders') %></button></li>
			<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#tab-lists" type="button"><%= i18n.__('mailing.ui.settings.tab_lists') %></button></li>
			<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#tab-fields" type="button"><%= i18n.__('mailing.ui.settings.tab_fields') %></button></li>
			<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#tab-supp" type="button"><%= i18n.__('mailing.ui.settings.tab_suppressions') %></button></li>
			<li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#tab-general" type="button"><%= i18n.__('mailing.ui.settings.tab_general') %></button></li>
		</ul>

		<div class="tab-content border border-top-0 p-3 bg-white">
			<!-- ═══ ВІДПРАВНИКИ ═══ -->
			<div class="tab-pane fade show active" id="tab-senders">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<p class="text-muted mb-0"><%= i18n.__('mailing.ui.senders.intro') %></p>
					<% if (canEdit) { %><button class="btn btn-primary rounded-0" id="btn-sender-add"><i class="fa-solid fa-plus"></i> <%= i18n.__('mailing.ui.senders.add') %></button><% } %>
				</div>
				<div id="senders-table"></div>
			</div>

			<!-- ═══ СПИСКИ ═══ -->
			<div class="tab-pane fade" id="tab-lists">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<p class="text-muted mb-0"><%= i18n.__('mailing.ui.lists.intro') %></p>
					<% if (canContacts) { %><button class="btn btn-primary rounded-0" id="btn-list-add"><i class="fa-solid fa-plus"></i> <%= i18n.__('mailing.ui.lists.add') %></button><% } %>
				</div>
				<div id="lists-table"></div>
				<div class="mt-3 p-3 bg-body-tertiary">
					<p class="fw-semibold mb-2"><%= i18n.__('mailing.ui.lists.form_title') %></p>
					<p class="mailing-sub mb-2"><%= i18n.__('mailing.ui.lists.form_hint') %></p>
					<pre class="mb-0 small" id="form-snippet"></pre>
				</div>
			</div>

			<!-- ═══ ПОЛЯ ═══ -->
			<div class="tab-pane fade" id="tab-fields">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<p class="text-muted mb-0"><%= i18n.__('mailing.ui.fields.intro') %></p>
					<% if (canContacts) { %><button class="btn btn-primary rounded-0" id="btn-field-add"><i class="fa-solid fa-plus"></i> <%= i18n.__('mailing.ui.fields.add') %></button><% } %>
				</div>
				<div id="fields-table"></div>
			</div>

			<!-- ═══ СТОП-ЛИСТ ═══ -->
			<div class="tab-pane fade" id="tab-supp">
				<div class="row g-2 mb-3">
					<div class="col-12 col-md-4"><input type="search" class="form-control rounded-0" id="supp-search" placeholder="<%= i18n.__('mailing.ui.search') %>" maxlength="100" /></div>
					<div class="col-12 col-md-3">
						<select class="form-select rounded-0" id="supp-reason">
							<option value=""><%= i18n.__('mailing.ui.all') %></option>
							<% ['hard_bounce','complaint','unsubscribe_all','manual','invalid'].forEach(function (r) { %><option value="<%= r %>"><%= i18n.__('mailing.ui.supp.reason.' + r) %></option><% }) %>
						</select>
					</div>
					<div class="col-12 col-md-5 text-md-end">
						<% if (canContacts) { %><button class="btn btn-primary rounded-0" id="btn-supp-add"><i class="fa-solid fa-ban"></i> <%= i18n.__('mailing.ui.supp.add') %></button><% } %>
					</div>
				</div>
				<div id="supp-table"></div>
			</div>

			<!-- ═══ ЗАГАЛЬНІ ═══ -->
			<div class="tab-pane fade" id="tab-general">
				<form id="form-general" class="row g-3" style="max-width: 900px">
					<div class="col-md-6">
						<label class="form-label"><%= i18n.__('mailing.ui.general.default_timezone') %></label>
						<input class="form-control rounded-0" name="default_timezone" maxlength="64" list="tz-list" />
						<datalist id="tz-list"></datalist>
					</div>
					<div class="col-md-6">
						<label class="form-label"><%= i18n.__('mailing.ui.general.default_lang') %></label>
						<select class="form-select rounded-0" name="default_id_lang" data-type="int">
							<% languages.forEach(function (l) { %><option value="<%= l.id %>"><%= l.name %></option><% }) %>
						</select>
					</div>
					<div class="col-md-3">
						<label class="form-label"><%= i18n.__('mailing.ui.general.cap_count') %></label>
						<input type="number" class="form-control rounded-0" name="cap_count" min="0" max="100" data-type="int" />
						<div class="form-text"><%= i18n.__('mailing.ui.general.cap_hint') %></div>
					</div>
					<div class="col-md-3">
						<label class="form-label"><%= i18n.__('mailing.ui.general.cap_days') %></label>
						<input type="number" class="form-control rounded-0" name="cap_days" min="1" max="365" data-type="int" />
					</div>
					<div class="col-md-3">
						<label class="form-label"><%= i18n.__('mailing.ui.general.soft_bounce_limit') %></label>
						<input type="number" class="form-control rounded-0" name="soft_bounce_limit" min="1" max="20" data-type="int" />
					</div>
					<div class="col-md-3">
						<label class="form-label"><%= i18n.__('mailing.ui.general.double_optin_ttl') %></label>
						<input type="number" class="form-control rounded-0" name="double_optin_ttl_days" min="1" max="90" data-type="int" />
					</div>
					<div class="col-md-6">
						<label class="form-label"><%= i18n.__('mailing.ui.general.sunset_days') %></label>
						<input type="number" class="form-control rounded-0" name="sunset_days" min="0" max="3650" data-type="int" />
						<div class="form-text"><%= i18n.__('mailing.ui.general.sunset_hint') %></div>
					</div>
					<div class="col-md-6">
						<label class="form-label"><%= i18n.__('mailing.ui.general.clients_sync') %></label>
						<div class="input-group">
							<div class="input-group-text rounded-0"><input class="form-check-input mt-0" type="checkbox" name="sync_enabled" /></div>
							<select class="form-select rounded-0" name="sync_id_list" data-type="int" id="sync-list"></select>
						</div>
						<div class="form-text"><%= i18n.__('mailing.ui.general.clients_sync_hint') %></div>
					</div>
					<% if (canEdit) { %><div class="col-12"><button type="submit" class="btn btn-primary rounded-0"><%= i18n.__('mailing.ui.save') %></button></div><% } %>
				</form>
			</div>
		</div>
	</div>

	<!-- ═══ МОДАЛКА: ВІДПРАВНИК ═══ -->
	<div class="modal fade" id="modal-sender" tabindex="-1">
		<div class="modal-dialog modal-lg">
			<form class="modal-content rounded-0" id="form-sender" autocomplete="off">
				<div class="modal-header"><h5 class="modal-title"><%= i18n.__('mailing.ui.senders.modal_title') %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
				<div class="modal-body row g-3">
					<input type="hidden" name="id" data-type="int" />
					<div class="col-12">
						<div class="btn-group w-100" role="group">
							<input type="radio" class="btn-check" name="provider" id="prov-smtp" value="smtp" checked />
							<label class="btn btn-outline-primary rounded-0" for="prov-smtp"><i class="fa-solid fa-server"></i> <%= i18n.__('mailing.sender.provider.smtp') %></label>
							<input type="radio" class="btn-check" name="provider" id="prov-gmail" value="gmail" />
							<label class="btn btn-outline-primary rounded-0" for="prov-gmail"><i class="fa-brands fa-google"></i> <%= i18n.__('mailing.sender.provider.gmail') %></label>
						</div>
					</div>
					<div class="col-12 gmail-only d-none"><div class="alert alert-info rounded-0 mb-0 small"><%= i18n.__('mailing.sender.gmail_hint') %></div></div>

					<div class="col-md-6"><label class="form-label"><%= i18n.__('mailing.ui.senders.name') %> *</label><input class="form-control rounded-0" name="name" maxlength="128" required /></div>
					<div class="col-md-6"><label class="form-label"><%= i18n.__('mailing.ui.senders.from_name') %> *</label><input class="form-control rounded-0" name="from_name" maxlength="128" required /></div>
					<div class="col-md-6"><label class="form-label"><%= i18n.__('mailing.ui.senders.from_email') %> *</label><input type="email" class="form-control rounded-0" name="from_email" maxlength="254" required /></div>
					<div class="col-md-6"><label class="form-label"><%= i18n.__('mailing.ui.senders.reply_to') %></label><input type="email" class="form-control rounded-0" name="reply_to" maxlength="254" /></div>
					<div class="col-12"><label class="form-label"><%= i18n.__('mailing.ui.senders.company_address') %></label><input class="form-control rounded-0" name="company_address" maxlength="512" /><div class="form-text"><%= i18n.__('mailing.ui.senders.company_address_hint') %></div></div>

					<div class="col-md-6 gmail-only d-none">
						<label class="form-label"><%= i18n.__('mailing.ui.senders.app_password') %> *</label>
						<input type="password" class="form-control rounded-0" name="gmail_pass" maxlength="64" autocomplete="new-password" placeholder="xxxx xxxx xxxx xxxx" />
						<div class="form-text pass-keep d-none"><%= i18n.__('mailing.ui.senders.pass_keep') %></div>
					</div>

					<div class="col-12 smtp-only"><hr class="my-1" /><p class="fw-semibold mb-0">SMTP</p></div>
					<div class="col-md-6 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.smtp_host') %> *</label><input class="form-control rounded-0" name="smtp_host" maxlength="255" placeholder="smtp.example.com" /></div>
					<div class="col-md-3 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.port') %> *</label><input type="number" class="form-control rounded-0" name="smtp_port" value="587" min="1" max="65535" data-type="int" /></div>
					<div class="col-md-3 smtp-only d-flex align-items-end"><div class="form-check"><input class="form-check-input" type="checkbox" name="smtp_secure" id="smtp-secure" /><label class="form-check-label" for="smtp-secure"><%= i18n.__('mailing.ui.senders.ssl') %></label></div></div>
					<div class="col-md-6 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.login') %> *</label><input class="form-control rounded-0" name="smtp_user" maxlength="255" autocomplete="off" /></div>
					<div class="col-md-6 smtp-only">
						<label class="form-label"><%= i18n.__('mailing.ui.senders.password') %></label>
						<input type="password" class="form-control rounded-0" name="smtp_pass" maxlength="512" autocomplete="new-password" />
						<div class="form-text pass-keep d-none"><%= i18n.__('mailing.ui.senders.pass_keep') %></div>
					</div>
					<div class="col-md-6 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.bounce_address') %></label><input type="email" class="form-control rounded-0" name="bounce_address" maxlength="254" placeholder="bounce@example.com" /><div class="form-text"><%= i18n.__('mailing.ui.senders.bounce_hint') %></div></div>
					<div class="col-md-6 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.dkim_selector') %></label><input class="form-control rounded-0" name="dkim_selector" maxlength="63" /></div>

					<div class="col-12 smtp-only"><hr class="my-1" /><p class="fw-semibold mb-0">IMAP <span class="mailing-sub">— <%= i18n.__('mailing.ui.senders.imap_hint') %></span></p></div>
					<div class="col-md-6 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.imap_host') %></label><input class="form-control rounded-0" name="imap_host" maxlength="255" placeholder="imap.example.com" /></div>
					<div class="col-md-3 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.port') %></label><input type="number" class="form-control rounded-0" name="imap_port" value="993" min="1" max="65535" data-type="int" /></div>
					<div class="col-md-3 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.mailbox') %></label><input class="form-control rounded-0" name="imap_mailbox" value="INBOX" maxlength="128" /></div>
					<div class="col-md-6 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.login') %></label><input class="form-control rounded-0" name="imap_user" maxlength="255" autocomplete="off" /></div>
					<div class="col-md-6 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.password') %></label><input type="password" class="form-control rounded-0" name="imap_pass" maxlength="512" autocomplete="new-password" /></div>

					<div class="col-12"><hr class="my-1" /><p class="fw-semibold mb-0"><%= i18n.__('mailing.ui.senders.limits') %></p></div>
					<div class="col-md-3"><label class="form-label"><%= i18n.__('mailing.ui.senders.rate_per_minute') %></label><input type="number" class="form-control rounded-0" name="rate_per_minute" value="60" min="1" max="10000" data-type="int" /></div>
					<div class="col-md-3"><label class="form-label"><%= i18n.__('mailing.ui.senders.daily_limit') %></label><input type="number" class="form-control rounded-0" name="daily_limit" value="0" min="0" data-type="int" /><div class="form-text"><%= i18n.__('mailing.ui.senders.daily_hint') %></div></div>
					<div class="col-md-3 smtp-only"><label class="form-label"><%= i18n.__('mailing.ui.senders.connections') %></label><input type="number" class="form-control rounded-0" name="smtp_max_connections" value="3" min="1" max="10" data-type="int" /></div>
					<div class="col-md-3"><label class="form-label"><%= i18n.__('mailing.ui.senders.warmup_start') %></label><input type="date" class="form-control rounded-0" name="warmup_start" data-type="nullable" /></div>
					<div class="col-md-6 d-flex gap-4">
						<div class="form-check"><input class="form-check-input" type="checkbox" name="is_default" id="s-default" /><label class="form-check-label" for="s-default"><%= i18n.__('mailing.ui.senders.is_default') %></label></div>
						<div class="form-check"><input class="form-check-input" type="checkbox" name="active" id="s-active" checked /><label class="form-check-label" for="s-active"><%= i18n.__('mailing.ui.active') %></label></div>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('mailing.ui.cancel') %></button>
					<button type="submit" class="btn btn-primary rounded-0"><%= i18n.__('mailing.ui.save') %></button>
				</div>
			</form>
		</div>
	</div>

	<!-- ═══ МОДАЛКА: ТЕСТ ВІДПРАВНИКА ═══ -->
	<div class="modal fade" id="modal-test" tabindex="-1">
		<div class="modal-dialog">
			<form class="modal-content rounded-0" id="form-test">
				<div class="modal-header"><h5 class="modal-title"><%= i18n.__('mailing.ui.senders.test_title') %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
				<div class="modal-body">
					<input type="hidden" name="id" />
					<label class="form-label"><%= i18n.__('mailing.ui.senders.test_to') %></label>
					<input type="email" class="form-control rounded-0" name="to" maxlength="254" />
					<div class="form-text"><%= i18n.__('mailing.ui.senders.test_hint') %></div>
					<div class="mt-3 d-none" id="dns-result"></div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary rounded-0" id="btn-dns"><i class="fa-solid fa-shield-halved"></i> <%= i18n.__('mailing.ui.senders.check_dns') %></button>
					<button type="submit" class="btn btn-primary rounded-0"><%= i18n.__('mailing.ui.senders.test_run') %></button>
				</div>
			</form>
		</div>
	</div>

	<!-- ═══ МОДАЛКА: СПИСОК ═══ -->
	<div class="modal fade" id="modal-list" tabindex="-1">
		<div class="modal-dialog modal-lg">
			<form class="modal-content rounded-0" id="form-list">
				<div class="modal-header"><h5 class="modal-title"><%= i18n.__('mailing.ui.lists.modal_title') %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
				<div class="modal-body row g-3">
					<input type="hidden" name="id" data-type="int" />
					<div class="col-md-6"><label class="form-label"><%= i18n.__('mailing.ui.lists.code') %> *</label><input class="form-control rounded-0" name="code" maxlength="64" pattern="[a-z0-9_-]+" required /><div class="form-text"><%= i18n.__('mailing.ui.lists.code_hint') %></div></div>
					<div class="col-md-6"><label class="form-label"><%= i18n.__('mailing.ui.sort_order') %></label><input type="number" class="form-control rounded-0" name="sort_order" value="0" data-type="int" /></div>
					<div class="col-12 d-flex gap-4 flex-wrap">
						<div class="form-check"><input class="form-check-input" type="checkbox" name="is_public" id="l-public" checked /><label class="form-check-label" for="l-public"><%= i18n.__('mailing.ui.lists.is_public') %></label></div>
						<div class="form-check"><input class="form-check-input" type="checkbox" name="double_optin" id="l-doi" checked /><label class="form-check-label" for="l-doi"><%= i18n.__('mailing.ui.lists.double_optin') %></label></div>
						<div class="form-check"><input class="form-check-input" type="checkbox" name="active" id="l-active" checked /><label class="form-check-label" for="l-active"><%= i18n.__('mailing.ui.active') %></label></div>
					</div>
					<% languages.forEach(function (l) { %>
						<div class="col-md-6 lang-block" data-id-lang="<%= l.id %>">
							<label class="form-label"><%= i18n.__('mailing.ui.lists.name') %> (<%= l.name %>)</label>
							<input class="form-control rounded-0 lang-name" maxlength="128" />
							<textarea class="form-control rounded-0 mt-1 lang-desc" rows="2" maxlength="512" placeholder="<%= i18n.__('mailing.ui.lists.description') %>"></textarea>
						</div>
					<% }) %>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('mailing.ui.cancel') %></button>
					<button type="submit" class="btn btn-primary rounded-0"><%= i18n.__('mailing.ui.save') %></button>
				</div>
			</form>
		</div>
	</div>

	<!-- ═══ МОДАЛКА: ПОЛЕ ═══ -->
	<div class="modal fade" id="modal-field" tabindex="-1">
		<div class="modal-dialog">
			<form class="modal-content rounded-0" id="form-field">
				<div class="modal-header"><h5 class="modal-title"><%= i18n.__('mailing.ui.fields.modal_title') %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
				<div class="modal-body row g-3">
					<div class="col-12"><label class="form-label"><%= i18n.__('mailing.ui.fields.code') %> *</label><input class="form-control rounded-0" name="code" maxlength="64" pattern="[a-z][a-z0-9_]*" required /><div class="form-text"><%= i18n.__('mailing.ui.fields.code_hint') %></div></div>
					<div class="col-12"><label class="form-label"><%= i18n.__('mailing.ui.fields.name') %> *</label><input class="form-control rounded-0" name="name" maxlength="128" required /></div>
					<div class="col-12">
						<label class="form-label"><%= i18n.__('mailing.ui.fields.type') %></label>
						<select class="form-select rounded-0" name="type"><% ['text','number','date','bool'].forEach(function (x) { %><option value="<%= x %>"><%= i18n.__('mailing.ui.fields.types.' + x) %></option><% }) %></select>
					</div>
				</div>
				<div class="modal-footer">
