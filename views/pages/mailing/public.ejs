<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="robots" content="noindex, nofollow" />
	<title><%= t('title') %></title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
	<style>
		:root { --brand: #0d3b66; --accent: #f4a261; }
		body { background: #f4f6f9; }
		.box { max-width: 560px; margin: 48px auto; }
		.btn-brand { background: var(--brand); border-color: var(--brand); color: #fff; }
		.btn-brand:hover { background: #0a2e50; color: #fff; }
	</style>
</head>
<body>
	<div class="box px-3">
		<div class="card rounded-0 shadow-sm">
			<div class="card-body p-4">
				<h1 class="h4 mb-3"><%= t('title') %></h1>

				<% if (state === 'prefs') { %>
					<% if (data.notice === 'saved') { %><div class="alert alert-success rounded-0"><%= t('saved') %></div><% } %>
					<% if (data.notice === 'blocked' || data.blocked) { %><div class="alert alert-warning rounded-0"><%= t('blocked') %></div><% } %>
					<% if (data.notice === 'unsubscribed' || data.unsubscribed) { %>
						<div class="alert alert-secondary rounded-0"><%= t('unsubscribed') %><br /><small><%= t('resubscribe_hint') %></small></div>
					<% } %>

					<p class="text-muted"><%= t('prefs_intro') %> <strong><%= data.email %></strong></p>

					<form method="post" action="<%= data.action %>">
						<input type="hidden" name="action" value="save" />
						<p class="fw-semibold mb-2"><%= t('lists') %></p>
						<% if (!data.lists.length) { %><p class="text-muted"><%= t('no_lists') %></p><% } %>
						<% data.lists.forEach(function (l) { %>
							<div class="form-check mb-2">
								<input class="form-check-input rounded-0" type="checkbox" name="lists" value="<%= l.id %>" id="l<%= l.id %>" <%= l.checked ? 'checked' : '' %> <%= data.blocked ? 'disabled' : '' %> />
								<label class="form-check-label" for="l<%= l.id %>">
									<%= l.name %><% if (l.description) { %><br /><small class="text-muted"><%= l.description %></small><% } %>
								</label>
							</div>
						<% }) %>
						<% if (!data.blocked && data.lists.length) { %><button type="submit" class="btn btn-brand rounded-0 mt-2"><%= t('save') %></button><% } %>
					</form>

					<% if (!data.unsubscribed && !data.blocked) { %>
						<hr />
						<form method="post" action="<%= data.action %>">
							<input type="hidden" name="action" value="unsubscribe_all" />
							<button type="submit" class="btn btn-outline-danger rounded-0 w-100"><%= t('unsubscribe_all') %></button>
						</form>
					<% } %>

				<% } else if (state === 'confirm') { %>
					<p><%= t('confirm_title') %>: <strong><%= data.email %></strong></p>
					<form method="post" action="<%= data.action %>">
						<button type="submit" class="btn btn-brand rounded-0"><%= t('confirm_button') %></button>
					</form>

				<% } else if (state === 'confirmed' || state === 'subscribed') { %>
					<div class="alert alert-success rounded-0 mb-0"><%= t(state) %></div>

				<% } else if (state === 'check_email') { %>
					<div class="alert alert-info rounded-0 mb-0"><%= t('check_email') %></div>

				<% } else { %>
					<div class="alert alert-warning rounded-0 mb-0"><%= t(state) %></div>
				<% } %>
			</div>
		</div>
	</div>
</body>
</html>
