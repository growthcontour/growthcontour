<!DOCTYPE html>
<html lang="<%= i18n.__('lang_iso') %>">
<head>
	<%- include('../../partials/head'); %>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/css/tabulator_bootstrap5.min.css" />
	<style>
		.tabulator { font-size: 0.9rem; }
		.mailing-sub { font-size: 0.8rem; color: #6c757d; }
	</style>
	<title><%= i18n.__('mailing.ui.campaigns.title') %></title>
</head>
<body>
	<%- include('../../partials/header'); %>
	<% const canAdd = can('mailing.campaigns', 'edit'); %>

	<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
	<div class="breadcrumbs pt-3 pb-3">
		<div class="container-fluid">
			<div class="row align-items-center">
				<div class="col">
					<span><%= i18n.__('header.nav.mailing') %></span>
					<div>
						<ul class="list-inline mb-0">
							<li class="list-inline-item">
								<a href="/">
									<i class="fas fa-home"></i>
									<span><%= i18n.__('header.nav.home') %></span>
								</a>
							</li>
							<li class="list-inline-item">
								<i class="fas fa-chevron-right"></i>
								<%= i18n.__('header.nav.mailing') %>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="container-fluid mt-3 mb-4">
		<div class="card border-primary rounded-0">
			<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center flex-wrap gap-2">
				<span><%= i18n.__('mailing.ui.campaigns.title') %> <span class="badge text-bg-light rounded-0" id="total">0</span></span>
				<% if (canAdd) { %><button class="btn btn-light btn-sm rounded-0" id="btn-add"><i class="fa-solid fa-plus"></i> <%= i18n.__('mailing.ui.campaigns.add') %></button><% } %>
			</div>
			<div class="card-body">
				<div class="row g-2 mb-3">
					<div class="col-12 col-md-4"><input type="search" class="form-control rounded-0" id="f-search" placeholder="<%= i18n.__('mailing.ui.search') %>" maxlength="100" /></div>
					<div class="col-12 col-md-3">
						<select class="form-select rounded-0" id="f-status">
							<option value=""><%= i18n.__('mailing.ui.all') %></option>
							<% ['draft','scheduled','preparing','sending','paused','sent','cancelled','failed'].forEach(function (s) { %><option value="<%= s %>"><%= i18n.__('mailing.ui.campaigns.status.' + s) %></option><% }) %>
						</select>
					</div>
				</div>
				<div id="campaigns-table"></div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="modal-add" tabindex="-1">
		<div class="modal-dialog">
			<form class="modal-content rounded-0" id="form-add">
				<div class="modal-header"><h5 class="modal-title"><%= i18n.__('mailing.ui.campaigns.add') %></h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
				<div class="modal-body row g-3">
					<div class="col-12"><label class="form-label"><%= i18n.__('mailing.ui.campaigns.name') %> *</label><input class="form-control rounded-0" name="name" maxlength="255" required /></div>
					<div class="col-12">
						<label class="form-label"><%= i18n.__('mailing.ui.campaigns.type_title') %></label>
						<select class="form-select rounded-0" name="type"><option value="regular"><%= i18n.__('mailing.ui.campaigns.type.regular') %></option><option value="ab"><%= i18n.__('mailing.ui.campaigns.type.ab') %></option></select>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('mailing.ui.cancel') %></button>
					<button type="submit" class="btn btn-primary rounded-0"><%= i18n.__('mailing.ui.campaigns.create') %></button>
				</div>
			</form>
		</div>
	</div>

	<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
	<script src="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/tabulator-tables@6.3.1/dist/js/tabulator.min.js"></script>
	<script>
		var TR_UI_CAMPAIGNS_STATUS = { draft: "<%= i18n.__('mailing.ui.campaigns.status.draft') %>", scheduled: "<%= i18n.__('mailing.ui.campaigns.status.scheduled') %>", preparing: "<%= i18n.__('mailing.ui.campaigns.status.preparing') %>", sending: "<%= i18n.__('mailing.ui.campaigns.status.sending') %>", paused: "<%= i18n.__('mailing.ui.campaigns.status.paused') %>", sent: "<%= i18n.__('mailing.ui.campaigns.status.sent') %>", cancelled: "<%= i18n.__('mailing.ui.campaigns.status.cancelled') %>", failed: "<%= i18n.__('mailing.ui.campaigns.status.failed') %>" };
		var TR_UI_CAMPAIGNS_TYPE = { regular: "<%= i18n.__('mailing.ui.campaigns.type.regular') %>", ab: "<%= i18n.__('mailing.ui.campaigns.type.ab') %>", resend: "<%= i18n.__('mailing.ui.campaigns.type.resend') %>" };
		var notyf = new Notyf({
			position: { x: "right", y: "top" },
			duration: 4000,
			types: [
				{ type: "success", dismissible: true, icon: false },
				{ type: "error", background: "indianred", dismissible: true, icon: false },
			],
		});

		// Екранування для форматерів Tabulator
		function esc(v) {
			return String(v == null ? "" : v).replace(/[&<>"']/g, function (c) {
				return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
			});
		}

		// Дата UTC з БД → локальний час браузера
		function fmtDate(v) {
			if (!v) return "";
			var d = new Date(String(v).replace(" ", "T") + "Z");
			if (isNaN(d)) return esc(v);
			var p = function (n) {
				return String(n).padStart(2, "0");
			};
			return p(d.getHours()) + ":" + p(d.getMinutes()) + " " + p(d.getDate()) + "." + p(d.getMonth() + 1) + "." + d.getFullYear();
		}

		// POST JSON → Promise(data). Помилка: notyf + reject(data)
		function api(url, payload) {
			return fetch(url, {
				method: "POST",
				credentials: "same-origin",
				headers: { "Content-Type": "application/json", Accept: "application/json" },
				body: JSON.stringify(payload || {}),
			})
				.then(function (r) {
					return r
						.json()
						.catch(function () {
							return { ok: false, message: "<%= i18n.__('mailing.errors.server_error') %>" };
						})
						.then(function (d) {
							if (!r.ok || d.ok === false) return Promise.reject(d);
							return d;
						});
				})
				.catch(function (d) {
					if (d && d.message) notyf.error(d.message);
					else notyf.error("<%= i18n.__('mailing.errors.server_error') %>");
					return Promise.reject(d || {});
				});
		}

		// Помилки полів: {errors:[{field,message}]} → .is-invalid + .invalid-feedback (текст, не HTML)
		function clearErrors($form) {
			$form.find(".is-invalid").removeClass("is-invalid");
			$form.find(".invalid-feedback.js-err").remove();
		}

		function showErrors($form, d) {
			clearErrors($form);
			(d && d.errors ? d.errors : []).forEach(function (e) {
				var $el = $form.find('[name="' + String(e.field).replace(/"/g, "") + '"]').first();
				if (!$el.length) return;
				$el.addClass("is-invalid");
				$('<div class="invalid-feedback js-err"></div>').text(e.message).insertAfter($el);
			});
		}

		// Значення форми → об'єкт: data-type="int|bool|json" керує типом
		function formData($form) {
			var out = {};
			$form.find("[name]").each(function () {
				var $el = $(this);
				var name = $el.attr("name");
				var type = $el.data("type");
				if ($el.is(":disabled") && !$el.data("send-disabled")) return;
				var val;
				if ($el.is(":checkbox")) val = $el.is(":checked");
				else val = $el.val();
				if (type === "int") val = val === "" || val === null ? null : parseInt(val, 10);
				if (type === "nullable") val = val === "" ? null : val;
				out[name] = val;
			});
			return out;
		}

		// Спільні налаштування Tabulator (серверна пагінація/сортування)
		function gridOptions(url, extra) {
			return Object.assign(
				{
					layout: "fitColumns",
					ajaxURL: url,
					ajaxConfig: "POST",
					ajaxContentType: "json",
					pagination: true,
					paginationMode: "remote",
					sortMode: "remote",
					paginationSize: 20,
					paginationSizeSelector: [20, 50, 100],
					placeholder: "<%= i18n.__('mailing.ui.empty') %>",
					movableColumns: true,
				},
				extra || {}
			);
		}

		function badge(text, cls) {
			return '<span class="badge rounded-0 ' + (cls || "text-bg-secondary") + '">' + esc(text) + "</span>";
		}

		var STATUS_CLS = {
			active: "text-bg-success",
			subscribed: "text-bg-success",
			unsubscribed: "text-bg-secondary",
			pending: "text-bg-warning",
			bounced: "text-bg-danger",
			complained: "text-bg-danger",
			cleaned: "text-bg-dark",
			draft: "text-bg-secondary",
			scheduled: "text-bg-info",
			preparing: "text-bg-info",
			sending: "text-bg-primary",
			paused: "text-bg-warning",
			sent: "text-bg-success",
			cancelled: "text-bg-dark",
			failed: "text-bg-danger",
			uploaded: "text-bg-secondary",
			queued: "text-bg-info",
			processing: "text-bg-primary",
			done: "text-bg-success",
		};
	</script>
	<script>
		function pct(a, b) {
			return b ? ((a / b) * 100).toFixed(1) + "%" : "—";
		}
		function filters() {
			return { search: $("#f-search").val(), status: $("#f-status").val() };
		}

		var table = new Tabulator(
			"#campaigns-table",
			gridOptions("/api/mailing/campaigns/list", {
				ajaxParams: filters,
				initialSort: [{ column: "id", dir: "desc" }],
				ajaxResponse: function (u, p, res) {
					$("#total").text(res.last_row);
					return res;
				},
				columns: [
					{ title: "ID", field: "id", width: 70 },
					{
						title: "<%= i18n.__('mailing.ui.campaigns.name') %>",
						field: "name",
						formatter: function (c) {
							var d = c.getRow().getData();
							var url = "/mailing/campaigns/" + parseInt(d.id, 10) + "/" + (d.status === "draft" ? "" : "report/");
							return '<a href="' + url + '">' + esc(d.name) + '</a><div class="mailing-sub">' + esc(TR_UI_CAMPAIGNS_TYPE[d.type]) + (d.sender_name ? " · " + esc(d.sender_name) : "") + "</div>";
						},
					},
					{
						title: "<%= i18n.__('mailing.ui.status') %>",
						field: "status",
						width: 150,
						formatter: function (c) {
							var d = c.getRow().getData();
							return badge(TR_UI_CAMPAIGNS_STATUS[d.status], STATUS_CLS[d.status]) + (d.status === "scheduled" && d.date_scheduled ? '<div class="mailing-sub">' + (d.send_mode === "timezone" ? esc(String(d.date_scheduled).slice(0, 16)) : fmtDate(d.date_scheduled)) + "</div>" : "");
						},
					},
					{
						title: "<%= i18n.__('mailing.ui.campaigns.sent') %>",
						field: "cnt_sent",
						hozAlign: "right",
						formatter: function (c) {
							var d = c.getRow().getData();
							return esc(d.cnt_sent) + " / " + esc(d.cnt_total);
						},
					},
					{ title: "<%= i18n.__('mailing.ui.campaigns.open_rate') %>", field: "cnt_opened_human", hozAlign: "right", headerSort: false, formatter: function (c) { var d = c.getRow().getData(); return pct(d.cnt_opened_human, d.cnt_sent); } },
					{ title: "<%= i18n.__('mailing.ui.campaigns.click_rate') %>", field: "cnt_clicked", hozAlign: "right", headerSort: false, formatter: function (c) { var d = c.getRow().getData(); return pct(d.cnt_clicked, d.cnt_sent); } },
					{ title: "<%= i18n.__('mailing.ui.campaigns.unsub_rate') %>", field: "cnt_unsubscribed", hozAlign: "right", headerSort: false, formatter: function (c) { var d = c.getRow().getData(); return pct(d.cnt_unsubscribed, d.cnt_sent); } },
					{ title: "<%= i18n.__('mailing.ui.campaigns.launched') %>", field: "date_launched", formatter: function (c) { return fmtDate(c.getValue()); } },
					{ title: "<%= i18n.__('mailing.ui.date') %>", field: "date_add", formatter: function (c) { return fmtDate(c.getValue()); } },
				],
			})
		);

		var timer;
		$("#f-search").on("input", function () {
			clearTimeout(timer);
			timer = setTimeout(function () { table.setData(); }, 400);
		});
		$("#f-status").on("change", function () { table.setData(); });
		// Активні розсилки — оновлюємо прогрес
		setInterval(function () {
			if (table.getData().some(function (r) { return ["preparing", "sending"].indexOf(r.status) >= 0; })) table.replaceData();
		}, 15000);

		var $fa = $("#form-add");
		var modal = new bootstrap.Modal("#modal-add");
		$("#btn-add").on("click", function () {
			clearErrors($fa);
			$fa[0].reset();
			modal.show();
		});
		$fa.on("submit", function (e) {
			e.preventDefault();
			var d = formData($fa);
			d.audience = { lists: [] };
			api("/api/mailing/campaigns/save", d)
				.then(function (r) { window.location.href = "/mailing/campaigns/" + parseInt(r.id, 10) + "/"; })
				.catch(function (err) { showErrors($fa, err); });
		});
	</script>
</body>
</html>
