<!doctype html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('chat.title') %></title>
		<%- include('../../partials/head'); %>
	</head>
	<body class="d-flex flex-column h-100">
		<%- include('../../partials/header'); %>
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('chat.title') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/"><i class="fas fa-home"></i> <span><%= i18n.__('chat.breadcrumb.home') %></span></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= i18n.__('chat.breadcrumb.current') %>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- ─── ОСНОВНИЙ КОНТЕНТ ──────────────────────────────────────── -->
		<div class="container-fluid mt-3">
			<div class="row">
				<div class="col-12 mb-3">
					<div class="card border-primary rounded-0">
						<%- include('../../partials/chat/app', { chatMode: 'page', chatPrefix: '' }); %>
					</div>
				</div>
			</div>
		</div>

		<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
	</body>
</html>
