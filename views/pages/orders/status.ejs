      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0">
          <div class="modal-header">
            <h1 class="modal-title fs-5"><%= i18n.__('orders.statuses.add_modal.title') %></h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <div class="modal-body">
            <!-- Назва статусу (багатомовні поля) -->
            <div class="mb-3">
              <label class="form-label"><%= i18n.__('orders.statuses.add_modal.name') %></label>
              <% languages.forEach(function(lang, i) { %>
              <div class="lang-block <%= i === 0 ? '' : 'd-none' %>" data-lang="<%= lang.id %>">
                <input type="text" class="form-control rounded-0 lang-name" name="name_<%= lang.iso %>" data-id-lang="<%= lang.id %>" />
              </div>
              <% }); %>
            </div>

            <div class="row">
              <!-- Колір тексту -->
              <div class="col-12 col-md-4 mb-3">
                <label class="form-label"><%= i18n.__('orders.statuses.add_modal.color_text') %></label>
                <div class="pickr-color" data-target="add_color_text"></div>
                <input type="hidden" name="color_text" id="add_color_text" />
              </div>

              <!-- Колір фону -->
              <div class="col-12 col-md-4 mb-3">
                <label class="form-label"><%= i18n.__('orders.statuses.add_modal.color_background') %></label>
                <div class="pickr-color" data-target="add_color_background"></div>
                <input type="hidden" name="color_background" id="add_color_background" />
              </div>

              <!-- Іконка -->
              <div class="col-12 col-md-4 mb-3">
                <label class="form-label d-block"><%= i18n.__('orders.statuses.add_modal.icon') %></label>
                <button type="button" class="btn btn-outline-secondary rounded-0 icon-trigger" data-target="add_icon">
                  <i class="fa-regular fa-circle-question icon-preview"></i>
                </button>
                <input type="hidden" name="icon" id="add_icon" />
              </div>
            </div>

            <!-- Прапорці налаштувань -->
            <div class="row">
              <% const addFlags = ['logable','invoice','hidden','send_email','pdf_invoice','pdf_delivery','shipped','paid','delivery']; %> <% addFlags.forEach(function(f) { %>
              <div class="col-12 col-md-6">
                <div class="form-check mb-2">
                  <input type="checkbox" class="form-check-input rounded-0 add-status-flag" id="add_flag_<%= f %>" name="<%= f %>" value="1" />
                  <label class="form-check-label" for="add_flag_<%= f %>"> <%= i18n.__('orders.statuses.flags.' + f) %> </label>
                </div>
              </div>
              <% }); %>
            </div>

            <!-- Прапорці аналітики -->
            <hr class="my-3" />
            <div class="row">
              <div class="col-12 mb-2">
                <span class="fw-semibold">Аналітика</span>
              </div>
              <% const addAnalyticsFlags = ['count_in_revenue','is_final','is_negative']; %> <% addAnalyticsFlags.forEach(function(f) { %>
              <div class="col-12 col-md-6">
                <div class="form-check mb-2">
                  <input type="checkbox" class="form-check-input rounded-0 add-status-flag" id="add_flag_<%= f %>" name="<%= f %>" value="1" />
                  <label class="form-check-label" for="add_flag_<%= f %>"> <%= i18n.__('orders.statuses.flags.' + f) %> </label>
                </div>
              </div>
              <% }); %>
            </div>
          </div>

          <div class="modal-footer">
            <!-- Перемикач мов -->
            <div class="dropdown me-auto">
              <button class="btn btn-secondary rounded-0 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <span class="lang-current"><%= languages[0] ? languages[0].name : '' %></span>
              </button>
              <ul class="dropdown-menu rounded-0">
                <% languages.forEach(function(lang, i) { %>
                <li>
                  <a class="dropdown-item lang-switch <%= i === 0 ? 'active' : '' %>" href="#" data-lang="<%= lang.id %>"> <%= lang.name %> </a>
                </li>
                <% }); %>
              </ul>
            </div>

            <button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.statuses.add_modal.close') %></button>
            <button type="button" class="btn btn-primary rounded-0" id="btn_add_status"><%= i18n.__('orders.statuses.add_modal.save') %></button>
          </div>
        </div>
