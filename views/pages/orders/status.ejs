<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
  <head>
    <title><%= i18n.__('orders.statuses.title') %></title>
    <%- include('../../partials/head'); %>

    <!-- Сторонні бібліотеки -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/themes/monolith.min.css" />

    <!-- Tabulator (таблиці) -->
    <link href="/assets/css/tabulator/tabulator.min.css" rel="stylesheet" />
    <link href="/assets/css/tabulator/tabulator_bootstrap5.min.css" rel="stylesheet" />

    <!-- Локальні стилі -->
    <style>
      /* Стилі для таблиці статусів */
      #statuses-table .tabulator-col,
      #statuses-table .tabulator-cell {
        border-right: 1px solid #dee2e6;
        border-bottom: 1px solid #dee2e6;
      }

      #statuses-table .tabulator-col:last-child,
      #statuses-table .tabulator-cell:last-child {
        border-right: none;
      }

      #statuses-table .tabulator-row:last-child .tabulator-cell {
        border-bottom: none;
      }

      /* Стилі для мовних блоків */
      .lang-block .invalid-feedback {
        display: block;
      }

      /* Стилі для колірного пікера */
      .pickr .pcr-button {
        border: 1px solid #eee;
        border-radius: 0;
      }
    </style>
  </head>

  <body class="d-flex flex-column h-100">
    <%- include('../../partials/header'); %>

    <!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
    <div class="breadcrumbs pt-3 pb-3">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col">
            <span><%= i18n.__('orders.statuses.title') %></span>
            <div>
              <ul class="list-inline mb-0">
                <li class="list-inline-item">
                  <a href="/">
                    <i class="fas fa-home"></i>
                    <span><%= i18n.__('orders.statuses.breadcrumb.home') %></span>
                  </a>
                </li>
                <li class="list-inline-item">
                  <i class="fas fa-chevron-right"></i>
                  <a href="/orders"><%= i18n.__('orders.statuses.breadcrumb.orders') %></a>
                </li>
                <li class="list-inline-item">
                  <i class="fas fa-chevron-right"></i>
                  <%= i18n.__('orders.statuses.breadcrumb.current') %>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-auto">
            <a href="/orders" class="btn btn-primary rounded-0">
              <i class="fa-solid fa-angle-left"></i>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ─── ОСНОВНИЙ КОНТЕНТ ──────────────────────────────────────── -->
    <div class="container-fluid mt-3">
      <div class="row">
        <div class="col-12 mb-3">
          <!-- Кнопка додавання статусу -->
          <button type="button" class="btn btn-primary rounded-0 mb-3" data-bs-toggle="modal" data-bs-target="#modalAddStatus"><%= i18n.__('orders.statuses.add_modal.button') %></button>

          <!-- Таблиця статусів -->
          <div class="card border-primary rounded-0">
            <div class="card-header text-bg-primary rounded-0"><%= i18n.__('orders.statuses.title') %></div>
            <div id="statuses-table"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- МОДАЛЬНЕ ВІКНО РЕДАГУВАННЯ СТАТУСУ -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div class="modal fade" id="modalEditStatus" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0">
          <div class="modal-header">
            <h1 class="modal-title fs-5">
              <%= i18n.__('orders.statuses.edit_modal.title') %>
              <span class="text-muted">#<span id="edit_status_id"></span></span>
            </h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <div class="modal-body">
            <!-- Назва статусу (багатомовні поля) -->
            <div class="mb-3">
              <label class="form-label"><%= i18n.__('orders.statuses.edit_modal.name') %></label>
              <% languages.forEach(function(lang, i) { %>
              <div class="lang-block <%= i === 0 ? '' : 'd-none' %>" data-lang="<%= lang.id %>">
                <input type="text" class="form-control rounded-0 lang-name" name="name_<%= lang.iso %>" data-id-lang="<%= lang.id %>" />
              </div>
              <% }); %>
            </div>

            <div class="row">
              <!-- Колір тексту -->
              <div class="col-12 col-md-4 mb-3">
                <label class="form-label"><%= i18n.__('orders.statuses.edit_modal.color_text') %></label>
                <div class="pickr-color" data-target="edit_color_text"></div>
                <input type="hidden" name="color_text" id="edit_color_text" />
              </div>

              <!-- Колір фону -->
              <div class="col-12 col-md-4 mb-3">
                <label class="form-label"><%= i18n.__('orders.statuses.edit_modal.color_background') %></label>
                <div class="pickr-color" data-target="edit_color_background"></div>
                <input type="hidden" name="color_background" id="edit_color_background" />
              </div>

              <!-- Іконка -->
              <div class="col-12 col-md-4 mb-3">
                <label class="form-label d-block"><%= i18n.__('orders.statuses.edit_modal.icon') %></label>
                <button type="button" class="btn btn-outline-secondary rounded-0 icon-trigger" data-target="edit_icon">
                  <i class="fa-regular fa-circle-question icon-preview"></i>
                </button>
                <input type="hidden" name="icon" id="edit_icon" />
              </div>
            </div>

            <!-- Прапорці налаштувань -->
            <div class="row">
              <% const flags = ['logable','invoice','hidden','send_email','pdf_invoice','pdf_delivery','shipped','paid','delivery']; %> <% flags.forEach(function(f) { %>
              <div class="col-12 col-md-6">
                <div class="form-check mb-2">
                  <input type="checkbox" class="form-check-input rounded-0 status-flag" id="flag_<%= f %>" name="<%= f %>" value="1" />
                  <label class="form-check-label" for="flag_<%= f %>"> <%= i18n.__('orders.statuses.flags.' + f) %> </label>
                </div>
              </div>
              <% }); %>
            </div>

            <!-- Прапорці аналітики -->
            <hr class="my-3" />
            <div class="row">
              <div class="col-12 mb-2">
                <span class="fw-semibold">Аналітика</span>
              </div>
              <% const analyticsFlags = ['count_in_revenue','is_final','is_negative']; %> <% analyticsFlags.forEach(function(f) { %>
              <div class="col-12 col-md-6">
                <div class="form-check mb-2">
                  <input type="checkbox" class="form-check-input rounded-0 status-flag" id="flag_<%= f %>" name="<%= f %>" value="1" />
                  <label class="form-check-label" for="flag_<%= f %>"> <%= i18n.__('orders.statuses.flags.' + f) %> </label>
                </div>
              </div>
              <% }); %>
            </div>
          </div>

          <div class="modal-footer">
            <!-- Перемикач мов -->
            <div class="dropdown me-auto">
              <button class="btn btn-secondary rounded-0 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <span class="lang-current"><%= languages[0] ? languages[0].name : '' %></span>
              </button>
              <ul class="dropdown-menu rounded-0">
                <% languages.forEach(function(lang, i) { %>
                <li>
                  <a class="dropdown-item lang-switch <%= i === 0 ? 'active' : '' %>" href="#" data-lang="<%= lang.id %>"> <%= lang.name %> </a>
                </li>
                <% }); %>
              </ul>
            </div>

            <button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.statuses.edit_modal.close') %></button>
            <button type="button" class="btn btn-primary rounded-0" id="btn_save_status"><%= i18n.__('orders.statuses.edit_modal.save') %></button>
          </div>
        </div>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- МОДАЛЬНЕ ВІКНО ДОДАВАННЯ СТАТУСУ -->
    <!-- ═══════════════════════════════════════════════════════════ -->
