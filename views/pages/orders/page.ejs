            '<div class="py-1"><i class="fa-solid fa-file-pdf text-danger me-2"></i><a href="'+esc(dc.file_path||'#')+'" target="_blank">'+esc(dc.number||dc.type)+'</a> <small class="text-muted">'+esc(dc.type)+'</small></div>'
          ).join('') : '';
    let fees = d.fees.length
        ? '<div class="section-title mt-2">' + "<%= i18n.__('orders.page.fees') %>" + '</div>' + d.fees.map(f =>
