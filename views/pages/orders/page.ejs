</div>
<%- include('../../partials/footer'); %>
<%- include('../../partials/script'); %>
<script src="/assets/js/tabulator/tabulator.min.js"></script>
<script>
const ORDER_ID = <%= order.id %>;
const LOCK = { other: <%= lockOther %> };
const STATUS_NAMES = <%- JSON.stringify(Object.fromEntries(statuses.map((s) => [s.id, s.name]))).replace(/</g, '\\u003c') %>;

// Взяти в роботу / звільнити / перехопити
document.getElementById('order-lock').addEventListener('click', async function (e) {
    const b = e.target.closest('[data-lock]');
    if (!b) return;
    if (b.dataset.lock === 'force' && !confirm("<%= i18n.__('orders.lock.force_q') %>")) return;
    b.disabled = true;
    const res = await fetch('/api/orders/' + ORDER_ID + '/' + (b.dataset.lock === 'release' ? 'release' : 'take') + '/', {
        method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ force: b.dataset.lock === 'force' })
    }).catch(() => null);
    const d = res ? await res.json().catch(() => ({})) : {};
    if (!res || !res.ok || !d.ok) { alert(d.error || "<%= i18n.__('orders.lock.error') %>"); b.disabled = false; return; }
    location.reload();
});
// У роботі в іншого: кнопки змін вимкнено (сервер однаково не прийме зміну — 423)
if (LOCK.other) document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-action="apply-status"], #rf-open, #os-resync, #os-warehouse, #new-status, #status-comment').forEach(function (el) { el.disabled = true; el.title = "<%= i18n.__('orders.lock.disabled_hint') %>"; });
});
const CURRENCY = "<%= order.currency_iso %>";
const TOTAL_PRODUCTS = <%= Number(order.total_products) %>;

// Екранування всього, що прийшло ззовні (CMS/маркетплейс), перед вставкою в DOM
function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g, function(c) {
        return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
    });
}
// Гроші: розряди й 2 знаки після коми (4 344,00 UAH)
const MONEY = new Intl.NumberFormat('uk-UA', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
function money(v, cur) { return MONEY.format(Number(v || 0)) + ' ' + (cur === undefined ? CURRENCY : cur || ''); }

/* ─── Повернення ─── */
const RF = { canEdit: <%= !!can('orders.list', 'edit') %> };
function rfPost(url, body) {
    return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(body || {}) })
        .then(function (r) { return r.json().then(function (d) { if (!r.ok || !d.ok) throw d; return d; }); });
}
function rfErr(e) {
    alert((e && (e.error + (e.errors ? ': ' + e.errors.map(function (x) { return x.field + ' ' + x.message; }).join('; ') : ''))) || "<%= i18n.__('orders.refunds.error') %>");
}
function rfTotal() {
    var sum = Number(document.getElementById('rf-shipping').value || 0);
    document.querySelectorAll('#rf-items input[data-item]').forEach(function (el) { sum += Number(el.value || 0) * Number(el.dataset.unit); });
    document.getElementById('rf-amount').placeholder = sum.toFixed(2);
    document.getElementById('rf-total').textContent = "<%= i18n.__('orders.refunds.total') %>" + ': ' + money(Number(document.getElementById('rf-amount').value || sum));
}
document.addEventListener('click', function (e) {
    if (e.target.closest('#rf-open')) {
        rfPost('/api/orders/' + ORDER_ID + '/refunds/form/').then(function (d) {
            document.getElementById('rf-items').innerHTML = d.items.map(function (it) {
                return '<tr><td>' + esc(it.name) + (it.sku ? '<br><small class="text-muted">' + esc(it.sku) + '</small>' : '') + (it.mapped ? '' : ' <span class="badge text-bg-warning rounded-0" title="' + "<%= i18n.__('orders.refunds.unmapped_tip') %>" + '">' + "<%= i18n.__('orders.refunds.unmapped') %>" + '</span>') + '</td>'
                    + '<td class="text-end">' + it.quantity + '</td><td class="text-end">' + it.returned + '</td><td class="text-end">' + money(it.unit) + '</td>'
                    + '<td><input type="number" class="form-control form-control-sm rounded-0" min="0" max="' + it.available + '" step="1" value="0" data-item="' + it.id + '" data-unit="' + it.unit + '"' + (it.available > 0 ? '' : ' disabled') + '></td></tr>';
            }).join('');
            ['rf-amount', 'rf-reason', 'rf-transaction'].forEach(function (id) { document.getElementById(id).value = ''; });
            document.getElementById('rf-shipping').value = 0;
            rfTotal();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('rf-modal')).show();
        }).catch(rfErr);
    }
    var del = e.target.closest('.js-rf-del');
    if (del) {
        if (!confirm("<%= i18n.__('orders.refunds.del_q') %>")) return;
        rfPost('/api/orders/' + ORDER_ID + '/refunds/' + del.dataset.id + '/delete/').then(function () { location.reload(); }).catch(rfErr);
    }
});
document.addEventListener('input', function (e) { if (e.target.closest('#rf-form')) rfTotal(); });
document.addEventListener('submit', function (e) {
    if (e.target.id !== 'rf-form') return;
    e.preventDefault();
    var items = [];
    document.querySelectorAll('#rf-items input[data-item]').forEach(function (el) { if (Number(el.value) > 0) items.push({ id_item: Number(el.dataset.item), qty: Number(el.value) }); });
    var body = {
        items: items,
        shipping: Number(document.getElementById('rf-shipping').value || 0),
        restock: document.getElementById('rf-restock').checked,
        reason: document.getElementById('rf-reason').value,
        transaction_id: document.getElementById('rf-transaction').value,
    };
    var amount = document.getElementById('rf-amount').value;
    if (amount !== '') body.amount = Number(amount);
    var btn = document.getElementById('rf-submit');
    btn.disabled = true;
    rfPost('/api/orders/' + ORDER_ID + '/refunds/create/', body)
        .then(function () { location.reload(); })
        .catch(function (err) { btn.disabled = false; rfErr(err); });
});

/* ─── Заявки на повернення / обмін ─── */
const RMA_BADGE = { new: 'primary', awaiting: 'info', received: 'warning', checked: 'warning', refunded: 'success', exchanged: 'success', rejected: 'danger', closed: 'secondary', canceled: 'secondary' };
const RMA_EDITABLE = ['new', 'awaiting', 'received', 'checked'];
let rmaRows = [];
let rmaCurrent = null;
const rmaUrl = (r, action) => '/api/orders/' + ORDER_ID + '/returns/' + Number(r.id) + '/' + action + '/';
const rmaValue = (r) => r.items.reduce(function (s, x) { return s + Number(x.qty) * Number(x.unit || 0); }, 0);
function rmaFill(s, vars) { return String(s || '').replace(/\{(\w+)\}/g, function (m, k) { return vars[k] != null ? vars[k] : m; }); }

function rmaLoad() {
    rfPost('/api/orders/' + ORDER_ID + '/returns/').then(function (d) {
        rmaRows = d.rows;
        document.getElementById('rma-body').innerHTML = rmaRows.length ? rmaRows.map(rmaCard).join('') : '<div class="p-3 text-muted">' + "<%= i18n.__('orders.returns.none') %>" + '</div>';
    }).catch(function () { document.getElementById('rma-body').innerHTML = '<div class="p-3 text-danger">' + "<%= i18n.__('orders.page.load_error') %>" + '</div>'; });
}
function rmaCard(r) {
    const edit = RF.canEdit && RMA_EDITABLE.includes(r.status);
    const items = r.items.map(function (x, i) {
        const cond = edit
            ? '<select class="form-select form-select-sm rounded-0 w-auto" data-rma-cond="' + i + '">' + ['', 'ok', 'defect'].map(function (c) { return '<option value="' + c + '"' + ((x.condition || '') === c ? ' selected' : '') + '>' + esc(({ none: "<%= i18n.__('orders.returns.c.none') %>", ok: "<%= i18n.__('orders.returns.c.ok') %>", defect: "<%= i18n.__('orders.returns.c.defect') %>" })[c || 'none']) + '</option>'; }).join('') + '</select>'
            : (x.condition ? '<span class="badge rounded-0 text-bg-' + (x.condition === 'defect' ? 'danger' : 'success') + '">' + esc(({ none: "<%= i18n.__('orders.returns.c.none') %>", ok: "<%= i18n.__('orders.returns.c.ok') %>", defect: "<%= i18n.__('orders.returns.c.defect') %>" })[x.condition]) + '</span>' : '');
        return '<tr><td>' + esc(x.name || x.sku || '') + (x.sku ? ' <small class="text-muted">' + esc(x.sku) + '</small>' : '') + '</td><td class="text-end text-nowrap">' + Number(x.qty) + ' × ' + money(x.unit) + '</td><td style="width:200px">' + cond + '</td></tr>';
    }).join('');
    const ttn = edit
        ? '<div class="input-group input-group-sm" style="max-width:320px"><span class="input-group-text rounded-0">' + "<%= i18n.__('orders.returns.ttn') %>" + '</span><input type="text" maxlength="36" class="form-control rounded-0" data-rma-ttn value="' + esc(r.ttn || '') + '"></div>'
        : (r.ttn ? '<span class="small">' + "<%= i18n.__('orders.returns.ttn') %>" + ': ' + esc(r.ttn) + '</span>' : '');
    const track = r.ttn ? ' <a class="small ms-1" target="_blank" rel="noopener" href="https://novaposhta.ua/tracking/?cargo_number=' + encodeURIComponent(r.ttn) + '">' + "<%= i18n.__('orders.returns.track') %>" + '</a>' : '';
    const flow = RF.canEdit ? (r.flow || []).map(function (s) {
        return '<button type="button" class="btn btn-sm rounded-0 py-0 btn-outline-' + (s === 'canceled' || s === 'rejected' ? 'danger' : 'secondary') + ' js-rma-go" data-id="' + Number(r.id) + '" data-to="' + s + '">' + esc(({ awaiting: "<%= i18n.__('orders.returns.go.awaiting') %>", received: "<%= i18n.__('orders.returns.go.received') %>", checked: "<%= i18n.__('orders.returns.go.checked') %>", rejected: "<%= i18n.__('orders.returns.go.rejected') %>", closed: "<%= i18n.__('orders.returns.go.closed') %>", canceled: "<%= i18n.__('orders.returns.go.canceled') %>" })[s] || s) + '</button>';
    }).join(' ') : '';
    const resolve = RF.canEdit && r.status === 'checked'
        ? ' <button type="button" class="btn btn-sm rounded-0 py-0 btn-' + (r.type === 'return' ? '' : 'outline-') + 'danger js-rma-refund" data-id="' + Number(r.id) + '"><i class="fa-solid fa-rotate-left"></i> ' + "<%= i18n.__('orders.returns.refund') %>" + '</button>'
          + ' <button type="button" class="btn btn-sm rounded-0 py-0 btn-' + (r.type === 'exchange' ? '' : 'outline-') + 'primary js-rma-exchange" data-id="' + Number(r.id) + '"><i class="fa-solid fa-right-left"></i> ' + "<%= i18n.__('orders.returns.exchange') %>" + '</button>'
        : '';
    const result = [
        Number(r.amount) ? "<%= i18n.__('orders.returns.back') %>" + ': <b class="text-danger">' + money(r.amount) + '</b>' : '',
        Number(r.amount_due) ? "<%= i18n.__('orders.returns.due') %>" + ': <b>' + money(r.amount_due) + '</b>' : '',
        r.id_exchange_order ? "<%= i18n.__('orders.returns.exchange_order') %>" + ': <a href="/orders/' + Number(r.id_exchange_order) + '/">' + esc(r.exchange_reference || '#' + r.id_exchange_order) + '</a>' : '',
    ].filter(Boolean).join(' · ');
    return '<div class="border-bottom p-2" data-rma="' + Number(r.id) + '">'
        + '<div class="d-flex flex-wrap align-items-center gap-2 mb-1"><b>' + esc(r.number) + '</b>'
        + '<span class="badge rounded-0 text-bg-light border">' + esc(({ return: "<%= i18n.__('orders.returns.t.return') %>", exchange: "<%= i18n.__('orders.returns.t.exchange') %>" })[r.type] || r.type) + '</span>'
        + '<span class="badge rounded-0 text-bg-' + (RMA_BADGE[r.status] || 'secondary') + '">' + esc(({ new: "<%= i18n.__('orders.returns.s.new') %>", awaiting: "<%= i18n.__('orders.returns.s.awaiting') %>", received: "<%= i18n.__('orders.returns.s.received') %>", checked: "<%= i18n.__('orders.returns.s.checked') %>", refunded: "<%= i18n.__('orders.returns.s.refunded') %>", exchanged: "<%= i18n.__('orders.returns.s.exchanged') %>", rejected: "<%= i18n.__('orders.returns.s.rejected') %>", closed: "<%= i18n.__('orders.returns.s.closed') %>", canceled: "<%= i18n.__('orders.returns.s.canceled') %>" })[r.status] || r.status) + '</span>'
        + '<span class="small">' + esc(({ size: "<%= i18n.__('orders.returns.r.size') %>", defect: "<%= i18n.__('orders.returns.r.defect') %>", not_as_described: "<%= i18n.__('orders.returns.r.not_as_described') %>", wrong_item: "<%= i18n.__('orders.returns.r.wrong_item') %>", damaged: "<%= i18n.__('orders.returns.r.damaged') %>", changed_mind: "<%= i18n.__('orders.returns.r.changed_mind') %>", other: "<%= i18n.__('orders.returns.r.other') %>" })[r.reason] || r.reason) + '</span>'
        + '<small class="text-muted ms-auto">' + esc(new Date(r.date_add).toLocaleString()) + (r.user_name ? ' · ' + esc(r.user_name) : '') + '</small></div>'
        + '<table class="table table-sm mb-1"><tbody>' + items + '</tbody></table>'
        + '<div class="small text-muted mb-1">' + "<%= i18n.__('orders.returns.value') %>" + ': ' + money(rmaValue(r)) + (result ? ' · ' + result : '') + '</div>'
        + (edit
            ? '<textarea rows="1" maxlength="2000" class="form-control form-control-sm rounded-0 mb-1" data-rma-comment placeholder="' + "<%= i18n.__('orders.returns.comment') %>" + '">' + esc(r.comment || '') + '</textarea>'
            : (r.comment ? '<div class="small mb-1"><i>' + esc(r.comment) + '</i></div>' : ''))
        + '<div class="d-flex flex-wrap align-items-center gap-1">' + ttn + track
        + (edit ? ' <button type="button" class="btn btn-sm btn-outline-primary rounded-0 py-0 js-rma-save" data-id="' + Number(r.id) + '"><i class="fa-solid fa-floppy-disk"></i> ' + "<%= i18n.__('orders.returns.save') %>" + '</button>' : '')
        + '<span class="ms-auto"></span>' + flow + resolve + '</div>'
        + '</div>';
}
// Поточні значення полів картки заявки
function rmaFields(id) {
    const box = document.querySelector('[data-rma="' + id + '"]');
    const body = {};
    const ttn = box.querySelector('[data-rma-ttn]');
    const comment = box.querySelector('[data-rma-comment]');
    const conds = box.querySelectorAll('[data-rma-cond]');
    if (ttn) body.ttn = ttn.value;
    if (comment) body.comment = comment.value;
    if (conds.length) body.conditions = Array.prototype.map.call(conds, function (el) { return el.value; });
    return body;
}
function rmaCreateTotal() {
    let sum = 0;
    document.querySelectorAll('#rma-items input[data-item]').forEach(function (el) { sum += Number(el.value || 0) * Number(el.dataset.unit); });
    document.getElementById('rma-total').textContent = "<%= i18n.__('orders.returns.value') %>" + ': ' + money(sum);
}

// Обмін: вибрані товари й підсумок
let rmaEx = [];
let rmaExTimer = null;
function rmaExRender() {
    document.getElementById('rma-ex-items').innerHTML = rmaEx.map(function (x, i) {
        return '<tr><td>' + esc(x.name) + (x.sku ? ' <small class="text-muted">' + esc(x.sku) + '</small>' : '') + '</td>'
            + '<td><input type="number" min="0" step="0.01" class="form-control form-control-sm rounded-0" data-ex-price="' + i + '" value="' + Number(x.price) + '"></td>'
            + '<td><input type="number" min="1" step="1" class="form-control form-control-sm rounded-0" data-ex-qty="' + i + '" value="' + Number(x.quantity) + '"></td>'
            + '<td><button type="button" class="btn btn-sm btn-link text-danger p-0" data-ex-del="' + i + '"><i class="fa-solid fa-xmark"></i></button></td></tr>';
    }).join('');
    rmaExSum();
}
function rmaExSum() {
    const credit = rmaCurrent ? rmaValue(rmaCurrent) : 0;
    const total = rmaEx.reduce(function (s, x) { return s + Number(x.price) * Number(x.quantity); }, 0) + Number(document.getElementById('rma-ex-shipping').value || 0);
    const diff = total - credit;
    document.getElementById('rma-ex-sum').innerHTML = "<%= i18n.__('orders.returns.credit') %>" + ': <b>' + money(Math.min(credit, total)) + '</b> · ' + "<%= i18n.__('orders.returns.new_total') %>" + ': <b>' + money(total) + '</b><br>'
        + (diff > 0.004 ? "<%= i18n.__('orders.returns.due') %>" + ': <b>' + money(diff) + '</b>' : diff < -0.004 ? "<%= i18n.__('orders.returns.back') %>" + ': <b class="text-danger">' + money(-diff) + '</b>' : '');
}

document.addEventListener('click', function (e) {
    if (e.target.closest('#rma-open')) {
        rfPost('/api/orders/' + ORDER_ID + '/returns/form/').then(function (d) {
            document.getElementById('rma-reason').innerHTML = d.reasons.map(function (k) { return '<option value="' + k + '">' + esc(({ size: "<%= i18n.__('orders.returns.r.size') %>", defect: "<%= i18n.__('orders.returns.r.defect') %>", not_as_described: "<%= i18n.__('orders.returns.r.not_as_described') %>", wrong_item: "<%= i18n.__('orders.returns.r.wrong_item') %>", damaged: "<%= i18n.__('orders.returns.r.damaged') %>", changed_mind: "<%= i18n.__('orders.returns.r.changed_mind') %>", other: "<%= i18n.__('orders.returns.r.other') %>" })[k] || k) + '</option>'; }).join('');
            document.getElementById('rma-items').innerHTML = d.items.map(function (it) {
                return '<tr><td>' + esc(it.name) + (it.sku ? '<br><small class="text-muted">' + esc(it.sku) + '</small>' : '') + '</td>'
                    + '<td class="text-end">' + it.quantity + (it.returned ? ' <small class="text-muted">(−' + it.returned + ')</small>' : '') + '</td><td class="text-end">' + (it.in_requests || 0) + '</td><td class="text-end">' + money(it.unit) + '</td>'
                    + '<td><input type="number" class="form-control form-control-sm rounded-0" min="0" max="' + it.available + '" step="1" value="0" data-item="' + it.id + '" data-unit="' + it.unit + '"' + (it.available > 0 ? '' : ' disabled') + '></td></tr>';
            }).join('');
            ['rma-ttn', 'rma-comment'].forEach(function (id) { document.getElementById(id).value = ''; });
            document.getElementById('rma-type').value = 'return';
            rmaCreateTotal();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('rma-modal')).show();
        }).catch(rfErr);
        return;
    }
    const byId = function (el) { return rmaRows.find(function (x) { return Number(x.id) === Number(el.dataset.id); }); };
    const save = e.target.closest('.js-rma-save');
    if (save) {
        rfPost(rmaUrl(byId(save), 'update'), rmaFields(save.dataset.id)).then(rmaLoad).catch(rfErr);
        return;
    }
    const go = e.target.closest('.js-rma-go');
    if (go) {
        if (!confirm(rmaFill("<%= i18n.__('orders.returns.confirm_status') %>", { status: ({ new: "<%= i18n.__('orders.returns.s.new') %>", awaiting: "<%= i18n.__('orders.returns.s.awaiting') %>", received: "<%= i18n.__('orders.returns.s.received') %>", checked: "<%= i18n.__('orders.returns.s.checked') %>", refunded: "<%= i18n.__('orders.returns.s.refunded') %>", exchanged: "<%= i18n.__('orders.returns.s.exchanged') %>", rejected: "<%= i18n.__('orders.returns.s.rejected') %>", closed: "<%= i18n.__('orders.returns.s.closed') %>", canceled: "<%= i18n.__('orders.returns.s.canceled') %>" })[go.dataset.to] || go.dataset.to }))) return;
        rfPost(rmaUrl(byId(go), 'update'), Object.assign(rmaFields(go.dataset.id), { to: go.dataset.to })).then(rmaLoad).catch(rfErr);
        return;
    }
    const rf = e.target.closest('.js-rma-refund');
    if (rf) {
        rmaCurrent = byId(rf);
        document.getElementById('rma-refund-title').textContent = rmaFill("<%= i18n.__('orders.returns.refund_title') %>", { number: rmaCurrent.number });
        document.getElementById('rma-refund-info').innerHTML = rmaCurrent.items.map(function (x) { return esc(x.name) + ' × ' + Number(x.qty) + (x.condition === 'defect' ? ' <span class="badge text-bg-danger rounded-0">' + "<%= i18n.__('orders.returns.defect') %>" + '</span>' : ''); }).join('<br>')
            + '<div class="mt-1">' + "<%= i18n.__('orders.returns.value') %>" + ': <b>' + money(rmaValue(rmaCurrent)) + '</b></div>';
        ['rma-refund-amount', 'rma-refund-transaction'].forEach(function (id) { document.getElementById(id).value = ''; });
        document.getElementById('rma-refund-shipping').value = 0;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('rma-refund-modal')).show();
        return;
    }
    const ex = e.target.closest('.js-rma-exchange');
    if (ex) {
        rmaCurrent = byId(ex);
        // За замовчуванням — ті самі товари (обмін на інший розмір / екземпляр), ціни як у поверненні
        rmaEx = rmaCurrent.items.map(function (x) { return { sku: x.sku || '', name: x.name, price: Number(x.unit) || 0, quantity: Number(x.qty) }; });
        document.getElementById('rma-exchange-title').textContent = rmaFill("<%= i18n.__('orders.returns.exchange_title') %>", { number: rmaCurrent.number });
        document.getElementById('rma-ex-shipping').value = 0;
        document.getElementById('rma-ex-search').value = '';
        rmaExRender();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('rma-exchange-modal')).show();
        return;
    }
    const pick = e.target.closest('[data-ex-pick]');
    if (pick) {
        const p = JSON.parse(pick.dataset.exPick);
        rmaEx.push({ sku: p.sku || '', name: p.name, price: Number(p.price) || 0, quantity: 1 });
        document.getElementById('rma-ex-found').classList.add('d-none');
        document.getElementById('rma-ex-search').value = '';
        rmaExRender();
        return;
    }
    const del = e.target.closest('[data-ex-del]');
    if (del) { rmaEx.splice(Number(del.dataset.exDel), 1); rmaExRender(); }
});
document.addEventListener('input', function (e) {
    if (e.target.closest('#rma-form')) rmaCreateTotal();
    if (e.target.dataset.exPrice !== undefined) { rmaEx[Number(e.target.dataset.exPrice)].price = Number(e.target.value || 0); rmaExSum(); }
    if (e.target.dataset.exQty !== undefined) { rmaEx[Number(e.target.dataset.exQty)].quantity = Math.max(1, parseInt(e.target.value, 10) || 1); rmaExSum(); }
    if (e.target.id === 'rma-ex-shipping') rmaExSum();
    if (e.target.id === 'rma-ex-search') {
        clearTimeout(rmaExTimer);
        const q = e.target.value.trim();
        const box = document.getElementById('rma-ex-found');
        if (q.length < 2) { box.classList.add('d-none'); return; }
        rmaExTimer = setTimeout(function () {
            rfPost('/api/orders/products/search/', { q: q }).catch(function () { return { rows: [] }; }).then(function (d) {
                box.innerHTML = (d.rows || []).map(function (p) {
                    return '<button type="button" class="list-group-item list-group-item-action rounded-0 py-1 small" data-ex-pick="' + esc(JSON.stringify(p)) + '">' + esc(p.name) + ' <span class="text-muted">' + esc(p.sku || '') + '</span><span class="float-end">' + money(p.price) + '</span></button>';
                }).join('');
                box.classList.toggle('d-none', !(d.rows || []).length);
            });
        }, 300);
    }
});
document.addEventListener('submit', function (e) {
    if (e.target.id === 'rma-form') {
        e.preventDefault();
        const items = [];
        document.querySelectorAll('#rma-items input[data-item]').forEach(function (el) { if (Number(el.value) > 0) items.push({ id_item: Number(el.dataset.item), qty: Number(el.value) }); });
        const btn = document.getElementById('rma-submit');
        btn.disabled = true;
        rfPost('/api/orders/' + ORDER_ID + '/returns/create/', {
            type: document.getElementById('rma-type').value,
            reason: document.getElementById('rma-reason').value,
            ttn: document.getElementById('rma-ttn').value,
            comment: document.getElementById('rma-comment').value,
            items: items,
        }).then(function () {
            bootstrap.Modal.getInstance(document.getElementById('rma-modal')).hide();
            rmaLoad();
        }).catch(rfErr).finally(function () { btn.disabled = false; });
    }
    if (e.target.id === 'rma-refund-form') {
        e.preventDefault();
        const body = { shipping: Number(document.getElementById('rma-refund-shipping').value || 0), transaction_id: document.getElementById('rma-refund-transaction').value };
        const amount = document.getElementById('rma-refund-amount').value;
        if (amount !== '') body.amount = Number(amount);
        const btn = document.getElementById('rma-refund-submit');
        btn.disabled = true;
        rfPost(rmaUrl(rmaCurrent, 'refund'), body).then(function () { location.reload(); }).catch(function (err) { btn.disabled = false; rfErr(err); });
    }
    if (e.target.id === 'rma-exchange-form') {
        e.preventDefault();
        const btn = document.getElementById('rma-ex-submit');
        btn.disabled = true;
        rfPost(rmaUrl(rmaCurrent, 'exchange'), { items: rmaEx, shipping: Number(document.getElementById('rma-ex-shipping').value || 0) })
            .then(function (d) { location.href = '/orders/' + Number(d.order.id) + '/'; })
            .catch(function (err) { btn.disabled = false; rfErr(err); });
    }
});
rmaLoad();

// ── ДЕЛЕГУВАННЯ ПОДІЙ (замість inline onclick — сумісно з CSP) ──
document.addEventListener('click', function(e) {
    const el = e.target.closest('[data-action]');
    if (!el) return;
    switch (el.dataset.action) {
        case 'apply-status':       applyStatus(); break;
        case 'load-events':        loadEvents(); break;
        case 'load-raw':           loadRaw(); break;
        case 'link-client':        linkClient(Number(el.dataset.id)); break;
        case 'unlink-client':      unlinkClient(); break;
        case 'open-client-search': openClientSearch(); break;
        case 'create-client':      createClient(); break;
        case 'load-client':        loadClient(); break;
    }
});

// ── СТАТУС ────────────────────────────────────────────────
function applyStatus() {
    const id_status = document.getElementById('new-status').value;
    const comment   = document.getElementById('status-comment').value;
    const notify    = document.getElementById('status-notify').checked;

    fetch('/api/orders/' + ORDER_ID + '/status/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_status, comment, notify })
    }).then(r => r.json()).then(function(d) {
        if (d.status === 'success') {
            document.getElementById('status-comment').value = '';
            document.getElementById('status-notify').checked = false;
            if (historyTable) historyTable.setData('/api/orders/' + ORDER_ID + '/history/', {}, 'POST');
            // Оновлюємо бейдж поточного статусу з випадайки
            const opt = document.querySelector('#new-status option[value="' + d.id_status + '"]');
            if (opt) document.getElementById('current-status-badge').textContent = opt.textContent.trim();
        } else {
            alert(d.message || d.error || "<%= i18n.__('orders.page.error') %>");
        }
        eventsLoaded = false;
        if (document.getElementById('tab-events').classList.contains('active')) loadEvents();
    });
}

// ── ДЕТАЛІ (товари/оплати/доставка/повернення+документи) — ліниво ──
function renderDetails(d) {
    // Товари
    if (!d.items.length) {
        document.getElementById('items-body').innerHTML = '<div class="p-3 text-muted">' + "<%= i18n.__('orders.page.no_items') %>" + '</div>';
    } else {
        let sum = 0;
        let rows = d.items.map(function(it) {
            sum += Number(it.total);
            let attrs = '';
            if (it.attributes) { try { attrs = Object.entries(it.attributes).map(([k,v]) => esc(k)+': '+esc(v)).join(', '); } catch(e){} }
            return '<tr>'
                 + '<td>' + esc(it.name) + (attrs ? '<br><small class="text-muted">'+attrs+'</small>' : '') + '</td>'
                 + '<td>' + esc(it.sku || '—') + '</td>'
                 + '<td class="text-end">' + Number(it.quantity) + '</td>'
                 + '<td class="text-end text-nowrap">' + money(it.unit_price_wt) + '</td>'
                 + '<td class="text-end text-nowrap">' + (Number(it.discount) ? '−'+money(it.discount) : '—') + '</td>'
                 + '<td class="text-end fw-semibold text-nowrap">' + money(it.total) + '</td>'
                 + '</tr>';
        }).join('');
        let totals = d.totals.map(t =>
            '<tr><td colspan="5" class="text-end text-muted">'+esc(t.title)+'</td><td class="text-end text-nowrap">'+money(t.value)+'</td></tr>'
        ).join('');
        // Знижки замовлення (купон, сертифікат, бали): назва, код, сума
        if (d.discounts && d.discounts.length) {
            totals += '<tr><td colspan="6" class="small text-muted pt-2">' + "<%= i18n.__('orders.events.discounts') %>" + ': ' + d.discounts.map(function (x) {
                return esc(x.name || x.type) + (x.code ? ' <code>' + esc(x.code) + '</code>' : '') + ' <span class="text-danger text-nowrap">−' + money(x.value) + '</span>';
            }).join(' · ') + '</td></tr>';
        }
        document.getElementById('items-body').innerHTML =
            '<table class="table table-sm mb-0"><thead><tr>'
          + '<th>' + "<%= i18n.__('orders.page.col_name') %>" + '</th><th>SKU</th><th class="text-end">' + "<%= i18n.__('orders.page.col_qty') %>" + '</th><th class="text-end">' + "<%= i18n.__('orders.page.col_price') %>" + '</th><th class="text-end">' + "<%= i18n.__('orders.page.col_discount') %>" + '</th><th class="text-end">' + "<%= i18n.__('orders.page.col_total') %>" + '</th>'
          + '</tr></thead><tbody>' + rows + totals + '</tbody></table>';

        // Перевірка «здоровʼя» сум: сума позицій vs total_products
        if (Math.abs(sum - TOTAL_PRODUCTS) > 0.01) {
            document.getElementById('sum-warn').classList.remove('d-none');
        }
    }

    // Оплати
    const payBadge = { paid:'success', pending:'secondary', authorized:'info', failed:'danger', refunded:'danger', partially_refunded:'warning' };
    document.getElementById('payments-body').innerHTML = d.payments.length
