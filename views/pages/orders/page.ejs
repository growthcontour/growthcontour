// ── ЖУРНАЛ ПОДІЙ (ліниво) ──
var eventsLoaded = false;
function loadEvents() {
    if (eventsLoaded) return; eventsLoaded = true;
    fetch('/api/orders/' + ORDER_ID + '/events/', { method: 'POST' })
        .then(r => r.json()).then(function(rows) {
            document.getElementById('events-list').innerHTML = rows.length
                ? '<table class="table table-sm align-middle mb-0"><tbody>' + rows.map(function(e) {
                    let p = e.payload;
                    if (typeof p === 'string') { try { p = JSON.parse(p); } catch (x) { p = null; } }
                    return '<tr><td class="text-nowrap text-muted small" style="width:150px">' + esc(e.date_add) + '</td>'
                         + '<td style="width:180px"><span class="badge rounded-0 text-bg-' + (EV_COLOR[e.type] || 'secondary') + '">' + esc(({ created: "<%= i18n.__('orders.events.types.created') %>", updated: "<%= i18n.__('orders.events.types.updated') %>", status_change: "<%= i18n.__('orders.events.types.status_change') %>", taken: "<%= i18n.__('orders.events.types.taken') %>", released: "<%= i18n.__('orders.events.types.released') %>", client_linked: "<%= i18n.__('orders.events.types.client_linked') %>", client_created: "<%= i18n.__('orders.events.types.client_created') %>", client_unlinked: "<%= i18n.__('orders.events.types.client_unlinked') %>", refund: "<%= i18n.__('orders.events.types.refund') %>", refund_canceled: "<%= i18n.__('orders.events.types.refund_canceled') %>", item_mapped: "<%= i18n.__('orders.events.types.item_mapped') %>", warehouse_change: "<%= i18n.__('orders.events.types.warehouse_change') %>", ttn_created: "<%= i18n.__('orders.events.types.ttn_created') %>", ttn_deleted: "<%= i18n.__('orders.events.types.ttn_deleted') %>", assigned: "<%= i18n.__('orders.events.types.assigned') %>", merged: "<%= i18n.__('orders.events.types.merged') %>", merged_into: "<%= i18n.__('orders.events.types.merged_into') %>", rma: "<%= i18n.__('orders.events.types.rma') %>" })[e.type] || e.type) + '</span></td>'
                         + '<td class="small">' + eventText(e.type, p || {}) + '</td>'
                         + '<td class="text-nowrap small text-muted text-end">' + esc(e.user_name || (e.source === 'webhook' ? "<%= i18n.__('orders.events.site') %>" : "<%= i18n.__('orders.events.system') %>")) + '</td></tr>';
                  }).join('') + '</tbody></table>'
                : '<p class="text-muted">' + "<%= i18n.__('orders.events.empty') %>" + '</p>';
        });
}
const EV_COLOR = { created: 'primary', updated: 'info', status_change: 'primary', taken: 'success', released: 'secondary', refund: 'danger', refund_canceled: 'warning', ttn_created: 'success', ttn_deleted: 'warning', assigned: 'info', merged: 'primary', merged_into: 'warning', client_linked: 'info', client_created: 'info', client_unlinked: 'warning', rma: 'dark' };
// Людський опис події: що саме змінилось
function eventText(type, p) {
    const st = (id) => esc(STATUS_NAMES[id] || ('#' + id));
    switch (type) {
        case 'status_change': return st(p.before) + ' → ' + st(p.after) + (p.comment ? ' · <i>' + esc(p.comment) + '</i>' : '') + (p.notify ? ' · ' + "<%= i18n.__('orders.events.notified') %>" : '');
        case 'client_linked': case 'client_created': return p.id_client ? '<a href="/clients/' + Number(p.id_client) + '/">#' + Number(p.id_client) + '</a>' : '';
        case 'client_unlinked': return p.prev_client ? '#' + Number(p.prev_client) : '';
        case 'refund': return esc(p.number || '') + ' · −' + money(p.amount) + (p.items && p.items.length ? ' · ' + p.items.map((x) => esc(x.name || x.sku || '') + ' × ' + Number(x.qty)).join(', ') : '');
        case 'refund_canceled': return esc(p.number || '');
        case 'rma': return esc(p.number || '')
            + (p.to ? ' · ' + (p.from ? esc(({ new: "<%= i18n.__('orders.returns.s.new') %>", awaiting: "<%= i18n.__('orders.returns.s.awaiting') %>", received: "<%= i18n.__('orders.returns.s.received') %>", checked: "<%= i18n.__('orders.returns.s.checked') %>", refunded: "<%= i18n.__('orders.returns.s.refunded') %>", exchanged: "<%= i18n.__('orders.returns.s.exchanged') %>", rejected: "<%= i18n.__('orders.returns.s.rejected') %>", closed: "<%= i18n.__('orders.returns.s.closed') %>", canceled: "<%= i18n.__('orders.returns.s.canceled') %>" })[p.from] || p.from) + ' → ' : '') + esc(({ new: "<%= i18n.__('orders.returns.s.new') %>", awaiting: "<%= i18n.__('orders.returns.s.awaiting') %>", received: "<%= i18n.__('orders.returns.s.received') %>", checked: "<%= i18n.__('orders.returns.s.checked') %>", refunded: "<%= i18n.__('orders.returns.s.refunded') %>", exchanged: "<%= i18n.__('orders.returns.s.exchanged') %>", rejected: "<%= i18n.__('orders.returns.s.rejected') %>", closed: "<%= i18n.__('orders.returns.s.closed') %>", canceled: "<%= i18n.__('orders.returns.s.canceled') %>" })[p.to] || p.to) : '')
            + (p.ttn ? ' · ' + esc(p.ttn) : '')
            + (p.id_exchange ? ' · <a href="/orders/' + Number(p.id_exchange) + '/">' + esc(p.exchange_reference || '#' + p.id_exchange) + '</a>' : '')
            + (p.exchange_of ? ' · ' + "<%= i18n.__('orders.returns.exchange_order') %>" + ' ← <a href="/orders/' + Number(p.exchange_of) + '/">' + esc(p.exchange_of_reference || '#' + p.exchange_of) + '</a>' : '');
        case 'taken': return p.from_name ? "<%= i18n.__('orders.events.taken_from') %>" + ' ' + esc(p.from_name) : '';
        case 'ttn_created': case 'ttn_deleted': return p.number ? esc(p.number) : '';
        case 'assigned': return esc(p.from_name || '—') + ' → ' + esc(p.to_name || '—');
        case 'merged': return (p.orders || []).map((o) => '<a href="/orders/' + Number(o.id) + '/">' + esc(o.reference || '#' + o.id) + '</a>').join(', ');
        case 'merged_into': return '<a href="/orders/' + Number(p.id) + '/">' + esc(p.reference || '#' + p.id) + '</a>';
        case 'created': return p.via ? esc(p.via) : '';
        default: {
            const t = JSON.stringify(p);
            return t && t !== '{}' ? '<small class="text-muted">' + esc(t.length > 300 ? t.slice(0, 300) + '…' : t) + '</small>' : '';
        }
    }
}

// ── RAW PAYLOAD (ліниво) ──
var rawLoaded = false;
function loadRaw() {
    if (rawLoaded) return; rawLoaded = true;
    fetch('/api/orders/' + ORDER_ID + '/raw/', { method: 'POST' })
        .then(r => r.json()).then(function(d) {
            document.getElementById('raw-box').textContent = d.payload
                ? JSON.stringify(d.payload, null, 2)
                : "<%= i18n.__('orders.page.no_raw') %>";
        });
}

// ============================================================
// КЛІЄНТ У ЗАМОВЛЕННІ
// ============================================================
const confBadge = { high: 'text-bg-success', medium: 'text-bg-warning', low: 'text-bg-secondary' };
const confText  = { high: "<%= i18n.__('orders.page.conf_high') %>", medium: "<%= i18n.__('orders.page.conf_medium') %>", low: "<%= i18n.__('orders.page.conf_low') %>" };
const reasonMap = {
    email: 'email', phone: "<%= i18n.__('orders.page.r_phone') %>", name: "<%= i18n.__('orders.page.r_name') %>",
    same_phone: "<%= i18n.__('orders.page.r_phone') %>", same_email: 'email', same_telegram: 'Telegram', same_instagram: 'Instagram',
    same_external_site: "<%= i18n.__('orders.page.r_site') %>", same_edrpou: "<%= i18n.__('orders.page.r_edrpou') %>", same_tax_id: "<%= i18n.__('orders.page.r_tax') %>"
};

const money2 = (v, cur) => money(v, cur || '');

// Один рядок кандидата/результату пошуку з кнопкою «Привʼязати»
function clientRow(c, withReasons) {
    let meta = [];
    if (c.company) meta.push(esc(c.company));
    if (c.orders_count != null) meta.push(c.orders_count + ' ' + "<%= i18n.__('orders.page.orders_short') %>");
    if (c.total_spent != null) meta.push('LTV ' + MONEY.format(Number(c.total_spent) || 0));
    let reasons = '';
    if (withReasons && c.reasons && c.reasons.length) {
        reasons = ' ' + c.reasons.map(r => '<span class="badge rounded-0 text-bg-light border">' + (reasonMap[r] || r) + '</span>').join(' ');
    }
    let conf = '';
    if (withReasons && c.confidence) {
        conf = '<span class="badge rounded-0 ' + (confBadge[c.confidence] || 'text-bg-secondary') + '">' + (confText[c.confidence] || '') + '</span>';
    }
    return '<div class="d-flex justify-content-between align-items-center border-bottom py-2">'
         + '<div><div class="fw-semibold">' + esc(c.display_name || ((c.firstname||'') + ' ' + (c.lastname||''))) + ' '
         + (c.is_vip ? '<i class="fa-solid fa-star text-warning" title="VIP"></i>' : '') + '</div>'
         + '<div class="small text-muted">' + esc(c.phone || '') + (c.email ? ' · ' + esc(c.email) : '') + '</div>'
         + (meta.length ? '<div class="small text-muted">' + meta.join(' · ') + '</div>' : '')
         + (reasons ? '<div class="mt-1">' + conf + reasons + '</div>' : '')
         + '</div>'
         + '<button class="btn btn-sm btn-primary rounded-0" data-action="link-client" data-id="' + c.id + '">' + "<%= i18n.__('orders.page.link') %>" + '</button>'
         + '</div>';
}

// Завантаження стану блоку клієнта
function loadClient() {
    document.getElementById('client-body').innerHTML = '<div class="spinner-wrap"><span class="spinner-border spinner-border-sm"></span></div>';
    fetch('/orders/' + ORDER_ID + '/client/', { method: 'POST' })
        .then(r => r.json())
        .then(function(d) {
            // Снапшот — завжди
            renderSnapshot(d.snapshot || {});

            if (d.linked && d.client) {
                renderLinkedClient(d.client);
            } else {
                renderUnlinked(d.candidates || []);
            }
        })
        .catch(() => {
            document.getElementById('client-body').innerHTML = '<div class="text-danger small p-2">' + "<%= i18n.__('orders.page.load_error') %>" + '</div>';
        });
}

// Снапшот контакту з замовлення
function renderSnapshot(s) {
    const rows = [
        ["<%= i18n.__('orders.page.f_name') %>", [s.firstname, s.lastname].filter(Boolean).join(' ')],
        ["<%= i18n.__('orders.page.f_company') %>", s.company],
        ["<%= i18n.__('orders.page.f_phone') %>", s.phone],
        ['Email', s.email],
    ].filter(r => r[1]);
    document.getElementById('snapshot-body').innerHTML = rows.length
        ? '<table class="table table-sm table-borderless kv mb-0">' + rows.map(r =>
            '<tr><td class="k">' + esc(r[0]) + '</td><td>' + esc(r[1]) + '</td></tr>').join('') + '</table>'
        : '<span class="text-muted small">' + "<%= i18n.__('orders.page.no_contact') %>" + '</span>';
}

// Стан: клієнт прив'язаний → жива картка
function renderLinkedClient(c) {
    document.getElementById('client-badge').innerHTML =
        '<span class="badge rounded-0 text-bg-success">' + "<%= i18n.__('orders.page.linked') %>" + '</span>';
    const orders = (c.orders_valid_count || 0) + (c.orders_count !== c.orders_valid_count ? ' / ' + (c.orders_count || 0) : '');
    document.getElementById('client-body').innerHTML =
        '<div class="d-flex justify-content-between align-items-start">'
      + '<div><div class="fw-semibold fs-6">' + esc(c.display_name) + ' '
      + (c.is_vip ? '<i class="fa-solid fa-crown text-warning" title="VIP"></i>' : '') + '</div>'
      + '<div class="small text-muted">' + esc(c.phone || '') + (c.email ? ' · ' + esc(c.email) : '') + '</div></div>'
      + '<a href="/clients/' + c.id + '/" class="btn btn-sm btn-outline-primary rounded-0" title="' + "<%= i18n.__('orders.page.client_card') %>" + '"><i class="fa-solid fa-up-right-from-square"></i></a>'
      + '</div>'
      + '<table class="table table-sm table-borderless kv mt-2 mb-2">'
      + (c.group_name ? '<tr><td class="k">' + "<%= i18n.__('orders.page.price_group') %>" + '</td><td>' + esc(c.group_name) + '</td></tr>' : '')
      + '<tr><td class="k">' + "<%= i18n.__('orders.page.orders_count') %>" + '</td><td>' + orders + '</td></tr>'
      + '<tr><td class="k">' + "<%= i18n.__('orders.page.revenue') %>" + '</td><td>' + money2(c.total_spent, c.balance_currency) + '</td></tr>'
      + '</table>'
      + '<button class="btn btn-sm btn-outline-danger rounded-0 w-100" data-action="unlink-client">'
      + '<i class="fa-solid fa-link-slash me-1"></i>' + "<%= i18n.__('orders.page.unlink') %>" + '</button>';
}

// Стан: не прив'язаний → автозбіги + дії
function renderUnlinked(candidates) {
    document.getElementById('client-badge').innerHTML =
        '<span class="badge rounded-0 text-bg-secondary">' + "<%= i18n.__('orders.page.guest') %>" + '</span>';

    let html = '';
    if (candidates.length) {
        html += '<div class="section-title">' + "<%= i18n.__('orders.page.similar') %>" + '</div>';
        html += candidates.map(c => clientRow(c, true)).join('');
    } else {
        html += '<p class="text-muted small mb-2">' + "<%= i18n.__('orders.page.no_matches') %>" + '</p>';
    }
    html += '<div class="d-flex gap-2 mt-3">'
          + '<button class="btn btn-sm btn-outline-secondary rounded-0 flex-fill" data-action="open-client-search"><i class="fa-solid fa-magnifying-glass me-1"></i>' + "<%= i18n.__('orders.page.find') %>" + '</button>'
          + '<button class="btn btn-sm btn-primary rounded-0 flex-fill" data-action="create-client"><i class="fa-solid fa-user-plus me-1"></i>' + "<%= i18n.__('orders.page.create') %>" + '</button>'
          + '</div>';
    document.getElementById('client-body').innerHTML = html;
}

// Дія: прив'язати
function linkClient(id_client) {
    fetch('/api/orders/' + ORDER_ID + '/client/link/', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_client })
    }).then(r => r.json()).then(function(d) {
        if (d.status === 'success') {
            bootstrap.Modal.getInstance(document.getElementById('client-search-modal'))?.hide();
            loadClient();
        } else alert(d.message || "<%= i18n.__('orders.page.error') %>");
    });
}

// Дія: відв'язати
function unlinkClient() {
    if (!confirm("<%= i18n.__('orders.page.unlink_q') %>")) return;
    fetch('/api/orders/' + ORDER_ID + '/client/unlink/', { method: 'POST' })
        .then(r => r.json()).then(function(d) {
            if (d.status === 'success') loadClient(); else alert(d.message || "<%= i18n.__('orders.page.error') %>");
        });
}

// Дія: створити зі снапшоту (з обробкою дубля 409)
function createClient() {
    fetch('/api/orders/' + ORDER_ID + '/client/create/', { method: 'POST' })
        .then(async r => ({ ok: r.ok, status: r.status, data: await r.json() }))
        .then(function(res) {
            if (res.data.status === 'success') { loadClient(); return; }
            if (res.status === 409 && res.data.candidates) {
                // Дубль знайдено — пропонуємо прив'язати наявного
                const list = res.data.candidates.map(c => clientRow(c, false)).join('');
                document.getElementById('client-body').innerHTML =
                    '<div class="alert alert-warning rounded-0 small mb-2">' + esc(res.data.message) + '</div>' + list
                  + '<button class="btn btn-sm btn-outline-secondary rounded-0 w-100 mt-2" data-action="load-client">' + "<%= i18n.__('orders.page.back') %>" + '</button>';
            } else alert(res.data.message || "<%= i18n.__('orders.page.error') %>");
        });
}

// Ручний пошук
function openClientSearch() {
    const modal = new bootstrap.Modal(document.getElementById('client-search-modal'));
    modal.show();
    document.getElementById('client-search-input').value = '';
    document.getElementById('client-search-results').innerHTML = '<p class="text-muted small mb-0">' + "<%= i18n.__('orders.page.min2') %>" + '</p>';
    setTimeout(() => document.getElementById('client-search-input').focus(), 300);
}

let searchTimer = null;
document.getElementById('client-search-input').addEventListener('input', function() {
    const q = this.value.trim();
    clearTimeout(searchTimer);
    if (q.length < 2) {
        document.getElementById('client-search-results').innerHTML = '<p class="text-muted small mb-0">' + "<%= i18n.__('orders.page.min2') %>" + '</p>';
        return;
    }
    searchTimer = setTimeout(function() {
        fetch('/api/orders/clients/search/', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ q })
        }).then(r => r.json()).then(function(rows) {
            document.getElementById('client-search-results').innerHTML = rows.length
                ? rows.map(c => clientRow(c, false)).join('')
                : '<p class="text-muted small mb-0">' + "<%= i18n.__('orders.page.nothing') %>" + '</p>';
        });
    }, 300); // debounce
});

loadClient(); // старт
</script>
<script>
/* ─── Склад замовлення ─── */
(function () {
    "use strict";
    const OID = <%= Number(order.id) %>;
    const T = {
        state: {
            none: ["secondary", "<%= i18n.__('catalog.order_stock.state.none') %>"],
            ok: ["success", "<%= i18n.__('catalog.order_stock.state.ok') %>"],
            warning: ["warning", "<%= i18n.__('catalog.order_stock.state.warning') %>"],
            error: ["danger", "<%= i18n.__('catalog.order_stock.state.error') %>"],
        },
        msg: {
            unmapped_items: "<%= i18n.__('catalog.order_stock.msg.unmapped_items') %>",
            no_warehouse: "<%= i18n.__('catalog.order_stock.msg.no_warehouse') %>",
            insufficient_to_reserve: "<%= i18n.__('catalog.order_stock.msg.insufficient_to_reserve') %>",
            insufficient_to_ship: "<%= i18n.__('catalog.order_stock.msg.insufficient_to_ship') %>",
            variant_required: "<%= i18n.__('catalog.order_stock.msg.variant_required') %>",
            exception: "<%= i18n.__('catalog.order_stock.msg.exception') %>",
        },
        src: {
            manual: "<%= i18n.__('catalog.order_stock.src.manual') %>",
            link: "<%= i18n.__('catalog.order_stock.src.link') %>",
            sku: "<%= i18n.__('catalog.order_stock.src.sku') %>",
        },
        default_wh: "<%= i18n.__('catalog.order_stock.default_warehouse') %>",
        not_mapped: "<%= i18n.__('catalog.order_stock.not_mapped') %>",
        map: "<%= i18n.__('catalog.order_stock.map') %>",
        reserved: "<%= i18n.__('catalog.order_stock.reserved') %>",
        shipped: "<%= i18n.__('catalog.order_stock.shipped') %>",
        error: "<%= i18n.__('catalog.common.error') %>",
    };
    const e = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
    const num = (v) => Number(v || 0).toLocaleString(undefined, { maximumFractionDigits: 3 });

    async function api(url, body) {
        const res = await fetch(url, { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(body || {}) });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.ok === false) throw json;
        return json;
    }
    const fail = (err) => alert((err && (err.error || err.message)) || T.error);

    let data = null;
    const whSel = document.getElementById("os-warehouse");

    function render(d) {
        data = d;
        const st = T.state[d.order.stock_state] || T.state.none;
        const badge = document.getElementById("os-state");
        badge.className = "badge rounded-0 ms-1 text-bg-" + st[0];
        badge.textContent = st[1];

        whSel.innerHTML = `<option value="">${e(T.default_wh)}</option>` + d.warehouses.map((w) => `<option value="${w.id}">${e(w.name)}${w.id === d.id_default_warehouse ? " ★" : ""}</option>`).join("");
        whSel.value = d.order.id_warehouse || "";

        document.getElementById("os-messages").innerHTML = (d.messages || [])
            .map((m) => `<div class="text-${["insufficient_to_ship", "no_warehouse", "exception"].includes(m.code) ? "danger" : "warning"}"><i class="fa-solid fa-triangle-exclamation"></i> ${e(T.msg[m.code] || m.code)}${m.count ? ": " + Number(m.count) : ""}${m.need ? ": " + num(m.need) : ""}${m.id_product ? " (#" + Number(m.id_product) + ")" : ""}${m.message ? " — " + e(m.message) : ""}</div>`)
            .join("");

        const sumBy = (list) => {
            const m = new Map();
            list.forEach((r) => m.set(r.id_product + ":" + r.id_variant, (m.get(r.id_product + ":" + r.id_variant) || 0) + Number(r.qty)));
            return m;
        };
        const res = sumBy(d.reserved);
        const shp = sumBy(d.shipped);

        document.getElementById("os-body").innerHTML = d.items.length
            ? `<table class="table table-sm mb-0 align-middle"><tbody>${d.items
                  .map((it) => {
                      const k = it.id_product + ":" + it.id_variant;
                      const product = it.id_product
                          ? `<a href="/catalog/products/${it.id_product}/" target="_blank">${e(it.product_name || "#" + it.id_product)}</a> <small class="text-muted">${e(it.variant_sku || it.product_sku || "")}</small>
                             <span class="badge rounded-0 text-bg-light border">${e(T.src[it.map_source] || it.map_source || "")}</span>`
                          : `<span class="badge rounded-0 text-bg-danger">${e(T.not_mapped)}</span>`;
                      const qty = [res.get(k) ? `<span class="badge rounded-0 text-bg-info">${e(T.reserved)} ${num(res.get(k))}</span>` : "", shp.get(k) ? `<span class="badge rounded-0 text-bg-success">${e(T.shipped)} ${num(shp.get(k))}</span>` : ""].join(" ");
                      return `<tr>
                          <td class="ps-3"><div>${e(it.name)}</div><small class="text-muted">${e(it.sku || "")} · ×${num(it.quantity)}</small></td>
                          <td>${product}<div>${qty}</div></td>
                          <td class="text-end pe-3"><button type="button" class="btn btn-sm btn-outline-primary rounded-0" data-os-map="${it.id}" title="${e(T.map)}"><i class="fa-solid fa-link"></i></button></td>
                      </tr>`;
                  })
                  .join("")}</tbody></table>`
            : `<div class="p-3 text-muted small">—</div>`;
    }

    const load = () => api(`/api/orders/${OID}/stock/`).then(render).catch(() => (document.getElementById("os-body").innerHTML = `<div class="p-3 text-danger small">${e(T.error)}</div>`));

    whSel.addEventListener("change", () => api(`/api/orders/${OID}/stock/warehouse/`, { id_warehouse: whSel.value ? Number(whSel.value) : null }).then(load).catch((err) => (fail(err), load())));
    document.getElementById("os-resync").addEventListener("click", (ev) => {
        const b = ev.currentTarget;
        b.disabled = true;
        api(`/api/orders/${OID}/stock/resync/`).then(load).catch(fail).finally(() => (b.disabled = false));
    });

    // ── Зіставлення позиції ──
    const modal = new bootstrap.Modal("#os-map-modal");
    const search = document.getElementById("os-map-search");
    const results = document.getElementById("os-map-results");
    const vBox = document.getElementById("os-map-variant-box");
    const vSel = document.getElementById("os-map-variant");
    const picked = document.getElementById("os-map-picked");
    const saveBtn = document.getElementById("os-map-save");
    let item = null;
    let product = null;

    document.getElementById("os-body").addEventListener("click", (ev) => {
        const b = ev.target.closest("[data-os-map]");
        if (!b) return;
        item = data.items.find((x) => x.id === Number(b.dataset.osMap));
        product = null;
        search.value = "";
        results.classList.add("d-none");
        vBox.classList.add("d-none");
        picked.textContent = item.id_product ? (item.product_name || "#" + item.id_product) : "";
        saveBtn.disabled = true;
        document.getElementById("os-map-item").textContent = `${item.name} · ${item.sku || "—"}${item.external_product_id ? " · ID " + item.external_product_id : ""}`;
        document.getElementById("os-map-remember-box").classList.toggle("d-none", !item.external_product_id || !data.order.id_integration);
        document.getElementById("os-map-clear").classList.toggle("d-none", !item.id_product);
        modal.show();
    });

    let t;
    search.addEventListener("input", () => {
        clearTimeout(t);
        const s = search.value.trim();
        if (s.length < 2) return results.classList.add("d-none");
        t = setTimeout(() => {
            api("/api/catalog/products/picker/search/", { search: s })
                .then((r) => {
                    results.innerHTML = r.rows.map((p) => `<button type="button" class="list-group-item list-group-item-action rounded-0" data-pid="${p.id}">${e(p.name)} <small class="text-muted">${e(p.sku || "")} #${p.id}</small></button>`).join("") || `<div class="list-group-item text-muted">—</div>`;
                    results.classList.remove("d-none");
                })
                .catch(fail);
        }, 300);
    });
    results.addEventListener("click", async (ev) => {
        const b = ev.target.closest("[data-pid]");
        if (!b) return;
        results.classList.add("d-none");
        try {
            product = (await api(`/api/catalog/products/picker/${b.dataset.pid}/`)).row;
            picked.textContent = product.name + (product.sku ? " · " + product.sku : "");
            vBox.classList.toggle("d-none", !product.variants.length);
            vSel.innerHTML = product.variants.map((v) => `<option value="${v.id}">${e(v.label)} · ${e(v.sku || "")}</option>`).join("");
            const same = product.variants.find((v) => item.sku && v.sku === item.sku);
            if (same) vSel.value = same.id;
            saveBtn.disabled = false;
        } catch (err) {
            fail(err);
        }
    });

    async function saveMap(body) {
        try {
            await api(`/api/orders/${OID}/stock/map/`, { id_item: item.id, ...body });
            modal.hide();
            load();
        } catch (err) {
            fail(err);
        }
    }
    saveBtn.addEventListener("click", () =>
        saveMap({ id_product: product.id, id_variant: product.variants.length ? Number(vSel.value) : 0, remember: document.getElementById("os-map-remember").checked })
    );
    document.getElementById("os-map-clear").addEventListener("click", () => saveMap({ id_product: null }));

    load();
})();
</script>
<script>
// ── Повідомлення клієнту (Viber / SMS через SMSClub): журнал, шаблони, ручна відправка ──
(function () {
    const B = '/api/orders/' + ORDER_ID + '/messages/';
    const $m = (id) => document.getElementById(id);
    const STATE = { pending: 'secondary', processing: 'info', sent: 'success', failed: 'danger' };
    let tpl = [];
    let loaded = false;

    async function call(url, body) {
        const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
        const r = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(r.message || 'Error');
        return r;
    }
    const state = (text, ok) => { const s = $m('msg-state'); if (s) { s.className = 'small text-' + (ok ? 'success' : 'danger'); s.textContent = text; } };

    async function load() {
        try {
            const r = await call(B);
            tpl = r.templates || [];
            if ($m('msg-template') && !loaded) {
                $m('msg-template').insertAdjacentHTML('beforeend', tpl.map((t) => '<option value="' + t.id + '">' + esc(t.name) + '</option>').join(''));
                $m('msg-service').innerHTML = (r.services || []).map((s) => '<option value="' + s.id + '">' + esc(s.name) + '</option>').join('') || '<option value="">' + "<%= i18n.__('orders.messages.no_service') %>" + '</option>';
            }
            loaded = true;
            $m('msg-list').innerHTML = r.rows.length
                ? '<table class="table table-sm align-middle mb-0"><tbody>' + r.rows.map((m) =>
                    '<tr><td class="text-nowrap small text-muted" style="width:150px">' + esc(m.sent_at || m.date_add) + '</td>'
                    + '<td style="width:120px"><span class="badge rounded-0 text-bg-' + (STATE[m.status] || 'secondary') + '">' + esc(({ title: "<%= i18n.__('orders.messages.title') %>", tab: "<%= i18n.__('orders.messages.tab') %>", help: "<%= i18n.__('orders.messages.help') %>", templates: "<%= i18n.__('orders.messages.templates') %>", add: "<%= i18n.__('orders.messages.add') %>", name: "<%= i18n.__('orders.messages.name') %>", trigger: "<%= i18n.__('orders.messages.trigger') %>", active: "<%= i18n.__('orders.messages.active') %>", service: "<%= i18n.__('orders.messages.service') %>", statuses: "<%= i18n.__('orders.messages.statuses') %>", sites: "<%= i18n.__('orders.messages.sites') %>", sites_hint: "<%= i18n.__('orders.messages.sites_hint') %>", text: "<%= i18n.__('orders.messages.text') %>", vars: "<%= i18n.__('orders.messages.vars') %>", tr_manual: "<%= i18n.__('orders.messages.tr_manual') %>", tr_new: "<%= i18n.__('orders.messages.tr_new') %>", tr_status: "<%= i18n.__('orders.messages.tr_status') %>", tr_ttn: "<%= i18n.__('orders.messages.tr_ttn') %>", tr_delivered: "<%= i18n.__('orders.messages.tr_delivered') %>", tr_returned: "<%= i18n.__('orders.messages.tr_returned') %>", save: "<%= i18n.__('orders.messages.save') %>", saved: "<%= i18n.__('orders.messages.saved') %>", delete: "<%= i18n.__('orders.messages.delete') %>", confirm_delete: "<%= i18n.__('orders.messages.confirm_delete') %>", no_templates: "<%= i18n.__('orders.messages.no_templates') %>", no_service: "<%= i18n.__('orders.messages.no_service') %>", own_text: "<%= i18n.__('orders.messages.own_text') %>", text_ph: "<%= i18n.__('orders.messages.text_ph') %>", preview: "<%= i18n.__('orders.messages.preview') %>", send: "<%= i18n.__('orders.messages.send') %>", confirm: "<%= i18n.__('orders.messages.confirm') %>", queued: "<%= i18n.__('orders.messages.queued') %>", empty: "<%= i18n.__('orders.messages.empty') %>", no_phone: "<%= i18n.__('orders.messages.no_phone') %>", auto: "<%= i18n.__('orders.messages.auto') %>", manual: "<%= i18n.__('orders.messages.manual') %>", quiet: "<%= i18n.__('orders.messages.quiet') %>", st_pending: "<%= i18n.__('orders.messages.st_pending') %>", st_processing: "<%= i18n.__('orders.messages.st_processing') %>", st_sent: "<%= i18n.__('orders.messages.st_sent') %>", st_failed: "<%= i18n.__('orders.messages.st_failed') %>", e_required: "<%= i18n.__('orders.messages.e_required') %>", e_order: "<%= i18n.__('orders.messages.e_order') %>", e_service: "<%= i18n.__('orders.messages.e_service') %>" })['st_' + m.status] || m.status) + '</span>'
                    + (m.status === 'pending' && m.attempts == 0 && m.source === 'auto' ? '<div class="small text-muted">' + "<%= i18n.__('orders.messages.quiet') %>" + '</div>' : '') + '</td>'
                    + '<td class="small" style="white-space:pre-wrap">' + esc(m.text) + (m.last_error ? '<div class="text-danger">' + esc(m.last_error) + '</div>' : '') + '</td>'
                    + '<td class="small text-muted text-end text-nowrap">' + esc(m.template || (m.source === 'auto' ? "<%= i18n.__('orders.messages.auto') %>" : "<%= i18n.__('orders.messages.manual') %>")) + '<div>' + esc(m.user_name || '') + '</div>' + esc(m.phone || '') + '</td></tr>'
                  ).join('') + '</tbody></table>'
                : '<p class="text-muted mb-0">' + "<%= i18n.__('orders.messages.empty') %>" + '</p>';
        } catch (e) {
            $m('msg-list').innerHTML = '<p class="text-danger mb-0">' + esc(e.message) + '</p>';
        }
    }

    document.querySelector('[data-bs-target="#tab-messages"]').addEventListener('shown.bs.tab', () => !loaded && load());
    if (!$m('msg-send')) return;

    $m('msg-template').addEventListener('change', function () {
        const t = tpl.find((x) => String(x.id) === this.value);
        if (t) {
            $m('msg-text').value = t.text;
            if (t.id_service) $m('msg-service').value = t.id_service;
        }
    });
    $m('msg-preview').addEventListener('click', async () => {
        try {
            const r = await call(B + 'preview/', { text: $m('msg-text').value });
            const box = $m('msg-preview-box');
            box.firstElementChild.textContent = r.text + '\n\n→ ' + (r.phone || "<%= i18n.__('orders.messages.no_phone') %>");
            box.classList.remove('d-none');
        } catch (e) { state(e.message); }
    });
    $m('msg-send').addEventListener('click', async function () {
        if (!$m('msg-text').value.trim() || !confirm("<%= i18n.__('orders.messages.confirm') %>")) return;
        this.disabled = true;
        try {
            await call(B + 'send/', { text: $m('msg-text').value, id_template: $m('msg-template').value || null, id_service: $m('msg-service').value || null });
            state("<%= i18n.__('orders.messages.queued') %>", true);
            $m('msg-text').value = '';
            $m('msg-preview-box').classList.add('d-none');
            setTimeout(load, 3000);
            load();
        } catch (e) { state(e.message); }
        finally { this.disabled = false; }
    });
})();
</script>
</body>