<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
<head>
    <title><%= i18n.__('orders.page.title') %> <%= order.reference %></title>
    <%- include('../../partials/head'); %>
    <link href="/assets/css/tabulator/tabulator.min.css" rel="stylesheet" />
    <link href="/assets/css/tabulator/tabulator_bootstrap5.min.css" rel="stylesheet" />
    <style>
        .section-title { font-size: 11px; font-weight: 700; text-transform: uppercase;
                         color: #6c757d; letter-spacing: .5px; margin-bottom: 6px; }
        .tab-content { min-height: 260px; }
        .spinner-wrap { padding: 40px; text-align: center; color: #adb5bd; }
        .kv td { padding: .25rem .5rem; font-size: 13px; }
        .kv td.k { color: #6c757d; width: 45%; }
        .badge-status { font-size: 12px; }
        .money-final { font-size: 20px; font-weight: 700; }
        .warn-sum { color: #e67e22; cursor: help; }
    </style>
</head>
<body class="d-flex flex-column h-100">
<%- include('../../partials/header'); %>

<!-- Breadcrumb -->а
		<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('orders.page.title') %> <%= order.reference %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('orders.page.breadcrumb.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/orders/"><%= i18n.__('orders.page.breadcrumb.orders') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= order.reference %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/orders/" class="btn btn-primary rounded-0">
							<i class="fa-solid fa-angle-left"></i>
						</a>
					</div>
				</div>
			</div>
		</div>
<!-- END Breadcrumb -->

<div class="container-fluid py-3">

    <!-- В роботі: хто веде замовлення; поки воно в роботі в іншого — змінювати не можна -->
    <% const lockLive = !!order.locked_by && Number(order.lock_live) === 1;
       const lockMine = lockLive && Number(order.locked_by) === Number(me);
       const lockOther = lockLive && !lockMine; %>
    <div id="order-lock" class="alert rounded-0 d-flex flex-wrap align-items-center gap-2 py-2 mb-3 <%= lockMine ? 'alert-success' : lockOther ? 'alert-warning' : 'alert-light border' %>">
        <i class="fa-solid <%= lockLive ? 'fa-user-lock' : 'fa-lock-open' %>"></i>
        <span class="me-auto"><%= lockMine ? i18n.__('orders.lock.mine') : lockOther ? i18n.__('orders.lock.busy', { name: order.locked_name || '#' + order.locked_by }) : i18n.__('orders.lock.free') %></span>
        <% if (can('orders.list', 'edit') && !lockLive) { %><button type="button" class="btn btn-sm btn-primary rounded-0" data-lock="take"><i class="fa-solid fa-hand"></i> <%= i18n.__('orders.lock.take') %></button><% } %>
        <% if (lockMine || (lockOther && can('orders.settings', 'edit'))) { %><button type="button" class="btn btn-sm btn-outline-secondary rounded-0" data-lock="release"><i class="fa-solid fa-lock-open"></i> <%= i18n.__('orders.lock.release') %></button><% } %>
        <% if (lockOther && can('orders.settings', 'edit')) { %><button type="button" class="btn btn-sm btn-outline-danger rounded-0" data-lock="force"><i class="fa-solid fa-hand"></i> <%= i18n.__('orders.lock.force') %></button><% } %>
    </div>

    <%- include('../../partials/risk', { riskUrl: '/api/orders/' + order.id + '/risk/' }) %>

    <div class="row g-3">

        <!-- ЛІВА КОЛОНКА -->
        <div class="col-12 col-xl-8">

            <!-- Шапка замовлення -->
            <div class="card rounded-0 border-primary mb-3">
                <div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
                    <span class="fw-bold fs-5">
                        <%= i18n.__('orders.title') %> <%= order.reference %>
                        <% if (order.external_number) { %>
                            <small class="opacity-75">· <%= i18n.__('orders.page.external_number') %>: <%= order.external_number %></small>
                        <% } %>
                    </span>
                    <a href="/orders/" class="btn btn-sm btn-light rounded-0"><i class="fa-solid fa-arrow-left"></i></a>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('orders.page.status') %></div>
                            <span class="badge badge-status rounded-0" id="current-status-badge"
                                  style="color:<%= order.status_color_text %>;background:<%= order.status_color_background %>">
                                <% if (order.status_icon) { %><i class="<%= order.status_icon %> me-1"></i><% } %>
                                <%= order.status_name || '—' %>
                            </span>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('orders.page.payment') %></div>
                            <% const finCls = { paid: 'text-bg-success', partially_paid: 'text-bg-warning', authorized: 'text-bg-info', refunded: 'text-bg-dark', partially_refunded: 'text-bg-dark', voided: 'text-bg-danger' }; %>
                            <span class="badge rounded-0 <%= finCls[order.financial_status] || 'text-bg-secondary' %>" id="financial-badge"><%= i18n.__('orders.financial.' + (order.financial_status || 'pending')) %></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('orders.page.fulfillment') %></div>
                            <% const fulCls = { fulfilled: 'text-bg-success', partial: 'text-bg-warning', returned: 'text-bg-dark' }; %>
                            <span class="badge rounded-0 <%= fulCls[order.fulfillment_status] || 'text-bg-secondary' %>"><%= i18n.__('orders.fulfillment.' + (order.fulfillment_status || 'unfulfilled')) %></span>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="section-title"><%= i18n.__('orders.source.title') %></div>
                            <% if (order.integration_name) { %>
                            <span class="badge rounded-0" style="color:<%= order.integration_color_text || '#ffffff' %>;background:<%= order.integration_color_background || '#607d8b' %>"><%= order.integration_name %></span>
                            <% if (order.integration_url) { %><a href="<%= order.integration_url %>" target="_blank" rel="noopener" class="small ms-1"><i class="fa-solid fa-arrow-up-right-from-square"></i></a><% } %>
                            <% } else if (order.source_channel === 'contact-center') { %>
                            <span class="badge rounded-0 text-bg-dark"><%= i18n.__('orders.source.contact_center') %></span>
                            <% } else { %>
                            <span class="badge rounded-0 text-bg-secondary"><%= i18n.__('orders.source.none') %></span>
                            <% } %>
                            <% if (order.source_channel && order.source_channel !== 'contact-center') { %><div class="small text-secondary mt-1"><%= i18n.__('orders.source.channel') %>: <%= i18n.__('orders.source.channels.' + order.source_channel) %></div><% } %>
                            <% if (typeof ccConversation !== 'undefined' && ccConversation) { %>
                            <div class="mt-1">
                                <a href="/contact-center/chat/<%= ccConversation.url_token %>/" class="btn btn-sm btn-outline-primary rounded-0" target="_blank">
                                    <i class="fa-solid fa-comments me-1"></i> <%= i18n.__('orders.page.open_chat') %>
                                </a>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <hr>

                    <!-- Зміна статусу (стиль OpenCart) -->
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-3">
                            <div class="section-title"><%= i18n.__('orders.page.new_status') %></div>
                            <select id="new-status" class="form-select form-select-sm rounded-0">
                                <% statuses.forEach(function(s) { %>
                                <option value="<%= s.id %>" <%= order.status == s.id ? 'selected' : '' %>><%= s.name %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="col-12 col-md-5">
                            <div class="section-title"><%= i18n.__('orders.page.status_comment') %></div>
                            <input id="status-comment" type="text" class="form-control form-control-sm rounded-0" placeholder="<%= i18n.__('orders.page.optional') %>">
                        </div>
                        <div class="col-6 col-md-2">
                            <div class="form-check mt-3">
                                <input id="status-notify" class="form-check-input" type="checkbox">
                                <label class="form-check-label small" for="status-notify"><%= i18n.__('orders.page.notify_client') %></label>
                            </div>
                        </div>
                        <div class="col-6 col-md-2">
                            <button class="btn btn-primary btn-sm rounded-0 w-100" data-action="apply-status">
                                <i class="fa-solid fa-check me-1"></i> <%= i18n.__('orders.page.apply') %>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Товари (ліниво) -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2 d-flex justify-content-between">
                    <span><%= i18n.__('orders.page.items') %> <span id="sum-warn" class="warn-sum d-none" title="<%= i18n.__('orders.page.sum_warn') %>"><i class="fa-solid fa-triangle-exclamation"></i></span></span>
                </div>
                <div class="card-body p-0" id="items-body">
                    <div class="spinner-wrap"><span class="spinner-border spinner-border-sm"></span> <%= i18n.__('orders.page.loading') %></div>
                </div>
            </div>

            <!-- Склад: зіставлення з каталогом, резерв / списання -->
            <div class="card rounded-0 mb-3" id="os-card">
                <div class="card-header fw-semibold py-2 d-flex flex-wrap gap-2 align-items-center">
                    <span class="me-auto"><i class="fa-solid fa-warehouse me-1"></i><%= i18n.__('catalog.order_stock.title') %> <span class="badge rounded-0 ms-1" id="os-state"></span></span>
                    <select class="form-select form-select-sm rounded-0 w-auto" id="os-warehouse" title="<%= i18n.__('catalog.order_stock.warehouse') %>"></select>
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="os-resync" title="<%= i18n.__('catalog.order_stock.resync') %>"><i class="fa-solid fa-rotate"></i></button>
                </div>
                <div class="card-body p-0">
                    <div class="px-3 pt-2 small" id="os-messages"></div>
                    <div id="os-body"><div class="p-3 text-muted small"><span class="spinner-border spinner-border-sm"></span></div></div>
                </div>
            </div>

            <div class="modal fade" id="os-map-modal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content rounded-0">
                        <div class="modal-header">
                            <h5 class="modal-title"><%= i18n.__('catalog.order_stock.map_title') %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="small text-muted mb-2" id="os-map-item"></div>
                            <div class="position-relative mb-2">
                                <input class="form-control rounded-0" id="os-map-search" autocomplete="off" placeholder="<%= i18n.__('catalog.order_stock.search') %>" />
                                <div class="list-group rounded-0 position-absolute w-100 d-none" style="z-index:1060;max-height:260px;overflow:auto" id="os-map-results"></div>
                            </div>
                            <div class="mb-2 d-none" id="os-map-variant-box">
                                <label class="form-label small"><%= i18n.__('catalog.order_stock.variant') %></label>
                                <select class="form-select rounded-0" id="os-map-variant"></select>
                            </div>
                            <div class="fw-semibold mb-2" id="os-map-picked"></div>
                            <div class="form-check" id="os-map-remember-box"><input class="form-check-input" type="checkbox" id="os-map-remember" checked /><label class="form-check-label" for="os-map-remember"><%= i18n.__('catalog.order_stock.remember') %></label></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-danger rounded-0 me-auto" id="os-map-clear"><%= i18n.__('catalog.order_stock.unmap') %></button>
                            <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('catalog.common.cancel') %></button>
                            <button type="button" class="btn btn-primary rounded-0" id="os-map-save" disabled><%= i18n.__('catalog.common.save') %></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Оплати (ліниво) -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('orders.page.payments') %></div>
                <div class="card-body p-0" id="payments-body">
                    <div class="spinner-wrap"><span class="spinner-border spinner-border-sm"></span></div>
                </div>
            </div>

            <!-- Доставка (ліниво) -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('orders.page.shipments') %></div>
                <%- typeof hook === 'function' ? hook('displayOrderShipping', { i18n, can, order }) : '' %>
                <div class="card-body p-0" id="shipments-body">
                    <div class="spinner-wrap"><span class="spinner-border spinner-border-sm"></span></div>
                </div>
            </div>

            <!-- Повернення / Документи (ліниво) -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2 d-flex align-items-center"><%= i18n.__('orders.page.refunds_docs') %>
                    <a class="btn btn-sm btn-outline-secondary rounded-0 ms-auto py-0 me-1" href="/orders/<%= order.id %>/print/invoice/" target="_blank"><i class="fa-solid fa-print"></i> <%= i18n.__('orders.print.invoice') %></a>
                    <a class="btn btn-sm btn-outline-secondary rounded-0 py-0 me-1" href="/orders/<%= order.id %>/print/delivery/" target="_blank"><i class="fa-solid fa-print"></i> <%= i18n.__('orders.print.delivery') %></a>
                    <% if (can('orders.list', 'edit')) { %><button type="button" class="btn btn-sm btn-outline-danger rounded-0 py-0" id="rf-open"><i class="fa-solid fa-rotate-left"></i> <%= i18n.__('orders.refunds.create') %></button><% } %>
                </div>
                <div class="card-body" id="refdoc-body">
                    <div class="spinner-wrap"><span class="spinner-border spinner-border-sm"></span></div>
                </div>
            </div>

            <!-- Заявки на повернення / обмін (ліниво) -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2 d-flex align-items-center"><%= i18n.__('orders.returns.section') %>
                    <a class="btn btn-sm btn-link py-0 ms-auto" href="/orders/returns/"><%= i18n.__('orders.returns.menu') %></a>
                    <% if (can('orders.list', 'edit')) { %><button type="button" class="btn btn-sm btn-outline-primary rounded-0 py-0" id="rma-open"><i class="fa-solid fa-right-left"></i> <%= i18n.__('orders.returns.create') %></button><% } %>
                </div>
                <div class="card-body p-0" id="rma-body">
                    <div class="spinner-wrap p-3"><span class="spinner-border spinner-border-sm"></span></div>
                </div>
            </div>
        </div>

        <!-- Оформлення повернення -->
        <div class="modal fade" id="rf-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <form class="modal-content rounded-0" id="rf-form">
                    <div class="modal-header">
                        <h5 class="modal-title"><%= i18n.__('orders.refunds.title') %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead><tr><th><%= i18n.__('orders.refunds.item') %></th><th class="text-end"><%= i18n.__('orders.refunds.bought') %></th><th class="text-end"><%= i18n.__('orders.refunds.returned') %></th><th class="text-end"><%= i18n.__('orders.refunds.price') %></th><th style="width:110px"><%= i18n.__('orders.refunds.qty') %></th></tr></thead>
                                <tbody id="rf-items"></tbody>
                            </table>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-4"><label class="form-label small mb-1"><%= i18n.__('orders.refunds.shipping') %></label><input type="number" min="0" step="0.01" class="form-control form-control-sm rounded-0" id="rf-shipping" value="0"></div>
                            <div class="col-md-4"><label class="form-label small mb-1"><%= i18n.__('orders.refunds.amount') %></label><input type="number" min="0" step="0.01" class="form-control form-control-sm rounded-0" id="rf-amount"><div class="form-text"><%= i18n.__('orders.refunds.amount_hint') %></div></div>
                            <div class="col-md-4"><label class="form-label small mb-1"><%= i18n.__('orders.refunds.transaction') %></label><input type="text" maxlength="191" class="form-control form-control-sm rounded-0" id="rf-transaction"></div>
                            <div class="col-12"><label class="form-label small mb-1"><%= i18n.__('orders.refunds.reason') %></label><input type="text" maxlength="255" class="form-control form-control-sm rounded-0" id="rf-reason"></div>
                            <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="rf-restock" checked><label class="form-check-label" for="rf-restock"><%= i18n.__('orders.refunds.restock') %></label></div><div class="form-text"><%= i18n.__('orders.refunds.restock_hint') %></div></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <span class="me-auto fw-semibold" id="rf-total"></span>
                        <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.refunds.cancel') %></button>
                        <button type="submit" class="btn btn-danger rounded-0" id="rf-submit"><%= i18n.__('orders.refunds.submit') %></button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Нова заявка на повернення / обмін -->
        <div class="modal fade" id="rma-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <form class="modal-content rounded-0" id="rma-form">
                    <div class="modal-header">
                        <h5 class="modal-title"><%= i18n.__('orders.returns.create_title') %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-2 mb-2">
                            <div class="col-md-4"><label class="form-label small mb-1"><%= i18n.__('orders.returns.type') %></label>
                                <select class="form-select form-select-sm rounded-0" id="rma-type"><option value="return"><%= i18n.__('orders.returns.t.return') %></option><option value="exchange"><%= i18n.__('orders.returns.t.exchange') %></option></select></div>
                            <div class="col-md-8"><label class="form-label small mb-1"><%= i18n.__('orders.returns.reason') %></label>
                                <select class="form-select form-select-sm rounded-0" id="rma-reason"></select></div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead><tr><th><%= i18n.__('orders.returns.item') %></th><th class="text-end"><%= i18n.__('orders.returns.bought') %></th><th class="text-end"><%= i18n.__('orders.returns.in_requests') %></th><th class="text-end"><%= i18n.__('orders.returns.price') %></th><th style="width:110px"><%= i18n.__('orders.returns.qty') %></th></tr></thead>
                                <tbody id="rma-items"></tbody>
                            </table>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-5"><label class="form-label small mb-1"><%= i18n.__('orders.returns.ttn') %></label><input type="text" maxlength="36" class="form-control form-control-sm rounded-0" id="rma-ttn"><div class="form-text"><%= i18n.__('orders.returns.ttn_hint') %></div></div>
                            <div class="col-md-7"><label class="form-label small mb-1"><%= i18n.__('orders.returns.comment') %></label><textarea rows="2" maxlength="2000" class="form-control form-control-sm rounded-0" id="rma-comment"></textarea></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <span class="me-auto fw-semibold" id="rma-total"></span>
                        <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.returns.cancel') %></button>
                        <button type="submit" class="btn btn-primary rounded-0" id="rma-submit"><%= i18n.__('orders.returns.submit') %></button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Повернення коштів за заявкою -->
        <div class="modal fade" id="rma-refund-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <form class="modal-content rounded-0" id="rma-refund-form">
                    <div class="modal-header">
                        <h5 class="modal-title" id="rma-refund-title"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2 small" id="rma-refund-info"></div>
                        <div class="row g-2">
                            <div class="col-6"><label class="form-label small mb-1"><%= i18n.__('orders.returns.shipping') %></label><input type="number" min="0" step="0.01" class="form-control form-control-sm rounded-0" id="rma-refund-shipping" value="0"></div>
                            <div class="col-6"><label class="form-label small mb-1"><%= i18n.__('orders.returns.amount') %></label><input type="number" min="0" step="0.01" class="form-control form-control-sm rounded-0" id="rma-refund-amount"><div class="form-text"><%= i18n.__('orders.returns.amount_hint') %></div></div>
                            <div class="col-12"><label class="form-label small mb-1"><%= i18n.__('orders.returns.transaction') %></label><input type="text" maxlength="191" class="form-control form-control-sm rounded-0" id="rma-refund-transaction"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.returns.cancel') %></button>
                        <button type="submit" class="btn btn-danger rounded-0" id="rma-refund-submit"><%= i18n.__('orders.returns.refund') %></button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Обмін за заявкою -->
        <div class="modal fade" id="rma-exchange-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <form class="modal-content rounded-0" id="rma-exchange-form">
                    <div class="modal-header">
                        <h5 class="modal-title" id="rma-exchange-title"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-text mt-0 mb-2"><%= i18n.__('orders.returns.exchange_hint') %></div>
                        <div class="position-relative mb-2">
                            <input type="search" class="form-control form-control-sm rounded-0" id="rma-ex-search" autocomplete="off" placeholder="<%= i18n.__('orders.returns.exchange_search') %>">
                            <div class="list-group position-absolute w-100 shadow-sm d-none" style="z-index:1060;max-height:260px;overflow:auto" id="rma-ex-found"></div>
                        </div>
                        <table class="table table-sm align-middle">
                            <thead><tr><th><%= i18n.__('orders.returns.item') %></th><th style="width:120px"><%= i18n.__('orders.returns.price') %></th><th style="width:90px"><%= i18n.__('orders.returns.qty') %></th><th style="width:30px"></th></tr></thead>
                            <tbody id="rma-ex-items"></tbody>
                        </table>
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4"><label class="form-label small mb-1"><%= i18n.__('orders.returns.exchange_shipping') %></label><input type="number" min="0" step="0.01" class="form-control form-control-sm rounded-0" id="rma-ex-shipping" value="0"></div>
                            <div class="col-md-8 small" id="rma-ex-sum"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.returns.cancel') %></button>
                        <button type="submit" class="btn btn-primary rounded-0" id="rma-ex-submit"><%= i18n.__('orders.returns.exchange') %></button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ПРАВА КОЛОНКА -->
        <div class="col-12 col-xl-4">

            <!-- Клієнт -->
            <div class="card rounded-0 mb-3" id="client-card">
                <div class="card-header fw-semibold py-2 d-flex justify-content-between align-items-center">
                    <span><%= i18n.__('orders.page.client') %></span>
                    <span id="client-badge"></span>
                </div>
                <div class="card-body" id="client-body">
                    <div class="spinner-wrap"><span class="spinner-border spinner-border-sm"></span></div>
                </div>
            </div>

                        <!-- Заплановано -->
            <%- include('../../partials/calendar/links', {
                calType: 'order',
                calId: order.id,
                calManager: order.id_user || 0,
                calExtra: [order.id_client ? { type: 'client', id: order.id_client } : null, order.id_client_org ? { type: 'client', id: order.id_client_org } : null].filter(Boolean)
            }) %>

            <!-- Контакт із замовлення (снапшот) — показуємо завжди -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('orders.page.snapshot') %></div>
                <div class="card-body" id="snapshot-body">
                    <div class="spinner-wrap"><span class="spinner-border spinner-border-sm"></span></div>
                </div>
            </div>

            <!-- Адреси -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('orders.page.addresses') %></div>
                <div class="card-body">
                    <% if (!addresses.length) { %>
                        <span class="text-muted"><%= i18n.__('orders.page.no_addresses') %></span>
                    <% } %>
                    <% addresses.forEach(function(a) { %>
                        <div class="mb-2">
                            <div class="section-title"><%= a.type === 'billing' ? i18n.__('orders.page.addr_billing') : i18n.__('orders.page.addr_shipping') %></div>
                            <div style="font-size:13px">
                                <%= [a.firstname, a.lastname].filter(Boolean).join(' ') %><br>
                                <% if (a.company) { %><%= a.company %><br><% } %>
                                <%= [a.country, a.region, a.city].filter(Boolean).join(', ') %><br>
                                <% if (a.warehouse) { %><%= a.warehouse %><br><% } %>
                                <% if (a.address_1) { %><%= a.address_1 %><% if (a.address_2) { %>, <%= a.address_2 %><% } %><br><% } %>
                                <% if (a.postcode) { %><%= a.postcode %><% } %>
                                <% if (a.phone) { %> · <%= a.phone %><% } %>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>

            <!-- Підсумок -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('orders.page.summary') %></div>
                <div class="card-body">
                    <% const fm = (v) => new Intl.NumberFormat('uk-UA', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(Number(v) || 0); %>
                    <table class="table table-sm table-borderless kv mb-2">
                        <tr><td class="k"><%= i18n.__('orders.page.sum_items') %></td><td><%= fm(order.total_products) %> <%= order.currency_iso %></td></tr>
                        <% if (Number(order.total_discount)) { %><tr><td class="k"><%= i18n.__('orders.page.sum_discount') %></td><td class="text-danger">−<%= fm(order.total_discount) %> <%= order.currency_iso %></td></tr><% } %>
                        <% if (Number(order.total_shipping)) { %><tr><td class="k"><%= i18n.__('orders.page.sum_shipping') %></td><td><%= fm(order.total_shipping) %> <%= order.currency_iso %></td></tr><% } %>
                        <% if (Number(order.total_wrapping)) { %><tr><td class="k"><%= i18n.__('orders.page.sum_wrapping') %></td><td><%= fm(order.total_wrapping) %> <%= order.currency_iso %></td></tr><% } %>
                        <% if (Number(order.total_tax)) { %><tr><td class="k"><%= i18n.__('orders.page.sum_tax') %></td><td><%= fm(order.total_tax) %> <%= order.currency_iso %></td></tr><% } %>
                        <% if (Number(order.total_tips)) { %><tr><td class="k"><%= i18n.__('orders.page.sum_tips') %></td><td><%= fm(order.total_tips) %> <%= order.currency_iso %></td></tr><% } %>
                    </table>
                    <div class="d-flex justify-content-between align-items-center border-top pt-2">
                        <span class="text-muted"><%= i18n.__('orders.page.to_pay') %></span>
                        <span class="money-final"><%= fm(order.total) %> <%= order.currency_iso %></span>
                    </div>
                    <table class="table table-sm table-borderless kv mt-2 mb-0">
                        <tr><td class="k"><%= i18n.__('orders.page.sum_paid') %></td><td><%= fm(order.total_paid) %> <%= order.currency_iso %></td></tr>
                        <% if (Number(order.total_refunded)) { %><tr><td class="k"><%= i18n.__('orders.page.sum_refunded') %></td><td class="text-danger">−<%= fm(order.total_refunded) %> <%= order.currency_iso %></td></tr><% } %>
                        <% if (Number(order.total_fees)) { %><tr><td class="k"><%= i18n.__('orders.page.sum_fees') %></td><td><%= fm(order.total_fees) %> <%= order.currency_iso %></td></tr><% } %>
                        <% if (order.currency_iso !== order.base_currency) { %><tr><td class="k"><%= i18n.__('orders.page.sum_rate') %></td><td><%= Number(order.currency_rate).toFixed(4) %></td></tr><% } %>
                    </table>
                </div>
            </div>

            <!-- Дати / прапорці -->
            <div class="card rounded-0 mb-3">
                <div class="card-header fw-semibold py-2"><%= i18n.__('orders.page.info') %></div>
                <div class="card-body">
                    <table class="table table-sm table-borderless kv mb-2">
                        <tr><td class="k"><%= i18n.__('orders.page.created') %></td><td><%= new Date(order.date_add).toLocaleString('uk-UA') %></td></tr>
                        <tr><td class="k"><%= i18n.__('orders.page.changed') %></td><td><%= new Date(order.date_edit).toLocaleString('uk-UA') %></td></tr>
                        <% if (order.date_order) { %><tr><td class="k"><%= i18n.__('orders.page.date_source') %></td><td><%= new Date(order.date_order).toLocaleString('uk-UA') %></td></tr><% } %>
                        <% if (order.ip_text) { %><tr><td class="k">IP</td><td><%= order.ip_text %></td></tr><% } %>
                    </table>
                    <div class="d-flex flex-wrap gap-1">
                        <% if (order.is_paid) { %><span class="badge rounded-0 text-bg-success"><%= i18n.__('orders.page.flag_paid') %></span><% } %>
                        <% if (order.is_shipped) { %><span class="badge rounded-0 text-bg-info"><%= i18n.__('orders.page.flag_shipped') %></span><% } %>
                        <% if (order.is_gift) { %><span class="badge rounded-0 text-bg-warning text-dark"><%= i18n.__('orders.page.flag_gift') %></span><% } %>
                        <% if (order.is_canceled) { %><span class="badge rounded-0 text-bg-danger"><%= i18n.__('orders.page.flag_canceled') %></span><% } %>
                    </div>
                    <% if (order.is_gift && order.gift_message) { %>
                        <div class="mt-2 small fst-italic text-muted">🎁 <%= order.gift_message %></div>
                    <% } %>
                    <% if (order.note) { %>
                        <div class="mt-2"><div class="section-title"><%= i18n.__('orders.page.note') %></div><div class="small"><%= order.note %></div></div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- ТАБИ -->
    <div class="card rounded-0 mt-1">
        <div class="card-header p-0">
            <ul class="nav nav-tabs border-0">
                <li class="nav-item"><button class="nav-link active rounded-0" data-bs-toggle="tab" data-bs-target="#tab-history">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i> <%= i18n.__('orders.page.tab_history') %></button></li>
                <li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#tab-events" data-action="load-events">
                    <i class="fa-solid fa-list me-1"></i> <%= i18n.__('orders.page.tab_events') %></button></li>
                <li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#tab-messages">
                    <i class="fa-brands fa-viber me-1"></i> <%= i18n.__('orders.messages.tab') %></button></li>
                <li class="nav-item"><button class="nav-link rounded-0" data-bs-toggle="tab" data-bs-target="#tab-raw" data-action="load-raw">
                    <i class="fa-solid fa-code me-1"></i> <%= i18n.__('orders.page.tab_raw') %></button></li>
            </ul>
        </div>
        <div class="tab-content p-3">
            <div class="tab-pane fade show active" id="tab-history"><div id="history-table"></div></div>
            <div class="tab-pane fade" id="tab-events"><div id="events-list"><div class="spinner-wrap"><span class="spinner-border spinner-border-sm"></span></div></div></div>
            <div class="tab-pane fade" id="tab-messages">
                <% if (can('orders.list', 'edit')) { %>
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <select class="form-select form-select-sm rounded-0" id="msg-template"><option value=""><%= i18n.__('orders.messages.own_text') %></option></select>
                    </div>
                    <div class="col-md-8">
                        <textarea class="form-control form-control-sm rounded-0" id="msg-text" rows="3" maxlength="1000" placeholder="<%= i18n.__('orders.messages.text_ph') %>"></textarea>
                        <div class="form-text"><%= i18n.__('orders.messages.vars') %></div>
                    </div>
                    <div class="col-12 d-flex flex-wrap align-items-center gap-2">
                        <select class="form-select form-select-sm rounded-0 w-auto" id="msg-service"></select>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="msg-preview"><i class="fa-solid fa-eye me-1"></i><%= i18n.__('orders.messages.preview') %></button>
                        <button type="button" class="btn btn-sm btn-primary rounded-0" id="msg-send"><i class="fa-brands fa-viber me-1"></i><%= i18n.__('orders.messages.send') %></button>
                        <span class="small" id="msg-state"></span>
