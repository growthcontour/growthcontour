<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('orders.title') %></title>
		<%- include('../../partials/head'); %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
		<!-- tabulator -->
		<link href="/assets/css/tabulator/tabulator.min.css" rel="stylesheet" />
		<link href="/assets/css/tabulator/tabulator_bootstrap5.min.css" rel="stylesheet" />
		<!-- END tabulator -->
		<style>
			/* Стилі для таблиці статусів */
			#orders-table .tabulator-col,
			#orders-table .tabulator-cell {
				border-right: 1px solid #dee2e6;
				border-bottom: 1px solid #dee2e6;
			}

			#orders-table .tabulator-col:last-child,
			#orders-table .tabulator-cell:last-child {
				border-right: none;
			}

			#orders-table .tabulator-row:last-child .tabulator-cell {
				border-bottom: none;
			}
		</style>
	</head>

	<body class="d-flex flex-column h-100">
		<%- include('../../partials/header'); %>
		<!-- Breadcrumb -->
		<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('orders.title') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('orders.breadcrumb.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= i18n.__('orders.breadcrumb.current') %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/" class="btn btn-primary rounded-0">
							<i class="fa-solid fa-angle-left"></i>
						</a>
					</div>
				</div>
			</div>
		</div>
		<!-- END Breadcrumb -->
		<div class="container-fluid mt-3">
			<div class="row">
				<div class="col-12 mb-3">
					<div class="card border-primary rounded-0">
						<div class="card-header text-bg-primary rounded-0 d-flex justify-content-between align-items-center">
							<span><%= i18n.__('orders.title') %> <span id="orders-total"></span></span>
							<button class="btn btn-sm btn-light rounded-0" type="button" data-bs-toggle="collapse" data-bs-target="#orders-filters"><i class="fa-solid fa-filter me-1"></i> <%= i18n.__('orders.list.filters') %></button>
						</div>

						<!-- Панель фільтрів -->
						<div class="collapse" id="orders-filters">
							<div class="card-body border-bottom bg-light">
								<div class="row g-2">
									<div class="col-6 col-md-3">
										<label class="section-title d-block"><%= i18n.__('orders.list.search') %></label>
										<input type="text" id="f-search" class="form-control form-control-sm rounded-0" placeholder="<%= i18n.__('orders.list.search_ph') %>" />
									</div>
									<div class="col-6 col-md-2">
										<label class="section-title d-block"><%= i18n.__('orders.list.status') %></label>
										<select id="f-status" class="form-select form-select-sm rounded-0">
											<option value=""><%= i18n.__('orders.list.all') %></option>
										</select>
									</div>
									<div class="col-6 col-md-2">
										<label class="section-title d-block"><%= i18n.__('orders.list.payment') %></label>
										<select id="f-financial" class="form-select form-select-sm rounded-0">
											<option value=""><%= i18n.__('orders.list.all') %></option>
										</select>
									</div>
									<div class="col-6 col-md-2">
										<label class="section-title d-block"><%= i18n.__('orders.list.channel') %></label>
										<select id="f-channel" class="form-select form-select-sm rounded-0">
											<option value=""><%= i18n.__('orders.list.all') %></option>
										</select>
									</div>
									<div class="col-6 col-md-3">
										<label class="section-title d-block"><%= i18n.__('orders.list.currency') %></label>
										<select id="f-currency" class="form-select form-select-sm rounded-0">
											<option value=""><%= i18n.__('orders.list.all') %></option>
										</select>
									</div>
									<div class="col-6 col-md-3">
										<label class="section-title d-block"><%= i18n.__('orders.list.date_from') %></label>
										<input type="date" id="f-date-from" class="form-control form-control-sm rounded-0" />
									</div>
									<div class="col-6 col-md-3">
										<label class="section-title d-block"><%= i18n.__('orders.list.date_to') %></label>
										<input type="date" id="f-date-to" class="form-control form-control-sm rounded-0" />
									</div>
									<div class="col-6 col-md-3">
										<label class="section-title d-block"><%= i18n.__('orders.list.site') %></label>
										<select id="f-site" class="form-select form-select-sm rounded-0">
											<option value=""><%= i18n.__('orders.list.all') %></option>
										</select>
									</div>
									<div class="col-12 col-md-3 d-flex align-items-end gap-3">
										<div class="form-check mb-1"><input class="form-check-input" type="checkbox" id="f-mine" /><label class="form-check-label small" for="f-mine"><%= i18n.__('orders.list.mine') %></label></div>
										<button type="button" class="btn btn-primary btn-sm rounded-0" id="btn-apply"><i class="fa-solid fa-check me-1"></i><%= i18n.__('orders.list.apply') %></button>
										<button type="button" class="btn btn-outline-secondary btn-sm rounded-0" id="btn-reset"><i class="fa-solid fa-xmark me-1"></i><%= i18n.__('orders.list.reset') %></button>
									</div>
								</div>
							</div>
						</div>

						<% if (can('orders.list', 'edit')) { %>
						<!-- Масові дії: з'являються, коли вибрано замовлення -->
						<div class="card-body border-bottom py-2 d-none" id="bulk-bar">
							<div class="d-flex flex-wrap align-items-center gap-2">
								<b class="small"><%= i18n.__('orders.bulk.selected') %>: <span id="bulk-count">0</span></b>
								<div class="input-group input-group-sm w-auto">
									<select id="bulk-status" class="form-select rounded-0"><option value=""><%= i18n.__('orders.bulk.status') %></option></select>
									<button type="button" class="btn btn-primary rounded-0" data-bulk="status"><%= i18n.__('orders.bulk.apply') %></button>
								</div>
								<div class="input-group input-group-sm w-auto">
									<select id="bulk-manager" class="form-select rounded-0"><option value=""><%= i18n.__('orders.bulk.manager') %></option><option value="0"><%= i18n.__('orders.bulk.unassign') %></option></select>
									<button type="button" class="btn btn-primary rounded-0" data-bulk="manager"><%= i18n.__('orders.bulk.assign') %></button>
								</div>
								<button type="button" class="btn btn-sm btn-outline-secondary rounded-0" id="bulk-merge"><i class="fa-solid fa-object-group me-1"></i><%= i18n.__('orders.merge.button') %></button>
								<%- typeof hook === 'function' ? hook('displayOrdersBulk', { i18n, can }) : '' %>
								<button type="button" class="btn btn-sm btn-link ms-auto" id="bulk-clear"><%= i18n.__('orders.bulk.clear') %></button>
							</div>
						</div>
						<% } %>

						<div id="orders-table"></div>
					</div>
				</div>
			</div>
		</div>

		<!-- Модалка видалення замовлення -->
		<div class="modal fade" id="modalDeleteOrder" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content rounded-0">
					<div class="modal-header">
						<h1 class="modal-title fs-5"><%= i18n.__('orders.list.delete_title') %></h1>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<p class="mb-0"><%= i18n.__('orders.list.delete_q') %></p>
						<p class="mb-0">
							<strong>ID: <span id="delete_order_id"></span></strong>
						</p>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.list.cancel') %></button>
						<button type="button" class="btn btn-danger rounded-0" id="btn_confirm_delete_order"><%= i18n.__('orders.list.delete') %></button>
					</div>
				</div>
			</div>
		</div>

		<%- include('../../partials/footer'); %> <%- include('../../partials/script'); %>
		<script src="/assets/js/notyf/notyf.min.js"></script>
		<script>
			const notyf = new Notyf({
				position: { x: "right", y: "top" },
				duration: 4000,
				types: [
					{ type: "success", dismissible: true, icon: false },
					{ type: "error", background: "indianred", dismissible: true, icon: false },
				],
			});
		</script>
		<script src="/assets/js/tabulator/tabulator.min.js"></script>
		<style>
			.section-title {
				font-size: 11px;
				font-weight: 700;
				text-transform: uppercase;
				color: #6c757d;
				letter-spacing: 0.5px;
				margin-bottom: 4px;
			}
		</style>
		<script>
			// Екранування для formatter-ів
			function esc(s) {
				return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
			}

			// Тексти сторінки й мітки статусів — з перекладів
			const BULK = !!document.getElementById("bulk-bar");
			const FIN_COLOR = { paid: "success", pending: "secondary", authorized: "info", partially_paid: "warning", partially_refunded: "warning", refunded: "danger", voided: "dark" };

			// Гроші: розряди й 2 знаки після коми (4 344,00)
			const MONEY = new Intl.NumberFormat("uk-UA", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

			// Бейдж-хелпер (колір із БД може бути з # або без — нормалізуємо)
			function colorBadge(text, colorText, colorBg) {
				const ct = colorText ? (colorText[0] === "#" ? colorText : "#" + colorText) : "#fff";
				const cb = colorBg ? (colorBg[0] === "#" ? colorBg : "#" + colorBg) : "#6c757d";
				return '<span class="badge rounded-0" style="color:' + ct + ";background:" + cb + '">' + esc(text || "—") + "</span>";
			}

			var table = new Tabulator("#orders-table", {
				layout: "fitColumns",
				ajaxURL: "/api/orders/orders-list/",
				ajaxConfig: "POST",
				ajaxContentType: "json",
				ajaxParams: () => currentFilters(), // фільтри — при кожному запиті сторінки
				// Сторінки й сортування рахує сервер: у браузер іде лише поточна сторінка
				pagination: true,
				paginationMode: "remote",
				paginationSize: 20,
				paginationSizeSelector: [10, 20, 50, 100],
				sortMode: "remote",
				initialSort: [{ column: "id", dir: "desc" }],
				dataLoaderLoading: '<span class="spinner-border spinner-border-sm me-1"></span>',
				ajaxResponse: function (url, params, r) {
					const el = document.getElementById("orders-total");
					if (el) el.textContent = "(" + Number(r.total || 0).toLocaleString("uk-UA") + ")";
					return r;
				},
				movableColumns: true,
				placeholder: "<%= i18n.__('orders.list.empty') %>",
				selectable: BULK ? true : false,
				columns: [
					...(BULK ? [{ formatter: "rowSelection", titleFormatter: "rowSelection", hozAlign: "center", headerSort: false, width: 40, cellClick: (e, cell) => cell.getRow().toggleSelect() }] : []),
					{ title: "ID", field: "id", width: 70, headerSort: true },
					{
						title: "<%= i18n.__('orders.list.col_source') %>",
						field: "integration_name",
						headerSort: false,
						formatter: function (cell) {
							const d = cell.getRow().getData();
							let src;
							if (d.integration_name) {
								src = colorBadge(d.integration_name, d.integration_color_text, d.integration_color_background);
							} else if (d.source_channel === "contact-center") {
								// Внутрішнє замовлення з контакт-центру (без інтеграції)
								src = '<span class="badge rounded-0 text-bg-info"><i class="fa-solid fa-headset me-1"></i>' + "<%= i18n.__('orders.list.contact_center') %>" + '</span>';
							} else {
								src = '<span class="text-muted">—</span>';
							}
							// Дрібний підпис каналу показуємо лише коли він НЕ contact-center (щоб не дублювати бейдж)
							const ch = d.source_channel && d.source_channel !== "contact-center" ? '<div><small class="text-muted">' + esc(d.source_channel) + "</small></div>" : "";
							return src + ch;
						},
					},
					{
						title: "№",
						field: "reference",
						headerSort: false,
						formatter: function (cell) {
							const d = cell.getRow().getData();
							return esc(d.reference) + (d.external_number ? '<div><small class="text-muted">' + esc(d.external_number) + "</small></div>" : "");
						},
					},
					{
						title: "<%= i18n.__('orders.list.col_total') %>",
						field: "total",
						headerSort: true,
						hozAlign: "right",
						formatter: function (cell) {
							const d = cell.getRow().getData();
							return '<span class="text-nowrap fw-semibold">' + MONEY.format(Number(d.total) || 0) + " " + esc(d.currency_iso || d.currency_iso_code || "") + "</span>";
						},
					},
					{
						title: "<%= i18n.__('orders.list.payment') %>",
						field: "financial_status",
						headerSort: false,
						formatter: function (cell) {
							const v = cell.getValue();
							const d = cell.getRow().getData();
							return '<span class="badge rounded-0 text-bg-' + (FIN_COLOR[v] || "secondary") + '">' + (({ pending: "<%= i18n.__('orders.financial.pending') %>", authorized: "<%= i18n.__('orders.financial.authorized') %>", paid: "<%= i18n.__('orders.financial.paid') %>", partially_paid: "<%= i18n.__('orders.financial.partially_paid') %>", partially_refunded: "<%= i18n.__('orders.financial.partially_refunded') %>", refunded: "<%= i18n.__('orders.financial.refunded') %>", voided: "<%= i18n.__('orders.financial.voided') %>" })[v] || v || "—") + "</span>" + (d.payment_method ? '<div><small class="text-muted">' + esc(d.payment_method) + "</small></div>" : "");
						},
					},
					{
						title: "<%= i18n.__('orders.list.status') %>",
						field: "status_name",
						headerSort: false,
						formatter: function (cell) {
							const d = cell.getRow().getData();
							const icon = d.status_icon ? '<i class="' + d.status_icon + ' me-1"></i>' : "";
							const ct = d.status_color_text || "#fff",
								cb = d.status_color_background || "#6c757d";
							return '<span class="badge rounded-0" style="color:' + ct + ";background:" + cb + '">' + icon + esc(d.status_name || "—") + "</span>";
						},
					},
					{
						title: "<%= i18n.__('orders.list.col_delivery') %>",
						field: "delivery_name",
						headerSort: false,
						formatter: function (cell) {
							const d = cell.getRow().getData();
							// Спосіб доставки з сайту (назва, як її бачив покупець); довідник системи — якщо задано вручну
							if (d.delivery_method) return '<small>' + esc(d.delivery_method) + "</small>";
							return d.delivery_name ? colorBadge(d.delivery_name, d.delivery_color_text, d.delivery_color_background) : '<span class="text-muted">—</span>';
						},
					},
					{
						title: "<%= i18n.__('orders.list.col_manager') %>",
						field: "manager_name",
						headerSort: false,
						formatter: (cell) => {
							const d = cell.getRow().getData();
							return d.manager_name ? (d.locked ? '<i class="fa-solid fa-user-lock text-success me-1" title="' + "<%= i18n.__('orders.list.in_work') %>" + '"></i>' : "") + esc(d.manager_name) : '<span class="text-muted">—</span>';
						},
					},
					{ title: "<%= i18n.__('orders.list.col_created') %>", field: "date_add", width: 150, headerSort: true },
					{
						title: "",
						field: "actions",
						width: 100,
						headerSort: false,
						hozAlign: "center",
						formatter: function (cell) {
							const id = cell.getRow().getData().id;
							return '<div class="d-flex justify-content-center gap-2">' + '<a href="/orders/' + id + '/" class="d-block text-primary"><i class="fa-regular fa-pen-to-square"></i></a>' + '<button type="button" class="bg-transparent border-0 text-danger delete-order-btn" data-order-id="' + id + '">' + '<i class="fa-regular fa-trash-can"></i></button>' + "</div>";
						},
					},
				],
			});

			// ── Фільтри ──
			function currentFilters() {
				return {
					search: document.getElementById("f-search").value.trim(),
					status: document.getElementById("f-status").value,
					financial_status: document.getElementById("f-financial").value,
					source_channel: document.getElementById("f-channel").value,
					currency: document.getElementById("f-currency").value,
					date_from: document.getElementById("f-date-from").value,
					date_to: document.getElementById("f-date-to").value,
					id_integration: document.getElementById("f-site").value,
					mine: document.getElementById("f-mine").checked ? 1 : 0,
				};
			}
			function applyFilters() {
				table.setData();
			}
			function resetFilters() {
				["f-search", "f-status", "f-financial", "f-channel", "f-currency", "f-date-from", "f-date-to", "f-site"].forEach((id) => (document.getElementById(id).value = ""));
				document.getElementById("f-mine").checked = false;
				table.setData();
			}

			// Наповнення випадайок фільтрів
			fetch("/api/orders/list-filters/", { method: "POST" })
				.then((r) => r.json())
				.then(function (d) {
					const st = document.getElementById("f-status");
					(d.statuses || []).forEach((s) => st.insertAdjacentHTML("beforeend", '<option value="' + s.id + '">' + esc(s.name) + "</option>"));
					const fin = document.getElementById("f-financial");
					(d.financial_statuses || []).forEach((v) => fin.insertAdjacentHTML("beforeend", '<option value="' + v + '">' + (({ pending: "<%= i18n.__('orders.financial.pending') %>", authorized: "<%= i18n.__('orders.financial.authorized') %>", paid: "<%= i18n.__('orders.financial.paid') %>", partially_paid: "<%= i18n.__('orders.financial.partially_paid') %>", partially_refunded: "<%= i18n.__('orders.financial.partially_refunded') %>", refunded: "<%= i18n.__('orders.financial.refunded') %>", voided: "<%= i18n.__('orders.financial.voided') %>" })[v] || v) + "</option>"));
					const ch = document.getElementById("f-channel");
					const CH_LABELS = { "contact-center": "<%= i18n.__('orders.list.contact_center') %>" };
					(d.channels || []).forEach((v) => ch.insertAdjacentHTML("beforeend", '<option value="' + esc(v) + '">' + esc(CH_LABELS[v] || v) + "</option>"));
					const cur = document.getElementById("f-currency");
					(d.currencies || []).forEach((c) => cur.insertAdjacentHTML("beforeend", '<option value="' + c.id + '">' + esc(c.currency_iso_code) + "</option>"));
					const site = document.getElementById("f-site");
					(d.integrations || []).forEach((i) => site.insertAdjacentHTML("beforeend", '<option value="' + i.id + '">' + esc(i.name) + "</option>"));
					if (BULK) {
						(d.statuses || []).forEach((s) => document.getElementById("bulk-status").insertAdjacentHTML("beforeend", '<option value="' + s.id + '">' + esc(s.name) + "</option>"));
						(d.managers || []).forEach((u) => document.getElementById("bulk-manager").insertAdjacentHTML("beforeend", '<option value="' + u.id + '">' + esc(u.name || "#" + u.id) + "</option>"));
					}
				});

			// ── Масові дії ──
			// Спільний API для кнопок модулів (хук displayOrdersBulk): вибрані id, запуск дії, оновлення списку
			window.ordersBulk = {
				ids: () => table.getSelectedData().map((d) => d.id),
				reload: () => table.replaceData(),
				// Підсумок дії: скільки зроблено й чому пропущено
				report(r) {
					if (r.done) notyf.success("<%= i18n.__('orders.bulk.done') %>".replace("%n", r.done));
					const sk = r.skipped || [];
					if (sk.length) notyf.error("<%= i18n.__('orders.bulk.skipped') %>".replace("%n", sk.length) + ": " + sk.slice(0, 5).map((x) => (x.reference || "#" + x.id) + " — " + (({ selected: "<%= i18n.__('orders.bulk.selected') %>", status: "<%= i18n.__('orders.bulk.status') %>", manager: "<%= i18n.__('orders.bulk.manager') %>", unassign: "<%= i18n.__('orders.bulk.unassign') %>", apply: "<%= i18n.__('orders.bulk.apply') %>", assign: "<%= i18n.__('orders.bulk.assign') %>", clear: "<%= i18n.__('orders.bulk.clear') %>", choose: "<%= i18n.__('orders.bulk.choose') %>", confirm: "<%= i18n.__('orders.bulk.confirm') %>", done: "<%= i18n.__('orders.bulk.done') %>", skipped: "<%= i18n.__('orders.bulk.skipped') %>", r_locked: "<%= i18n.__('orders.bulk.r_locked') %>", r_not_found: "<%= i18n.__('orders.bulk.r_not_found') %>", r_error: "<%= i18n.__('orders.bulk.r_error') %>", r_no_ttn: "<%= i18n.__('orders.bulk.r_no_ttn') %>", r_not_ready: "<%= i18n.__('orders.bulk.r_not_ready') %>", r_has_ttn: "<%= i18n.__('orders.bulk.r_has_ttn') %>", merge_two: "<%= i18n.__('orders.bulk.merge_two') %>", merge_confirm: "<%= i18n.__('orders.bulk.merge_confirm') %>" })["r_" + x.reason] || x.message || x.reason)).join("; "));
				},
			};
			if (BULK) {
				const bar = document.getElementById("bulk-bar");
				table.on("rowSelectionChanged", (data) => {
					document.getElementById("bulk-count").textContent = data.length;
					bar.classList.toggle("d-none", !data.length);
				});
				document.getElementById("bulk-clear").addEventListener("click", () => table.deselectRow());
				// Об'єднання: позиції — у найстаріше замовлення, після успіху відкриваємо його
				document.getElementById("bulk-merge").addEventListener("click", async function () {
					const ids = window.ordersBulk.ids();
					if (ids.length < 2) return notyf.error("<%= i18n.__('orders.bulk.merge_two') %>");
					if (!confirm("<%= i18n.__('orders.bulk.merge_confirm') %>".replace("%n", ids.length))) return;
					this.disabled = true;
					try {
						const res = await fetch("/api/orders/merge/", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ids }) });
						const r = await res.json().catch(() => ({}));
						if (!res.ok) throw new Error(r.message || "Error");
						location.href = "/orders/" + r.id + "/";
					} catch (err) {
						notyf.error(err.message);
						this.disabled = false;
					}
				});
				bar.addEventListener("click", async (e) => {
					const btn = e.target.closest("[data-bulk]");
					if (!btn) return;
					const action = btn.dataset.bulk;
					const value = document.getElementById("bulk-" + action).value;
					if (value === "") return notyf.error("<%= i18n.__('orders.bulk.choose') %>");
					const ids = window.ordersBulk.ids();
					if (!confirm("<%= i18n.__('orders.bulk.confirm') %>".replace("%n", ids.length))) return;
					btn.disabled = true;
					try {
						const res = await fetch("/api/orders/bulk/", {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({ action, ids, ...(action === "status" ? { id_status: value } : { id_manager: value }) }),
						});
						const r = await res.json().catch(() => ({}));
						if (!res.ok) throw new Error(r.message || "Error");
						window.ordersBulk.report(r);
						table.replaceData();
					} catch (err) {
						notyf.error(err.message);
					} finally {
						btn.disabled = false;
					}
				});
			}

			document.getElementById("btn-apply").addEventListener("click", applyFilters);
			document.getElementById("btn-reset").addEventListener("click", resetFilters);

			// Enter у полі пошуку = застосувати
			document.getElementById("f-search").addEventListener("keydown", (e) => {
				if (e.key === "Enter") applyFilters();
			});
		</script>
		<!-- END tabulator -->
		<script>
			// ── Відкриття модалки видалення замовлення ──────────────────────────────────
			$(document).on("click", ".delete-order-btn", function () {
				const orderId = $(this).data("order-id");
				document.getElementById("delete_order_id").textContent = orderId;
				bootstrap.Modal.getOrCreateInstance(document.getElementById("modalDeleteOrder")).show();
			});

			// ── Підтвердження видалення замовлення ──────────────────────────────────────
			// ── Підтвердження видалення замовлення ──────────────────────────────────────
			document.getElementById("btn_confirm_delete_order").addEventListener("click", async function () {
				const btn = this;
				if (btn.disabled) return;

				const id = parseInt(document.getElementById("delete_order_id").textContent, 10);
				const originalHtml = btn.innerHTML;
				btn.disabled = true;
				btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

				try {
					const res = await fetch("/api/orders/delete/", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({ id }),
					});

					const data = await res.json().catch(() => ({}));

					if (!res.ok || data.status !== "success") {
						throw new Error(data.message || data.error || "<%= i18n.__('orders.list.delete_error') %>");
					}

					// Закриваємо модалку
					bootstrap.Modal.getOrCreateInstance(document.getElementById("modalDeleteOrder")).hide();

					// Показуємо сповіщення про успіх
					notyf.success("<%= i18n.__('orders.list.deleted') %>");

					// Оновлюємо таблицю з поточними фільтрами
					applyFilters(); // або table.setData("/api/orders/orders-list/", currentFilters(), "POST");
				} catch (err) {
					notyf.error(err.message);
				} finally {
					btn.disabled = false;
					btn.innerHTML = originalHtml;
				}
			});
		</script>
	</body>
</html>
