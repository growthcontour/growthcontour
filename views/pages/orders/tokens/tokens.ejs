    <!-- ─── МОДАЛКА: ГЕНЕРАЦІЯ ТОКЕНА ──────────────────────────────────────── -->
    <div class="modal fade" id="modalGenerateToken" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-0">
          <div class="modal-header">
            <h1 class="modal-title fs-5"><%= i18n.__('orders.tokens.generate_modal.title') %></h1>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>

          <!-- Крок 1: форма -->
          <div class="modal-body" id="gen-form-step">
            <div class="mb-3">
              <label class="form-label"><%= i18n.__('orders.tokens.fields.name') %></label>
              <input type="text" class="form-control rounded-0" id="gen_name" />
            </div>
            <div class="row">
              <div class="col-12 col-md-6 mb-3">
                <label class="form-label"><%= i18n.__('orders.tokens.fields.environment') %></label>
                <select class="form-select rounded-0" id="gen_environment">
                  <option value="live"><%= i18n.__('orders.tokens.env.live') %></option>
                  <option value="test"><%= i18n.__('orders.tokens.env.test') %></option>
                </select>
              </div>
                            <div class="col-12 col-md-6 mb-3">
                <label class="form-label"><%= i18n.__('orders.tokens.fields.source_check_mode') %></label>
                <select class="form-select rounded-0" id="gen_source_check_mode">
                  <option value="any"><%= i18n.__('orders.tokens.check_mode.any') %></option>
                  <option value="all"><%= i18n.__('orders.tokens.check_mode.all') %></option>
                  <option value="off"><%= i18n.__('orders.tokens.check_mode.off') %></option>
                </select>
              </div>
            </div>
                        <div class="row">
              <div class="col-12 mb-3">
                <label class="form-label"><%= i18n.__('orders.tokens.fields.integration') %></label>
                <select class="form-select rounded-0" id="gen_id_integration">
                  <option value=""><%= i18n.__('orders.tokens.integration.none') %></option>
                </select>
                <small class="text-muted"><%= i18n.__('orders.tokens.hint.integration') %></small>
              </div>
            </div>
            <div class="row">
              <div class="col-12 col-md-6 mb-3">
                <label class="form-label"><%= i18n.__('orders.tokens.fields.allowed_domains') %></label>
                <textarea class="form-control rounded-0" id="gen_allowed_domains" rows="3" placeholder="shop.com"></textarea>
                <small class="text-muted"><%= i18n.__('orders.tokens.hint.one_per_line') %></small>
              </div>
              <div class="col-12 col-md-6 mb-3">
                <label class="form-label"><%= i18n.__('orders.tokens.fields.allowed_ips') %></label>
                <textarea class="form-control rounded-0" id="gen_allowed_ips" rows="3" placeholder="1.2.3.4&#10;10.0.0.0/24"></textarea>
                <small class="text-muted"><%= i18n.__('orders.tokens.hint.one_per_line') %></small>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label"><%= i18n.__('orders.tokens.fields.scopes') %></label>
              <div class="row">
                <% const scopes = ['can_create_orders','can_update_orders','can_update_status','can_create_clients','can_read', 'can_sync_carts']; %>
                <% scopes.forEach(function(s) { %>
                <div class="col-12 col-md-6">
                  <div class="form-check mb-2">
                    <input type="checkbox" class="form-check-input rounded-0 gen-scope" id="gen_<%= s %>" name="<%= s %>" value="1"
                           <%= (s === 'can_create_orders' || s === 'can_create_clients') ? 'checked' : '' %> />
                    <label class="form-check-label" for="gen_<%= s %>"><%= i18n.__('orders.tokens.scopes.' + s) %></label>
                  </div>
                </div>
                <% }); %>
              </div>
            </div>
            <div class="row">
              <div class="col-12 col-md-6 mb-3">
                <label class="form-label"><%= i18n.__('orders.tokens.fields.expires_at') %></label>
                <input type="date" class="form-control rounded-0" id="gen_expires_at" />
              </div>
              <div class="col-12 col-md-6 mb-3">
                <label class="form-label"><%= i18n.__('orders.tokens.fields.note') %></label>
                <input type="text" class="form-control rounded-0" id="gen_note" />
              </div>
            </div>
          </div>

          <!-- Крок 2: показ сирого токена (разово) -->
          <div class="modal-body d-none" id="gen-result-step">
            <div class="alert alert-warning rounded-0 mb-3">
              <i class="fa-solid fa-triangle-exclamation me-1"></i>
              <%= i18n.__('orders.tokens.generate_modal.copy_warning') %>
            </div>
            <div class="token-reveal mb-2" id="gen-token-value"></div>
            <button type="button" class="btn btn-outline-primary btn-sm rounded-0" id="btn-copy-token">
              <i class="fa-regular fa-copy me-1"></i><%= i18n.__('orders.tokens.generate_modal.copy') %>
            </button>
          </div>

          <div class="modal-footer" id="gen-form-footer">
            <button type="button" class="btn btn-secondary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.tokens.generate_modal.close') %></button>
            <button type="button" class="btn btn-primary rounded-0" id="btn_generate_token"><%= i18n.__('orders.tokens.generate_modal.generate') %></button>
          </div>
          <div class="modal-footer d-none" id="gen-result-footer">
            <button type="button" class="btn btn-primary rounded-0" data-bs-dismiss="modal"><%= i18n.__('orders.tokens.generate_modal.done') %></button>
          </div>
        </div>
      </div>
    </div>
    <!-- ─── END МОДАЛКА ГЕНЕРАЦІЇ ──────────────────────────────────────────── -->

