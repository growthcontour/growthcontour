    <%- include('../../../partials/footer'); %> <%- include('../../../partials/script'); %>
    <script src="/assets/js/notyf/notyf.min.js"></script>
    <script>
      const notyf = new Notyf({
        position: { x: "right", y: "top" },
        duration: 4000,
        types: [
          { type: "success", dismissible: true, icon: false },
          { type: "error", background: "indianred", dismissible: true, icon: false },
        ],
      });

      function esc(s){ return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

      // Мітки станів/результатів (з перекладів)
      const STATE_BADGE = { active:'text-bg-success', disabled:'text-bg-secondary', expired:'text-bg-warning', revoked:'text-bg-danger' };
      const STATE_LABEL = {
        active: "<%= i18n.__('orders.tokens.state.active') %>",
        disabled: "<%= i18n.__('orders.tokens.state.disabled') %>",
        expired: "<%= i18n.__('orders.tokens.state.expired') %>",
        revoked: "<%= i18n.__('orders.tokens.state.revoked') %>",
      };
      const REJECT_LABEL = {
        bad_token: "<%= i18n.__('orders.tokens.reject.bad_token') %>",
        expired: "<%= i18n.__('orders.tokens.reject.expired') %>",
        revoked: "<%= i18n.__('orders.tokens.reject.revoked') %>",
        disabled: "<%= i18n.__('orders.tokens.reject.disabled') %>",
        ip_denied: "<%= i18n.__('orders.tokens.reject.ip_denied') %>",
        domain_denied: "<%= i18n.__('orders.tokens.reject.domain_denied') %>",
        no_scope: "<%= i18n.__('orders.tokens.reject.no_scope') %>",
        bad_payload: "<%= i18n.__('orders.tokens.reject.bad_payload') %>",
      };
    </script>
    <!-- Завантаження джерел (інтеграцій) для селектів токена -->
    <script>
      let INTEGRATIONS = [];
      function fillIntegrationSelect(selectId, selectedId) {
        const sel = document.getElementById(selectId);
        if (!sel) return;
        const none = "<%= i18n.__('orders.tokens.integration.none') %>";
        let html = '<option value="">' + none + '</option>';
        INTEGRATIONS.forEach(function (i) {
          const dis = i.status === "disabled" ? " (—)" : "";
          const isSel = String(selectedId || "") === String(i.id) ? ' selected' : '';
          html += '<option value="' + i.id + '"' + isSel + '>' + esc(i.name) + dis + '</option>';
        });
        sel.innerHTML = html;
      }
      async function loadIntegrations() {
        try {
          const res = await fetch("/api/orders/integrations/list/", {
            method: "POST", headers: { "Content-Type": "application/json" }, body: "{}",
          });
          INTEGRATIONS = await res.json().catch(() => []);
          if (!Array.isArray(INTEGRATIONS)) INTEGRATIONS = [];
        } catch (e) { INTEGRATIONS = []; }
        fillIntegrationSelect("gen_id_integration", "");
      }
      loadIntegrations();
    </script>
    <!-- Генерація -->
    <script>
      document.getElementById("btn_generate_token").addEventListener("click", async function () {
        const btn = this;
        if (btn.disabled) return;
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        const scopes = {};
        document.querySelectorAll(".gen-scope").forEach((cb) => { scopes[cb.name] = cb.checked ? 1 : 0; });

                const payload = {
          name: document.getElementById("gen_name").value,
          environment: document.getElementById("gen_environment").value,
          source_check_mode: document.getElementById("gen_source_check_mode").value,
          id_integration: document.getElementById("gen_id_integration").value || null,
          allowed_domains: document.getElementById("gen_allowed_domains").value,
          allowed_ips: document.getElementById("gen_allowed_ips").value,
          expires_at: document.getElementById("gen_expires_at").value,
          note: document.getElementById("gen_note").value,
          ...scopes,
        };

        try {
          const res = await fetch("/api/orders/tokens/generate/", {
            method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.status !== "success") throw new Error(data.message || "Error");

          // Показуємо сирий токен (крок 2)
          document.getElementById("gen-token-value").textContent = data.token;
          document.getElementById("gen-form-step").classList.add("d-none");
          document.getElementById("gen-form-footer").classList.add("d-none");
          document.getElementById("gen-result-step").classList.remove("d-none");
          document.getElementById("gen-result-footer").classList.remove("d-none");
          table.replaceData();
        } catch (err) {
          notyf.error(err.message);
        } finally {
          btn.disabled = false;
          btn.innerHTML = original;
        }
      });

      // Копіювати токен
      document.getElementById("btn-copy-token").addEventListener("click", function () {
        const val = document.getElementById("gen-token-value").textContent;
        navigator.clipboard.writeText(val).then(() => notyf.success("<%= i18n.__('orders.tokens.generate_modal.copied') %>"));
      });

      // Скидання модалки генерації при закритті
      document.getElementById("modalGenerateToken").addEventListener("hidden.bs.modal", function () {
        ["gen_name","gen_allowed_domains","gen_allowed_ips","gen_expires_at","gen_note"].forEach(id => document.getElementById(id).value = "");
                document.getElementById("gen_environment").value = "live";
        document.getElementById("gen_source_check_mode").value = "any";
        fillIntegrationSelect("gen_id_integration", "");
        document.querySelectorAll(".gen-scope").forEach(cb => {
          cb.checked = (cb.name === "can_create_orders" || cb.name === "can_create_clients");
        });
        document.getElementById("gen-form-step").classList.remove("d-none");
        document.getElementById("gen-form-footer").classList.remove("d-none");
        document.getElementById("gen-result-step").classList.add("d-none");
        document.getElementById("gen-result-footer").classList.add("d-none");
      });
    </script>

    <!-- Редагування -->
    <script>
      let currentEditId = null;

      $(document).on("click", ".edit-token-btn", function () {
        const id = $(this).data("token-id");
        currentEditId = id;
        $.ajax({
          type: "POST", url: "/api/orders/tokens/get/", dataType: "json", data: { id },
          success: function (t) {
            document.getElementById("edit_token_id").textContent = t.id;
            document.getElementById("edit_name").value = t.name || "";
            document.getElementById("edit_key_preview").textContent = (t.prefix || "") + "…" + (t.last4 || "");
                        document.getElementById("edit_source_check_mode").value = t.source_check_mode || "any";
            document.getElementById("edit_status").value = t.status || "active";
            fillIntegrationSelect("edit_id_integration", t.id_integration);
            document.getElementById("edit_allowed_domains").value = (t.allowed_domains || []).join("\n");
            document.getElementById("edit_allowed_ips").value = (t.allowed_ips || []).join("\n");
            document.getElementById("edit_expires_at").value = t.expires_at || "";
            document.getElementById("edit_note").value = t.note || "";
            document.querySelectorAll(".edit-scope").forEach((cb) => { cb.checked = Number(t[cb.name]) === 1; });
            document.getElementById("edit_usage_count").textContent = t.usage_count || 0;
            document.getElementById("edit_error_count").textContent = t.error_count || 0;
            document.getElementById("edit_last_used").textContent = t.last_used_at || "—";

            // Якщо токен відкликано — блокуємо збереження
            const revoked = !!t.revoked_at;
            document.getElementById("btn_save_token").disabled = revoked;
            document.getElementById("btn_revoke_token").disabled = revoked;

            bootstrap.Modal.getOrCreateInstance(document.getElementById("modalEditToken")).show();
          },
          error: function (XHR) {
            notyf.error((XHR.responseJSON || {}).message || "Error");
          },
        });
      });

      document.getElementById("btn_save_token").addEventListener("click", async function () {
        const btn = this;
        if (btn.disabled) return;
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        const scopes = {};
        document.querySelectorAll(".edit-scope").forEach((cb) => { scopes[cb.name] = cb.checked ? 1 : 0; });

                const payload = {
          id: currentEditId,
          name: document.getElementById("edit_name").value,
          source_check_mode: document.getElementById("edit_source_check_mode").value,
          status: document.getElementById("edit_status").value,
          id_integration: document.getElementById("edit_id_integration").value || null,
          allowed_domains: document.getElementById("edit_allowed_domains").value,
          allowed_ips: document.getElementById("edit_allowed_ips").value,
          expires_at: document.getElementById("edit_expires_at").value,
          note: document.getElementById("edit_note").value,
          ...scopes,
        };

        try {
          const res = await fetch("/api/orders/tokens/update/", {
            method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.status !== "success") throw new Error(data.message || "Error");
          bootstrap.Modal.getOrCreateInstance(document.getElementById("modalEditToken")).hide();
          notyf.success("<%= i18n.__('orders.tokens.edit_modal.saved') %>");
          table.replaceData();
        } catch (err) {
          notyf.error(err.message);
        } finally {
          btn.disabled = false;
          btn.innerHTML = original;
        }
      });
    </script>

    <!-- Відкликання -->
    <script>
      document.getElementById("btn_revoke_token").addEventListener("click", function () {
        document.getElementById("revoke_reason").value = "";
        bootstrap.Modal.getOrCreateInstance(document.getElementById("modalRevokeToken")).show();
      });

            document.getElementById("btn_confirm_revoke").addEventListener("click", async function () {
        const btn = this;
        if (btn.disabled) return;
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
          const res = await fetch("/api/orders/tokens/revoke/", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: currentEditId, reason: document.getElementById("revoke_reason").value }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.status !== "success") throw new Error(data.message || "Error");
          bootstrap.Modal.getOrCreateInstance(document.getElementById("modalRevokeToken")).hide();
          bootstrap.Modal.getOrCreateInstance(document.getElementById("modalEditToken")).hide();
          notyf.success("<%= i18n.__('orders.tokens.revoke_modal.revoked') %>");
          table.replaceData();
        } catch (err) {
          notyf.error(err.message);
        } finally {
          btn.disabled = false;
          btn.innerHTML = original;
        }
      });

      // Відкликання з таблиці — окрема модалка й окремий контекст (не чіпає currentEditId)
      let revokeRowId = null;
      $(document).on("click", ".revoke-token-btn", function () {
        revokeRowId = $(this).data("token-id");
        document.getElementById("revoke_row_id").textContent = revokeRowId;
        document.getElementById("revoke_row_name").textContent = $(this).data("token-name") || "";
        document.getElementById("revoke_row_reason").value = "";
        bootstrap.Modal.getOrCreateInstance(document.getElementById("modalRevokeTokenRow")).show();
      });

      document.getElementById("btn_confirm_revoke_row").addEventListener("click", async function () {
        const btn = this;
        if (btn.disabled || !revokeRowId) return;
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
          const res = await fetch("/api/orders/tokens/revoke/", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: revokeRowId, reason: document.getElementById("revoke_row_reason").value }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.status !== "success") throw new Error(data.message || "Error");
          bootstrap.Modal.getOrCreateInstance(document.getElementById("modalRevokeTokenRow")).hide();
          notyf.success("<%= i18n.__('orders.tokens.revoke_modal.revoked') %>");
          table.replaceData();
        } catch (err) {
          notyf.error(err.message);
        } finally {
          btn.disabled = false;
          btn.innerHTML = original;
        }
      });
    </script>
    <!-- Видалення токена з таблиці -->
    <script>
      let deleteTokenId = null;
      $(document).on("click", ".delete-token-btn", function () {
        deleteTokenId = $(this).data("token-id");
        document.getElementById("delete_token_id").textContent = deleteTokenId;
        document.getElementById("delete_token_name").textContent = $(this).data("token-name") || "";
        bootstrap.Modal.getOrCreateInstance(document.getElementById("modalDeleteToken")).show();
      });

      document.getElementById("btn_confirm_delete_token").addEventListener("click", async function () {
        const btn = this;
        if (btn.disabled || !deleteTokenId) return;
        const original = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        try {
          const res = await fetch("/api/orders/tokens/delete/", {
            method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: deleteTokenId }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || data.status !== "success") throw new Error(data.message || "Error");
          bootstrap.Modal.getOrCreateInstance(document.getElementById("modalDeleteToken")).hide();
          notyf.success(data.message || "OK");
          table.replaceData();
        } catch (err) {
          notyf.error(err.message);
        } finally {
          btn.disabled = false;
          btn.innerHTML = original;
        }
      });
    </script>
    <!-- Логи -->
    <script>
      $(document).on("click", ".log-token-btn", function () {
        const id = $(this).data("token-id");
        document.getElementById("log_token_id").textContent = id;
        document.getElementById("log-content").innerHTML = '<div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm"></span></div>';
        bootstrap.Modal.getOrCreateInstance(document.getElementById("modalTokenLog")).show();

        fetch("/api/orders/tokens/log/", {
          method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id }),
        }).then(r => r.json()).then(function (rows) {
          if (!rows.length) {
            document.getElementById("log-content").innerHTML = '<p class="text-muted mb-0"><%= i18n.__('orders.tokens.log_modal.empty') %></p>';
            return;
          }
          const body = rows.map(function (r) {
            const ok = r.result === "success";
            const resultBadge = ok
              ? '<span class="badge rounded-0 text-bg-success"><%= i18n.__('orders.tokens.log.success') %></span>'
              : '<span class="badge rounded-0 text-bg-danger">' + (REJECT_LABEL[r.reject_reason] || esc(r.reject_reason) || '<%= i18n.__('orders.tokens.log.rejected') %>') + '</span>';
            return '<tr>'
              + '<td>' + resultBadge + '</td>'
              + '<td>' + esc(r.ip || '—') + '</td>'
              + '<td>' + esc(r.domain || '—') + '</td>'
              + '<td>' + (r.external_id ? esc(r.external_id) : '—') + '</td>'
              + '<td>' + (r.http_status || '') + '</td>'
              + '<td>' + esc(r.message || '') + '</td>'
              + '<td class="text-nowrap">' + esc(r.date_add || '') + '</td>'
              + '</tr>';
          }).join("");
          document.getElementById("log-content").innerHTML =
            '<table class="table table-sm table-bordered log-table mb-0"><thead><tr>'
            + '<th><%= i18n.__('orders.tokens.log.result') %></th>'
            + '<th>IP</th><th><%= i18n.__('orders.tokens.log.domain') %></th>'
            + '<th><%= i18n.__('orders.tokens.log.external_id') %></th>'
            + '<th><%= i18n.__('orders.tokens.log.http') %></th>'
            + '<th><%= i18n.__('orders.tokens.log.message') %></th>'
            + '<th><%= i18n.__('orders.tokens.log.date') %></th>'
            + '</tr></thead><tbody>' + body + '</tbody></table>';
        }).catch(function () {
          document.getElementById("log-content").innerHTML = '<p class="text-danger mb-0">Error</p>';
        });
      });
    </script>

    <!-- Tabulator -->
    <script src="/assets/js/tabulator/tabulator.min.js"></script>
    <script>
      var table = new Tabulator("#tokens-table", {
        layout: "fitColumns",
        ajaxURL: "/api/orders/tokens/list/",
        ajaxConfig: "POST",
        paginationSize: 10,
        paginationSizeSelector: [10, 20, 30, 40],
        pagination: true,
        movableColumns: true,
        placeholder: "<%= i18n.__('orders.tokens.table.empty') %>",
        columns: [
          { title: "<%= i18n.__('orders.tokens.columns.id') %>", field: "id", headerSort: false, widthGrow: 1 },
          { title: "<%= i18n.__('orders.tokens.columns.name') %>", field: "name", headerSort: false, widthGrow: 3,
            formatter: function (cell) {
              const d = cell.getRow().getData();
              const env = d.environment === "test"
                ? ' <span class="badge rounded-0 text-bg-light border"><%= i18n.__('orders.tokens.env.test') %></span>' : '';
              return '<div>' + esc(d.name) + env + '</div>'
                + '<small class="text-muted"><code>' + esc(d.prefix || '') + '…' + esc(d.last4 || '') + '</code></small>';
            },
          },
          { title: "<%= i18n.__('orders.tokens.columns.state') %>", field: "state", headerSort: false, widthGrow: 1,
            formatter: function (cell) {
              const s = cell.getValue();
              return '<span class="badge rounded-0 ' + (STATE_BADGE[s] || 'text-bg-secondary') + '">' + (STATE_LABEL[s] || s) + '</span>';
            },
          },
          { title: "<%= i18n.__('orders.tokens.columns.usage') %>", field: "usage_count", headerSort: false, widthGrow: 1,
            formatter: function (cell) {
              const d = cell.getRow().getData();
              let out = '<span class="text-success">' + (d.usage_count || 0) + '</span>';
              if (d.error_count) out += ' / <span class="text-danger">' + d.error_count + '</span>';
              return out;
            },
          },
          { title: "<%= i18n.__('orders.tokens.columns.last_used') %>", field: "last_used_at", headerSort: false, widthGrow: 2,
            formatter: (cell) => cell.getValue() || '—' },
          { title: "<%= i18n.__('orders.tokens.columns.date_add') %>", field: "date_add", headerSort: false, widthGrow: 2 },
                    { title: "", field: "id", headerSort: false, width: 130,
                        formatter: function (cell) {
              const d = cell.getRow().getData();
              const id = d.id;
              // Відкликаний токен уже не відкликати повторно — кнопку глушимо
              const revoked = d.state === "revoked";
              const revokeBtn = revoked
                ? '<button type="button" class="bg-transparent border-0 text-muted" disabled title="<%= i18n.__('orders.tokens.state.revoked') %>"><i class="fa-solid fa-ban"></i></button>'
                : '<button type="button" class="bg-transparent border-0 text-danger revoke-token-btn" data-token-id="' + id + '" data-token-name="' + esc(d.name) + '" title="<%= i18n.__('orders.tokens.actions.revoke') %>"><i class="fa-solid fa-ban"></i></button>';
              return '<div class="d-flex justify-content-center gap-2">'
                + '<button type="button" class="bg-transparent border-0 text-primary edit-token-btn" data-token-id="' + id + '" title="<%= i18n.__('orders.tokens.actions.edit') %>"><i class="fa-regular fa-pen-to-square"></i></button>'
                + '<button type="button" class="bg-transparent border-0 text-secondary log-token-btn" data-token-id="' + id + '" title="<%= i18n.__('orders.tokens.actions.log') %>"><i class="fa-solid fa-list"></i></button>'
                + revokeBtn
                + '<button type="button" class="bg-transparent border-0 text-danger delete-token-btn" data-token-id="' + id + '" data-token-name="' + esc(d.name) + '" title="<%= i18n.__('orders.tokens.actions.delete') %>"><i class="fa-regular fa-trash-can"></i></button>'
                + '</div>';
            },
            },
        ],
      });
    </script>
  </body>
</html>