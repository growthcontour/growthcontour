<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
  <head>
    <title><%= i18n.__('orders.tokens.title') %></title>
    <%- include('../../../partials/head'); %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
    <link href="/assets/css/tabulator/tabulator.min.css" rel="stylesheet" />
    <link href="/assets/css/tabulator/tabulator_bootstrap5.min.css" rel="stylesheet" />
    <style>
      #tokens-table .tabulator-col,
      #tokens-table .tabulator-cell {
        border-right: 1px solid #dee2e6;
        border-bottom: 1px solid #dee2e6;
      }
      #tokens-table .tabulator-col:last-child,
      #tokens-table .tabulator-cell:last-child { border-right: none; }
      #tokens-table .tabulator-row:last-child .tabulator-cell { border-bottom: none; }
      .token-reveal {
        font-family: monospace; font-size: 15px; word-break: break-all;
        background: #f8f9fa; border: 1px dashed #0d6efd; padding: 12px;
      }
      .section-title { font-size: 11px; font-weight: 700; text-transform: uppercase;
                       color: #6c757d; letter-spacing: .5px; margin-bottom: 4px; }
      .log-table { font-size: 12px; }
      .invalid-feedback { display: block; }
    </style>
  </head>
  <body class="d-flex flex-column h-100">
    <%- include('../../../partials/header'); %>

    <!-- Breadcrumb -->
    <div class="breadcrumbs pt-3 pb-3">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col">
            <span><%= i18n.__('orders.tokens.title') %></span>
            <div>
              <ul class="list-inline mb-0">
                <li class="list-inline-item">
                  <a href="/"><i class="fas fa-home"></i> <span><%= i18n.__('orders.tokens.breadcrumb.home') %></span></a>
                </li>
                <li class="list-inline-item">
                  <i class="fas fa-chevron-right"></i>
                  <a href="/orders"><%= i18n.__('orders.tokens.breadcrumb.orders') %></a>
                </li>
                <li class="list-inline-item">
                  <i class="fas fa-chevron-right"></i>
                  <%= i18n.__('orders.tokens.breadcrumb.current') %>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-auto">
            <a href="/orders" class="btn btn-primary rounded-0"><i class="fa-solid fa-angle-left"></i></a>
          </div>
        </div>
      </div>
    </div>
    <!-- END Breadcrumb -->
 
      <div class="container-fluid mt-3">
      <div class="row">
        <div class="col-12 mb-3">
          <button type="button" class="btn btn-primary rounded-0 mb-3" data-bs-toggle="modal" data-bs-target="#modalGenerateToken">
