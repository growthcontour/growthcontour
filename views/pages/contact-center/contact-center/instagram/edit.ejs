<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('contact_center.instagram.edit.title') %></title>
		<%- include('../../../../partials/head'); %>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css" />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/themes/monolith.min.css" />
		<link href="/assets/css/scheduler/scheduler.css" rel="stylesheet" />
		<style>
			.pickr .pcr-button { border: 1px solid #eee; border-radius: 0; }
			.pickr-color { display: flex; justify-content: flex-start; }
			.pickr-color .pickr { display: block; }
		</style>
	</head>

	<body class="d-flex flex-column h-100">
		<%- include('../../../../partials/header'); %>

		<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('contact_center.instagram.edit.title') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/"><i class="fas fa-home"></i> <span><%= i18n.__('contact_center.instagram.edit.breadcrumb.home') %></span></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/contact-center"><%= i18n.__('contact_center.instagram.edit.breadcrumb.contact_center') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= i18n.__('contact_center.instagram.edit.breadcrumb.current') %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/contact-center/instagram/settings" class="btn btn-primary rounded-0"><i class="fa-solid fa-angle-left"></i></a>
					</div>
				</div>
			</div>
		</div>

		<!-- ─── ОСНОВНИЙ КОНТЕНТ ──────────────────────────────────────── -->
		<div class="container-fluid mt-3">
			<form id="settings-form">
				<input type="hidden" id="settings_id" value="<%= ns.id %>" />

				<!-- ═══ БЛОК 1: НАЛАШТУВАННЯ АКАУНТА ═══ -->
				<div class="card border-primary rounded-0 mb-3">
					<div class="card-header text-bg-primary rounded-0"><%= i18n.__('contact_center.instagram.edit.bot.title') %></div>
					<div class="card-body">
						<div class="form-check form-switch mb-3">
							<input class="form-check-input" type="checkbox" value="1" id="f_active" name="active" <%= Number(ns.active) === 1 ? 'checked' : '' %> />
							<label class="form-check-label" for="f_active"><%= i18n.__('contact_center.instagram.edit.bot.active') %></label>
						</div>

						<div class="mb-3">
							<label for="f_name" class="form-label"><%= i18n.__('contact_center.instagram.edit.bot.name') %></label>
							<input type="text" class="form-control rounded-0" id="f_name" name="name" value="<%= ns.name %>" />
						</div>

						<div class="mb-3">
							<label class="form-label"><%= i18n.__('contact_center.instagram.edit.bot.username') %></label>
							<input type="text" class="form-control rounded-0 bg-light" value="<%= ns.username || ns.description || '' %>" readonly />
							<input type="hidden" id="f_description" value="<%= ns.description %>" />
						</div>

						<div class="mb-0">
							<label for="f_note" class="form-label"><%= i18n.__('contact_center.instagram.edit.bot.note') %></label>
							<textarea class="form-control rounded-0" id="f_note" name="note" rows="3"><%= ns.note %></textarea>
						</div>
					</div>
				</div>

				<!-- ═══ БЛОК 2: СПОВІЩЕННЯ ═══ -->
				<div class="card border-primary rounded-0 mb-3">
					<div class="card-header text-bg-primary rounded-0"><%= i18n.__('contact_center.instagram.edit.notify.title') %></div>
					<div class="card-body">
						<div class="form-check form-switch mb-3">
							<input class="form-check-input" type="checkbox" value="1" id="f_notify_active" name="notify_active" <%= Number(ns.notify_active) === 1 ? 'checked' : '' %> />
							<label class="form-check-label" for="f_notify_active"><%= i18n.__('contact_center.instagram.edit.notify.active') %></label>
						</div>

						<div class="mb-3">
							<label for="f_chat_id" class="form-label"><%= i18n.__('contact_center.instagram.edit.notify.chat_id') %></label>
							<input type="text" class="form-control rounded-0" id="f_chat_id" name="chat_id" value="<%= ns.chat_id %>" />
						</div>

						<div class="form-check mb-2">
							<input class="form-check-input rounded-0" type="checkbox" value="1" id="f_topic" name="topic" <%= Number(ns.topic) === 1 ? 'checked' : '' %> />
							<label class="form-check-label" for="f_topic"><%= i18n.__('contact_center.instagram.edit.notify.topic') %></label>
						</div>

						<div class="mb-4 <%= Number(ns.topic) === 1 ? '' : 'd-none' %>" id="topic_id_block">
							<label for="f_topic_id" class="form-label"><%= i18n.__('contact_center.instagram.edit.notify.topic_id') %></label>
							<input type="text" class="form-control rounded-0" id="f_topic_id" name="topic_id" value="<%= ns.topic_id %>" />
						</div>

						<hr />

						<h6 class="mb-3"><%= i18n.__('contact_center.instagram.edit.notify.recipients_title') %></h6>

						<!-- CRM користувачі -->
						<div class="mb-3">
							<label class="form-label"><%= i18n.__('contact_center.instagram.edit.notify.recipients_users') %></label>
							<div class="position-relative">
								<input type="text" class="form-control rounded-0" id="rec_user_search" autocomplete="off" placeholder="<%= i18n.__('contact_center.instagram.edit.notify.recipients_users_ph') %>" />
								<div class="list-group position-absolute w-100 shadow-sm" id="rec_user_results" style="display:none; z-index:1080; max-height:200px; overflow-y:auto;"></div>
							</div>
							<div class="d-flex flex-wrap gap-2 mt-2" id="rec_users"></div>
						</div>

						<!-- CRM групи -->
						<div class="mb-0">
							<label class="form-label"><%= i18n.__('contact_center.instagram.edit.notify.recipients_groups') %></label>
							<select class="form-select rounded-0" id="rec_group_select">
								<option value=""><%= i18n.__('contact_center.instagram.edit.notify.recipients_groups_ph') %></option>
							</select>
							<div class="d-flex flex-wrap gap-2 mt-2" id="rec_groups"></div>
						</div>
					</div>
				</div>

				<!-- ═══ БЛОК 3: ВИГЛЯД + РОБОЧИЙ ЧАС ═══ -->
				<div class="row">
					<div class="col-12 col-lg-6 mb-3">
						<div class="card border-primary rounded-0 h-100">
							<div class="card-header text-bg-primary rounded-0"><%= i18n.__('contact_center.instagram.edit.appearance.title') %></div>
							<div class="card-body">
								<div class="row">
									<div class="col-12 col-md-4 mb-3">
										<label class="form-label"><%= i18n.__('contact_center.instagram.edit.appearance.color_text') %></label>
										<div class="pickr-color" data-target="f_color_text"></div>
										<input type="hidden" name="color_text" id="f_color_text" value="<%= ns.color_text %>" />
									</div>
									<div class="col-12 col-md-4 mb-3">
										<label class="form-label"><%= i18n.__('contact_center.instagram.edit.appearance.color_background') %></label>
										<div class="pickr-color" data-target="f_color_background"></div>
										<input type="hidden" name="color_background" id="f_color_background" value="<%= ns.color_background %>" />
									</div>
									<div class="col-12 col-md-4 mb-3">
										<label class="form-label d-block"><%= i18n.__('contact_center.instagram.edit.appearance.icon') %></label>
										<button type="button" class="btn btn-outline-secondary rounded-0 icon-trigger" data-target="f_icon">
											<i class="fa-regular fa-circle-question icon-preview"></i>
										</button>
										<input type="hidden" name="icon" id="f_icon" value="<%= ns.icon %>" />
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="col-12 col-lg-6 mb-3">
						<div class="card border-primary rounded-0 h-100">
							<div class="card-header text-bg-primary rounded-0"><%= i18n.__('contact_center.instagram.edit.working_hours.title') %></div>
							<div class="card-body">
								<table id="example"></table>
								<div class="alert alert-info mt-3 rounded-0 mb-0"><%= i18n.__('contact_center.instagram.edit.working_hours.info') %></div>
							</div>
						</div>
					</div>
				</div>

				<div class="row">
					<div class="col-12 mb-4">
						<button type="button" id="btn_save" class="btn btn-primary rounded-0"><%= i18n.__('contact_center.instagram.edit.save') %></button>
					</div>
				</div>
			</form>
		</div>

		<!-- Пікер іконок -->
		<div id="iconPickerPopup" class="border bg-white p-2 shadow-sm position-absolute overflow-auto d-none" style="z-index: 2000; width: 280px; max-height: 240px">
			<div class="d-flex flex-wrap gap-1" id="iconPickerGrid"></div>
		</div>

		<%- include('../../../../partials/footer'); %> <%- include('../../../../partials/script'); %>

		<!-- Notyf -->
		<script src="/assets/js/notyf/notyf.min.js"></script>
		<!-- scheduler потребує jQuery, тому йде після partials/script -->
		<script src="/assets/js/scheduler/scheduler.js"></script>
		<script>
			const notyf = new Notyf({
				position: { x: "right", y: "top" },
				duration: 4000,
				types: [
					{ type: "success", dismissible: true, icon: false },
					{ type: "error", background: "indianred", dismissible: true, icon: false },
				],
			});
		</script>

		<!-- Пікер іконок Font Awesome -->
		<script>
			const FA_ICONS = ["fa-brands fa-instagram", "fa-solid fa-box", "fa-solid fa-truck", "fa-solid fa-check", "fa-solid fa-circle-check", "fa-solid fa-clock", "fa-solid fa-credit-card", "fa-solid fa-money-bill", "fa-solid fa-cart-shopping", "fa-solid fa-gift", "fa-solid fa-tag", "fa-solid fa-xmark", "fa-solid fa-ban", "fa-solid fa-triangle-exclamation", "fa-solid fa-envelope", "fa-solid fa-paper-plane", "fa-solid fa-clipboard-check", "fa-solid fa-list-check", "fa-solid fa-thumbs-up", "fa-solid fa-star", "fa-solid fa-flag", "fa-solid fa-bell", "fa-solid fa-user-check", "fa-solid fa-shield-halved"];
			const DEFAULT_ICON = "fa-regular fa-circle-question";

			const iconGrid = document.getElementById("iconPickerGrid");
			FA_ICONS.forEach((cls) => {
				const btn = document.createElement("button");
				btn.type = "button";
				btn.className = "btn btn-light btn-sm rounded-0 icon-choice";
				btn.style.width = "40px";
				btn.style.height = "40px";
				btn.dataset.icon = cls;
				btn.innerHTML = '<i class="' + cls + '"></i>';
				iconGrid.appendChild(btn);
			});

			const iconPopup = document.getElementById("iconPickerPopup");
			let activeIconTarget = null;

			document.querySelectorAll(".icon-trigger").forEach((trigger) => {
				trigger.addEventListener("click", function (e) {
					e.stopPropagation();
					activeIconTarget = this.dataset.target;
					const rect = this.getBoundingClientRect();
					iconPopup.style.top = window.scrollY + rect.bottom + 4 + "px";
					iconPopup.style.left = window.scrollX + rect.left + "px";
					iconPopup.classList.remove("d-none");
				});
			});

			iconGrid.addEventListener("click", function (e) {
				const choice = e.target.closest(".icon-choice");
				if (!choice || !activeIconTarget) return;
				const iconClass = choice.dataset.icon;
				document.getElementById(activeIconTarget).value = iconClass;
				const trigger = document.querySelector('.icon-trigger[data-target="' + activeIconTarget + '"]');
				trigger.querySelector(".icon-preview").className = iconClass + " icon-preview";
				iconPopup.classList.add("d-none");
				activeIconTarget = null;
			});

			document.addEventListener("click", function (e) {
				if (!iconPopup.contains(e.target) && !e.target.closest(".icon-trigger")) {
					iconPopup.classList.add("d-none");
				}
			});

			function setIconTrigger(targetId, iconClass) {
				const value = iconClass || DEFAULT_ICON;
				document.getElementById(targetId).value = value;
				const trigger = document.querySelector('.icon-trigger[data-target="' + targetId + '"]');
				trigger.querySelector(".icon-preview").className = value + " icon-preview";
			}

			setIconTrigger("f_icon", document.getElementById("f_icon").value);
		</script>

		<!-- Pickr -->
		<script src="https://cdn.jsdelivr.net/npm/@simonwep/pickr/dist/pickr.min.js"></script>
		<script>
			function initPickr(triggerSelector, inputId, defaultColor) {
				const input = document.getElementById(inputId);
				const pickr = Pickr.create({
					el: triggerSelector,
					theme: "monolith",
					default: input.value || defaultColor,
					swatches: ["#e1306c", "#0057b8", "#2fb25c", "#e74c3c", "#3498db", "#8e44ad", "#f1c40f", "#e67e22", "#7f8c8d", "#34495e"],
					components: { preview: true, opacity: false, hue: true, interaction: { input: true, save: true } },
				});
				pickr.on("save", (color) => {
					if (color) input.value = color.toHEXA().toString(0).slice(0, 7);
					pickr.hide();
				});
				return pickr;
			}

			const pickrText = initPickr('[data-target="f_color_text"]', "f_color_text", "#000000");
			const pickrBg = initPickr('[data-target="f_color_background"]', "f_color_background", "#e1306c");
		</script>

		<!-- Scheduler -->
		<script src="/assets/js/scheduler/scheduler.js"></script>
		<script>
			$.fn.scheduler.locales["uk-UA"] = {
				AM: "ДП", PM: "ПП", TIME_TITLE: "ЧАС", WEEK_TITLE: "ДЕНЬ",
				WEEK_DAYS: ["ПОНЕДІЛОК", "ВІВТОРОК", "СЕРЕДА", "ЧЕТВЕР", "П'ЯТНИЦЯ", "СУБОТА", "НЕДІЛЯ"],
				DRAG_TIP: "Перетягніть, щоб вибрати години",
				RESET: "Скинути вибране",
			};

			$("#example").scheduler({ locale: "uk-UA" });

			$(document).ready(function () {
				$.ajax({
					type: "POST",
					url: "/api/contact-center/instagram/settings/working-hours/select/",
					data: { id: $("#settings_id").val() },
					success: function (response) { $("#example").scheduler("val", response); },
					error: function () {},
				});
			});
		</script>

		<!-- Логіка форми -->
		<script>
			document.getElementById("f_topic").addEventListener("change", function () {
				document.getElementById("topic_id_block").classList.toggle("d-none", !this.checked);
			});

			document.getElementById("btn_save").addEventListener("click", async function () {
				const btn = this;
				if (btn.disabled) return;
				const originalHtml = btn.innerHTML;
				btn.disabled = true;
				btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

				const payload = {
					id: parseInt(document.getElementById("settings_id").value, 10),
					name: document.getElementById("f_name").value,
					description: document.getElementById("f_description").value,
					note: document.getElementById("f_note").value,
					active: document.getElementById("f_active").checked ? 1 : 0,
					notify_active: document.getElementById("f_notify_active").checked ? 1 : 0,
					chat_id: document.getElementById("f_chat_id").value,
					topic: document.getElementById("f_topic").checked ? 1 : 0,
					topic_id: document.getElementById("f_topic_id").value,
					color_text: document.getElementById("f_color_text").value,
					color_background: document.getElementById("f_color_background").value,
					icon: document.getElementById("f_icon").value,
					working_hours: $("#example").scheduler("val"),
					recipients: window.collectRecipients ? window.collectRecipients() : [],
				};

				try {
					const res = await fetch("/api/contact-center/instagram/settings/save/", {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(payload),
					});
					const data = await res.json().catch(() => ({}));
					if (!res.ok || data.status !== "success") {
						throw new Error(data.message || "<%= i18n.__('contact_center.instagram.edit.server_error') %>");
					}
					notyf.success("<%= i18n.__('contact_center.instagram.edit.saved') %>");
				} catch (err) {
					notyf.error(err.message);
				} finally {
					btn.disabled = false;
					btn.innerHTML = originalHtml;
				}
			});
		</script>

		<!-- Отримувачі сповіщень -->
		<script>
			(function () {
				var recUsers = {};
				var recGroups = {};

				var searchTimer = null;
				$("#rec_user_search").on("input", function () {
					clearTimeout(searchTimer);
					var q = $.trim($(this).val());
					var $res = $("#rec_user_results");
					if (q.length < 2) { $res.hide(); return; }
					searchTimer = setTimeout(function () {
						$.post("/api/calendar/users/search", { q: q }).done(function (users) {
							$res.empty();
							(users || []).forEach(function (u) {
								$res.append($('<button type="button" class="list-group-item list-group-item-action small py-1">')
									.attr("data-id", u.id).attr("data-name", u.user_name).text(u.user_name));
							});
							$res.toggle(!!(users && users.length));
						});
					}, 300);
				});
				$("#rec_user_results").on("click", "button", function () {
					recUsers[$(this).data("id")] = $(this).data("name");
					renderUsers();
					$("#rec_user_search").val("");
					$("#rec_user_results").hide();
				});
				function renderUsers() {
					var $box = $("#rec_users").empty();
					Object.keys(recUsers).forEach(function (id) {
						$box.append($('<span class="badge text-bg-light border rounded-0 d-inline-flex align-items-center gap-1 py-2">')
							.append($("<span>").text(recUsers[id]))
							.append($('<button type="button" class="btn-close ms-1" style="font-size:.6rem">').attr("data-id", id)));
					});
				}
				$("#rec_users").on("click", ".btn-close", function () { delete recUsers[$(this).data("id")]; renderUsers(); });

				$.post("/api/users/groups/list").done(function (resp) {
					var list = (resp && resp.data) || [];
					var $sel = $("#rec_group_select");
					list.forEach(function (g) { $sel.append($("<option>").val(g.id).text(g.name)); });
					Object.keys(recGroups).forEach(function (id) {
						var opt = $sel.find('option[value="' + id + '"]');
						if (opt.length) recGroups[id] = opt.text();
					});
					renderGroups();
				});
				$("#rec_group_select").on("change", function () {
					var id = $(this).val();
					if (!id) return;
					recGroups[id] = $(this).find("option:selected").text();
					this.value = "";
					renderGroups();
				});
				function renderGroups() {
					var $box = $("#rec_groups").empty();
					Object.keys(recGroups).forEach(function (id) {
						$box.append($('<span class="badge text-bg-light border rounded-0 d-inline-flex align-items-center gap-1 py-2">')
							.append($("<span>").text(recGroups[id]))
							.append($('<button type="button" class="btn-close ms-1" style="font-size:.6rem">').attr("data-id", id)));
					});
				}
				$("#rec_groups").on("click", ".btn-close", function () { delete recGroups[$(this).data("id")]; renderGroups(); });

				$.post("/api/contact-center/instagram/settings/recipients/list/", { id: $("#settings_id").val() }).done(function (resp) {
					var rows = (resp && resp.data) || [];
					rows.forEach(function (r) {
						if (r.kind === "crm_user") recUsers[r.ref] = r.name || ("User #" + r.ref);
						else if (r.kind === "crm_group") recGroups[r.ref] = r.name || ("Група #" + r.ref);
					});
					renderUsers();
					renderGroups();
				});

				$(document).on("click", function (e) {
					if (!$(e.target).closest("#rec_user_search, #rec_user_results").length) $("#rec_user_results").hide();
				});

				window.collectRecipients = function () {
					var out = [];
					Object.keys(recUsers).forEach(function (id) { out.push({ kind: "crm_user", ref: id }); });
					Object.keys(recGroups).forEach(function (id) { out.push({ kind: "crm_group", ref: id }); });
					return out;
				};
			})();
		</script>
	</body>
</html>