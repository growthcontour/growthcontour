<!DOCTYPE html>
<html class="h-100" lang="<%= i18n.__('lang_iso') %>">
	<head>
		<title><%= i18n.__('contact_center.chat.title') %></title>
		<%- include('../../../partials/head'); %>
		<style>
			.chats-list-card .avatar {
				height: 44px;
				width: 44px;
				position: relative;
				display: -webkit-box;
				display: -ms-flexbox;
				display: flex;
			}

			.chats-list-card h5 {
				font-size: 0.9375rem;
			}

			.chats-list-card .line-clamp {
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.chats-list-card .badge-circle {
				position: relative;
				border-radius: 2.25rem;
				height: calc(1em + 0.778em);
				padding: 0.389em;
			}

			.chats-list-card .badge-circle > span {
				display: block;
				min-width: 1em;
			}

			.chats-list-card a,
			.chats-archive-list-card a {
				position: relative;
				cursor: pointer;
				border-bottom: 1px solid #d2d2d2;
				display: block;
			}

			.chats-list-card a::after,
			.chats-archive-list-card a::after {
				position: absolute;
				content: "";
				height: 100%;
				width: 0.25rem;
				left: 0;
				top: 0;
			}

			.chats-list-card a:hover::after,
			.chats-archive-list-card a:hover::after {
				background-color: #0057b8;
			}

			form textarea {
				resize: none;
			}

			.tab-count:empty {
				display: none;
			}
		</style>
	</head>

	<body class="d-flex flex-column h-100">
		<%- include('../../../partials/header'); %>
		<!-- ─── ХЛІБНІ КРИХТИ ─────────────────────────────────────────── -->
		<div class="breadcrumbs pt-3 pb-3">
			<div class="container-fluid">
				<div class="row align-items-center">
					<div class="col">
						<span><%= i18n.__('contact_center.chats_list.pagetitle') %></span>
						<div>
							<ul class="list-inline mb-0">
								<li class="list-inline-item">
									<a href="/">
										<i class="fas fa-home"></i>
										<span><%= i18n.__('contact_center.chats_list.breadcrumb.home') %></span>
									</a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<a href="/orders"><%= i18n.__('contact_center.chats_list.breadcrumb.orders') %></a>
								</li>
								<li class="list-inline-item">
									<i class="fas fa-chevron-right"></i>
									<%= i18n.__('contact_center.chats_list.breadcrumb.current') %>
								</li>
							</ul>
						</div>
					</div>
					<div class="col-auto">
						<a href="/contact-center/channels/" class="btn btn-outline-primary rounded-0 me-1" title="<%= i18n.__('contact_center.channels.title') %>">
							<i class="fa-solid fa-plug"></i>
						</a>
						<a href="/orders" class="btn btn-primary rounded-0">
							<i class="fa-solid fa-angle-left"></i>
						</a>
					</div>
				</div>
			</div>
		</div>
		<div class="container-fluid mt-3 h-100">
			<div class="row h-100">
				<div class="col-12 col-lg-3 mb-3 d-flex flex-column">
					<ul class="nav nav-underline nav-fill mb-3" id="pills-tab" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="pills-open-tab" data-bs-toggle="pill" data-bs-target="#pills-open" data-tab="open" type="button" role="tab" aria-controls="pills-open" aria-selected="true">
								<%= i18n.__('contact_center.chats_list.tab_open') %>
								<span class="tab-count badge text-bg-secondary rounded-0"></span>
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="pills-resolved-tab" data-bs-toggle="pill" data-bs-target="#pills-resolved" data-tab="resolved" type="button" role="tab" aria-controls="pills-resolved" aria-selected="false">
								<%= i18n.__('contact_center.chats_list.tab_resolved') %>
								<span class="tab-count badge text-bg-secondary rounded-0"></span>
							</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="pills-archived-tab" data-bs-toggle="pill" data-bs-target="#pills-archived" data-tab="archived" type="button" role="tab" aria-controls="pills-archived" aria-selected="false">
								<%= i18n.__('contact_center.chats_list.tab_archived') %>
								<span class="tab-count badge text-bg-secondary rounded-0"></span>
							</button>
						</li>
					</ul>
					<div class="tab-content h-100" id="pills-tabContent">
						<!-- ВКЛАДКА: ВІДКРИТІ -->
						<div class="tab-pane fade h-100 show active" id="pills-open" role="tabpanel" aria-labelledby="pills-open-tab" tabindex="0">
							<div class="h-100 d-flex flex-column">
								<form class="mb-3">
									<div class="input-group">
										<span class="input-group-text rounded-0"><i class="fa-solid fa-magnifying-glass"></i></span>
										<input type="text" class="form-control rounded-0 chat-search" data-target="chats-list-open" placeholder="<%= i18n.__('contact_center.chats_list.search') %>" />
									</div>
								</form>
								<div class="card h-100 rounded-0">
									<div class="card-header rounded-0"><%= i18n.__('contact_center.chats_list.card_chats') %></div>
									<div style="position: relative; height: 100%; overflow: hidden; min-height: 300px">
										<div id="chats-list-open" class="chats-list-card chats-container p-0 text-center" data-tab="open" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; width: 100%; scrollbar-width: thin; overflow-y: scroll; overflow-x: hidden"></div>
									</div>
								</div>
							</div>
						</div>

						<!-- ВКЛАДКА: ЗАВЕРШЕНІ -->
						<div class="tab-pane fade h-100" id="pills-resolved" role="tabpanel" aria-labelledby="pills-resolved-tab" tabindex="0">
							<div class="h-100 d-flex flex-column">
								<form class="mb-3">
									<div class="input-group">
										<span class="input-group-text rounded-0"><i class="fa-solid fa-magnifying-glass"></i></span>
										<input type="text" class="form-control rounded-0 chat-search" data-target="chats-list-resolved" placeholder="<%= i18n.__('contact_center.chats_list.search') %>" />
									</div>
								</form>
								<div class="card h-100 rounded-0">
									<div class="card-header rounded-0"><%= i18n.__('contact_center.chats_list.card_resolved') %></div>
									<div style="position: relative; height: 100%; overflow: hidden; min-height: 300px">
										<div id="chats-list-resolved" class="chats-list-card chats-container p-0 text-center" data-tab="resolved" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; width: 100%; scrollbar-width: thin; overflow-y: scroll; overflow-x: hidden"></div>
									</div>
								</div>
							</div>
						</div>

						<!-- ВКЛАДКА: АРХІВ -->
						<div class="tab-pane fade h-100" id="pills-archived" role="tabpanel" aria-labelledby="pills-archived-tab" tabindex="0">
							<div class="h-100 d-flex flex-column">
								<form class="mb-3">
									<div class="input-group">
										<span class="input-group-text rounded-0"><i class="fa-solid fa-magnifying-glass"></i></span>
										<input type="text" class="form-control rounded-0 chat-search" data-target="chats-list-archived" placeholder="<%= i18n.__('contact_center.chats_list.search') %>" />
									</div>
								</form>
								<div class="card h-100 rounded-0">
									<div class="card-header rounded-0"><%= i18n.__('contact_center.chats_list.card_archive') %></div>
									<div style="position: relative; height: 100%; overflow: hidden; min-height: 300px">
										<div id="chats-list-archived" class="chats-list-card chats-container p-0 text-center" data-tab="archived" style="position: absolute; top: 0; bottom: 0; left: 0; right: 0; width: 100%; scrollbar-width: thin; overflow-y: scroll; overflow-x: hidden"></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="col-12 col-lg-9 mb-3">
					<div class="card rounded-0">
						<div class="card-body">
							<p class="mb-0"><%= i18n.__('contact_center.chats_list.select_chat') %></p>
						</div>
					</div>
				</div>
			</div>
		</div>

		<%- include('../../../partials/footer'); %> <%- include('../../../partials/script'); %>

		<script>
			// ================================================================
			// КОНСТАНТИ
			// ================================================================
			const currentUserId = "<%= user.userId %>";
			const isUk = "<%= i18n.__('lang_iso') %>" === "uk";

			// Переклади для клієнтського коду (рендеряться на сервері)
			const T = {
				statusOpen: "<%= i18n.__('contact_center.chats_list.status_open') %>",
				statusInProgress: "<%= i18n.__('contact_center.chats_list.status_in_progress') %>",
				emptyList: "<%= i18n.__('contact_center.chats_list.empty_list') %>",
				loadError: "<%= i18n.__('contact_center.chats_list.load_error') %>",
				noMessages: "<%= i18n.__('contact_center.chats_list.no_messages') %>",
				channelInactive: "<%= i18n.__('contact_center.chats_list.channel_inactive') %>",
			};
		</script>

		<script>
			// ================================================================
			// РЕНДЕР ЕЛЕМЕНТА ЧАТУ
			// Канало-незалежний: іконка, колір, назва каналу і посилання
			// приходять із сервера. Новий канал (facebook, discord)
			// не потребує правок у цьому файлі.
			// ================================================================
			function escapeHtml(str) {
				return String(str == null ? "" : str).replace(/[&<>"']/g, function (c) {
					return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
				});
			}

			// Єдине посилання на діалог для всіх каналів
			function chatHref(item) {
				return "/contact-center/chat/" + encodeURIComponent(item.url_token || "") + "/";
			}

			// Селектор по наскрізному ID діалогу
			function chatSelector(item) {
				return 'a[data-conv-id="' + Number(item.id) + '"]';
			}

			function formatChatTime(value) {
				if (!value) return "";

				const d = new Date(String(value).replace(" ", "T"));
				if (isNaN(d)) return "";

				const now = new Date();
				if (d.toDateString() === now.toDateString()) return d.toTimeString().slice(0, 5);

				const diffDays = Math.floor((now - d) / 86400000);
				if (diffDays < 7) return d.toLocaleDateString(isUk ? "uk-UA" : "en-US", { weekday: "short" });

				return d.toLocaleDateString(isUk ? "uk-UA" : "en-US", { day: "2-digit", month: "2-digit" });
			}

			function buildChatInner(item) {
				const title = escapeHtml(item.title || "—");

				const countBadge = item.count ? '<span class="badge text-bg-success ms-1">' + item.count + "</span>" : "";

				// Канал вимкнено в налаштуваннях — відповісти не вийде
				const offBadge = item.channel_active === 0 ? '<span class="badge text-bg-danger ms-1" title="' + T.channelInactive + '"><i class="fa-solid fa-plug-circle-xmark"></i></span>' : "";

				const icon = item.channel_icon ? '<span class="ms-2" style="color:' + item.channel_color + ';font-size:small;" title="' + escapeHtml(item.channel_name || "") + '"><i class="' + item.channel_icon + '"></i></span>' : "";

				// Прев'ю останнього повідомлення; стрілка для вихідних
				const dirMark = item.preview_dir === "out" ? '<i class="fa-solid fa-reply fa-flip-horizontal me-1 text-muted"></i>' : "";
				const preview = item.preview ? '<span class="d-block text-muted line-clamp" style="font-size:small;">' + dirMark + escapeHtml(item.preview) + "</span>" : "";

				const statusMap = {
					0: '<span style="display:block;font-size:small;">🟢 ' + T.statusOpen + "</span>",
					1: '<span style="display:block;font-size:small;">🔵 ' + T.statusInProgress + "</span>",
				};
				const statusLabel = statusMap[item.status] || statusMap[0];

				const time = '<span class="text-muted" style="font-size:small;white-space:nowrap;">' + formatChatTime(item.last_at) + "</span>";

				return '<div class="d-flex align-items-start justify-content-between">' + '<p class="mb-0 text-start">' + title + countBadge + offBadge + preview + statusLabel + "</p>" + '<span class="text-end">' + time + icon + "</span>" + "</div>";
			}

			// ================================================================
			// UPSERT елемента списку
			// ================================================================
			const OPEN_LIST = "#chats-list-open";

			function spinnerHtml() {
				return '<svg width="24" height="24" viewBox="0 0 24 24" style="margin:15px auto;display:block"><rect x="1" y="4" width="6" height="14" style="fill:#0057b8;animation:spinner_Ctle .8s linear infinite;animation-delay:-.8s"></rect><rect x="9" y="4" width="6" height="14" style="fill:#0057b8;animation:spinner_Ctle .8s linear infinite;animation-delay:-.65s"></rect><rect x="17" y="4" width="6" height="14" style="fill:#0057b8;animation:spinner_Ctle .8s linear infinite;animation-delay:-.5s"></rect></svg>';
			}

			function upsertActiveChat(item, reorder, listSel) {
				if (reorder === undefined) reorder = true;
				if (!listSel) listSel = OPEN_LIST;

				const $list = $(listSel);
				const $existing = $list.find(chatSelector(item));

				if ($existing.length) {
					$existing.attr("data-status", item.status || 0).html(buildChatInner(item));
					if (reorder) $list.prepend($existing);
					return;
				}

				$list.find("svg, p.empty-msg").remove();
				$list.removeClass("text-center");

				const $newItem = $('<a href="' + chatHref(item) + '" class="card-body d-block p-3 text-decoration-none text-reset" data-conv-id="' + Number(item.id) + '" data-channel="' + escapeHtml(item.channel) + '" data-status="' + (item.status || 0) + '"></a>');

				$newItem.html(buildChatInner(item));

				if (reorder) $list.prepend($newItem);
				else $list.append($newItem);
			}

			// ================================================================
			// ВИДАЛЕННЯ елемента
			// ================================================================
			function removeFromList(listSel, convId) {
				const $list = $(listSel);
				$list.find('a[data-conv-id="' + Number(convId) + '"]').remove();

				if (!$list.find("a[data-conv-id]").length) {
					$list.find("svg, p.empty-msg").remove();
					$list.addClass("text-center").append('<p class="empty-msg mt-3 mb-3">' + T.emptyList + "</p>");
				}
			}

			function removeActiveChat(convId) {
				removeFromList("#chats-list-open", convId);
				removeFromList("#chats-list-resolved", convId);
				removeFromList("#chats-list-archived", convId);
			}
		</script>

		<script>
			// ================================================================
			// ЗАВАНТАЖЕННЯ СПИСКУ
			// ================================================================
			let listView = "all"; // all | mine

			const tabState = {
				open: { cursorDate: null, cursorId: null, loading: false, done: false, loaded: false, sel: "#chats-list-open" },
				resolved: { cursorDate: null, cursorId: null, loading: false, done: false, loaded: false, sel: "#chats-list-resolved" },
				archived: { cursorDate: null, cursorId: null, loading: false, done: false, loaded: false, sel: "#chats-list-archived" },
			};

			function loadTab(tab, reset) {
				const st = tabState[tab];
				if (!st || st.loading) return;

				if (reset) {
					st.cursorDate = null;
					st.cursorId = null;
					st.done = false;
				}
				if (st.done) return;

				st.loading = true;

				const $list = $(st.sel);
				if (reset) $list.html(spinnerHtml());

				$.ajax({
					url: "/api/contact-center/get-list-chats/",
					method: "POST",
					contentType: "application/json",
					data: JSON.stringify({
						view: listView,
						tab: tab,
						cursorDate: st.cursorDate,
						cursorId: st.cursorId,
						limit: 30,
					}),
					success: function (resp) {
						const items = (resp && resp.items) || [];

						$list.find("svg").remove();
						$list.removeClass("text-center");

						// Сервер віддав усе готове — жодних перетворень по каналах
						items.forEach(function (it) {
							upsertActiveChat(it, false, st.sel);
						});

						if (!$list.find("a[data-conv-id]").length) {
							$list.find("svg, p.empty-msg").remove();
							$list.addClass("text-center").append('<p class="empty-msg mt-3 mb-3">' + T.emptyList + "</p>");
						} else {
							$list.find("p.empty-msg").remove();
						}

						st.cursorDate = resp.nextCursorDate || null;
						st.cursorId = resp.nextCursorId || null;
						st.done = !st.cursorDate;
						st.loaded = true;
						st.loading = false;

						// Якщо список не заповнив контейнер — довантажуємо наступну сторінку
						const el = document.querySelector(st.sel);
						if (!st.done && el && el.scrollHeight <= el.clientHeight + 40) loadTab(tab, false);
					},
					error: function (xhr) {
						st.loading = false;
						$list.find("svg").remove();
						if (!$list.find("a[data-conv-id]").length) {
							$list.addClass("text-center").html('<p class="mt-3 text-danger">' + T.loadError + "</p>");
						}
						console.error("get-list-chats:", xhr.status, xhr.statusText);
					},
				});
			}

			// ================================================================
			// ЛІЧИЛЬНИКИ ВКЛАДОК
			// ================================================================
			function loadCounters() {
				$.ajax({
					url: "/api/contact-center/get-counters/",
					method: "POST",
					contentType: "application/json",
					data: JSON.stringify({}),
					success: function (c) {
						$("#pills-open-tab .tab-count").text(c.open || "");
						$("#pills-resolved-tab .tab-count").text(c.resolved || "");
						$("#pills-archived-tab .tab-count").text(c.archived || "");
					},
				});
			}

			function loadOnlineList() {
				$.ajax({
					url: "/api/contact-center/online-list/",
					method: "POST",
					contentType: "application/json",
					data: JSON.stringify({}),
					success: function (resp) {
						(resp.ids || []).forEach(function (id) {
							const $el = $('a[data-conv-id="' + Number(id) + '"]');
							if (!$el.length) return;
							let $dot = $el.find(".cc-dot");
							if (!$dot.length) {
								$dot = $('<span class="cc-dot" style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle"></span>');
								$el.find("p").first().prepend($dot);
							}
							$dot.css("background", "#22c55e");
						});
					},
				});
			}

			$(document).ready(function () {
				loadTab("open", true);
				loadCounters();
				setTimeout(loadOnlineList, 1000);

				$(".chats-container").each(function () {
					const tab = $(this).data("tab");
					this.addEventListener("scroll", function () {
						if (this.scrollTop + this.clientHeight >= this.scrollHeight - 120) loadTab(tab, false);
					});
				});

				$('#pills-tab button[data-bs-toggle="pill"]').on("shown.bs.tab", function () {
					const tab = $(this).data("tab");
					if (tabState[tab] && !tabState[tab].loaded) loadTab(tab, true);
				});
			});

			// ================================================================
			// ПОШУК
			// ================================================================
			$(document).ready(function () {
				$(".chat-search").on("input", function () {
					const query = $(this).val().toLowerCase().trim();
					const listId = $(this).data("target");
					$("#" + listId + " a[data-conv-id]").each(function () {
						const name = $(this).find("p").text().toLowerCase();
						$(this).toggle(name.indexOf(query) !== -1);
					});
				});
			});
		</script>

		<script>
			// ================================================================
			// SOCKET — один потік подій для всіх каналів.
			// Події надсилає модель діалогів, незалежно від того,
			// звідки прийшло повідомлення.
			// ================================================================
			socket.emit("room", "io_alert_contact_center");
			socket.emit("room", "io_manager_" + currentUserId);

			// Нове повідомлення в діалозі (вхідне або вихідне)
			socket.on("cc:message", function (data) {
				if (!data || !data.conversation) return;

				const conv = data.conversation;

				// Клієнт написав у закритий діалог — повертаємо у "Відкриті"
				if (data.reopened) {
					removeFromList("#chats-list-resolved", conv.id);
					removeFromList("#chats-list-archived", conv.id);
				}

				// Лічильник непрочитаних персональний — його не можна брати
				// з широкомовної події. Перезавантажуємо вкладку.
				loadTab("open", true);
				loadCounters();

				// Звук і лічильник у favicon — тільки на вхідні
				if (data.direction === "in") {
					try {
						if (typeof audio !== "undefined") audio.play();
					} catch (e) {}
					if (typeof favico !== "undefined") {
						favico_count = (favico_count | 0) + 1;
						favico.badge(favico_count);
					}
				}
			});

			// Зміна статусу діалогу
			socket.on("cc:conversation_status", function (data) {
				if (!data || !data.id) return;

				if (data.status === "archived") {
					removeFromList("#chats-list-open", data.id);
					removeFromList("#chats-list-resolved", data.id);
					if (tabState.archived.loaded) loadTab("archived", true);
				} else if (data.status === "resolved") {
					removeFromList("#chats-list-open", data.id);
					removeFromList("#chats-list-archived", data.id);
					if (tabState.resolved.loaded) loadTab("resolved", true);
				} else if (data.status === "open") {
					removeFromList("#chats-list-resolved", data.id);
					removeFromList("#chats-list-archived", data.id);
					if (tabState.open.loaded) loadTab("open", true);
				}

				loadCounters();
			});

			// Діалог призначено іншому менеджеру
			socket.on("cc:conversation_removed", function (data) {
				if (!data || !data.id) return;
				removeActiveChat(data.id);
				loadCounters();
			});

			// Онлайн-статус співрозмовника (наразі актуально для веб-чату)
			socket.on("cc:presence", function (data) {
				if (!data || !data.id) return;

				const $el = $('a[data-conv-id="' + Number(data.id) + '"]');
				if (!$el.length) return;

				let $dot = $el.find(".cc-dot");
				if (!$dot.length) {
					$dot = $('<span class="cc-dot" style="display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:middle"></span>');
					$el.find("p").first().prepend($dot);
				}
				$dot.css("background", data.online ? "#22c55e" : "#c4c4c4");
			});
		</script>
	</body>
</html>
